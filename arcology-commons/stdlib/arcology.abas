' Arcology Commons v0.1a: domain helpers for the standalone social network.
'
' This module builds on Commons and ArcoDB. It intentionally avoids web-server
' concerns for now; request routing, identity, and service hosting can attach to
' these records later.

#IMPORT "commons"
#IMPORT "arcodb"

FUNCTION Arcology.Version()
    RETURN "ARCOLOGY_0.1A"
END FUNCTION

FUNCTION Arcology.Manifest()
    RETURN {
        "Name": "The Arcology Commons",
        "Motto": "Built by its citizens. Maintained by its citizens. Belongs to its citizens.",
        "Principles": [
            "Community first",
            "No advertising economy",
            "No selling user data",
            "Transparent moderation",
            "Explainable feeds"
        ]
    }
END FUNCTION

FUNCTION Arcology.Open(path)
    db = ArcoDB.Open(path)
    app = {"Format": Arcology.Version(), "Db": db, "Schemas": {}}
    RETURN Arcology.EnsureSchemas(app)
END FUNCTION

FUNCTION Arcology.EnsureSchemas(app)
    db = app.Db
    schemas = {}

    schemas = Object.Set(schemas, "User", ArcoDB.SchemaVersion(db, "ArcologyUser", ["Handle", "DisplayName", "Bio", "Role", "CreatedAt"], 1))
    schemas = Object.Set(schemas, "Community", ArcoDB.SchemaVersion(db, "ArcologyCommunity", ["Slug", "Name", "Description", "Rules", "CreatedAt"], 1))
    schemas = Object.Set(schemas, "Membership", ArcoDB.SchemaVersion(db, "ArcologyMembership", ["UserHandle", "CommunitySlug", "Role", "CreatedAt"], 1))
    schemas = Object.Set(schemas, "Post", ArcoDB.SchemaVersion(db, "ArcologyPost", ["CommunitySlug", "AuthorHandle", "Title", "Body", "Tags", "CreatedAt", "Visibility", "Removed"], 1))
    schemas = Object.Set(schemas, "Event", ArcoDB.SchemaVersion(db, "ArcologyEvent", ["CommunitySlug", "Title", "StartsAt", "Location", "Description", "CreatedAt"], 1))
    schemas = Object.Set(schemas, "Report", ArcoDB.SchemaVersion(db, "ArcologyReport", ["ContentId", "ReporterHandle", "Reason", "Details", "Evidence", "Status", "CreatedAt"], 1))
    schemas = Object.Set(schemas, "ModerationAction", ArcoDB.SchemaVersion(db, "ArcologyModerationAction", ["ContentId", "RuleId", "Action", "Explanation", "ActorHandle", "CreatedAt", "AppealAvailable"], 1))
    schemas = Object.Set(schemas, "Audit", ArcoDB.SchemaVersion(db, "ArcologyAudit", ["ActorHandle", "Verb", "TargetId", "Reason", "Metadata", "CreatedAt"], 1))

    ignored = ArcoDB.Catalog(db, Object.Get(schemas, "User"), "Handle")
    ignored = ArcoDB.Catalog(db, Object.Get(schemas, "Community"), "Slug")
    ignored = ArcoDB.Catalog(db, Object.Get(schemas, "Post"), "CommunitySlug")
    ignored = ArcoDB.Catalog(db, Object.Get(schemas, "Event"), "CommunitySlug")
    ignored = ArcoDB.Catalog(db, Object.Get(schemas, "Report"), "ContentId")

    app.Db = db
    app.Schemas = schemas
    RETURN app
END FUNCTION

FUNCTION Arcology.Schema(app, name)
    RETURN Object.Get(app.Schemas, name, NULL)
END FUNCTION

FUNCTION Arcology.Now()
    RETURN Time.Now()
END FUNCTION

FUNCTION Arcology.NormalizeHandle(handle)
    RETURN Lower(String.Trim(handle))
END FUNCTION

FUNCTION Arcology.NormalizeSlug(slug)
    text = Lower(String.Trim(slug))
    text = String.Replace(text, " ", "-")
    RETURN text
END FUNCTION

FUNCTION Arcology.CreateUser(app, handle, displayName, bio = "", role = "citizen")
    handle = Arcology.NormalizeHandle(handle)
    validation = Commons.Validation()
    validation = Commons.RequireField(validation, handle, "handle")
    validation = Commons.RequireField(validation, displayName, "displayName")
    validation = Commons.MaxLength(validation, bio, "bio", 500)
    IF validation.Ok == FALSE THEN RETURN Commons.Error("invalid user", "validation")

    schema = Arcology.Schema(app, "User")
    existing = ArcoDB.RecallBy(app.Db, schema, "Handle", handle)
    IF ISNULL(existing) == FALSE THEN RETURN Commons.Error("user already exists: " + handle, "duplicate")

    user = {"Handle": handle, "DisplayName": displayName, "Bio": bio, "Role": role, "CreatedAt": Arcology.Now()}
    id = ArcoDB.Keep(app.Db, schema, user)
    user.__id = id
    RETURN Commons.Ok(user)
END FUNCTION

FUNCTION Arcology.User(app, handle)
    RETURN ArcoDB.RecallBy(app.Db, Arcology.Schema(app, "User"), "Handle", Arcology.NormalizeHandle(handle))
END FUNCTION

FUNCTION Arcology.DefaultRules()
    RETURN [
        Commons.ModerationRule("targeted_dehumanization", "No targeted dehumanization", "Do not portray people or groups as less than human.", "severe"),
        Commons.ModerationRule("violence", "No threats or celebration of violence", "Threats, encouragement, or celebration of violence are prohibited.", "severe"),
        Commons.ModerationRule("harassment", "No targeted harassment", "Repeated targeted harassment is prohibited.", "normal"),
        Commons.ModerationRule("spam", "No spam", "Do not flood communities with unrelated or manipulative content.", "normal")
    ]
END FUNCTION

FUNCTION Arcology.CreateCommunity(app, slug, name, description = "", rules = NULL)
    slug = Arcology.NormalizeSlug(slug)
    IF ISNULL(rules) THEN rules = Arcology.DefaultRules()

    validation = Commons.Validation()
    validation = Commons.RequireField(validation, slug, "slug")
    validation = Commons.RequireField(validation, name, "name")
    validation = Commons.MaxLength(validation, description, "description", 1000)
    IF validation.Ok == FALSE THEN RETURN Commons.Error("invalid community", "validation")

    schema = Arcology.Schema(app, "Community")
    existing = ArcoDB.RecallBy(app.Db, schema, "Slug", slug)
    IF ISNULL(existing) == FALSE THEN RETURN Commons.Error("community already exists: " + slug, "duplicate")

    community = {"Slug": slug, "Name": name, "Description": description, "Rules": rules, "CreatedAt": Arcology.Now()}
    id = ArcoDB.Keep(app.Db, schema, community)
    community.__id = id
    RETURN Commons.Ok(community)
END FUNCTION

FUNCTION Arcology.Community(app, slug)
    RETURN ArcoDB.RecallBy(app.Db, Arcology.Schema(app, "Community"), "Slug", Arcology.NormalizeSlug(slug))
END FUNCTION

FUNCTION Arcology.JoinCommunity(app, handle, slug, role = "member")
    handle = Arcology.NormalizeHandle(handle)
    slug = Arcology.NormalizeSlug(slug)
    IF ISNULL(Arcology.User(app, handle)) THEN RETURN Commons.Error("unknown user: " + handle, "missing_user")
    IF ISNULL(Arcology.Community(app, slug)) THEN RETURN Commons.Error("unknown community: " + slug, "missing_community")

    FOR membership IN ArcoDB.Scan(app.Db, Arcology.Schema(app, "Membership"))
        IF membership.UserHandle == handle AND membership.CommunitySlug == slug THEN
            RETURN Commons.Ok(membership)
        END IF
    NEXT

    membership = {"UserHandle": handle, "CommunitySlug": slug, "Role": role, "CreatedAt": Arcology.Now()}
    id = ArcoDB.Keep(app.Db, Arcology.Schema(app, "Membership"), membership)
    membership.__id = id
    ignored = Arcology.Audit(app, handle, "join_community", "community:" + slug, "joined as " + role)
    RETURN Commons.Ok(membership)
END FUNCTION

FUNCTION Arcology.CommunitiesForUser(app, handle)
    handle = Arcology.NormalizeHandle(handle)
    rows = []
    FOR membership IN ArcoDB.Scan(app.Db, Arcology.Schema(app, "Membership"))
        IF membership.UserHandle == handle THEN ignored = Array.Push(rows, membership.CommunitySlug)
    NEXT
    RETURN rows
END FUNCTION

FUNCTION Arcology.ValidatePost(title, body)
    validation = Commons.Validation()
    validation = Commons.RequireField(validation, title, "title")
    validation = Commons.RequireField(validation, body, "body")
    validation = Commons.MaxLength(validation, title, "title", 160)
    validation = Commons.MaxLength(validation, body, "body", 10000)
    RETURN validation
END FUNCTION

FUNCTION Arcology.Post(app, communitySlug, authorHandle, title, body, tags = [])
    communitySlug = Arcology.NormalizeSlug(communitySlug)
    authorHandle = Arcology.NormalizeHandle(authorHandle)
    validation = Arcology.ValidatePost(title, body)
    IF validation.Ok == FALSE THEN RETURN Commons.Error("invalid post", "validation")
    IF ISNULL(Arcology.Community(app, communitySlug)) THEN RETURN Commons.Error("unknown community: " + communitySlug, "missing_community")
    IF ISNULL(Arcology.User(app, authorHandle)) THEN RETURN Commons.Error("unknown user: " + authorHandle, "missing_user")

    post = {"CommunitySlug": communitySlug, "AuthorHandle": authorHandle, "Title": title, "Body": body, "Tags": tags, "CreatedAt": Arcology.Now(), "Visibility": "community", "Removed": FALSE}
    id = ArcoDB.Keep(app.Db, Arcology.Schema(app, "Post"), post)
    post.__id = id
    ignored = Arcology.Audit(app, authorHandle, "create_post", "post:" + STRING(id), "community:" + communitySlug)
    RETURN Commons.Ok(post)
END FUNCTION

FUNCTION Arcology.Event(app, communitySlug, title, startsAt, location = "", description = "")
    communitySlug = Arcology.NormalizeSlug(communitySlug)
    IF ISNULL(Arcology.Community(app, communitySlug)) THEN RETURN Commons.Error("unknown community: " + communitySlug, "missing_community")
    event = {"CommunitySlug": communitySlug, "Title": title, "StartsAt": startsAt, "Location": location, "Description": description, "CreatedAt": Arcology.Now()}
    id = ArcoDB.Keep(app.Db, Arcology.Schema(app, "Event"), event)
    event.__id = id
    RETURN Commons.Ok(event)
END FUNCTION

FUNCTION Arcology.CommunityFeed(app, communitySlug)
    communitySlug = Arcology.NormalizeSlug(communitySlug)
    items = []
    FOR post IN ArcoDB.Scan(app.Db, Arcology.Schema(app, "Post"))
        IF post.CommunitySlug == communitySlug AND post.Removed == FALSE THEN
            ignored = Array.Push(items, Commons.FeedItem("post", "post:" + STRING(post.__id), post.Title, "From the " + communitySlug + " community", post.CreatedAt))
        END IF
    NEXT
    FOR event IN ArcoDB.Scan(app.Db, Arcology.Schema(app, "Event"))
        IF event.CommunitySlug == communitySlug THEN
            ignored = Array.Push(items, Commons.FeedItem("event", "event:" + STRING(event.__id), event.Title, "Event in the " + communitySlug + " community", event.StartsAt))
        END IF
    NEXT
    RETURN Commons.Feed(items, "Community: " + communitySlug, "Posts and events from one community, in store order.")
END FUNCTION

FUNCTION Arcology.FeedForUser(app, handle)
    handle = Arcology.NormalizeHandle(handle)
    communities = Arcology.CommunitiesForUser(app, handle)
    items = []
    FOR post IN ArcoDB.Scan(app.Db, Arcology.Schema(app, "Post"))
        IF post.Removed == FALSE AND Array.Contains(communities, post.CommunitySlug) THEN
            ignored = Array.Push(items, Commons.FeedItem("post", "post:" + STRING(post.__id), post.Title, "From " + post.CommunitySlug + ", a community you joined", post.CreatedAt))
        END IF
    NEXT
    FOR event IN ArcoDB.Scan(app.Db, Arcology.Schema(app, "Event"))
        IF Array.Contains(communities, event.CommunitySlug) THEN
            ignored = Array.Push(items, Commons.FeedItem("event", "event:" + STRING(event.__id), event.Title, "Event from " + event.CommunitySlug + ", a community you joined", event.StartsAt))
        END IF
    NEXT
    RETURN Commons.Feed(items, "Your Commons", "Items from communities you joined. No hidden engagement ranking.")
END FUNCTION

FUNCTION Arcology.ReportContent(app, contentId, reporterHandle, reason, details = "", evidence = {})
    reporterHandle = Arcology.NormalizeHandle(reporterHandle)
    report = Commons.Report(contentId, reporterHandle, reason, details, evidence)
    stored = {
        "ContentId": report.ContentId,
        "ReporterHandle": report.ReporterId,
        "Reason": report.Reason,
        "Details": report.Details,
        "Evidence": report.Evidence,
        "Status": report.Status,
        "CreatedAt": report.CreatedAt
    }
    id = ArcoDB.Keep(app.Db, Arcology.Schema(app, "Report"), stored)
    stored.__id = id
    ignored = Arcology.Audit(app, reporterHandle, "report_content", contentId, reason)
    RETURN Commons.Ok(stored)
END FUNCTION

FUNCTION Arcology.Moderate(app, contentId, ruleId, action, explanation, actorHandle)
    actorHandle = Arcology.NormalizeHandle(actorHandle)
    modAction = Commons.ModerationAction({"ContentId": contentId}, ruleId, action, explanation, actorHandle)
    stored = {
        "ContentId": contentId,
        "RuleId": ruleId,
        "Action": action,
        "Explanation": explanation,
        "ActorHandle": actorHandle,
        "CreatedAt": modAction.CreatedAt,
        "AppealAvailable": modAction.AppealAvailable
    }
    id = ArcoDB.Keep(app.Db, Arcology.Schema(app, "ModerationAction"), stored)
    stored.__id = id

    IF action == "remove_content" AND String.StartsWith(contentId, "post:") THEN
        postId = NUMBER(String.Delete(contentId, 0, 5))
        post = ArcoDB.Recall(app.Db, Arcology.Schema(app, "Post"), postId)
        IF ISNULL(post) == FALSE THEN
            post.Removed = TRUE
            ignored = ArcoDB.Replace(app.Db, Arcology.Schema(app, "Post"), postId, post)
        END IF
    END IF

    ignored = Arcology.Audit(app, actorHandle, "moderate", contentId, action + ":" + ruleId)
    RETURN Commons.Ok(stored)
END FUNCTION

FUNCTION Arcology.Audit(app, actorHandle, verb, targetId, reason = "", metadata = {})
    entry = Commons.AuditEntry(actorHandle, verb, targetId, reason, metadata)
    stored = {"ActorHandle": entry.ActorId, "Verb": entry.Verb, "TargetId": entry.TargetId, "Reason": entry.Reason, "Metadata": entry.Metadata, "CreatedAt": entry.CreatedAt}
    id = ArcoDB.Keep(app.Db, Arcology.Schema(app, "Audit"), stored)
    stored.__id = id
    RETURN stored
END FUNCTION

FUNCTION Arcology.Save(app)
    RETURN ArcoDB.Write(app.Db)
END FUNCTION

FUNCTION Arcology.Inspect(app)
    dbInfo = ArcoDB.Inspect(app.Db)
    RETURN {"Format": app.Format, "Users": LEN(ArcoDB.Scan(app.Db, Arcology.Schema(app, "User"))), "Communities": LEN(ArcoDB.Scan(app.Db, Arcology.Schema(app, "Community"))), "Posts": LEN(ArcoDB.Scan(app.Db, Arcology.Schema(app, "Post"))), "Events": LEN(ArcoDB.Scan(app.Db, Arcology.Schema(app, "Event"))), "Reports": LEN(ArcoDB.Scan(app.Db, Arcology.Schema(app, "Report"))), "Records": dbInfo.Active}
END FUNCTION

FUNCTION Arcology.HtmlEscape(value)
    text = STRING(value)
    text = String.Replace(text, "&", "&amp;")
    text = String.Replace(text, "<", "&lt;")
    text = String.Replace(text, ">", "&gt;")
    text = String.Replace(text, "\"", "&quot;")
    RETURN text
END FUNCTION

FUNCTION Arcology.SitePath(root, file)
    IF String.EndsWith(root, "/") THEN RETURN root + file
    RETURN root + "/" + file
END FUNCTION

FUNCTION Arcology.SlugFile(slug)
    RETURN "community-" + Arcology.NormalizeSlug(slug) + ".html"
END FUNCTION

FUNCTION Arcology.RenderLayout(title, body)
    escapedTitle = Arcology.HtmlEscape(title)
    html = "<!doctype html>\n"
    html = html + "<html lang=\"en\">\n"
    html = html + "<head>\n"
    html = html + "  <meta charset=\"utf-8\">\n"
    html = html + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    html = html + "  <title>" + escapedTitle + "</title>\n"
    html = html + "  <link rel=\"stylesheet\" href=\"style.css\">\n"
    html = html + "</head>\n"
    html = html + "<body>\n"
    html = html + "  <header class=\"topbar\"><a href=\"index.html\">The Arcology Commons</a><span>Built by its citizens</span></header>\n"
    html = html + "  <main>\n" + body + "\n  </main>\n"
    html = html + "</body>\n"
    html = html + "</html>\n"
    RETURN html
END FUNCTION

FUNCTION Arcology.RenderHome(app)
    manifest = Arcology.Manifest()
    info = Arcology.Inspect(app)
    body = "    <section class=\"hero\">\n"
    body = body + "      <p class=\"eyebrow\">Arcology Commons v0.1a static site</p>\n"
    body = body + "      <h1>" + Arcology.HtmlEscape(manifest.Name) + "</h1>\n"
    body = body + "      <p>" + Arcology.HtmlEscape(manifest.Motto) + "</p>\n"
    body = body + "    </section>\n"
    body = body + "    <section class=\"metrics\">\n"
    body = body + "      <div><strong>" + STRING(info.Users) + "</strong><span>Users</span></div>\n"
    body = body + "      <div><strong>" + STRING(info.Communities) + "</strong><span>Communities</span></div>\n"
    body = body + "      <div><strong>" + STRING(info.Posts) + "</strong><span>Posts</span></div>\n"
    body = body + "      <div><strong>" + STRING(info.Reports) + "</strong><span>Reports</span></div>\n"
    body = body + "    </section>\n"
    body = body + "    <section>\n"
    body = body + "      <h2>Communities</h2>\n"
    body = body + "      <div class=\"grid\">\n"

    FOR community IN ArcoDB.Scan(app.Db, Arcology.Schema(app, "Community"))
        body = body + "        <article class=\"card\">\n"
        body = body + "          <h3><a href=\"" + Arcology.SlugFile(community.Slug) + "\">" + Arcology.HtmlEscape(community.Name) + "</a></h3>\n"
        body = body + "          <p>" + Arcology.HtmlEscape(community.Description) + "</p>\n"
        body = body + "        </article>\n"
    NEXT

    body = body + "      </div>\n    </section>\n"
    RETURN Arcology.RenderLayout(manifest.Name, body)
END FUNCTION

FUNCTION Arcology.RenderCommunity(app, slug)
    community = Arcology.Community(app, slug)
    IF ISNULL(community) THEN
        RETURN Arcology.RenderLayout("Community not found", "    <section><h1>Community not found</h1></section>")
    END IF

    feed = Arcology.CommunityFeed(app, community.Slug)
    body = "    <section class=\"hero compact\">\n"
    body = body + "      <p class=\"eyebrow\">Community</p>\n"
    body = body + "      <h1>" + Arcology.HtmlEscape(community.Name) + "</h1>\n"
    body = body + "      <p>" + Arcology.HtmlEscape(community.Description) + "</p>\n"
    body = body + "    </section>\n"
    body = body + "    <section>\n"
    body = body + "      <h2>Community Rules</h2>\n"
    body = body + "      <ul class=\"rules\">\n"
    FOR rule IN community.Rules
        body = body + "        <li><strong>" + Arcology.HtmlEscape(rule.Title) + "</strong><span>" + Arcology.HtmlEscape(rule.Description) + "</span></li>\n"
    NEXT
    body = body + "      </ul>\n"
    body = body + "    </section>\n"
    body = body + "    <section>\n"
    body = body + "      <h2>Feed</h2>\n"
    body = body + "      <p class=\"explain\">" + Arcology.HtmlEscape(feed.Explanation) + "</p>\n"

    IF LEN(feed.Items) == 0 THEN
        body = body + "      <p class=\"caught-up\">You're caught up.</p>\n"
    ELSE
        body = body + "      <div class=\"stack\">\n"
        FOR item IN feed.Items
            body = body + "        <article class=\"feed-item\">\n"
            body = body + "          <span>" + Arcology.HtmlEscape(item.Kind) + "</span>\n"
            body = body + "          <h3>" + Arcology.HtmlEscape(item.Title) + "</h3>\n"
            body = body + "          <p>" + Arcology.HtmlEscape(item.Reason) + "</p>\n"
            body = body + "        </article>\n"
        NEXT
        body = body + "      </div>\n"
    END IF

    body = body + "    </section>\n"
    RETURN Arcology.RenderLayout(community.Name + " - Arcology", body)
END FUNCTION

FUNCTION Arcology.RenderStyles()
    RETURN ":root{font-family:Inter,Arial,sans-serif;color:#202124;background:#f6f3ed}body{margin:0}.topbar{height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:#202124;color:#fff}.topbar a{color:#fff;text-decoration:none;font-weight:700}main{max-width:1080px;margin:0 auto;padding:28px 20px 56px}.hero{background:#d7e3dc;border-left:6px solid #3b6f5b;padding:28px;margin-bottom:24px}.hero.compact{padding:22px}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#4f5b54}.hero h1{font-size:40px;line-height:1.05;margin:6px 0 10px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:28px}.metrics div,.card,.feed-item{background:#fff;border:1px solid #d8d3ca;border-radius:6px;padding:16px}.metrics strong{display:block;font-size:28px}.metrics span,.explain,.feed-item p{color:#5b625d}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.card a{color:#235b47}.rules{list-style:none;padding:0;display:grid;gap:10px}.rules li{background:#fff;border-left:4px solid #6750a4;padding:12px}.rules span{display:block;color:#5b625d;margin-top:4px}.stack{display:grid;gap:12px}.feed-item span{font-size:12px;text-transform:uppercase;color:#6750a4}.feed-item h3{margin:6px 0}.caught-up{font-weight:700;color:#235b47}@media(max-width:700px){.topbar{align-items:flex-start;flex-direction:column;height:auto;padding:14px 18px;gap:4px}.hero h1{font-size:30px}.metrics{grid-template-columns:repeat(2,1fr)}}\n"
END FUNCTION

FUNCTION Arcology.ExportSite(app, outDir)
    Directory.Create(outDir)
    File.WriteText(Arcology.SitePath(outDir, "style.css"), Arcology.RenderStyles())
    File.WriteText(Arcology.SitePath(outDir, "index.html"), Arcology.RenderHome(app))
    count = 1
    FOR community IN ArcoDB.Scan(app.Db, Arcology.Schema(app, "Community"))
        File.WriteText(Arcology.SitePath(outDir, Arcology.SlugFile(community.Slug)), Arcology.RenderCommunity(app, community.Slug))
        count = count + 1
    NEXT
    RETURN {"Ok": TRUE, "Path": outDir, "Files": count + 1}
END FUNCTION
