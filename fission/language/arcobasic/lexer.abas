#IMPORT "fission/core/capability.abas"

CLASS FissionArcoBasicToken
    CONSTRUCTOR(kind, text, line, column)
        SELF.Kind = kind
        SELF.Text = text
        SELF.Line = line
        SELF.Column = column
    END CONSTRUCTOR

    FUNCTION Render()
        RETURN SELF.Kind + ":" + SELF.Text + "@" + String(SELF.Line) + ":" + String(SELF.Column)
    END FUNCTION
END CLASS

FUNCTION Fission_ArcoBasicIsAlpha(ch)
    RETURN String.Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", ch)
END FUNCTION

FUNCTION Fission_ArcoBasicIsDigit(ch)
    RETURN String.Contains("0123456789", ch)
END FUNCTION

FUNCTION Fission_ArcoBasicIsIdent(ch)
    RETURN Fission_ArcoBasicIsAlpha(ch) OR Fission_ArcoBasicIsDigit(ch)
END FUNCTION

FUNCTION Fission_ArcoBasicIsKeyword(text)
    keywords = ["abstract", "add", "addressof", "and", "andalso", "as", "bitand", "bitnot", "bitor", "bitxor", "catch", "class", "const", "constructor", "contains", "continue", "copy", "do", "else", "end", "exit", "extends", "false", "flags", "for", "function", "goto", "has", "if", "implements", "import", "in", "interface", "let", "loop", "mod", "next", "not", "null", "or", "orelse", "print", "private", "protected", "public", "remove", "return", "run", "sar", "self", "shared", "shl", "shr", "step", "stop", "super", "then", "throw", "to", "toggle", "true", "try", "until", "wend", "while", "xor"]
    RETURN Fission_ListContains(keywords, Lower(text))
END FUNCTION

FUNCTION Fission_ArcoBasicTokenRender(tokens)
    lines = []
    FOR token IN tokens
        ignored = Array.Push(lines, token.Render())
    NEXT
    RETURN Array.Join(lines, "\n")
END FUNCTION

FUNCTION Fission_ArcoBasicEscapedChar(ch)
    IF ch == "n" THEN RETURN "\n"
    IF ch == "r" THEN RETURN "\r"
    IF ch == "t" THEN RETURN "\t"
    IF ch == "0" THEN RETURN "\0"
    RETURN ch
END FUNCTION

' `chars`/`sourceLength` are the whole source exploded once via String.ToChars (see
' Fission_ArcoBasicLex) rather than a bare source string -- String.Length/String.Slice are both a
' full byte-0 rescan per call (needed to answer "what UTF-8 codepoint is at byte N" without any
' cross-call state), so calling them per character over a whole file is O(file length) work per
' character, O(n^2) for the whole scan. A real ~4800-line source file measured at 4+ minutes to
' lex, well past what linear extrapolation from a smaller file predicted, confirmed this exact
' loop as the cause. `chars[index]` below is a plain O(1) array index (this language already
' array-indexes with brackets everywhere, e.g. parser.abas's `SELF.Tokens[SELF.Index]`) --
' `Fission_ArcoBasicCharsSlice` is the only place multiple characters are joined, and each
' character it touches belongs to exactly one token, so total substring work across the whole
' file stays O(n), not O(n^2).
FUNCTION Fission_ArcoBasicCharsSlice(chars, sourceLength, start, length)
    text = ""
    endIndex = start + length
    index = start
    WHILE index < endIndex AND index < sourceLength
        text = text + chars[index]
        index = index + 1
    WEND
    RETURN text
END FUNCTION

FUNCTION Fission_ArcoBasicReadStringToken(chars, sourceLength, startIndex, line, column, interpolated)
    index = startIndex
    startColumn = column
    IF interpolated THEN
        index = index + 2
        column = column + 2
    ELSE
        index = index + 1
        column = column + 1
    END IF
    value = ""
    closed = FALSE
    WHILE index < sourceLength
        ch = chars[index]
        IF ch == "\n" THEN
            token = FissionArcoBasicToken("Error", "unterminated string", line, startColumn)
            RETURN {Token: token, Index: index, Column: column}
        END IF
        IF ch == "\"" THEN
            closed = TRUE
            index = index + 1
            column = column + 1
            EXIT WHILE
        END IF
        IF ch == "\\" THEN
            index = index + 1
            column = column + 1
            IF index >= sourceLength THEN
                token = FissionArcoBasicToken("Error", "unterminated string", line, startColumn)
                RETURN {Token: token, Index: index, Column: column}
            END IF
            escaped = chars[index]
            value = value + Fission_ArcoBasicEscapedChar(escaped)
            index = index + 1
            column = column + 1
            CONTINUE WHILE
        END IF
        value = value + ch
        index = index + 1
        column = column + 1
    WEND
    IF closed == FALSE THEN
        token = FissionArcoBasicToken("Error", "unterminated string", line, startColumn)
        RETURN {Token: token, Index: index, Column: column}
    END IF
    kind = "String"
    IF interpolated THEN kind = "InterpolatedString"
    token = FissionArcoBasicToken(kind, value, line, startColumn)
    RETURN {Token: token, Index: index, Column: column}
END FUNCTION

FUNCTION Fission_ArcoBasicLex(source)
    chars = String.ToChars(source)
    sourceLength = LEN(chars)
    tokens = []
    index = 0
    line = 1
    column = 1
    WHILE index < sourceLength
        ch = chars[index]

        IF ch == " " OR ch == "\t" OR ch == "\r" THEN
            index = index + 1
            column = column + 1
            CONTINUE WHILE
        END IF

        IF ch == "\n" THEN
            ignored = Array.Push(tokens, FissionArcoBasicToken("Newline", "\n", line, column))
            index = index + 1
            line = line + 1
            column = 1
            CONTINUE WHILE
        END IF

        IF ch == "'" THEN
            WHILE index < sourceLength ANDALSO chars[index] != "\n"
                index = index + 1
                column = column + 1
            WEND
            CONTINUE WHILE
        END IF

        IF ch == "\"" THEN
            read = Fission_ArcoBasicReadStringToken(chars, sourceLength, index, line, column, FALSE)
            ignored = Array.Push(tokens, read.Token)
            index = read.Index
            column = read.Column
            CONTINUE WHILE
        END IF

        IF ch == "$" AND Fission_ArcoBasicCharsSlice(chars, sourceLength, index, 2) == "$\"" THEN
            read = Fission_ArcoBasicReadStringToken(chars, sourceLength, index, line, column, TRUE)
            ignored = Array.Push(tokens, read.Token)
            index = read.Index
            column = read.Column
            CONTINUE WHILE
        END IF

        IF Fission_ArcoBasicIsAlpha(ch) THEN
            start = index
            startColumn = column
            WHILE index < sourceLength ANDALSO Fission_ArcoBasicIsIdent(chars[index])
                index = index + 1
                column = column + 1
            WEND
            text = Fission_ArcoBasicCharsSlice(chars, sourceLength, start, index - start)
            kind = "Identifier"
            IF Fission_ArcoBasicIsKeyword(text) THEN kind = "Keyword"
            ignored = Array.Push(tokens, FissionArcoBasicToken(kind, text, line, startColumn))
            CONTINUE WHILE
        END IF

        IF Fission_ArcoBasicIsDigit(ch) THEN
            start = index
            startColumn = column
            WHILE index < sourceLength ANDALSO Fission_ArcoBasicIsDigit(chars[index])
                index = index + 1
                column = column + 1
            WEND
            IF index + 1 < sourceLength ANDALSO chars[index] == "." ANDALSO Fission_ArcoBasicIsDigit(chars[index + 1]) THEN
                index = index + 1
                column = column + 1
                WHILE index < sourceLength ANDALSO Fission_ArcoBasicIsDigit(chars[index])
                    index = index + 1
                    column = column + 1
                WEND
            END IF
            ignored = Array.Push(tokens, FissionArcoBasicToken("Number", Fission_ArcoBasicCharsSlice(chars, sourceLength, start, index - start), line, startColumn))
            CONTINUE WHILE
        END IF

        startColumn = column
        three = Fission_ArcoBasicCharsSlice(chars, sourceLength, index, 3)
        IF Fission_ListContains(["<<=", ">>="], three) THEN
            ignored = Array.Push(tokens, FissionArcoBasicToken("Symbol", three, line, startColumn))
            index = index + 3
            column = column + 3
            CONTINUE WHILE
        END IF

        two = Fission_ArcoBasicCharsSlice(chars, sourceLength, index, 2)
        IF Fission_ListContains(["==", "!=", "<=", ">=", "<>", "&&", "||", "+=", "-=", "*=", "/=", "&=", "|=", "^=", "<<", ">>"], two) THEN
            ignored = Array.Push(tokens, FissionArcoBasicToken("Symbol", two, line, startColumn))
            index = index + 2
            column = column + 2
            CONTINUE WHILE
        END IF

        ignored = Array.Push(tokens, FissionArcoBasicToken("Symbol", ch, line, startColumn))
        index = index + 1
        column = column + 1
    WEND
    ignored = Array.Push(tokens, FissionArcoBasicToken("EOF", "", line, column))
    RETURN tokens
END FUNCTION
