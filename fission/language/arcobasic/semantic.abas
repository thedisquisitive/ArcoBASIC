#IMPORT "fission/core/diagnostics.abas"
#IMPORT "fission/sir/model.abas"

CLASS FissionArcoBasicSemanticSymbol
    CONSTRUCTOR(name, kind, scope)
        SELF.Name = name
        SELF.Kind = kind
        SELF.Scope = scope
        SELF.TypeName = ""
        SELF.DefaultValue = ""
    END CONSTRUCTOR

    FUNCTION Render()
        text = SELF.Kind + " " + SELF.Scope + "::" + SELF.Name
        IF SELF.TypeName != "" THEN text = text + " AS " + SELF.TypeName
        IF SELF.DefaultValue != "" THEN text = text + " = " + SELF.DefaultValue
        RETURN text
    END FUNCTION
END CLASS

CLASS FissionArcoBasicSemanticReference
    CONSTRUCTOR(kind, name, scope)
        SELF.Kind = kind
        SELF.Name = name
        SELF.Scope = scope
        SELF.Target = ""
        SELF.Status = "Unresolved"
    END CONSTRUCTOR

    FUNCTION Render()
        text = SELF.Kind + " " + SELF.Scope + "::" + SELF.Name + " -> " + SELF.Status
        IF SELF.Target != "" THEN text = text + " " + SELF.Target
        RETURN text
    END FUNCTION
END CLASS

CLASS FissionArcoBasicSemanticReport
    CONSTRUCTOR(moduleName)
        SELF.ModuleName = moduleName
        SELF.Symbols = []
        SELF.References = []
        SELF.Diagnostics = FissionDiagnosticBag()
    END CONSTRUCTOR

    FUNCTION HasSymbol(scope, name)
        FOR symbol IN SELF.Symbols
            IF symbol.Scope == scope AND Lower(symbol.Name) == Lower(name) THEN RETURN TRUE
        NEXT
        RETURN FALSE
    END FUNCTION

    FUNCTION FindSymbol(scope, name)
        searchScope = scope
        WHILE TRUE
            FOR symbol IN SELF.Symbols
                IF symbol.Scope == searchScope AND Lower(symbol.Name) == Lower(name) THEN RETURN symbol
            NEXT
            IF searchScope == "module" THEN EXIT WHILE
            IF String.Contains(searchScope, "::") == FALSE THEN EXIT WHILE
            parts = String.Split(searchScope, "::")
            parentParts = []
            index = 0
            WHILE index < LEN(parts) - 1
                ignored = Array.Push(parentParts, parts[index])
                index = index + 1
            WEND
            searchScope = Array.Join(parentParts, "::")
        WEND
        RETURN NULL
    END FUNCTION

    FUNCTION AddSymbol(symbol)
        IF SELF.HasSymbol(symbol.Scope, symbol.Name) THEN
            ignored = SELF.Diagnostics.ReportError("FISSION_ARCOBASIC_DUPLICATE_SYMBOL", "Duplicate symbol " + symbol.Scope + "::" + symbol.Name)
            RETURN symbol
        END IF
        ignored = Array.Push(SELF.Symbols, symbol)
        RETURN symbol
    END FUNCTION

    FUNCTION AddReference(reference)
        ignored = Array.Push(SELF.References, reference)
        RETURN reference
    END FUNCTION

    FUNCTION Render()
        lines = ["ArcoBASIC Semantics " + SELF.ModuleName]
        FOR symbol IN SELF.Symbols
            ignored = Array.Push(lines, "  " + symbol.Render())
        NEXT
        IF LEN(SELF.References) > 0 THEN
            ignored = Array.Push(lines, "  References")
            FOR reference IN SELF.References
                ignored = Array.Push(lines, "    " + reference.Render())
            NEXT
        END IF
        RETURN Array.Join(lines, "\n")
    END FUNCTION
END CLASS

FUNCTION Fission_ArcoBasicSemanticExternalName(name)
    IF name == "" THEN RETURN FALSE
    first = String.Slice(name, 0, 1)
    RETURN first == Upper(first)
END FUNCTION

FUNCTION Fission_ArcoBasicSemanticSplitArgument(argumentText)
    symbol = FissionArcoBasicSemanticSymbol(argumentText, "Parameter", "")
    remaining = argumentText
    IF String.Contains(remaining, "=") THEN
        parts = String.Split(remaining, "=")
        remaining = parts[0]
        symbol.DefaultValue = parts[1]
    END IF
    IF String.Contains(remaining, ":") THEN
        parts = String.Split(remaining, ":")
        symbol.Name = parts[0]
        symbol.TypeName = parts[1]
    ELSE
        symbol.Name = remaining
    END IF
    RETURN symbol
END FUNCTION

FUNCTION Fission_ArcoBasicSemanticAddArguments(report, scope, argsText)
    IF argsText == "" THEN RETURN
    args = String.Split(argsText, ",")
    FOR argText IN args
        argument = Fission_ArcoBasicSemanticSplitArgument(argText)
        argument.Scope = scope
        ignored = report.AddSymbol(argument)
    NEXT
END FUNCTION

FUNCTION Fission_ArcoBasicSemanticEnclosingClassScope(report, scope)
    best = ""
    FOR symbol IN report.Symbols
        IF symbol.Kind == "Class" THEN
            candidate = symbol.Scope + "::" + symbol.Name
            IF scope == candidate OR String.StartsWith(scope, candidate + "::") THEN
                IF LEN(candidate) > LEN(best) THEN best = candidate
            END IF
        END IF
    NEXT
    RETURN best
END FUNCTION

FUNCTION Fission_ArcoBasicSemanticEnsureField(report, classScope, name)
    IF classScope == "" OR name == "" THEN RETURN NULL
    existing = report.FindSymbol(classScope, name)
    IF existing != NULL THEN RETURN existing
    RETURN report.AddSymbol(FissionArcoBasicSemanticSymbol(name, "Field", classScope))
END FUNCTION

FUNCTION Fission_ArcoBasicSemanticIsSelfMember(node)
    IF node.Kind != "MemberRead" THEN RETURN FALSE
    IF LEN(node.Children) == 0 THEN RETURN FALSE
    base = node.Children[0]
    IF base.Kind != "Read" THEN RETURN FALSE
    RETURN Upper(Object.Get(base.Fields, "Name", "")) == "SELF"
END FUNCTION

FUNCTION Fission_ArcoBasicAnalyzeSirNode(report, node, scope)
    IF node.Kind == "Import" THEN
        symbol = FissionArcoBasicSemanticSymbol(Object.Get(node.Fields, "Path", ""), "Import", scope)
        aliasName = Object.Get(node.Fields, "Alias", "")
        IF aliasName != "" THEN symbol.Name = aliasName
        ignored = report.AddSymbol(symbol)
    END IF
    IF node.Kind == "Const" THEN
        symbol = FissionArcoBasicSemanticSymbol(Object.Get(node.Fields, "Name", ""), "Const", scope)
        ignored = report.AddSymbol(symbol)
    END IF
    IF node.Kind == "Declare" THEN
        kind = "Variable"
        IF Fission_ArcoBasicSemanticEnclosingClassScope(report, scope) == scope THEN kind = "Field"
        symbol = FissionArcoBasicSemanticSymbol(Object.Get(node.Fields, "Name", ""), kind, scope)
        symbol.TypeName = Object.Get(node.Fields, "Type", "")
        ignored = report.AddSymbol(symbol)
    END IF
    IF node.Kind == "Assign" THEN
        name = Object.Get(node.Fields, "Name", "")
        IF report.HasSymbol(scope, name) == FALSE THEN ignored = report.AddSymbol(FissionArcoBasicSemanticSymbol(name, "Variable", scope))
    END IF
    IF node.Kind == "Set" AND LEN(node.Children) > 0 THEN
        target = node.Children[0]
        IF Fission_ArcoBasicSemanticIsSelfMember(target) THEN
            classScope = Fission_ArcoBasicSemanticEnclosingClassScope(report, scope)
            ignored = Fission_ArcoBasicSemanticEnsureField(report, classScope, Object.Get(target.Fields, "Name", ""))
        END IF
    END IF
    IF node.Kind == "Function" THEN
        name = Object.Get(node.Fields, "Name", "")
        symbol = FissionArcoBasicSemanticSymbol(name, "Function", scope)
        symbol.TypeName = Object.Get(node.Fields, "Returns", "")
        ignored = report.AddSymbol(symbol)
        functionScope = scope + "::" + name
        ignored = Fission_ArcoBasicSemanticAddArguments(report, functionScope, Object.Get(node.Fields, "Arguments", ""))
        FOR child IN node.Children
            ignored = Fission_ArcoBasicAnalyzeSirNode(report, child, functionScope)
        NEXT
        RETURN
    END IF
    IF node.Kind == "Constructor" THEN
        constructorScope = scope + "::CONSTRUCTOR"
        ignored = Fission_ArcoBasicSemanticAddArguments(report, constructorScope, Object.Get(node.Fields, "Arguments", ""))
        FOR child IN node.Children
            ignored = Fission_ArcoBasicAnalyzeSirNode(report, child, constructorScope)
        NEXT
        RETURN
    END IF
    IF node.Kind == "Class" THEN
        name = Object.Get(node.Fields, "Name", "")
        ignored = report.AddSymbol(FissionArcoBasicSemanticSymbol(name, "Class", scope))
        classScope = scope + "::" + name
        FOR child IN node.Children
            ignored = Fission_ArcoBasicAnalyzeSirNode(report, child, classScope)
        NEXT
        RETURN
    END IF
    IF node.Kind == "Interface" THEN
        name = Object.Get(node.Fields, "Name", "")
        ignored = report.AddSymbol(FissionArcoBasicSemanticSymbol(name, "Interface", scope))
        interfaceScope = scope + "::" + name
        FOR child IN node.Children
            ignored = Fission_ArcoBasicAnalyzeSirNode(report, child, interfaceScope)
        NEXT
        RETURN
    END IF
    IF node.Kind == "ForEach" OR node.Kind == "ForRange" THEN
        name = Object.Get(node.Fields, "Name", "")
        IF name != "" AND report.HasSymbol(scope, name) == FALSE THEN ignored = report.AddSymbol(FissionArcoBasicSemanticSymbol(name, "Variable", scope))
    END IF
    FOR child IN node.Children
        ignored = Fission_ArcoBasicAnalyzeSirNode(report, child, scope)
    NEXT
END FUNCTION

FUNCTION Fission_ArcoBasicResolveReference(report, kind, name, scope)
    reference = FissionArcoBasicSemanticReference(kind, name, scope)
    symbol = report.FindSymbol(scope, name)
    IF symbol != NULL THEN
        reference.Status = "Resolved"
        reference.Target = symbol.Scope + "::" + symbol.Name
        RETURN report.AddReference(reference)
    END IF
    IF Fission_ArcoBasicSemanticExternalName(name) THEN
        reference.Status = "External"
        RETURN report.AddReference(reference)
    END IF
    ignored = report.AddReference(reference)
    RETURN reference
END FUNCTION

FUNCTION Fission_ArcoBasicResolveSirNode(report, node, scope)
    IF node.Kind == "Read" THEN
        ignored = Fission_ArcoBasicResolveReference(report, "Read", Object.Get(node.Fields, "Name", ""), scope)
        RETURN
    END IF
    IF node.Kind == "Call" THEN
        ignored = Fission_ArcoBasicResolveReference(report, "Call", Object.Get(node.Fields, "Name", ""), scope)
        FOR child IN node.Children
            ignored = Fission_ArcoBasicResolveSirNode(report, child, scope)
        NEXT
        RETURN
    END IF
    IF node.Kind == "CallExpr" THEN
        IF LEN(node.Children) > 0 THEN
            callee = node.Children[0]
            IF callee.Kind == "Read" THEN
                ignored = Fission_ArcoBasicResolveReference(report, "Call", Object.Get(callee.Fields, "Name", ""), scope)
            ELSE
                IF Fission_ArcoBasicSemanticIsSelfMember(callee) THEN
                    classScope = Fission_ArcoBasicSemanticEnclosingClassScope(report, scope)
                    ignored = Fission_ArcoBasicResolveReference(report, "Call", Object.Get(callee.Fields, "Name", ""), classScope)
                ELSE
                    ignored = Fission_ArcoBasicResolveSirNode(report, callee, scope)
                END IF
            END IF
        END IF
        index = 1
        WHILE index < LEN(node.Children)
            ignored = Fission_ArcoBasicResolveSirNode(report, node.Children[index], scope)
            index = index + 1
        WEND
        RETURN
    END IF
    IF Fission_ArcoBasicSemanticIsSelfMember(node) THEN
        classScope = Fission_ArcoBasicSemanticEnclosingClassScope(report, scope)
        ignored = Fission_ArcoBasicResolveReference(report, "Field", Object.Get(node.Fields, "Name", ""), classScope)
        RETURN
    END IF
    IF node.Kind == "Function" THEN
        functionScope = scope + "::" + Object.Get(node.Fields, "Name", "")
        FOR child IN node.Children
            ignored = Fission_ArcoBasicResolveSirNode(report, child, functionScope)
        NEXT
        RETURN
    END IF
    IF node.Kind == "Constructor" THEN
        constructorScope = scope + "::CONSTRUCTOR"
        FOR child IN node.Children
            ignored = Fission_ArcoBasicResolveSirNode(report, child, constructorScope)
        NEXT
        RETURN
    END IF
    IF node.Kind == "Class" THEN
        classScope = scope + "::" + Object.Get(node.Fields, "Name", "")
        FOR child IN node.Children
            ignored = Fission_ArcoBasicResolveSirNode(report, child, classScope)
        NEXT
        RETURN
    END IF
    IF node.Kind == "Interface" THEN
        interfaceScope = scope + "::" + Object.Get(node.Fields, "Name", "")
        FOR child IN node.Children
            ignored = Fission_ArcoBasicResolveSirNode(report, child, interfaceScope)
        NEXT
        RETURN
    END IF
    FOR child IN node.Children
        ignored = Fission_ArcoBasicResolveSirNode(report, child, scope)
    NEXT
END FUNCTION

FUNCTION Fission_ArcoBasicEnforceStrictReferences(report)
    FOR reference IN report.References
        IF reference.Status == "Unresolved" THEN
            ignored = report.Diagnostics.ReportError("FISSION_ARCOBASIC_UNRESOLVED_SYMBOL", "Unresolved " + Lower(reference.Kind) + " " + reference.Scope + "::" + reference.Name)
        END IF
    NEXT
    RETURN report
END FUNCTION

FUNCTION Fission_ArcoBasicAnalyzeSir(module)
    report = FissionArcoBasicSemanticReport(module.Name)
    FOR statement IN module.Statements
        ignored = Fission_ArcoBasicAnalyzeSirNode(report, statement, "module")
    NEXT
    FOR statement IN module.Statements
        ignored = Fission_ArcoBasicResolveSirNode(report, statement, "module")
    NEXT
    RETURN report
END FUNCTION

FUNCTION Fission_ArcoBasicAnalyzeSirStrict(module)
    report = Fission_ArcoBasicAnalyzeSir(module)
    ignored = Fission_ArcoBasicEnforceStrictReferences(report)
    RETURN report
END FUNCTION
