#IMPORT "fission/amir/model.abas"
#IMPORT "fission/sir/model.abas"

' SIR -> A-MIR lowering for the RFC's own "Tiny BASIC-like" acceptance subset
' (RFC-AP-FISSION-001 section 8, Test B: variables, numeric expressions,
' PRINT, IF, WHILE, functions) -- not the full current SIR surface. Real,
' honestly-scoped: unsupported SIR node kinds report a diagnostic and lower to
' a CONST 0 placeholder rather than silently producing wrong A-MIR or
' crashing, the same pattern the ArcoBASIC frontend itself already uses for
' unsupported syntax (see FISSION_ARCOBASIC_UNSUPPORTED_STATEMENT /
' _EXPRESSION). Every construct this file DOES lower was checked against
' `ArcoFission reveal FILE at A-MIR` (the legacy compiler, this project's own
' equivalence-testing oracle per RFC section 41) for the shape of temporaries,
' typed operators, block control flow, and function calls -- not for exact
' temp-number/block-name equivalence, which depends on the legacy allocator's
' own incidental processing order and is not attempted here.
'
' Type inference is intentionally minimal: a variable's type is known only
' when declared explicitly (`LET x AS U64` / a function parameter's own
' `AS type`) and tracked in a flat per-function scope stack (this project's
' scope model has no finer block scoping elsewhere either, see semantic.abas).
' A binary operation between two knowns of the same type lowers to a typed
' `INT.*` opcode; anything else lowers to the untyped generic-operator form
' the legacy compiler itself falls back to for untyped operands.

FUNCTION Fission_AmirBinaryTypedOp(operatorName)
    IF operatorName == "+" THEN RETURN "INT.ADD"
    IF operatorName == "-" THEN RETURN "INT.SUB"
    IF operatorName == "*" THEN RETURN "INT.MUL"
    IF operatorName == "==" THEN RETURN "INT.CMP_EQ"
    IF operatorName == "!=" THEN RETURN "INT.CMP_NE"
    IF operatorName == "<" THEN RETURN "INT.CMP_LT_UNSIGNED"
    IF operatorName == "<=" THEN RETURN "INT.CMP_LE_UNSIGNED"
    IF operatorName == ">" THEN RETURN "INT.CMP_GT_UNSIGNED"
    IF operatorName == ">=" THEN RETURN "INT.CMP_GE_UNSIGNED"
    RETURN ""
END FUNCTION

FUNCTION Fission_AmirIsComparison(operatorName)
    RETURN Fission_ListContains(["==", "!=", "<", "<=", ">", ">="], operatorName)
END FUNCTION

CLASS FissionAmirScope
    CONSTRUCTOR()
        SELF.Types = {}
    END CONSTRUCTOR

    FUNCTION Declare(name, typeName)
        IF typeName != "" THEN SELF.Types = Object.Set(SELF.Types, name, typeName)
        RETURN SELF
    END FUNCTION

    FUNCTION TypeOf(name)
        RETURN Object.Get(SELF.Types, name, "")
    END FUNCTION
END CLASS

CLASS FissionAmirBuilder
    CONSTRUCTOR(moduleName)
        SELF.Module = FissionAmirModule(moduleName)
        SELF.TempCounter = 0
        SELF.BlockCounter = 0
        SELF.CurrentBlock = NULL
        ' Explicitly tracked rather than inferred as "the module's last
        ' function" -- a real bug caught by comparing against the legacy
        ' oracle: inferring it that way silently reattached every block from
        ' an IF/WHILE encountered in Main, after a nested FUNCTION
        ' declaration had already been lowered, onto that nested function
        ' instead (since it had become the module's last-added function),
        ' producing a well-formed-looking but structurally wrong A-MIR module.
        SELF.CurrentFunction = NULL
        SELF.Scope = FissionAmirScope()
        SELF.Diagnostics = FissionDiagnosticBag()
    END CONSTRUCTOR

    FUNCTION NewTemp()
        name = "%t" + String(SELF.TempCounter)
        SELF.TempCounter = SELF.TempCounter + 1
        RETURN name
    END FUNCTION

    FUNCTION NewBlockName(prefix)
        name = prefix + String(SELF.BlockCounter)
        SELF.BlockCounter = SELF.BlockCounter + 1
        RETURN name
    END FUNCTION

    FUNCTION Emit(instruction)
        RETURN SELF.CurrentBlock.Append(instruction)
    END FUNCTION

    FUNCTION Unsupported(kind, detail)
        ignored = SELF.Diagnostics.ReportError("FISSION_AMIR_UNSUPPORTED", "Unsupported SIR " + kind + " for A-MIR lowering: " + detail)
        temp = SELF.NewTemp()
        ignored = SELF.Emit(FissionAmirInstruction("Const").WithField("Dest", temp).WithField("Value", "0"))
        RETURN {Value: temp, Type: ""}
    END FUNCTION
END CLASS

' Lowers a SIR expression node into (a) the A-MIR operand referring to its
' result (a temp name, or a literal's own text for a bare CONST) and (b) the
' operand's known type ("" when not statically known). Every non-trivial
' result is materialized into a fresh temp via CONST/LOAD/BinOp/CALL, matching
' the legacy oracle's own three-address-code shape.
FUNCTION Fission_AmirLowerExpr(builder, node)
    IF node.Kind == "Literal" THEN
        literalKind = Object.Get(node.Fields, "LiteralKind", "")
        value = Object.Get(node.Fields, "Value", "")
        IF literalKind == "InterpolatedString" THEN RETURN Fission_AmirUnsupportedExpr(builder, "interpolated string literal")
        IF value == "TRUE" THEN RETURN {Value: "1", Type: "BOOL"}
        IF value == "FALSE" THEN RETURN {Value: "0", Type: "BOOL"}
        IF value == "NULL" THEN RETURN Fission_AmirUnsupportedExpr(builder, "null literal")
        temp = builder.NewTemp()
        constText = value
        ' A plain string literal's CONST operand is quoted in the legacy
        ' oracle's own A-MIR (`CONST "hello"`), unlike a bare numeric CONST --
        ' confirmed via `ArcoFission reveal ... at A-MIR` on a real
        ' `s = "hello"` program.
        IF literalKind == "String" THEN constText = "\"" + value + "\""
        ignored = builder.Emit(FissionAmirInstruction("Const").WithField("Dest", temp).WithField("Value", constText))
        RETURN {Value: temp, Type: ""}
    END IF
    IF node.Kind == "Read" THEN
        name = Object.Get(node.Fields, "Name", "")
        temp = builder.NewTemp()
        ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", temp).WithField("Name", name))
        RETURN {Value: temp, Type: builder.Scope.TypeOf(name)}
    END IF
    IF node.Kind == "Binary" THEN
        operatorName = Object.Get(node.Fields, "Operator", "")
        left = Fission_AmirLowerExpr(builder, node.Children[0])
        right = Fission_AmirLowerExpr(builder, node.Children[1])
        typedOp = Fission_AmirBinaryTypedOp(operatorName)
        isComparison = Fission_AmirIsComparison(operatorName)
        dest = builder.NewTemp()
        instruction = FissionAmirInstruction("BinOp").WithField("Dest", dest).WithField("Left", left.Value).WithField("Right", right.Value).WithField("LeftType", left.Type).WithField("RightType", right.Type)
        resultType = ""
        ' A real, oracle-confirmed asymmetry: comparisons ALWAYS lower to the
        ' typed INT.CMP_* opcode with a BOOL result and a `[LeftType,
        ' RightType]` bracket, even when both operand types are unknown
        ' (`%t7 :BOOL := INT.CMP_EQ %t5, %t6 [,]` -- empty bracket, still
        ' shown). Arithmetic only gets the typed INT.* form -- bracket
        ' included -- when both operand types are concretely known and match;
        ' otherwise it falls back to the bare untyped operator with no
        ' bracket at all (`%t17 := + %t15, %t16`). Both confirmed directly
        ' against `ArcoFission reveal ... at A-MIR`, not assumed.
        arithmeticTyped = typedOp != "" AND isComparison == FALSE AND left.Type != "" AND left.Type == right.Type
        IF isComparison THEN resultType = "BOOL"
        IF arithmeticTyped THEN resultType = left.Type
        IF isComparison OR arithmeticTyped THEN
            ignored = instruction.WithField("Op", typedOp)
            ignored = instruction.WithField("Type", resultType)
            ignored = instruction.WithField("ShowBracket", "TRUE")
        END IF
        IF (isComparison OR arithmeticTyped) == FALSE THEN
            ignored = instruction.WithField("Op", operatorName)
        END IF
        ignored = builder.Emit(instruction)
        RETURN {Value: dest, Type: resultType}
    END IF
    IF node.Kind == "CallExpr" THEN
        callee = node.Children[0]
        IF callee.Kind != "Read" THEN RETURN Fission_AmirUnsupportedExpr(builder, "indirect call target")
        calleeName = Object.Get(callee.Fields, "Name", "")
        argValues = []
        index = 1
        WHILE index < LEN(node.Children)
            argResult = Fission_AmirLowerExpr(builder, node.Children[index])
            ignored = Array.Push(argValues, argResult.Value)
            index = index + 1
        WEND
        dest = builder.NewTemp()
        ignored = builder.Emit(FissionAmirInstruction("Call").WithField("Dest", dest).WithField("Callee", calleeName).WithField("Args", Array.Join(argValues, " ")))
        RETURN {Value: dest, Type: ""}
    END IF
    IF node.Kind == "Array" THEN
        itemValues = []
        FOR child IN node.Children
            itemResult = Fission_AmirLowerExpr(builder, child)
            ignored = Array.Push(itemValues, itemResult.Value)
        NEXT
        dest = builder.NewTemp()
        ignored = builder.Emit(FissionAmirInstruction("Array").WithField("Dest", dest).WithField("Items", Array.Join(itemValues, " ")))
        RETURN {Value: dest, Type: ""}
    END IF
    IF node.Kind == "Object" THEN
        fieldTexts = []
        FOR fieldNode IN node.Children
            fieldName = Object.Get(fieldNode.Fields, "Name", "")
            fieldValue = Fission_AmirLowerExpr(builder, fieldNode.Children[0])
            ignored = Array.Push(fieldTexts, fieldName + ":" + fieldValue.Value)
        NEXT
        dest = builder.NewTemp()
        ignored = builder.Emit(FissionAmirInstruction("Object").WithField("Dest", dest).WithField("Fields", Array.Join(fieldTexts, " ")))
        RETURN {Value: dest, Type: ""}
    END IF
    IF node.Kind == "IndexRead" THEN
        base = Fission_AmirLowerExpr(builder, node.Children[0])
        indexResult = Fission_AmirLowerExpr(builder, node.Children[1])
        dest = builder.NewTemp()
        ignored = builder.Emit(FissionAmirInstruction("Index").WithField("Dest", dest).WithField("Base", base.Value).WithField("Index", indexResult.Value))
        RETURN {Value: dest, Type: ""}
    END IF
    ' `obj.field` reads lower through the SAME INDEX opcode array indexing
    ' uses, just with a quoted string CONST as the index operand instead of
    ' a numeric one -- confirmed via the oracle (`err.Message` inside a real
    ' CATCH body lowers to `%t3 := CONST "Message"` / `%t4 := INDEX %t2,
    ' %t3`, no dedicated member-access opcode at all).
    IF node.Kind == "MemberRead" THEN
        base = Fission_AmirLowerExpr(builder, node.Children[0])
        fieldName = Object.Get(node.Fields, "Name", "")
        keyTemp = builder.NewTemp()
        ignored = builder.Emit(FissionAmirInstruction("Const").WithField("Dest", keyTemp).WithField("Value", "\"" + fieldName + "\""))
        dest = builder.NewTemp()
        ignored = builder.Emit(FissionAmirInstruction("Index").WithField("Dest", dest).WithField("Base", base.Value).WithField("Index", keyTemp))
        RETURN {Value: dest, Type: ""}
    END IF
    RETURN Fission_AmirUnsupportedExpr(builder, node.Kind)
END FUNCTION

FUNCTION Fission_AmirUnsupportedExpr(builder, detail)
    RETURN builder.Unsupported("expression", detail)
END FUNCTION

FUNCTION Fission_AmirLowerIf(builder, node)
    condition = Fission_AmirLowerExpr(builder, node.Children[0])
    thenName = builder.NewBlockName("IfThen")
    elseName = builder.NewBlockName("IfElse")
    endName = builder.NewBlockName("IfEnd")
    ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", condition.Value).WithField("Then", thenName).WithField("Else", elseName))

    thenBlock = builder.CurrentFunction.AddBlock(FissionAmirBlock(thenName))
    builder.CurrentBlock = thenBlock
    FOR statement IN node.Children[1].Children
        ignored = Fission_AmirLowerStatement(builder, statement)
    NEXT
    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", endName))

    elseBlock = builder.CurrentFunction.AddBlock(FissionAmirBlock(elseName))
    builder.CurrentBlock = elseBlock
    FOR statement IN node.Children[2].Children
        ignored = Fission_AmirLowerStatement(builder, statement)
    NEXT
    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", endName))

    endBlock = builder.CurrentFunction.AddBlock(FissionAmirBlock(endName))
    builder.CurrentBlock = endBlock
END FUNCTION

FUNCTION Fission_AmirLowerWhile(builder, node)
    condName = builder.NewBlockName("WhileCond")
    bodyName = builder.NewBlockName("WhileBody")
    endName = builder.NewBlockName("WhileEnd")
    currentFunction = builder.CurrentFunction

    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", condName))

    condBlock = currentFunction.AddBlock(FissionAmirBlock(condName))
    builder.CurrentBlock = condBlock
    condition = Fission_AmirLowerExpr(builder, node.Children[0])
    ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", condition.Value).WithField("Then", bodyName).WithField("Else", endName))

    bodyBlock = currentFunction.AddBlock(FissionAmirBlock(bodyName))
    builder.CurrentBlock = bodyBlock
    index = 1
    WHILE index < LEN(node.Children)
        ignored = Fission_AmirLowerStatement(builder, node.Children[index])
        index = index + 1
    WEND
    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", condName))

    endBlock = currentFunction.AddBlock(FissionAmirBlock(endName))
    builder.CurrentBlock = endBlock
END FUNCTION

' SIR "ForRange" nodes have no field marking whether an explicit STEP was
' given: children are [start, end, (step?), ...body statements spread
' directly] (see FissionSirBuilder.ForRangeLoop), so a step expression at
' children[2] is not distinguishable from the first body statement by
' position alone. Disambiguated here by SIR node Kind instead -- these two
' sets are disjoint in the current SIR vocabulary (an expression-shaped node
' can only be a step; a statement-shaped node can only be a body statement),
' which is reliable for every SIR shape this lowering pass already handles.
FUNCTION Fission_AmirIsAmirExpressionKind(kind)
    RETURN Fission_ListContains(["Literal", "Read", "CallExpr", "Call", "NamedArg", "IndexRead", "MemberRead", "Array", "ArrayComprehension", "Field", "Object", "Binary", "Unary", "AddressOf", "Copy"], kind)
END FUNCTION

' Matches the legacy oracle's own real desugaring (confirmed via
' `ArcoFission reveal ... at A-MIR` on a real `FOR i = 1 TO 3 ... NEXT`):
' the end and step values are stored once into hidden loop-local variables,
' then the loop tests BOTH ascending (step >= 0, `i <= end`) and descending
' (step < 0, `i >= end`) conditions via a branch on the step's own sign --
' ArcoBASIC's `STEP` can be negative, so which comparison direction is
' correct cannot be decided at lowering time from a constant step alone.
FUNCTION Fission_AmirLowerForRange(builder, node)
    name = Object.Get(node.Fields, "Name", "")
    startValue = Fission_AmirLowerExpr(builder, node.Children[0])
    endValue = Fission_AmirLowerExpr(builder, node.Children[1])
    bodyIndex = 2
    stepValue = NULL
    IF LEN(node.Children) > 2 AND Fission_AmirIsAmirExpressionKind(node.Children[2].Kind) THEN
        stepValue = Fission_AmirLowerExpr(builder, node.Children[2])
        bodyIndex = 3
    END IF

    endName = "__fission_for_end" + String(builder.NewBlockName(""))
    stepName = "__fission_for_step" + String(builder.NewBlockName(""))
    ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", name).WithField("Value", startValue.Value))
    ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", endName).WithField("Value", endValue.Value))
    IF stepValue == NULL THEN
        oneTemp = builder.NewTemp()
        ignored = builder.Emit(FissionAmirInstruction("Const").WithField("Dest", oneTemp).WithField("Value", "1"))
        ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", stepName).WithField("Value", oneTemp))
    ELSE
        ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", stepName).WithField("Value", stepValue.Value))
    END IF

    condName = builder.NewBlockName("ForCond")
    posName = builder.NewBlockName("ForCondPos")
    negName = builder.NewBlockName("ForCondNeg")
    bodyName = builder.NewBlockName("ForBody")
    incName = builder.NewBlockName("ForInc")
    forEndName = builder.NewBlockName("ForEnd")
    currentFunction = builder.CurrentFunction

    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", condName))

    condBlock = currentFunction.AddBlock(FissionAmirBlock(condName))
    builder.CurrentBlock = condBlock
    stepLoad = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", stepLoad).WithField("Name", stepName))
    zeroTemp = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Const").WithField("Dest", zeroTemp).WithField("Value", "0"))
    signDest = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("BinOp").WithField("Dest", signDest).WithField("Op", ">=").WithField("Left", stepLoad).WithField("Right", zeroTemp).WithField("LeftType", "").WithField("RightType", ""))
    ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", signDest).WithField("Then", posName).WithField("Else", negName))

    posBlock = currentFunction.AddBlock(FissionAmirBlock(posName))
    builder.CurrentBlock = posBlock
    iLoadPos = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", iLoadPos).WithField("Name", name))
    endLoadPos = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", endLoadPos).WithField("Name", endName))
    posDest = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("BinOp").WithField("Dest", posDest).WithField("Op", "<=").WithField("Left", iLoadPos).WithField("Right", endLoadPos).WithField("LeftType", "").WithField("RightType", ""))
    ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", posDest).WithField("Then", bodyName).WithField("Else", forEndName))

    negBlock = currentFunction.AddBlock(FissionAmirBlock(negName))
    builder.CurrentBlock = negBlock
    iLoadNeg = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", iLoadNeg).WithField("Name", name))
    endLoadNeg = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", endLoadNeg).WithField("Name", endName))
    negDest = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("BinOp").WithField("Dest", negDest).WithField("Op", ">=").WithField("Left", iLoadNeg).WithField("Right", endLoadNeg).WithField("LeftType", "").WithField("RightType", ""))
    ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", negDest).WithField("Then", bodyName).WithField("Else", forEndName))

    bodyBlock = currentFunction.AddBlock(FissionAmirBlock(bodyName))
    builder.CurrentBlock = bodyBlock
    index = bodyIndex
    WHILE index < LEN(node.Children)
        ignored = Fission_AmirLowerStatement(builder, node.Children[index])
        index = index + 1
    WEND
    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", incName))

    incBlock = currentFunction.AddBlock(FissionAmirBlock(incName))
    builder.CurrentBlock = incBlock
    iLoadInc = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", iLoadInc).WithField("Name", name))
    stepLoadInc = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", stepLoadInc).WithField("Name", stepName))
    sumDest = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("BinOp").WithField("Dest", sumDest).WithField("Op", "+").WithField("Left", iLoadInc).WithField("Right", stepLoadInc).WithField("LeftType", "").WithField("RightType", ""))
    ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", name).WithField("Value", sumDest))
    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", condName))

    endBlock = currentFunction.AddBlock(FissionAmirBlock(forEndName))
    builder.CurrentBlock = endBlock
END FUNCTION

' Matches the legacy oracle's own real desugaring (confirmed via
' `ArcoFission reveal ... at A-MIR` on a real `FOR item IN values ... NEXT`):
' the iterable is stored once into a hidden `__fission_each_items` variable
' and a numeric `__fission_each_index` counter drives the loop, comparing
' against `CALL LEN <items>` each iteration -- LEN is an ordinary callable
' name in this frontend (not a reserved keyword), so it lowers through the
' same CallExpr path as any other call, not a dedicated opcode. Unlike the
' legacy oracle (which reuses %t7/%t8 from the Cond block directly inside
' Body, valid under real SSA dominance), this lowering reloads items/index
' fresh in Body -- extra instructions, same semantics, consistent with every
' other loop in this file's own deliberate "correct over byte-identical"
' scope choice.
' Covers all four DO-loop shapes (pre/post condition x WHILE/UNTIL) plus a
' bare infinite `DO ... LOOP`. UNTIL is not a negated condition value --
' confirmed via the oracle (`ArcoFission reveal ... at A-MIR` on a real
' `LOOP UNTIL x >= 3`): the SAME comparison the source wrote is evaluated,
' and it is the BRANCH's own Then/Else targets that swap (condition true ->
' End for UNTIL, condition true -> Body for WHILE). SIR "Do" node children
' are [preCondition?, BodyWrapper, postCondition?] (unlike ForRange/ForEach/
' Function, the body IS wrapped here, so no Kind-based disambiguation is
' needed the way ForRange required).
FUNCTION Fission_AmirLowerDo(builder, node)
    preMode = Object.Get(node.Fields, "PreMode", "")
    postMode = Object.Get(node.Fields, "PostMode", "")
    childIndex = 0
    preConditionNode = NULL
    IF preMode != "" THEN
        preConditionNode = node.Children[0]
        childIndex = 1
    END IF
    bodyNode = node.Children[childIndex]
    childIndex = childIndex + 1
    postConditionNode = NULL
    IF postMode != "" THEN postConditionNode = node.Children[childIndex]

    bodyName = builder.NewBlockName("DoBody")
    endName = builder.NewBlockName("DoEnd")
    currentFunction = builder.CurrentFunction
    condName = ""

    IF preMode != "" THEN
        condName = builder.NewBlockName("DoCond")
        ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", condName))
        condBlock = currentFunction.AddBlock(FissionAmirBlock(condName))
        builder.CurrentBlock = condBlock
        preResult = Fission_AmirLowerExpr(builder, preConditionNode)
        IF preMode == "UNTIL" THEN
            ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", preResult.Value).WithField("Then", endName).WithField("Else", bodyName))
        ELSE
            ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", preResult.Value).WithField("Then", bodyName).WithField("Else", endName))
        END IF
    ELSE
        ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", bodyName))
    END IF

    bodyBlock = currentFunction.AddBlock(FissionAmirBlock(bodyName))
    builder.CurrentBlock = bodyBlock
    FOR statement IN bodyNode.Children
        ignored = Fission_AmirLowerStatement(builder, statement)
    NEXT

    IF postMode != "" THEN
        postResult = Fission_AmirLowerExpr(builder, postConditionNode)
        IF postMode == "UNTIL" THEN
            ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", postResult.Value).WithField("Then", endName).WithField("Else", bodyName))
        ELSE
            ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", postResult.Value).WithField("Then", bodyName).WithField("Else", endName))
        END IF
    ELSE
        IF preMode != "" THEN
            ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", condName))
        ELSE
            ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", bodyName))
        END IF
    END IF

    endBlock = currentFunction.AddBlock(FissionAmirBlock(endName))
    builder.CurrentBlock = endBlock
END FUNCTION

' TRY/CATCH does not open a new block for its own try-body the way every
' other control-flow construct in this file does -- confirmed via the
' oracle: `TRY_BEGIN Catch0 AS err` and the try-body's own statements stay
' inline in whatever block was already active, followed by `TRY_END` plus a
' JUMP to the end block on normal completion. Only CATCH gets a real new
' block. SIR "Try" node children are [TryBodyWrapper, CatchBodyWrapper]
' (both wrapped, like "Do", not spread like ForRange/ForEach/Function).
FUNCTION Fission_AmirLowerTry(builder, node)
    catchName = Object.Get(node.Fields, "Catch", "")
    tryBodyNode = node.Children[0]
    catchBodyNode = node.Children[1]

    catchBlockName = builder.NewBlockName("Catch")
    endBlockName = builder.NewBlockName("TryEnd")
    currentFunction = builder.CurrentFunction

    ignored = builder.Emit(FissionAmirInstruction("TryBegin").WithField("Catch", catchBlockName).WithField("Name", catchName))
    FOR statement IN tryBodyNode.Children
        ignored = Fission_AmirLowerStatement(builder, statement)
    NEXT
    ignored = builder.Emit(FissionAmirInstruction("TryEnd"))
    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", endBlockName))

    catchBlock = currentFunction.AddBlock(FissionAmirBlock(catchBlockName))
    builder.CurrentBlock = catchBlock
    FOR statement IN catchBodyNode.Children
        ignored = Fission_AmirLowerStatement(builder, statement)
    NEXT
    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", endBlockName))

    endBlock = currentFunction.AddBlock(FissionAmirBlock(endBlockName))
    builder.CurrentBlock = endBlock
END FUNCTION

FUNCTION Fission_AmirLowerForEach(builder, node)
    name = Object.Get(node.Fields, "Name", "")
    iterable = Fission_AmirLowerExpr(builder, node.Children[0])

    itemsName = "__fission_each_items" + String(builder.NewBlockName(""))
    indexName = "__fission_each_index" + String(builder.NewBlockName(""))
    ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", itemsName).WithField("Value", iterable.Value))
    zeroTemp = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Const").WithField("Dest", zeroTemp).WithField("Value", "0"))
    ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", indexName).WithField("Value", zeroTemp))

    condName = builder.NewBlockName("ForEachCond")
    bodyName = builder.NewBlockName("ForEachBody")
    incName = builder.NewBlockName("ForEachInc")
    endName = builder.NewBlockName("ForEachEnd")
    currentFunction = builder.CurrentFunction

    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", condName))

    condBlock = currentFunction.AddBlock(FissionAmirBlock(condName))
    builder.CurrentBlock = condBlock
    indexLoadCond = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", indexLoadCond).WithField("Name", indexName))
    itemsLoadCond = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", itemsLoadCond).WithField("Name", itemsName))
    lenDest = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Call").WithField("Dest", lenDest).WithField("Callee", "LEN").WithField("Args", itemsLoadCond))
    cmpDest = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("BinOp").WithField("Dest", cmpDest).WithField("Op", "<").WithField("Left", indexLoadCond).WithField("Right", lenDest).WithField("LeftType", "").WithField("RightType", ""))
    ignored = builder.Emit(FissionAmirInstruction("Branch").WithField("Condition", cmpDest).WithField("Then", bodyName).WithField("Else", endName))

    bodyBlock = currentFunction.AddBlock(FissionAmirBlock(bodyName))
    builder.CurrentBlock = bodyBlock
    itemsLoadBody = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", itemsLoadBody).WithField("Name", itemsName))
    indexLoadBody = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", indexLoadBody).WithField("Name", indexName))
    itemDest = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Index").WithField("Dest", itemDest).WithField("Base", itemsLoadBody).WithField("Index", indexLoadBody))
    ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", name).WithField("Value", itemDest))
    index = 1
    WHILE index < LEN(node.Children)
        ignored = Fission_AmirLowerStatement(builder, node.Children[index])
        index = index + 1
    WEND
    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", incName))

    incBlock = currentFunction.AddBlock(FissionAmirBlock(incName))
    builder.CurrentBlock = incBlock
    indexLoadInc = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Load").WithField("Dest", indexLoadInc).WithField("Name", indexName))
    oneTemp = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Const").WithField("Dest", oneTemp).WithField("Value", "1"))
    sumDest = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("BinOp").WithField("Dest", sumDest).WithField("Op", "+").WithField("Left", indexLoadInc).WithField("Right", oneTemp).WithField("LeftType", "").WithField("RightType", ""))
    ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", indexName).WithField("Value", sumDest))
    ignored = builder.Emit(FissionAmirInstruction("Jump").WithField("Target", condName))

    endBlock = currentFunction.AddBlock(FissionAmirBlock(endName))
    builder.CurrentBlock = endBlock
END FUNCTION

FUNCTION Fission_AmirParseArguments(argsText)
    descriptors = []
    IF argsText == "" THEN RETURN descriptors
    FOR part IN String.Split(argsText, ",")
        name = part
        typeName = ""
        IF String.Contains(part, ":") THEN
            pieces = String.Split(part, ":")
            name = pieces[0]
            typeName = pieces[1]
        END IF
        IF String.Contains(name, "=") THEN name = String.Split(name, "=")[0]
        ignored = Array.Push(descriptors, {Name: name, Type: typeName})
    NEXT
    RETURN descriptors
END FUNCTION

FUNCTION Fission_AmirLowerFunctionDecl(builder, node)
    name = Object.Get(node.Fields, "Name", "")
    returnType = Object.Get(node.Fields, "Returns", "")
    IF returnType == "" THEN returnType = "VOID"
    params = Fission_AmirParseArguments(Object.Get(node.Fields, "Arguments", ""))

    outerFunction = builder.CurrentFunction
    outerBlock = builder.CurrentBlock
    outerScope = builder.Scope

    paramText = []
    FOR param IN params
        ignored = Array.Push(paramText, param.Name + " AS " + param.Type)
    NEXT
    ignored = builder.Emit(FissionAmirInstruction("DeclareFunction").WithField("Name", name).WithField("Params", Array.Join(paramText, ",")).WithField("Returns", returnType))

    fn = FissionAmirFunction(name)
    fn.ReturnType = returnType
    FOR param IN params
        ignored = fn.AddParam(param.Name, param.Type)
    NEXT
    ignored = builder.Module.AddFunction(fn)
    entryBlock = fn.AddBlock(FissionAmirBlock("Entry"))
    builder.CurrentBlock = entryBlock
    builder.CurrentFunction = fn
    builder.Scope = FissionAmirScope()
    FOR param IN params
        ignored = builder.Scope.Declare(param.Name, param.Type)
    NEXT

    ' SIR "Function" nodes carry their body statements as direct children (see
    ' FissionSirBuilder.FunctionDecl -- there is no intermediate "Body" wrapper
    ' node, unlike the AST-level Function node this was lowered from). A real
    ' bug caught here: indexing node.Children[0] as if it were a Body wrapper
    ' picked out the function's first STATEMENT instead (e.g. its own Return
    ' node), then iterated *that* node's children -- silently lowering a
    ' Binary expression as if it were a top-level statement, producing an
    ' empty function body plus a spurious "unsupported statement: Binary"
    ' diagnostic. Caught by comparing this file's own output against a real
    ' `ArcoFission reveal ... at A-MIR` run, not by reasoning about the code.
    FOR statement IN node.Children
        ignored = Fission_AmirLowerStatement(builder, statement)
    NEXT

    builder.CurrentBlock = outerBlock
    builder.CurrentFunction = outerFunction
    builder.Scope = outerScope
END FUNCTION

FUNCTION Fission_AmirLowerStatement(builder, node)
    IF node.Kind == "Declare" THEN
        name = Object.Get(node.Fields, "Name", "")
        typeName = Object.Get(node.Fields, "Type", "")
        ignored = builder.Scope.Declare(name, typeName)
        IF LEN(node.Children) > 0 THEN
            value = Fission_AmirLowerExpr(builder, node.Children[0])
            ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", name).WithField("Value", value.Value))
        END IF
        RETURN
    END IF
    IF node.Kind == "Assign" THEN
        name = Object.Get(node.Fields, "Name", "")
        value = Fission_AmirLowerExpr(builder, node.Children[0])
        ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", name).WithField("Value", value.Value))
        RETURN
    END IF
    IF node.Kind == "Set" THEN
        target = node.Children[0]
        value = Fission_AmirLowerExpr(builder, node.Children[1])
        ' Only `name[index] = value` and `name.field = value` are supported
        ' here -- the base of the target must itself be a bare variable Read
        ' (matching bytecode's own STORE_INDEX, which addresses a LOCAL slot
        ' directly, not an arbitrary loaded value). Nested/indirect targets
        ' (`a[i][j] = value`, `a.b.c = value`) are out of scope for this
        ' lowering pass and report a diagnostic rather than silently
        ' mis-lowering. Member-write lowers through the same STORE_INDEX
        ' opcode as index-write, just with a quoted string CONST as the
        ' index (confirmed via the oracle: `obj.Name = "b"` lowers to
        ' `STORE_INDEX obj %t3 %t4` where %t3 is `CONST "Name"`).
        IF target.Kind == "IndexRead" AND target.Children[0].Kind == "Read" THEN
            baseName = Object.Get(target.Children[0].Fields, "Name", "")
            indexResult = Fission_AmirLowerExpr(builder, target.Children[1])
            ignored = builder.Emit(FissionAmirInstruction("StoreIndex").WithField("Name", baseName).WithField("Index", indexResult.Value).WithField("Value", value.Value))
            RETURN
        END IF
        IF target.Kind == "MemberRead" AND target.Children[0].Kind == "Read" THEN
            baseName = Object.Get(target.Children[0].Fields, "Name", "")
            fieldName = Object.Get(target.Fields, "Name", "")
            keyTemp = builder.NewTemp()
            ignored = builder.Emit(FissionAmirInstruction("Const").WithField("Dest", keyTemp).WithField("Value", "\"" + fieldName + "\""))
            ignored = builder.Emit(FissionAmirInstruction("StoreIndex").WithField("Name", baseName).WithField("Index", keyTemp).WithField("Value", value.Value))
            RETURN
        END IF
        ignored = builder.Diagnostics.ReportError("FISSION_AMIR_UNSUPPORTED", "Unsupported Set target for A-MIR lowering: " + target.Kind)
        RETURN
    END IF
    IF node.Kind == "Print" THEN
        value = Fission_AmirLowerExpr(builder, node.Children[0])
        ignored = builder.Emit(FissionAmirInstruction("CallVoid").WithField("Callee", "Runtime.Print").WithField("Args", value.Value))
        RETURN
    END IF
    IF node.Kind == "ExprStmt" THEN
        ignored = Fission_AmirLowerExpr(builder, node.Children[0])
        RETURN
    END IF
    IF node.Kind == "Return" THEN
        IF LEN(node.Children) > 0 THEN
            value = Fission_AmirLowerExpr(builder, node.Children[0])
            ignored = builder.Emit(FissionAmirInstruction("Return").WithField("Type", value.Type).WithField("Value", value.Value))
        ELSE
            ignored = builder.Emit(FissionAmirInstruction("Return").WithField("Type", "VOID"))
        END IF
        RETURN
    END IF
    IF node.Kind == "Branch" THEN
        ignored = Fission_AmirLowerIf(builder, node)
        RETURN
    END IF
    IF node.Kind == "While" THEN
        ignored = Fission_AmirLowerWhile(builder, node)
        RETURN
    END IF
    IF node.Kind == "ForRange" THEN
        ignored = Fission_AmirLowerForRange(builder, node)
        RETURN
    END IF
    IF node.Kind == "ForEach" THEN
        ignored = Fission_AmirLowerForEach(builder, node)
        RETURN
    END IF
    IF node.Kind == "Do" THEN
        ignored = Fission_AmirLowerDo(builder, node)
        RETURN
    END IF
    IF node.Kind == "Throw" THEN
        value = Fission_AmirLowerExpr(builder, node.Children[0])
        ignored = builder.Emit(FissionAmirInstruction("Throw").WithField("Value", value.Value))
        RETURN
    END IF
    IF node.Kind == "Try" THEN
        ignored = Fission_AmirLowerTry(builder, node)
        RETURN
    END IF
    IF node.Kind == "Function" THEN
        ignored = Fission_AmirLowerFunctionDecl(builder, node)
        RETURN
    END IF
    IF node.Kind == "Stop" OR node.Kind == "Import" OR node.Kind == "Directive" OR node.Kind == "Const" THEN RETURN
    ignored = builder.Diagnostics.ReportError("FISSION_AMIR_UNSUPPORTED", "Unsupported SIR statement for A-MIR lowering: " + node.Kind)
END FUNCTION

FUNCTION Fission_SirToAmir(sirModule)
    builder = FissionAmirBuilder(sirModule.Name)
    mainFunction = FissionAmirFunction("Main")
    mainFunction.ReturnType = "I32"
    ignored = builder.Module.AddFunction(mainFunction)
    entryBlock = mainFunction.AddBlock(FissionAmirBlock("Entry"))
    builder.CurrentBlock = entryBlock
    builder.CurrentFunction = mainFunction

    ' Every Main entry block starts by capturing the process's own argv into the
    ' `Args` global, matching the legacy oracle's own unconditional prelude
    ' (confirmed via `ArcoFission reveal ... at A-MIR`) -- real programs (e.g.
    ' examples/arconote.abas) read `Args` directly, so this is required for
    ' functional equivalence, not just cosmetic.
    argsTemp = builder.NewTemp()
    ignored = builder.Emit(FissionAmirInstruction("Call").WithField("Dest", argsTemp).WithField("Callee", "Runtime.Args").WithField("Args", ""))
    ignored = builder.Emit(FissionAmirInstruction("Store").WithField("Name", "Args").WithField("Value", argsTemp))

    FOR statement IN sirModule.Statements
        ignored = Fission_AmirLowerStatement(builder, statement)
    NEXT

    ignored = builder.Emit(FissionAmirInstruction("Return").WithField("Type", "I32").WithField("Value", "0"))
    ignored = builder.Module.Diagnostics.AppendMany(builder.Diagnostics)
    ignored = builder.Module.Diagnostics.AppendMany(sirModule.Diagnostics)
    RETURN builder.Module
END FUNCTION
