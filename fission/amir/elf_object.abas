#IMPORT "fission/core/diagnostics.abas"
#IMPORT "fission/amir/x86_64_fragment.abas"

' Real ELF64 relocatable object file (`.o`) parsing -- lets The Arcology
' Fusion Linker link genuine, externally-compiled native machine code
' (today: `fission/native_runtime/host_bridge.c`, compiled by the
' system's own C compiler as a ONE-TIME, DEVELOPMENT-TIME build step, see
' that file's own header comment for why this doesn't reintroduce an
' external-toolchain dependency into an end user's own ArcoBASIC compile)
' directly alongside this backend's own encoder-produced fragments, with
' ZERO changes needed to Fission_FusionLink's own merge/link logic beyond
' making its relocation-patching TYPE-aware (see
' fission/amir/fusion_linker.abas's own comment) -- `Fission_ElfObjectParse`
' produces a plain `FissionX86_64Fragment`-shaped result, the exact same
' shape `Fission_X86_64AssembleFragment` already produces, so Fusion
' itself never needs to know whether a given fragment came from this
' backend's own encoder or a genuine compiled `.o` file.
'
' Real relocation support: a `.rela.text` entry naming a real, named
' FUNC/OBJECT symbol (R_X86_64_PC32/PLT32 for a cross-function `call`,
' R_X86_64_32/32S for a plain absolute data reference) is parsed into the
' exact same {Target, FieldOffset, Section, Type, Addend} shape
' fission/amir/x86_64_assembler.abas's own encoder-produced relocations
' already use, resolved later by Fission_FusionLink's own already-generic
' relocation-patching loop at final link time -- confirmed against a real
' need, not spec-read speculatively: `fission/native_runtime/
' host_bridge.c`'s own Array.Contains/Array.Find/Array.Remove/Array.Join
' functions already call each other, and this was found to be an ACTIVELY
' BLOCKING gap (every real host-function call failed outright on this
' project's own reference toolchain), not merely a theoretical one -- see
' .agents/FISSION_SUBSTRATE_PROGRESS.md's own Known Failures history. Real,
' disclosed remaining scope: a relocation against a SECTION symbol (gcc's
' own usual convention for an ANONYMOUS string literal/static data
' reference, e.g. a bare C string literal inside host_bridge.c, rather than
' a named symbol) is still unimplemented -- resolving one needs this same
' fragment's own section base at final link time, not a name Fusion's own
' global symbol table can look up, a genuinely different resolution shape.
' Every host function in this file is written to avoid ever needing one
' (see e.g. arco_host_path_home's own comment on why), so this has never
' actually blocked anything yet.
FUNCTION Fission_ElfReadU16(bytes, offset)
    RETURN bytes[offset] BITOR (bytes[offset + 1] SHL 8)
END FUNCTION

FUNCTION Fission_ElfReadU32(bytes, offset)
    RETURN bytes[offset] BITOR (bytes[offset + 1] SHL 8) BITOR (bytes[offset + 2] SHL 16) BITOR (bytes[offset + 3] SHL 24)
END FUNCTION

' A real 64-bit little-endian read, built from two 32-bit halves (ArcoBASIC
' integers are themselves genuinely 64-bit, confirmed already relied on
' throughout this whole backend -- e.g. Fission_X86_64Buffer's own
' EmitU64Full wrapping arithmetic -- so this is exact, not an approximation).
' Every real ELF64 field this parser reads (offsets, sizes, symbol values)
' fits comfortably within this range for any object file this backend's
' own toolchain produces or consumes.
FUNCTION Fission_ElfReadU64(bytes, offset)
    low = Fission_ElfReadU32(bytes, offset)
    high = Fission_ElfReadU32(bytes, offset + 4)
    RETURN low BITOR (high SHL 32)
END FUNCTION

' A real SIGNED 32-bit read -- every relocation addend this parser reads
' is a genuine signed value (e.g. -4 for a real RIP-relative reference,
' see fission/amir/fusion_linker.abas's own comment on why that specific
' value matters).
FUNCTION Fission_ElfReadI32(bytes, offset)
    v = Fission_ElfReadU32(bytes, offset)
    IF v >= 2147483648 THEN RETURN v - 4294967296
    RETURN v
END FUNCTION

FUNCTION Fission_ElfReadBytes(bytes, offset, count)
    result = []
    index = 0
    WHILE index < count
        ignored = Array.Push(result, bytes[offset + index])
        index = index + 1
    WEND
    RETURN result
END FUNCTION

' A real, NUL-terminated ASCII string read starting at `offset` within a
' string table's own bytes (ELF's own `.strtab`/`.shstrtab` convention:
' every name is just a NUL-terminated run inside one shared byte blob,
' addressed by its own starting offset, not length-prefixed the way this
' backend's own fragment format's strings are).
FUNCTION Fission_ElfReadCString(bytes, offset)
    chars = []
    index = offset
    WHILE index < LEN(bytes) ANDALSO bytes[index] != 0
        ignored = Array.Push(chars, Fission_FragmentCharFromCode(bytes[index]))
        index = index + 1
    WEND
    RETURN Array.Join(chars, "")
END FUNCTION

' One real ELF64 section header (64 bytes): NameOffset (into .shstrtab,
' resolved to a real Name once .shstrtab itself is located), Type, Flags,
' Offset (into the file), Size, Link, Info, EntSize.
' `SectionFlags`, not `Flags` -- a real reserved ArcoBASIC keyword
' (confirmed the hard way: `{Flags: x}` fails to parse at all,
' "expected object field name" -- the same class of gotcha this
' project's own established discipline already documents for method
' names, e.g. `Add`/`Has`/`Contains` can't be SIR builder method names
' either).
FUNCTION Fission_ElfReadSectionHeader(bytes, offset)
    RETURN {NameOffset: Fission_ElfReadU32(bytes, offset), Type: Fission_ElfReadU32(bytes, offset + 4), SectionFlags: Fission_ElfReadU64(bytes, offset + 8), Address: Fission_ElfReadU64(bytes, offset + 16), Offset: Fission_ElfReadU64(bytes, offset + 24), Size: Fission_ElfReadU64(bytes, offset + 32), Link: Fission_ElfReadU32(bytes, offset + 40), Info: Fission_ElfReadU32(bytes, offset + 44), EntSize: Fission_ElfReadU64(bytes, offset + 56)}
END FUNCTION

' The real ELF section TYPE constants this parser actually consults.
FUNCTION Fission_ElfSectionTypeProgbits()
    RETURN 1
END FUNCTION
FUNCTION Fission_ElfSectionTypeSymtab()
    RETURN 2
END FUNCTION
FUNCTION Fission_ElfSectionTypeRela()
    RETURN 4
END FUNCTION
FUNCTION Fission_ElfSectionTypeNobits()
    RETURN 8
END FUNCTION

' Real ELF64 symbol table entries (24 bytes each): Name (resolved via
' .strtab), Info (bind/type packed, `Info SHR 4` = bind, `Info BITAND 15`
' = type -- STT_FUNC=2/STT_OBJECT=1 are what this parser cares about),
' SectionIndex (`st_shndx` -- which section this symbol's own Value is
' relative to), Value (byte offset within that section), Size.
FUNCTION Fission_ElfReadSymbol(bytes, offset, strtabBytes, strtabOffset)
    nameOffset = Fission_ElfReadU32(bytes, offset)
    info = bytes[offset + 4]
    sectionIndex = Fission_ElfReadU16(bytes, offset + 6)
    value = Fission_ElfReadU64(bytes, offset + 8)
    size = Fission_ElfReadU64(bytes, offset + 16)
    name = ""
    IF nameOffset != 0 THEN name = Fission_ElfReadCString(strtabBytes, strtabOffset + nameOffset)
    RETURN {Name: name, Info: info, SectionIndex: sectionIndex, Value: value, Size: size}
END FUNCTION

' The real parsing entry point. `bytes` is a genuine ELF64 relocatable
' object file's own raw bytes (e.g. `File.ReadBytes` on a real `.o` gcc
' produced). Returns {Ok, Fragment, Diagnostics} -- the exact same shape
' Fission_X86_64AssembleFragment/Fission_FragmentDeserialize already
' return, so a caller threading this alongside either barely notices the
' seam.
FUNCTION Fission_ElfObjectParse(bytes)
    diagnostics = FissionDiagnosticBag()
    emptyResult = {Ok: FALSE, Fragment: NULL, Diagnostics: diagnostics}
    IF LEN(bytes) < 64 THEN
        ignored = diagnostics.ReportError("FISSION_ELF_INVALID", "Not a real ELF64 object file (too short)")
        RETURN emptyResult
    END IF
    IF bytes[0] != 127 ORELSE bytes[1] != 69 ORELSE bytes[2] != 76 ORELSE bytes[3] != 70 THEN
        ignored = diagnostics.ReportError("FISSION_ELF_INVALID", "Not a real ELF64 object file (bad magic)")
        RETURN emptyResult
    END IF
    IF bytes[4] != 2 THEN
        ignored = diagnostics.ReportError("FISSION_ELF_INVALID", "The Arcology Fusion Linker only supports ELFCLASS64 object files")
        RETURN emptyResult
    END IF
    elfType = Fission_ElfReadU16(bytes, 16)
    IF elfType != 1 THEN
        ignored = diagnostics.ReportError("FISSION_ELF_INVALID", "The Arcology Fusion Linker only supports ET_REL (relocatable) object files, not a final executable/shared object")
        RETURN emptyResult
    END IF
    machine = Fission_ElfReadU16(bytes, 18)
    IF machine != 62 THEN
        ignored = diagnostics.ReportError("FISSION_ELF_INVALID", "The Arcology Fusion Linker only supports x86-64 object files")
        RETURN emptyResult
    END IF

    shoff = Fission_ElfReadU64(bytes, 40)
    shentsize = Fission_ElfReadU16(bytes, 58)
    shnum = Fission_ElfReadU16(bytes, 60)
    shstrndx = Fission_ElfReadU16(bytes, 62)

    sections = []
    index = 0
    WHILE index < shnum
        ignored = Array.Push(sections, Fission_ElfReadSectionHeader(bytes, shoff + index * shentsize))
        index = index + 1
    WEND

    shstrtabSection = sections[shstrndx]
    FOR section IN sections
        section.Name = Fission_ElfReadCString(bytes, shstrtabSection.Offset + section.NameOffset)
    NEXT

    textSection = NULL
    rodataSection = NULL
    bssSection = NULL
    symtabSection = NULL
    strtabSection = NULL
    relaTextSection = NULL
    FOR section IN sections
        IF section.Name == ".text" THEN textSection = section
        IF section.Name == ".rodata" THEN rodataSection = section
        IF section.Name == ".bss" THEN bssSection = section
        IF section.Type == Fission_ElfSectionTypeSymtab() THEN symtabSection = section
        IF section.Name == ".rela.text" THEN relaTextSection = section
    NEXT
    IF symtabSection == NULL THEN
        ignored = diagnostics.ReportError("FISSION_ELF_INVALID", "The Arcology Fusion Linker found no .symtab in this object file")
        RETURN emptyResult
    END IF
    strtabSection = sections[symtabSection.Link]

    textBytes = []
    IF textSection != NULL THEN textBytes = Fission_ElfReadBytes(bytes, textSection.Offset, textSection.Size)
    rodataBytes = []
    IF rodataSection != NULL THEN rodataBytes = Fission_ElfReadBytes(bytes, rodataSection.Offset, rodataSection.Size)
    bssSize = 0
    IF bssSection != NULL THEN bssSize = bssSection.Size

    ' Which section INDEX (this object file's own numbering, matching
    ' `st_shndx`) is .text/.rodata/.bss -- needed to translate each
    ' symbol's own section-relative Value into this fragment's own
    ' {Section, Offset} shape.
    textIndex = -1
    rodataIndex = -1
    bssIndex = -1
    sectionIndex = 0
    FOR section IN sections
        IF section.Name == ".text" THEN textIndex = sectionIndex
        IF section.Name == ".rodata" THEN rodataIndex = sectionIndex
        IF section.Name == ".bss" THEN bssIndex = sectionIndex
        sectionIndex = sectionIndex + 1
    NEXT

    symbols = []
    ' Every real symtab entry, kept by ORIGINAL symbol table INDEX (unlike
    ' `symbols` below, which only keeps the exportable subset) -- a real
    ' relocation names its target by that raw index (ELF64_R_SYM), never by
    ' name directly, so resolving one requires the FULL table, local
    ' symbols included (a relocation could, in principle, target one, even
    ' though nothing this parser has ever actually seen does).
    allSymbols = []
    symbolCount = symtabSection.Size / symtabSection.EntSize
    symIndex = 0
    WHILE symIndex < symbolCount
        symbol = Fission_ElfReadSymbol(bytes, symtabSection.Offset + symIndex * symtabSection.EntSize, bytes, strtabSection.Offset)
        ignored = Array.Push(allSymbols, symbol)
        symType = symbol.Info BITAND 15
        symBind = symbol.Info SHR 4
        ' Only real, globally-visible FUNC/OBJECT symbols (STT_FUNC=2,
        ' STT_OBJECT=1; STB_GLOBAL=1) become part of this fragment's own
        ' exported Symbols table -- a LOCAL symbol (a static helper, the
        ' file's own FILE/SECTION symbols) is never something another
        ' fragment's own relocation could legally name anyway, matching
        ' real ELF linking semantics.
        isExportable = (symType == 1 ORELSE symType == 2) ANDALSO symBind == 1 ANDALSO symbol.Name != ""
        IF isExportable THEN
            fragmentSection = ""
            IF symbol.SectionIndex == textIndex THEN fragmentSection = "text"
            IF symbol.SectionIndex == rodataIndex THEN fragmentSection = "rodata"
            IF symbol.SectionIndex == bssIndex THEN fragmentSection = "bss"
            IF fragmentSection != "" THEN
                ignored = Array.Push(symbols, {Name: symbol.Name, Section: fragmentSection, Offset: symbol.Value})
            END IF
        END IF
        symIndex = symIndex + 1
    WEND

    ' Real ELF64 relocation support -- confirmed ACTIVELY needed, not just
    ' theoretical (see .agents/FISSION_SUBSTRATE_PROGRESS.md's own Known
    ' Failures entry): fission/native_runtime/host_bridge.c already
    ' contains real cross-function calls between its own host functions
    ' (Array.Contains calling Array.Find, etc.) that are not inlined, and
    ' gcc emits a genuine R_X86_64_PLT32 relocation for each one. Produces
    ' the SAME {Target, FieldOffset, Section, Type, Addend} shape
    ' fission/amir/x86_64_assembler.abas's own encoder-produced relocations
    ' already use -- Fission_FusionLink's own relocation-patching loop
    ' (fission/amir/fusion_linker.abas) already understands "PC32"/"ABS32"
    ' fully generically (it was written expecting exactly this, see its
    ' own comment), resolving each `Target` against its OWN whole-link
    ' global symbol table at FINAL link time -- so nothing here needs to
    ' resolve or patch anything itself, only translate real ELF relocation
    ' records into that same shape.
    relocations = []
    IF relaTextSection != NULL THEN
        relaCount = relaTextSection.Size / relaTextSection.EntSize
        relaIndex = 0
        WHILE relaIndex < relaCount
            relaOffset = relaTextSection.Offset + relaIndex * relaTextSection.EntSize
            ' Elf64_Rela is {r_offset: u64, r_info: u64, r_addend: i64}.
            ' r_info's own low 32 bits are the TYPE and its high 32 bits are
            ' the symbol table INDEX (the real ELF64_R_TYPE/ELF64_R_SYM
            ' macros) -- reading each HALF directly as its own u32 (rather
            ' than one u64 read plus a 64-bit BITAND mask/shift) sidesteps
            ' any doubt about this backend's own large-constant 64-bit
            ' bitwise-operator behavior, and is exactly as correct: on a
            ' little-endian target the low 4 bytes of any 8-byte field ARE
            ' its own low 32 bits, unconditionally.
            rOffset = Fission_ElfReadU64(bytes, relaOffset)
            relocType = Fission_ElfReadU32(bytes, relaOffset + 8)
            relocSymIndex = Fission_ElfReadU32(bytes, relaOffset + 12)
            ' A real signed 64-bit addend read would need a genuine
            ' Fission_ElfReadI64 this parser doesn't have -- real, disclosed
            ' scope narrowing: every addend this parser actually needs to
            ' handle (a `call`'s own -4 PC-relative adjustment, or a small
            ' non-negative offset into rodata) fits comfortably inside a
            ' signed 32-bit range, so the low 32 bits alone (sign-extended
            ' the same way Fission_ElfReadI32 already does everywhere else
            ' in this file) are exact for every real case, never truncated.
            rAddend = Fission_ElfReadI32(bytes, relaOffset + 16)
            IF relocSymIndex < 0 ORELSE relocSymIndex >= LEN(allSymbols) THEN
                ignored = diagnostics.ReportError("FISSION_ELF_UNSUPPORTED_RELOCATION", "The Arcology Fusion Linker found a relocation in .rela.text referencing an out-of-range symbol table index")
                RETURN emptyResult
            END IF
            relocSymbol = allSymbols[relocSymIndex]
            relocSymType = relocSymbol.Info BITAND 15
            ' STT_OBJECT=1/STT_FUNC=2 only -- a relocation against a
            ' SECTION symbol (STT_SECTION=3, gcc's own usual convention for
            ' an anonymous string literal/static data reference, e.g. the
            ' `.rodata.str1.1` case this whole feature's own investigation
            ' found and worked around rather than needing) is real,
            ' disclosed, deliberately still-unimplemented follow-on work --
            ' resolving one needs this SAME fragment's own section base at
            ' FINAL link time (not a named global symbol at all), a
            ' genuinely different resolution shape Fusion's own
            ' `globalSymbols` name->offset map has no way to express yet.
            targetIsResolvable = relocSymType == 1 ORELSE relocSymType == 2
            IF targetIsResolvable == FALSE THEN
                ignored = diagnostics.ReportError("FISSION_ELF_UNSUPPORTED_RELOCATION", "The Arcology Fusion Linker does not yet support a relocation against a symbol of this kind (expected a real named FUNC/OBJECT symbol, e.g. not an anonymous SECTION-relative static-data reference): " + relocSymbol.Name)
                RETURN emptyResult
            END IF
            ' R_X86_64_PC32=2 and R_X86_64_PLT32=4 both resolve identically
            ' here (S + A - P either way) -- PLT32's own "through a real PLT
            ' stub" distinction only matters for a genuinely external,
            ' dynamically-linked symbol, never the case anywhere in this
            ' whole ecosystem (every symbol ever linked against is a real
            ' definition in one of Fusion's own input fragments, resolved
            ' directly). R_X86_64_32=10/R_X86_64_32S=11 are both a plain
            ' absolute reference (S + A, no P subtraction) -- signed vs.
            ' unsigned only matters for gcc's own out-of-range diagnostics
            ' at ITS compile time, never for how the 4 patched bytes
            ' themselves are computed or stored.
            relocTypeName = ""
            IF relocType == 2 ORELSE relocType == 4 THEN relocTypeName = "PC32"
            IF relocType == 10 ORELSE relocType == 11 THEN relocTypeName = "ABS32"
            IF relocTypeName == "" THEN
                ignored = diagnostics.ReportError("FISSION_ELF_UNSUPPORTED_RELOCATION", "The Arcology Fusion Linker does not yet handle ELF relocation type " + String(relocType) + " (found in .rela.text)")
                RETURN emptyResult
            END IF
            ignored = Array.Push(relocations, {Target: relocSymbol.Name, FieldOffset: rOffset, Section: "text", Type: relocTypeName, Addend: rAddend})
            relaIndex = relaIndex + 1
        WEND
    END IF

    fragment = FissionX86_64Fragment(textBytes, rodataBytes, bssSize, symbols, relocations)
    RETURN {Ok: TRUE, Fragment: fragment, Diagnostics: diagnostics}
END FUNCTION
