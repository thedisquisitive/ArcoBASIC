#IMPORT "fission/language/arcobasic/lower_sir.abas"

Source = "FUNCTION add(left, right)\nRETURN left + right\nEND FUNCTION\nvalue = add(2, 3)\nPRINT value"
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "function-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)

PRINT Ast.Diagnostics.HasErrors()
PRINT Ast.Render()
PRINT "---"
PRINT Sir.Diagnostics.HasErrors()
PRINT Sir.Render()
