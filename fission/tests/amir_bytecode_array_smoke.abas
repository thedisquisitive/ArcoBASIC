#IMPORT "fission/language/arcobasic/lower_sir.abas"
#IMPORT "fission/amir/lower_bytecode.abas"

Source = "values = [1, 2, 3]\nPRINT values[1]\nvalues[0] = 9\nPRINT values[0]"
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "array-bytecode-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)
Amir = Fission_SirToAmir(Sir)
Bytecode = Fission_AmirToBytecode(Amir)

PRINT Ast.Diagnostics.HasErrors()
PRINT Amir.Diagnostics.HasErrors()
PRINT Bytecode.Diagnostics.HasErrors()
PRINT Bytecode.Render()
