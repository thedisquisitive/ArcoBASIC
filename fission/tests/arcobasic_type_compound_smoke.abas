#IMPORT "fission/language/arcobasic/lower_sir.abas"

Source = "FUNCTION Next(value AS U64) AS U64\nvalue += 1\nRETURN value\nEND FUNCTION\nSELF.total -= 2"
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "type-compound-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)

PRINT Ast.Diagnostics.HasErrors()
PRINT Ast.Render()
PRINT "---"
PRINT Sir.Diagnostics.HasErrors()
PRINT Sir.Render()
