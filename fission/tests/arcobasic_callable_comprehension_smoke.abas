#IMPORT "fission/language/arcobasic/lower_sir.abas"

Source = "handler = ADDRESSOF Demo.Run\ncopyItems = COPY items\nsquares = [i * i FOR i IN Range(1, 5) IF i % 2 == 0]"
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "callable-comprehension-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)

PRINT Ast.Diagnostics.HasErrors()
PRINT Ast.Render()
PRINT "---"
PRINT Sir.Diagnostics.HasErrors()
PRINT Sir.Render()
