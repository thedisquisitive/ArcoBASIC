#IMPORT "fission/language/arcobasic/lower_sir.abas"

Source = "CLASS Handles\nSHARED NextHandle = 0\nSHARED FUNCTION Issue(prefix AS String) AS String\nNextHandle += 1\nRETURN prefix\nEND FUNCTION\nEND CLASS"
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "shared-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)

PRINT Ast.Diagnostics.HasErrors()
PRINT Ast.Render()
PRINT "---"
PRINT Sir.Diagnostics.HasErrors()
PRINT Sir.Render()
