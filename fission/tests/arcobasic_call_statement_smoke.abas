#IMPORT "fission/language/arcobasic/lower_sir.abas"

Source = "FUNCTION StopNow()\nGUI.Close(window)\nRETURN\nEND FUNCTION\nExitTheProgram(0)\napp.Window.Title = \"done\""
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "call-statement-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)

PRINT Ast.Diagnostics.HasErrors()
PRINT Ast.Render()
PRINT "---"
PRINT Sir.Diagnostics.HasErrors()
PRINT Sir.Render()
