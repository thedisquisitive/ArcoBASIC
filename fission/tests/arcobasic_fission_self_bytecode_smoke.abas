#IMPORT "fission/language/arcobasic/lower_sir.abas"
#IMPORT "fission/sir/lower_amir.abas"
#IMPORT "fission/amir/lower_bytecode.abas"

' Real, end-to-end SELF-HOSTING proof: every one of Fission's OWN current
' first-party `.abas` source files (the SAME file list
' arcobasic_fission_self_parse_smoke.abas/arcobasic_fission_self_semantic_
' smoke.abas already carry through Lex/Parse/SIR with zero diagnostics)
' now ALSO lowers cleanly all the way through this substrate's OWN
' self-hosted SIR -> A-MIR -> BYTECODE pipeline -- a genuinely stronger
' claim than parsing/semantic analysis alone: this is real CODE
' GENERATION, the actual definition of "Fission compiles Fission."
'
' This is NOT yet full self-hosting (see .agents/FISSION_SUBSTRATE_
' PROGRESS.md's own "No G1/G2/G3 self-host path exists yet" disclosure,
' still accurate): there is real, disclosed, separate remaining work
' before an actual G1 bootstrap is possible -- most importantly, no real
' `#IMPORT` expansion exists in this substrate's own codegen path yet, so
' each file here is still compiled as an ISOLATED translation unit (no
' cross-file linking), and the resulting bytecode is still executed by
' the LEGACY C++ `ArcoFission run` VM, not a self-hosted one. But every
' real CONSTRUCT Fission's own ~96-file source tree actually uses now
' lowers correctly -- confirmed empirically, not assumed, by running every
' single file through the real pipeline and checking for zero diagnostics
' at every stage, exactly like this ledger's own established discipline.
'
' Five real, previously-missing SIR->A-MIR lowering gaps were found and
' fixed to reach 96/96 (all in fission/sir/lower_amir.abas unless noted):
'   1. NULL literal -- lowered as a plain `CONST 0` (every pointer-kind
'      value in this substrate IS a plain integer address already, 0 is
'      a real, safe, never-otherwise-used sentinel).
'   2. Unary `!` (real logical negation, distinct from bitwise NOT) --
'      lowered as `1 - operand` (Bool-kind values are already plain 0/1
'      integers), the same "unfused, semantically identical" precedent
'      unary `-` already established.
'   3. `obj.Field.Method(...)` (a multi-level qualified CALL, e.g.
'      `SELF.Diagnostics.ReportError(...)`) and `expr().Method(...)` (a
'      call chained directly onto ANOTHER call's own return value) --
'      confirmed via direct oracle probes that a pure field-read chain
'      lowers to one flat dotted callee TEXT (matching `CALL
'      o.Child.Greet` exactly), while a genuinely COMPUTED receiver gets
'      materialized into a real named local first (matching the oracle's
'      own `__fission_dynrecv0` synthesized-receiver naming) -- the VM's
'      own CALL_VALUE resolution walks a dotted chain itself, but only
'      ever looks up real named locals, never a bare SSA temp.
'   4. The SAME two shapes for a real Set/assignment TARGET
'      (`SELF.Bytes[offset] = v`, `o.Inner.Bytes[2] = 99`) -- a real,
'      DIFFERENT mechanism from (3) was needed here: confirmed via a
'      direct bytecode-execution probe that STORE_INDEX's own "Local"
'      reference is a plain, single bytecode LOCAL SLOT lookup with NO
'      dot-walking at all (unlike CALL_VALUE), so even a flat
'      "SELF.Bytes"-style dotted name fails at runtime ("undefined
'      bytecode local") -- every non-bare-Read base is unconditionally
'      materialized into a real named local first here instead. Verified
'      the write correctly propagates through the real underlying shared
'      Array/Object reference, not a copy.
'   5. `ADDRESSOF FuncName` (a real, dedicated callable-reference value,
'      NOT just a string -- confirmed in the oracle's own bytecode VM,
'      `runtime.make_callable(...)` produces a genuinely distinct runtime
'      Value kind `CALL_VALUE` specially recognizes) -- lowered as a real,
'      dedicated new A-MIR "Addressof" instruction (this file's own first
'      case where the "compose from an existing instruction" shortcut
'      does not apply), with matching new bytecode lowering
'      (`fission/amir/lower_bytecode.abas`) and rendering
'      (`fission/bytecode/model.abas`) producing the oracle's own real
'      `ADDRESSOF dest name` bytecode shape (opcode 29).
'
' Every fix was verified via a real, isolated, hand-crafted probe run
' through the REAL bytecode VM (`ArcoFission run`) BEFORE being checked
' against this real 96-file corpus, matching this whole project's own
' "verify in isolation first" discipline.
Files = [

    "fission/amir/lower_bytecode.abas",
    "fission/amir/lower_x86_64.abas",
    "fission/amir/x86_64_assembler.abas",
    "fission/amir/x86_64_fragment.abas",
    "fission/amir/fusion_linker.abas",
    "fission/amir/elf_object.abas",
    "fission/amir/model.abas",
    "fission/cli/compile_to_bytecode.abas",
    "fission/cli/compile_to_x86_64.abas",
    "fission/cli/fusion.abas",
    "fission/cli/fission.abas",
    "fission/core/artifact.abas",
    "fission/core/capability.abas",
    "fission/core/compiler.abas",
    "fission/core/component.abas",
    "fission/core/diagnostics.abas",
    "fission/core/fission.abas",
    "fission/core/module.abas",
    "fission/core/pipeline.abas",
    "fission/core/registry.abas",
    "fission/core/resolver.abas",
    "fission/language/api/authoring_kit.abas",
    "fission/language/api/language.abas",
    "fission/language/arcobasic/lexer.abas",
