#IMPORT "fission/language/arcobasic/lower_sir.abas"

Source = "FUNCTION clamp(value AS U64, minimum AS U64 = 0, maximum AS U64 = 255) AS U64\nRETURN value\nEND FUNCTION\nresult = clamp(value = sample, maximum = 100)"
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "named-defaults-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)

PRINT Ast.Diagnostics.HasErrors()
PRINT Ast.Render()
PRINT "---"
PRINT Sir.Diagnostics.HasErrors()
PRINT Sir.Render()
