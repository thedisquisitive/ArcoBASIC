MixedArrayProgram = Fission_AmirToX86_64(MixedArrayAmir)
PRINT MixedArrayProgram.Diagnostics.HasErrors()

' The real HOST-FUNCTION BRIDGE (Fission_X86_64HostFunctionTable) -- a
' call to a real host function (`String.Length`) compiles with zero
' diagnostics and calls the REAL native symbol
' fission/native_runtime/host_bridge.c exports (`call
' arco_host_string_length`, never "String.Length" itself, confirmed
' structurally here), and `program.UsesHostBridge` is real, accurate
' tracking (see Fission_X86_64HostFunctionTable's own comment), not
' always TRUE regardless of whether a program actually calls one. Real
' execution (including the mmap-based allocation path for Trim/Slice, and
' a host function's own result flowing back through this backend's own
' concat/branch/further-host-call machinery) verified separately by
' fission/tests/native_programs/host_bridge_strings.abas.
HostCallSource = "n = String.Length(\"Hello\")\nPRINT n"
HostCallTokens = Fission_ArcoBasicLex(HostCallSource)
HostCallAst = Fission_ArcoBasicParse(HostCallTokens, "x86-64-host-call-smoke.abas")
HostCallSir = Fission_ArcoBasicAstToSir(HostCallAst)
HostCallAmir = Fission_SirToAmir(HostCallSir)
HostCallProgram = Fission_AmirToX86_64(HostCallAmir)
PRINT HostCallProgram.Diagnostics.HasErrors()
PRINT String.Contains(HostCallProgram.Render(), "call arco_host_string_length")
PRINT HostCallProgram.UsesHostBridge

