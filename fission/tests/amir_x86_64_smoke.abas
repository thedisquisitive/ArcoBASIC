MixedArraySource = "a = [1, \"two\", 3]\nPRINT a"
MixedArrayTokens = Fission_ArcoBasicLex(MixedArraySource)
MixedArrayAst = Fission_ArcoBasicParse(MixedArrayTokens, "x86-64-mixed-array-smoke.abas")
