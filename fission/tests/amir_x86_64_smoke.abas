HostCallBadCountAmir = Fission_SirToAmir(HostCallBadCountSir)
HostCallBadCountProgram = Fission_AmirToX86_64(HostCallBadCountAmir)
PRINT HostCallBadCountProgram.Diagnostics.HasErrors()

