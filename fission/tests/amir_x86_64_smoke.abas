#IMPORT "fission/language/arcobasic/lower_sir.abas"
#IMPORT "fission/amir/lower_x86_64.abas"

' fission/amir/lower_x86_64.abas's own header comment records this backend's
' current scope: PRINT of string literals, variables/arithmetic/
' comparisons/IF/WHILE/FOR/DO (all four shapes)/ForEach over plain numbers
' and arrays, EXIT/CONTINUE across every loop shape, PRINT of a computed
' integer, real user-declared FUNCTIONs with a genuine SysV calling
' convention (including stack-passed arguments beyond the first 6), real
' string VARIABLES (assign/PRINT/reassign/copy), real string CONCATENATION
' and EQUALITY (`==`/`!=`, real content comparison; a bump-allocated
' `.bss` arena shared with arrays), real numeric ARRAYS (construction,
' indexed read/write, `LEN`, and PRINT of a bare array rendering
' `[1, 2, 3]`), bare AND/OR/BITAND/BITOR/BITXOR/SHL/SHR plus the (eager,
' not actually short-circuit -- a real, disclosed, substrate-wide
' divergence from the oracle) ANDALSO/ORELSE, and, as of
' Fission_X86_64InferSignatures' own real inter-procedural fixed-point
' analysis, real STRING FUNCTION PARAMETERS AND RETURN VALUES -- a genuine
' Number/String kind CONFLICT across different call sites (real
' polymorphism, not representable here) is still a real diagnostic, not
' guessed at -- real PRINT of a Bool-kind value (a comparison result, or a
' bare TRUE/FALSE literal) rendering `TRUE`/`FALSE` like the oracle does,
' not the raw 0/1 -- and real CLASS support (a constructor initializing
' numeric fields, methods reading/writing SELF's own fields, external
' `obj.Field` access, multiple independent instances, inheritance with
' method overriding), with `obj.Method(...)` resolved STATICALLY at
' compile time from the calling code's own tracked concrete class (real
' runtime polymorphism -- a variable that could hold different concrete
' classes at different times -- is a real, disclosed diagnostic, the same
' Number/String-conflict machinery generalized). Remaining real, disclosed
' gaps: arrays crossing a function boundary, string ORDERING comparison
' (`<`/`<=`/`>`/`>=`), branching on a string, arrays of anything but plain
' numbers, non-numeric class fields, genuine class-instance runtime
' polymorphism, SAR (a real oracle limitation, not just this backend's
' own), and real integer division (`\`, likewise a real oracle
' limitation). Real execution verified
' separately by
' fission/tests/native_programs/*.abas (built as real ELF64s via
' FissionNativeCapsuleTarget and run directly -- see
' tests/integration/fission_substrate_core_smoke.sh). This file checks the
' lowering pass's own text output and its diagnostics.
Source = "PRINT \"Hello, native!\"\nPRINT \"Second line\""
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "x86-64-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)
Amir = Fission_SirToAmir(Sir)
Program = Fission_AmirToX86_64(Amir)

PRINT Ast.Diagnostics.HasErrors()
PRINT Amir.Diagnostics.HasErrors()
PRINT Program.Diagnostics.HasErrors()
PRINT Program.Render()

' Phase 2: variables, arithmetic (+, MOD), comparisons, IF, WHILE -- all
' over plain numbers, all real GAS mnemonics, no diagnostics.
ArithSource = "x = 1 + 2\nPRINT x\ny = 10 MOD 3\nPRINT y\nIF x > 2 THEN\n    PRINT 100\nEND IF\ni = 1\nWHILE i <= 3\n    PRINT i\n    i = i + 1\nWEND"
ArithTokens = Fission_ArcoBasicLex(ArithSource)
ArithAst = Fission_ArcoBasicParse(ArithTokens, "x86-64-arith-smoke.abas")
ArithSir = Fission_ArcoBasicAstToSir(ArithAst)
ArithAmir = Fission_SirToAmir(ArithSir)
ArithProgram = Fission_AmirToX86_64(ArithAmir)
PRINT ArithProgram.Diagnostics.HasErrors()
PRINT ArithProgram.Diagnostics.Render()

' Phase 4: real string VARIABLES (not just PRINT of a bare literal) --
' assign, PRINT, reassign, copy one string variable into another, mixed
' with an ordinary numeric variable in the same program. Before Phase 4
' this was a real, direct bug: `s = "hello"` / `PRINT s` compiled with zero
' diagnostics and printed "0" at runtime instead of "hello" or failing.
' Real execution verified separately by
' fission/tests/native_programs/strings.abas. Checked here: zero
' diagnostics, and that the rendered assembly actually contains the
' NUL-terminated (`.asciz`) string constant and a `call str_print`.
StringVarSource = "s = \"hello\"\nPRINT s\ns = \"world\"\nPRINT s\ncopy = s\nPRINT copy\nn = 5\nPRINT n"
StringVarTokens = Fission_ArcoBasicLex(StringVarSource)
StringVarAst = Fission_ArcoBasicParse(StringVarTokens, "x86-64-string-var-smoke.abas")
StringVarSir = Fission_ArcoBasicAstToSir(StringVarAst)
StringVarAmir = Fission_SirToAmir(StringVarSir)
StringVarProgram = Fission_AmirToX86_64(StringVarAmir)
PRINT StringVarProgram.Diagnostics.HasErrors()
PRINT StringVarProgram.Diagnostics.Render()
StringVarAssembly = StringVarProgram.Render()
PRINT String.Contains(StringVarAssembly, ".asciz")
PRINT String.Contains(StringVarAssembly, "call str_print")

' Phase 5: real string concatenation (`+` between two String-kind
' operands) -- a real bump allocator into a fixed `.bss` arena, chained/
' reused freely (`(a + b) + c`, concatenating into an accumulator inside a
' loop). Real execution verified separately by
' fission/tests/native_programs/concat.abas. Checked here: zero
' diagnostics, and that the rendered assembly actually contains the
' `str_concat` call, the `.bss` arena declaration, and (since a
' concatenation result is String-kind like any other) a `call str_print`
' for the PRINT of that result.
ConcatSource = "a = \"Hello, \"\nb = \"World\"\nc = a + b\nPRINT c"
ConcatTokens = Fission_ArcoBasicLex(ConcatSource)
ConcatAst = Fission_ArcoBasicParse(ConcatTokens, "x86-64-concat-smoke.abas")
ConcatSir = Fission_ArcoBasicAstToSir(ConcatAst)
ConcatAmir = Fission_SirToAmir(ConcatSir)
ConcatProgram = Fission_AmirToX86_64(ConcatAmir)
PRINT ConcatProgram.Diagnostics.HasErrors()
PRINT ConcatProgram.Diagnostics.Render()
ConcatAssembly = ConcatProgram.Render()
PRINT String.Contains(ConcatAssembly, "call str_concat")
PRINT String.Contains(ConcatAssembly, ".section .bss")
PRINT String.Contains(ConcatAssembly, "string_heap")
PRINT String.Contains(ConcatAssembly, "call str_print")

' Phase 6: real string equality (`==`/`!=`). Real execution verified
' separately by fission/tests/native_programs/string_equality.abas.
' Checked here: zero diagnostics, and that the rendered assembly actually
' contains `call str_equals` and (for `!=`) the inverting `xor $1, %rax`.
StringEqualsSource = "a = \"x\"\nb = \"y\"\nIF a == b THEN\n    PRINT 1\nEND IF\nIF a != b THEN\n    PRINT 2\nEND IF"
StringEqualsTokens = Fission_ArcoBasicLex(StringEqualsSource)
StringEqualsAst = Fission_ArcoBasicParse(StringEqualsTokens, "x86-64-string-equals-smoke.abas")
StringEqualsSir = Fission_ArcoBasicAstToSir(StringEqualsAst)
StringEqualsAmir = Fission_SirToAmir(StringEqualsSir)
StringEqualsProgram = Fission_AmirToX86_64(StringEqualsAmir)
PRINT StringEqualsProgram.Diagnostics.HasErrors()
PRINT StringEqualsProgram.Diagnostics.Render()
StringEqualsAssembly = StringEqualsProgram.Render()
PRINT String.Contains(StringEqualsAssembly, "call str_equals")
PRINT String.Contains(StringEqualsAssembly, "xor $1, %rax")

' String ORDERING comparison (as opposed to equality) remains a real,
' disclosed gap this phase does NOT close -- must still report a
' diagnostic, not silently emit wrong assembly.
StringOrderSource = "a = \"x\"\nb = \"y\"\nIF a < b THEN\n    PRINT 1\nEND IF"
StringOrderTokens = Fission_ArcoBasicLex(StringOrderSource)
StringOrderAst = Fission_ArcoBasicParse(StringOrderTokens, "x86-64-string-order-smoke.abas")
StringOrderSir = Fission_ArcoBasicAstToSir(StringOrderAst)
StringOrderAmir = Fission_SirToAmir(StringOrderSir)
StringOrderProgram = Fission_AmirToX86_64(StringOrderAmir)
PRINT StringOrderProgram.Diagnostics.HasErrors()

' A variable assigned both a string and a number somewhere in the same
' function is a real, disclosed gap -- must report a diagnostic instead of
' silently trusting whichever kind the collection pass happened to settle
' on last.
MixedKindSource = "IF 1 > 0 THEN\n    s = \"a\"\nEND IF\nIF 1 > 0 THEN\n    s = 1\nEND IF\nPRINT s"
MixedKindTokens = Fission_ArcoBasicLex(MixedKindSource)
MixedKindAst = Fission_ArcoBasicParse(MixedKindTokens, "x86-64-mixed-kind-smoke.abas")
MixedKindSir = Fission_ArcoBasicAstToSir(MixedKindAst)
MixedKindAmir = Fission_SirToAmir(MixedKindSir)
MixedKindProgram = Fission_AmirToX86_64(MixedKindAmir)
PRINT MixedKindProgram.Diagnostics.HasErrors()

' Real inter-procedural inference (Fission_X86_64InferSignatures) means a
' string function parameter/return value now genuinely works -- a
' pass-through function called only with a string converges to a
' String-kind parameter and return, zero diagnostics. Real execution
' verified separately by fission/tests/native_programs/string_params.abas.
StringArgSource = "FUNCTION Foo(x)\n    RETURN x\nEND FUNCTION\nPRINT Foo(\"hello\")"
StringArgTokens = Fission_ArcoBasicLex(StringArgSource)
StringArgAst = Fission_ArcoBasicParse(StringArgTokens, "x86-64-string-arg-smoke.abas")
StringArgSir = Fission_ArcoBasicAstToSir(StringArgAst)
StringArgAmir = Fission_SirToAmir(StringArgSir)
StringArgProgram = Fission_AmirToX86_64(StringArgAmir)
PRINT StringArgProgram.Diagnostics.HasErrors()

' The SAME pass-through function called with BOTH a Number and a String
' argument at different call sites is real, disclosed, genuine
' polymorphism this backend cannot represent (a parameter has exactly one
' physical kind) -- must still report a diagnostic, not silently pick
' whichever kind converged first or misinterpret one as the other.
PolySource = "FUNCTION Foo(x)\n    RETURN x\nEND FUNCTION\nPRINT Foo(\"hello\")\nPRINT Foo(1)"
PolyTokens = Fission_ArcoBasicLex(PolySource)
PolyAst = Fission_ArcoBasicParse(PolyTokens, "x86-64-poly-smoke.abas")
PolySir = Fission_ArcoBasicAstToSir(PolyAst)
PolyAmir = Fission_SirToAmir(PolySir)
PolyProgram = Fission_AmirToX86_64(PolyAmir)
PRINT PolyProgram.Diagnostics.HasErrors()

' A real array argument still cannot cross a function boundary -- a real,
' disclosed, unexplored gap, unaffected by string parameters now working.
ArrayArgSource = "FUNCTION Foo(x)\n    RETURN x\nEND FUNCTION\na = [1, 2]\nPRINT Foo(a)"
ArrayArgTokens = Fission_ArcoBasicLex(ArrayArgSource)
ArrayArgAst = Fission_ArcoBasicParse(ArrayArgTokens, "x86-64-array-arg-smoke.abas")
ArrayArgSir = Fission_ArcoBasicAstToSir(ArrayArgAst)
ArrayArgAmir = Fission_SirToAmir(ArrayArgSir)
ArrayArgProgram = Fission_AmirToX86_64(ArrayArgAmir)
PRINT ArrayArgProgram.Diagnostics.HasErrors()

StringBranchSource = "s = \"hello\"\nIF s THEN\n    PRINT 1\nEND IF"
StringBranchTokens = Fission_ArcoBasicLex(StringBranchSource)
StringBranchAst = Fission_ArcoBasicParse(StringBranchTokens, "x86-64-string-branch-smoke.abas")
StringBranchSir = Fission_ArcoBasicAstToSir(StringBranchAst)
StringBranchAmir = Fission_SirToAmir(StringBranchSir)
StringBranchProgram = Fission_AmirToX86_64(StringBranchAmir)
PRINT StringBranchProgram.Diagnostics.HasErrors()

' PRINT of a BARE array is a real oracle feature (`PRINT arr` renders
' `[1, 2, 3]`, confirmed via a direct oracle probe including the `[]`
' empty-array and negative-number cases) -- real runtime string-building
' (array_print/itoa_write) landed the session right after Phase 7 (see
' below); zero diagnostics now, not a diagnostic-fail path. Checked here:
' zero diagnostics, and that the rendered assembly actually contains
' `call array_print`.
ArraySource = "a = [1, 2, 3]\nPRINT a"
ArrayTokens = Fission_ArcoBasicLex(ArraySource)
ArrayAst = Fission_ArcoBasicParse(ArrayTokens, "x86-64-array-smoke.abas")
ArraySir = Fission_ArcoBasicAstToSir(ArrayAst)
ArrayAmir = Fission_SirToAmir(ArraySir)
ArrayProgram = Fission_AmirToX86_64(ArrayAmir)
PRINT ArrayProgram.Diagnostics.HasErrors()
PRINT String.Contains(ArrayProgram.Render(), "call array_print")

' Phase 3: real user-declared FUNCTIONs, a genuine SysV-shaped calling
' convention (arguments in %rdi/%rsi/..., return value in %rax), and real
' recursion -- verified separately by real execution
' (fission/tests/native_programs/fibonacci.abas, a real recursive Fib).
' Checked here: zero diagnostics, and that both functions' own "Entry"
' blocks get distinct, function-prefixed labels (Sum_Entry/Fib_Entry) so
' they never collide with each other or with Main's own bare "Entry".
FuncSource = "FUNCTION Sum(a, b)\n    RETURN a + b\nEND FUNCTION\n\nFUNCTION Fib(n)\n    IF n <= 1 THEN\n        RETURN n\n    END IF\n    RETURN Fib(n - 1) + Fib(n - 2)\nEND FUNCTION\n\nPRINT Sum(3, 4)\nPRINT Fib(10)"
FuncTokens = Fission_ArcoBasicLex(FuncSource)
FuncAst = Fission_ArcoBasicParse(FuncTokens, "x86-64-func-smoke.abas")
FuncSir = Fission_ArcoBasicAstToSir(FuncAst)
FuncAmir = Fission_SirToAmir(FuncSir)
FuncProgram = Fission_AmirToX86_64(FuncAmir)
PRINT FuncProgram.Diagnostics.HasErrors()
PRINT FuncProgram.Diagnostics.Render()
FuncAssembly = FuncProgram.Render()
PRINT String.Contains(FuncAssembly, "Sum:")
PRINT String.Contains(FuncAssembly, "Sum_Entry:")
PRINT String.Contains(FuncAssembly, "Fib_Entry:")
PRINT String.Contains(FuncAssembly, "call Sum")
PRINT String.Contains(FuncAssembly, "call Fib")
PRINT String.Contains(FuncAssembly, "leave")

' More than 6 parameters/arguments is real SysV too -- stack-passed, no
' arbitrary limit (a real gap this backend had until directly asked to
' close it: "We need to allow more than 6 params in user declared
' functions"). Checked here: zero diagnostics for a 7-parameter function
' and call, and that the generated assembly actually contains the real
' stack-argument mechanics (a `push` for the pushed 7th argument and the
' caller-side `add $8, %rsp` cleanup afterward) -- real execution verified
' separately (this session, not committed as a fixture: a 7-arg function
' using every parameter distinctly, and a 10-arg function printing every
' parameter in order to catch a register/stack mis-ordering bug, both
' matched legacy `ArcoFission compile-run` exactly).
SevenParamsSource = "FUNCTION Seven(a, b, c, d, e, f, g)\n    RETURN a + g\nEND FUNCTION\nPRINT Seven(1, 2, 3, 4, 5, 6, 7)"
SevenParamsTokens = Fission_ArcoBasicLex(SevenParamsSource)
SevenParamsAst = Fission_ArcoBasicParse(SevenParamsTokens, "x86-64-seven-params-smoke.abas")
SevenParamsSir = Fission_ArcoBasicAstToSir(SevenParamsAst)
SevenParamsAmir = Fission_SirToAmir(SevenParamsSir)
SevenParamsProgram = Fission_AmirToX86_64(SevenParamsAmir)
PRINT SevenParamsProgram.Diagnostics.HasErrors()
PRINT SevenParamsProgram.Diagnostics.Render()
SevenParamsAssembly = SevenParamsProgram.Render()
PRINT String.Contains(SevenParamsAssembly, "push")
PRINT String.Contains(SevenParamsAssembly, "add $8, %rsp")
PRINT String.Contains(SevenParamsAssembly, "16(%rbp)")

' Calling a name that isn't a user-declared ArcoBASIC function (and isn't
' Runtime.Print) must report a diagnostic instead of emitting a `call` to
' an undefined symbol and letting the failure surface later, more
' confusingly, at link time.
UnknownCallSource = "PRINT UnknownFunc(1, 2)"
UnknownCallTokens = Fission_ArcoBasicLex(UnknownCallSource)
UnknownCallAst = Fission_ArcoBasicParse(UnknownCallTokens, "x86-64-unknown-call-smoke.abas")
UnknownCallSir = Fission_ArcoBasicAstToSir(UnknownCallAst)
UnknownCallAmir = Fission_SirToAmir(UnknownCallSir)
UnknownCallProgram = Fission_AmirToX86_64(UnknownCallAmir)
PRINT UnknownCallProgram.Diagnostics.HasErrors()

' DO loops (all four shapes) needed zero dedicated codegen at all, the
' same "already works" precedent FOR-range set in Phase 2 -- confirmed
' directly, not assumed. Checked here: zero diagnostics, real execution
' verified separately by fission/tests/native_programs/do_loops.abas.
DoSource = "i = 1\nDO WHILE i <= 3\n    PRINT i\n    i = i + 1\nLOOP\nj = 1\nDO\n    PRINT j\n    j = j + 1\nLOOP UNTIL j > 3"
DoTokens = Fission_ArcoBasicLex(DoSource)
DoAst = Fission_ArcoBasicParse(DoTokens, "x86-64-do-smoke.abas")
DoSir = Fission_ArcoBasicAstToSir(DoAst)
DoAmir = Fission_SirToAmir(DoSir)
DoProgram = Fission_AmirToX86_64(DoAmir)
PRINT DoProgram.Diagnostics.HasErrors()
PRINT DoProgram.Diagnostics.Render()

' A real, serious bug found and fixed this session while confirming DO
' loops: comparisons used the WRONG (unsigned) x86 set* instruction family
' for A-MIR's typed INT.CMP_*_UNSIGNED opcodes, which A-MIR picks for
' EVERY comparison regardless of whether the operand is actually unsigned
' -- a negative number's bit pattern, compared unsigned, is never "<=" a
' positive number, so `DO UNTIL k <= 0 ... k = k - 3 ... LOOP` never
' terminated. Confirmed against the real canonical oracle (the bytecode
' VM, which reduces INT.CMP_LE_UNSIGNED back to a bare, ordinary signed
' comparison before executing) that ArcoBASIC's real semantics are signed.
' Checked here: the rendered assembly for a `<=` comparison uses `setle`
' (signed), never `setbe` (unsigned) -- real execution verified separately
' by fission/tests/native_programs/do_loops.abas (a real DO UNTIL counting
' through zero into negative numbers).
NegCompareSource = "k = 10\nDO UNTIL k <= 0\n    PRINT k\n    k = k - 3\nLOOP"
NegCompareTokens = Fission_ArcoBasicLex(NegCompareSource)
NegCompareAst = Fission_ArcoBasicParse(NegCompareTokens, "x86-64-neg-compare-smoke.abas")
NegCompareSir = Fission_ArcoBasicAstToSir(NegCompareAst)
NegCompareAmir = Fission_SirToAmir(NegCompareSir)
NegCompareProgram = Fission_AmirToX86_64(NegCompareAmir)
PRINT NegCompareProgram.Diagnostics.HasErrors()
NegCompareAssembly = NegCompareProgram.Render()
PRINT String.Contains(NegCompareAssembly, "setle")
PRINT String.Contains(NegCompareAssembly, "setbe")

' A second real bug found and fixed the same session: unary minus (`-5`)
' was never lowered by this substrate's shared A-MIR pass at all (fell
' through to a generic "unsupported expression" diagnostic) -- affects
' both the bytecode and native backends, since they share
' fission/sir/lower_amir.abas. Checked here: zero diagnostics for a
' program using a bare unary-minus literal.
UnaryMinusSource = "x = -5\nPRINT x"
UnaryMinusTokens = Fission_ArcoBasicLex(UnaryMinusSource)
UnaryMinusAst = Fission_ArcoBasicParse(UnaryMinusTokens, "x86-64-unary-minus-smoke.abas")
UnaryMinusSir = Fission_ArcoBasicAstToSir(UnaryMinusAst)
UnaryMinusAmir = Fission_SirToAmir(UnaryMinusSir)
PRINT UnaryMinusAmir.Diagnostics.HasErrors()
UnaryMinusProgram = Fission_AmirToX86_64(UnaryMinusAmir)
PRINT UnaryMinusProgram.Diagnostics.HasErrors()

' Phase 7: real numeric arrays -- construction, indexed read/write, and
' LEN. Real execution verified separately by
' fission/tests/native_programs/arrays.abas. Checked here: zero
' diagnostics, and that the rendered assembly actually contains
' `call array_alloc`, real SIB scaled addressing for the indexed read/
' write (`8(%rax,%rcx,8)`), and the `.section .bss` arena declaration
' (shared with string concatenation).
ArraysSource = "a = [10, 20, 30]\nPRINT a[0]\na[1] = 99\nPRINT a[1]\nPRINT LEN(a)"
ArraysTokens = Fission_ArcoBasicLex(ArraysSource)
ArraysAst = Fission_ArcoBasicParse(ArraysTokens, "x86-64-arrays-smoke.abas")
ArraysSir = Fission_ArcoBasicAstToSir(ArraysAst)
ArraysAmir = Fission_SirToAmir(ArraysSir)
ArraysProgram = Fission_AmirToX86_64(ArraysAmir)
PRINT ArraysProgram.Diagnostics.HasErrors()
PRINT ArraysProgram.Diagnostics.Render()
ArraysAssembly = ArraysProgram.Render()
PRINT String.Contains(ArraysAssembly, "call array_alloc")
PRINT String.Contains(ArraysAssembly, "8(%rax,%rcx,8)")
PRINT String.Contains(ArraysAssembly, ".section .bss")

' Indexing a non-array value, and array elements that aren't plain
' numbers, both remain real, disclosed gaps -- must report a diagnostic,
' not silently misinterpret a number as a pointer or vice versa.
BadIndexSource = "x = 5\nPRINT x[0]"
BadIndexTokens = Fission_ArcoBasicLex(BadIndexSource)
BadIndexAst = Fission_ArcoBasicParse(BadIndexTokens, "x86-64-bad-index-smoke.abas")
BadIndexSir = Fission_ArcoBasicAstToSir(BadIndexAst)
BadIndexAmir = Fission_SirToAmir(BadIndexSir)
BadIndexProgram = Fission_AmirToX86_64(BadIndexAmir)
PRINT BadIndexProgram.Diagnostics.HasErrors()

StringArraySource = "a = [\"x\", \"y\"]\nPRINT a[0]"
StringArrayTokens = Fission_ArcoBasicLex(StringArraySource)
StringArrayAst = Fission_ArcoBasicParse(StringArrayTokens, "x86-64-string-array-smoke.abas")
StringArraySir = Fission_ArcoBasicAstToSir(StringArrayAst)
StringArrayAmir = Fission_SirToAmir(StringArraySir)
StringArrayProgram = Fission_AmirToX86_64(StringArrayAmir)
PRINT StringArrayProgram.Diagnostics.HasErrors()

' Bare AND/OR/BITAND/BITOR/BITXOR/SHL/SHR, plus the (eager, not actually
' short-circuit) ANDALSO/ORELSE -- real execution verified separately by
' fission/tests/native_programs/bitops.abas. Checked here: zero
' diagnostics, and that the rendered assembly actually contains the real
' single-instruction x86 lowerings (`and`, `or`, `xor`, `shl`, and `sar`
' for SHR specifically -- confirmed, not assumed, that SHR is actually an
' arithmetic shift right at runtime).
BitopsSource = "x = 5\ny = 10\nz = x AND y\nPRINT z\nw = x BITAND y\nPRINT w\nv = x BITOR y\nPRINT v\nu = x SHL 2\nPRINT u\nt = x BITXOR y\nPRINT t\ns = x SHR 1\nPRINT s\nIF x > 0 ANDALSO y > 0 THEN\n    PRINT 1\nEND IF\nIF x < 0 ORELSE y > 0 THEN\n    PRINT 2\nEND IF"
BitopsTokens = Fission_ArcoBasicLex(BitopsSource)
BitopsAst = Fission_ArcoBasicParse(BitopsTokens, "x86-64-bitops-smoke.abas")
BitopsSir = Fission_ArcoBasicAstToSir(BitopsAst)
BitopsAmir = Fission_SirToAmir(BitopsSir)
BitopsProgram = Fission_AmirToX86_64(BitopsAmir)
PRINT BitopsProgram.Diagnostics.HasErrors()
BitopsAssembly = BitopsProgram.Render()
PRINT String.Contains(BitopsAssembly, "    and %rcx, %rax")
PRINT String.Contains(BitopsAssembly, "    or %rcx, %rax")
PRINT String.Contains(BitopsAssembly, "    xor %rcx, %rax")
PRINT String.Contains(BitopsAssembly, "    shl %cl, %rax")
PRINT String.Contains(BitopsAssembly, "    sar %cl, %rax")

' SAR itself (as opposed to SHR) and real integer division (`\`) remain
' real, disclosed gaps -- confirmed via a direct oracle probe that legacy
' `ArcoFission compile-run` fails outright on both ("unsupported bytecode
' binary operator"), so this backend correctly reports a diagnostic rather
' than guessing a semantic its own equivalence-testing oracle can never
' confirm or deny.
SarSource = "a = -8\nPRINT a SAR 1"
SarTokens = Fission_ArcoBasicLex(SarSource)
SarAst = Fission_ArcoBasicParse(SarTokens, "x86-64-sar-smoke.abas")
SarSir = Fission_ArcoBasicAstToSir(SarAst)
SarAmir = Fission_SirToAmir(SarSir)
SarProgram = Fission_AmirToX86_64(SarAmir)
PRINT SarProgram.Diagnostics.HasErrors()

IntDivSource = "a = 17\nPRINT a \\ 5"
IntDivTokens = Fission_ArcoBasicLex(IntDivSource)
IntDivAst = Fission_ArcoBasicParse(IntDivTokens, "x86-64-intdiv-smoke.abas")
IntDivSir = Fission_ArcoBasicAstToSir(IntDivAst)
IntDivAmir = Fission_SirToAmir(IntDivSir)
IntDivProgram = Fission_AmirToX86_64(IntDivAmir)
PRINT IntDivProgram.Diagnostics.HasErrors()

' Real PRINT of a Bool-kind value (a bare TRUE/FALSE literal, or a
' comparison result) renders `TRUE`/`FALSE`, closing a real bug found
' while verifying string function parameters -- this backend previously
' itoa'd the raw 0/1 like any other number. Real execution verified
' separately by fission/tests/native_programs/bool_print.abas. Checked
' here: zero diagnostics, and that the rendered assembly actually contains
' `call bool_print`. A bitwise AND of two comparisons does NOT preserve
' Bool-ness (confirmed against the oracle) -- `w = x > 0 AND y > 0` prints
' `1`, not `TRUE`, so PRINTing it must still go through the ordinary
' itoa_print path, not bool_print.
BoolPrintSource = "x = 1\ny = 2\nb = x < y\nPRINT b\nPRINT TRUE\nw = x > 0 AND y > 0\nPRINT w"
BoolPrintTokens = Fission_ArcoBasicLex(BoolPrintSource)
BoolPrintAst = Fission_ArcoBasicParse(BoolPrintTokens, "x86-64-bool-print-smoke.abas")
BoolPrintSir = Fission_ArcoBasicAstToSir(BoolPrintAst)
BoolPrintAmir = Fission_SirToAmir(BoolPrintSir)
BoolPrintProgram = Fission_AmirToX86_64(BoolPrintAmir)
PRINT BoolPrintProgram.Diagnostics.HasErrors()
BoolPrintAssembly = BoolPrintProgram.Render()
PRINT String.Contains(BoolPrintAssembly, "call bool_print")
PRINT String.Contains(BoolPrintAssembly, "call itoa_print")

' Real CLASS support -- a constructor initializing a numeric field, a
' method reading/writing SELF's own field, and a method call from outside
' -- resolved to real fixed-offset field access and a real, statically-
' resolved direct call (see Fission_X86_64CollectClassFields' own header
' comment in fission/amir/lower_x86_64.abas for the full design). Real
' execution verified separately by
' fission/tests/native_programs/classes.abas. Checked here: zero
' diagnostics, and that the rendered assembly actually contains
' `call object_alloc`, a real fixed-displacement field access (`8(%rax)`,
' `SELF.Value`'s own offset -- 0 is always reserved for `__class`), and a
' real direct call to the statically-resolved method (`call
' Counter.Increment`, not the variable-qualified `c.Increment` text the
' A-MIR itself carries).
ClassSource = "CLASS Counter\n    CONSTRUCTOR(start)\n        SELF.Value = start\n    END CONSTRUCTOR\n    FUNCTION Increment()\n        SELF.Value = SELF.Value + 1\n    END FUNCTION\nEND CLASS\nc = Counter(5)\nc.Increment()\nPRINT c.Value"
ClassTokens = Fission_ArcoBasicLex(ClassSource)
ClassAst = Fission_ArcoBasicParse(ClassTokens, "x86-64-class-smoke.abas")
ClassSir = Fission_ArcoBasicAstToSir(ClassAst)
ClassAmir = Fission_SirToAmir(ClassSir)
ClassProgram = Fission_AmirToX86_64(ClassAmir)
PRINT ClassProgram.Diagnostics.HasErrors()
ClassAssembly = ClassProgram.Render()
PRINT String.Contains(ClassAssembly, "call object_alloc")
PRINT String.Contains(ClassAssembly, "8(%rax)")
PRINT String.Contains(ClassAssembly, "call Counter.Increment")

' A real, previously-undiscovered, SEVERE bug found while verifying
' CLASS support, NOT class-specific at all: a function with no explicit
' RETURN statement (falls off the end -- Counter.Increment above is
' exactly this shape) previously emitted NO closing `leave`/`ret` at all,
' silently falling through into whatever code is laid out next in the
' flat `.text` stream and corrupting the return address -- confirmed via
' a real SIGSEGV on the actual compiled binary before this fix. Checked
' here directly on the class assembly already rendered above (Increment
' itself never contains an explicit RETURN in its own ArcoBASIC source).
PRINT String.Contains(ClassAssembly, "Counter.Increment:")

' Real, disclosed Phase 1 gaps: a non-numeric (String) field, an unknown
' field name, and genuine runtime polymorphism (a variable that could hold
' different concrete classes at different times) all still correctly
' report a diagnostic rather than silently misinterpreting one kind as
' another.
StringFieldSource = "CLASS Person\n    CONSTRUCTOR(name)\n        SELF.Name = name\n    END CONSTRUCTOR\nEND CLASS\np = Person(\"Ada\")"
StringFieldTokens = Fission_ArcoBasicLex(StringFieldSource)
StringFieldAst = Fission_ArcoBasicParse(StringFieldTokens, "x86-64-string-field-smoke.abas")
StringFieldSir = Fission_ArcoBasicAstToSir(StringFieldAst)
StringFieldAmir = Fission_SirToAmir(StringFieldSir)
StringFieldProgram = Fission_AmirToX86_64(StringFieldAmir)
PRINT StringFieldProgram.Diagnostics.HasErrors()

UnknownFieldSource = "CLASS Counter\n    CONSTRUCTOR(start)\n        SELF.Value = start\n    END CONSTRUCTOR\nEND CLASS\nc = Counter(5)\nPRINT c.Missing"
UnknownFieldTokens = Fission_ArcoBasicLex(UnknownFieldSource)
UnknownFieldAst = Fission_ArcoBasicParse(UnknownFieldTokens, "x86-64-unknown-field-smoke.abas")
UnknownFieldSir = Fission_ArcoBasicAstToSir(UnknownFieldAst)
UnknownFieldAmir = Fission_SirToAmir(UnknownFieldSir)
UnknownFieldProgram = Fission_AmirToX86_64(UnknownFieldAmir)
PRINT UnknownFieldProgram.Diagnostics.HasErrors()

PolyClassSource = "CLASS Animal\n    CONSTRUCTOR(legs)\n        SELF.Legs = legs\n    END CONSTRUCTOR\n    FUNCTION Speak()\n        RETURN 0\n    END FUNCTION\nEND CLASS\nCLASS Dog EXTENDS Animal\n    FUNCTION Speak()\n        RETURN 1\n    END FUNCTION\nEND CLASS\nx = 1\nIF x == 1 THEN\n    pet = Dog(4)\nELSE\n    pet = Animal(2)\nEND IF\nPRINT pet.Speak()"
PolyClassTokens = Fission_ArcoBasicLex(PolyClassSource)
PolyClassAst = Fission_ArcoBasicParse(PolyClassTokens, "x86-64-poly-class-smoke.abas")
PolyClassSir = Fission_ArcoBasicAstToSir(PolyClassAst)
PolyClassAmir = Fission_SirToAmir(PolyClassSir)
PolyClassProgram = Fission_AmirToX86_64(PolyClassAmir)
PRINT PolyClassProgram.Diagnostics.HasErrors()
