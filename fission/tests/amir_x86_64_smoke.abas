' host bridge signature can never be inferred the way a real ArcoBASIC
' function's own signature can, so it is checked directly, exactly, not
' guessed at.
HostCallBadCountSource = "PRINT String.Length(\"a\", \"b\")"
HostCallBadCountTokens = Fission_ArcoBasicLex(HostCallBadCountSource)
HostCallBadCountAst = Fission_ArcoBasicParse(HostCallBadCountTokens, "x86-64-host-call-bad-count-smoke.abas")
