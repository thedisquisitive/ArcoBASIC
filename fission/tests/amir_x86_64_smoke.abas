StringArrayProgram = Fission_AmirToX86_64(StringArrayAmir)
PRINT StringArrayProgram.Diagnostics.HasErrors()
PRINT String.Contains(StringArrayProgram.Render(), "call array_print_string")

' A genuinely HETEROGENEOUS array literal (legal on the oracle -- real
