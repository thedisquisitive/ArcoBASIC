NoHostCallAmir = Fission_SirToAmir(NoHostCallSir)
NoHostCallProgram = Fission_AmirToX86_64(NoHostCallAmir)
PRINT NoHostCallProgram.UsesHostBridge

' A wrong argument COUNT or KIND for a real host function is a real,
