#IMPORT "fission/core/fission.abas"
#IMPORT "fission/build/rivet_modules.abas"

Fission = Fission_New()
Module = Fission_ArcoBasicFrontendModule()
ignored = Fission.RegisterModule(Module)

PRINT Module.OutputPath()
PRINT String.Contains(Module.RenderManifest(), "FISSION MODULE fission.arcobasic.frontend 0.1")
PRINT String.Contains(Module.RenderManifest(), "COMPONENT language.arcobasic [Language] Source.arcobasic -> SIR")
PRINT Fission.Registry.HasComponent("language.arcobasic")

Registered = Fission.Registry.FindByName("language.arcobasic")
PRINT Object.Get(Registered.Configuration, "ModuleExecutable", "")
PRINT Object.Get(Registered.Configuration, "ModuleProtocol", "")

Source = "value = 1\nPRINT value"
Artifact = FissionArtifact("Source.arcobasic", "module-demo.abas", Source)
SirArtifact = Registered.TransformArtifact(Artifact, {Registry: Fission.Registry}, "SIR")
PRINT SirArtifact.Type
PRINT SirArtifact.Value.Name
PRINT String.Contains(SirArtifact.Value.Render(), "SIR module-demo.abas v0.1")
PRINT String.Contains(SirArtifact.Value.Render(), "  Print")
PRINT SirArtifact.MetadataValue("SerializedAs", "")
PRINT SirArtifact.MetadataValue("SemanticSymbolCount", "")
PRINT SirArtifact.MetadataValue("SemanticReferenceCount", "")
PRINT String.Contains(SirArtifact.MetadataValue("Semantics.Render", ""), "Read module::value -> Resolved module::value")

Request = Fission.Request()
Request.Source = Source
Request.SourceName = "module-pipeline.abas"
ignored = Request.WithLanguage("arcobasic")
ignored = Request.ToArtifact("SIR")

Result = Fission.Compiler().Compile(Request)
PRINT Result.Ok
PRINT Result.Artifact.Value.Name
PRINT String.Contains(Result.Artifact.Value.Render(), "SIR module-pipeline.abas v0.1")
PRINT Result.Artifact.MetadataValue("SemanticSymbolCount", "")
PRINT Result.Artifact.MetadataValue("SemanticReferenceCount", "")
PRINT String.Contains(Result.Artifact.MetadataValue("Semantics.Render", ""), "Read module::value -> Resolved module::value")
