#IMPORT "fission/language/arcobasic/lower_sir.abas"

Source = "ok = value % 2 == 0 ANDALSO enabled OR fallback\nother = value MOD 3"
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "logic-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)

PRINT Ast.Diagnostics.HasErrors()
PRINT Ast.Render()
PRINT "---"
PRINT Sir.Diagnostics.HasErrors()
PRINT Sir.Render()
