#IMPORT "fission/language/arcobasic/semantic.abas"
#IMPORT "fission/language/arcobasic/lower_sir.abas"

Source = "#IMPORT \"text\" AS Txt\ncount AS U64 = 1\nFUNCTION Add(left AS U64, right AS U64 = 1) AS U64\ntotal = left + right\nRETURN total\nEND FUNCTION\nCLASS Box\nvalue AS U64\nEND CLASS"
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "semantic-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)
Report = Fission_ArcoBasicAnalyzeSir(Sir)

PRINT Report.Diagnostics.HasErrors()
PRINT Report.Render()
