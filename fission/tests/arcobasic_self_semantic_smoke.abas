#IMPORT "fission/core/fission.abas"
#IMPORT "fission/language/arcobasic/register.abas"

Fission = Fission_New()
ignored = Fission_RegisterArcoBasic(Fission)

Request = Fission.Request()
Request.Source = "#STRICT\nCLASS Counter\nCONSTRUCTOR(start AS U64)\nSELF.Value = start\nEND CONSTRUCTOR\nFUNCTION Current() AS U64\nRETURN SELF.Value\nEND FUNCTION\nFUNCTION Bump()\nSELF.Value = SELF.Current() + 1\nEND FUNCTION\nEND CLASS"
Request.SourceName = "self-semantic.abas"
ignored = Request.WithLanguage("arcobasic")
ignored = Request.ToArtifact("SIR")

Result = Fission.Compiler().Compile(Request)

PRINT Result.Ok
PRINT Result.Diagnostics.HasErrors()
PRINT Result.Artifact.MetadataValue("SemanticSymbolCount", "")
PRINT Result.Artifact.MetadataValue("SemanticReferenceCount", "")
PRINT Result.Artifact.MetadataValue("Semantics.Render", "")
