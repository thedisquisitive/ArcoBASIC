#IMPORT "fission/language/arcobasic/lower_sir.abas"

Source = "#IMPORT \"text\" AS Txt\n#DESCRIPTION \"Demo\"\nCONST Limit = 4\ncount AS U64 = 1: PRINT Txt.Join([count, Limit], \":\")"
Tokens = Fission_ArcoBasicLex(Source)
Ast = Fission_ArcoBasicParse(Tokens, "directive-decl-smoke.abas")
Sir = Fission_ArcoBasicAstToSir(Ast)

PRINT Ast.Diagnostics.HasErrors()
PRINT Ast.Render()
PRINT "---"
PRINT Sir.Diagnostics.HasErrors()
PRINT Sir.Render()
