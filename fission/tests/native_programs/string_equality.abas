' A real, ordinary ArcoBASIC program meant to be compiled BY the Fission
' Compiler Substrate's native x86-64 backend (fission/amir/lower_x86_64.abas)
' -- see fission/tests/native_programs/hello_native.abas's own header
' comment for the directory convention. This one exercises real string
' equality (`==`/`!=`): content comparison, not pointer identity -- two
' separately-`"hello"`-literal strings, a variable copy, and a
' concatenation result that happens to spell the same bytes as a literal,
' all compare equal; two different strings compare unequal.
'
' Expected output verified against legacy `ArcoFission compile-run` on this
' identical source as the equivalence-testing oracle.
a = "hello"
b = "hello"
c = "world"
d = a

IF a == b THEN
    PRINT 1
END IF

IF a == c THEN
    PRINT 2
ELSE
    PRINT 3
END IF

IF a != c THEN
    PRINT 4
END IF

IF a == d THEN
    PRINT 5
END IF

e = "hel" + "lo"
IF a == e THEN
    PRINT 6
END IF

IF a != e THEN
    PRINT 7
ELSE
    PRINT 8
END IF
