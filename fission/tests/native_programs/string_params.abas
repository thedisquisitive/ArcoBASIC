' A real, ordinary ArcoBASIC program meant to be compiled BY the Fission
' Compiler Substrate's native x86-64 backend (fission/amir/lower_x86_64.abas)
' -- see fission/tests/native_programs/hello_native.abas's own header
' comment for the directory convention. Exercises real string function
' PARAMETERS and RETURN VALUES, closing the exact gap this backend's own
' header comment disclosed since Phase 4 ("a parameter is always assumed
' numeric") via Fission_X86_64InferSignatures' real inter-procedural
' fixed-point kind inference across the whole module -- a pass-through
' function, string concatenation inside a function body, a multi-hop call
' chain, a mixed number/string parameter list, and a string-returning
' comparison function, all together with the numeric functions this
' backend already supported.
'
' Expected output verified against legacy `ArcoFission compile-run` on this
' identical source as the equivalence-testing oracle.
FUNCTION Echo(x)
    RETURN x
END FUNCTION

FUNCTION Greet(name)
    RETURN "Hello, " + name + "!"
END FUNCTION

PRINT Echo("plain string")
PRINT Greet("World")

s = "reused"
PRINT Echo(s)

FUNCTION Wrap(x)
    RETURN "[" + x + "]"
END FUNCTION

FUNCTION DoubleWrap(x)
    RETURN Wrap(Wrap(x))
END FUNCTION

PRINT DoubleWrap("core")

FUNCTION Combine(a, b, count)
    result = a + b
    i = 0
    WHILE i < count
        result = result + "!"
        i = i + 1
    WEND
    RETURN result
END FUNCTION
PRINT Combine("Hi", " there", 3)

FUNCTION Sum(a, b)
    RETURN a + b
END FUNCTION
PRINT Sum(3, 4)

FUNCTION EchoNum(x)
    RETURN x
END FUNCTION
PRINT EchoNum(42)
