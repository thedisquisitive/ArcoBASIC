' Lots of short-lived strings, maps and arrays next to long-lived ones: the
' garbage collector must reclaim the former and never touch the latter.
CLASS Keeper
    CONSTRUCTOR(label)
        SELF.Label = label
        SELF.Items = []
    END CONSTRUCTOR
END CLASS

keepers = []
total = 0
round = 0
WHILE round < 200000
    scratch = "item-" + String(round) + "-" + String(round * 3)
    shape = {Name: scratch, Size: round}
    pair = [round, scratch]
    total = total + LEN(scratch) + shape.Size - pair[0]
    IF round MOD 5000 == 0 THEN
        k = Keeper("keeper " + String(round))
        ignored = Array.Push(k.Items, scratch)
        ignored = Array.Push(k.Items, shape.Name)
        ignored = Array.Push(keepers, k)
    END IF
    round = round + 1
WEND
PRINT total
PRINT LEN(keepers)
check = 0
FOR k IN keepers
    IF k.Items[0] == k.Items[1] THEN check = check + 1
NEXT
PRINT check
PRINT keepers[7].Label
PRINT keepers[39].Items[0]
