' A real, ordinary ArcoBASIC program meant to be compiled BY the Fission
' Compiler Substrate's native x86-64 backend (fission/amir/lower_x86_64.abas)
' -- see fission/tests/native_programs/hello_native.abas's own header
' comment for the directory convention. Exercises real branching on a
' STRING value (`IF`/`WHILE`) -- a string's own truthiness is CONTENT-
' based, not pointer-based (confirmed via a direct oracle probe): any
' NON-EMPTY string is truthy, even one that spells "0" (a deliberately
' tricky case, since "0" as a NUMBER is falsy but "0" as a STRING is
' truthy), and only the empty string "" is falsy. Also exercises a real
' WHILE loop draining a string variable to empty.
'
' Expected output verified against legacy `ArcoFission compile-run` on this
' identical source as the equivalence-testing oracle.
s = "hello"
IF s THEN
    PRINT 1
ELSE
    PRINT 2
END IF

e = ""
IF e THEN
    PRINT 3
ELSE
    PRINT 4
END IF

WHILE s
    PRINT s
    s = ""
WEND

trickyZero = "0"
IF trickyZero THEN
    PRINT 5
ELSE
    PRINT 6
END IF
