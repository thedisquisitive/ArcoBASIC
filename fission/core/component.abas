#IMPORT "fission/core/artifact.abas"
#IMPORT "fission/core/diagnostics.abas"

FUNCTION Fission_ShellQuote(value)
    text = STRING(value)
    quoted = "'"
    index = 0
    WHILE index < String.Length(text)
        ch = String.Slice(text, index, 1)
        IF ch == "'" THEN
            quoted = quoted + "'\''"
        ELSE
            quoted = quoted + ch
        END IF
        index = index + 1
    WEND
    RETURN quoted + "'"
END FUNCTION

FUNCTION Fission_FileSafeName(value)
    text = STRING(value)
    safe = ""
    index = 0
    WHILE index < String.Length(text)
        ch = String.Slice(text, index, 1)
        IF String.Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-", ch) THEN
            safe = safe + ch
        ELSE
            safe = safe + "_"
        END IF
        index = index + 1
    WEND
    IF safe == "" THEN safe = "artifact"
    RETURN safe
END FUNCTION

FUNCTION Fission_ModuleTransformArtifact(component, artifact, context, outputType)
    executable = Object.Get(component.Configuration, "ModuleExecutable", "")
    IF executable == "" THEN RETURN NULL
    requestName = Fission_FileSafeName(component.Name + "_" + artifact.Name)
    requestPath = ".fission/tmp/" + requestName + ".request"
    responsePath = ".fission/tmp/" + requestName + ".response"
    ignored = Directory.Create(".fission")
    ignored = Directory.Create(".fission/tmp")
    ignored = File.WriteText(requestPath, STRING(artifact.Value))
    command = Fission_ShellQuote(executable) + " transform " + Fission_ShellQuote(requestPath) + " " + Fission_ShellQuote(responsePath) + " " + Fission_ShellQuote(outputType) + " " + Fission_ShellQuote(artifact.Name)
    runResult = Process.Run(command)
    output = FissionArtifact(outputType, artifact.Name, "")
    ignored = output.WithMetadata("PreviousType", artifact.Type)
    ignored = output.WithMetadata("ProducedBy", component.Name)
    ignored = output.WithMetadata("ModuleExecutable", executable)
    IF !runResult.Ok THEN
        diagnostics = FissionDiagnosticBag()
        ignored = diagnostics.ReportError("FISSION_MODULE_TRANSFORM_FAILED", component.Name + " module transform failed: " + Object.Get(runResult, "Output", ""))
        ignored = output.WithMetadata("Diagnostics", diagnostics)
        RETURN output
    END IF
    IF File.Exists(responsePath) == FALSE THEN
        diagnostics = FissionDiagnosticBag()
        ignored = diagnostics.ReportError("FISSION_MODULE_RESPONSE_MISSING", component.Name + " did not produce response file " + responsePath)
        ignored = output.WithMetadata("Diagnostics", diagnostics)
        RETURN output
    END IF
    output.Value = File.ReadText(responsePath)
    RETURN output
END FUNCTION

CLASS FissionComponent
    CONSTRUCTOR(name, componentClass)
        SELF.Name = name
        SELF.Version = "0.1"
        SELF.ComponentClass = componentClass
        SELF.Consumes = []
        SELF.Produces = []
        SELF.Capabilities = FissionCapabilitySet()
        SELF.Requirements = FissionCapabilitySet()
        SELF.Compatibility = []
        SELF.Configuration = {}
        SELF.TransformHandler = NULL
    END CONSTRUCTOR

    FUNCTION Versioned(version)
        SELF.Version = version
        RETURN SELF
    END FUNCTION

    FUNCTION Consume(artifactType)
        IF !Fission_ListContains(SELF.Consumes, artifactType) THEN ignored = Array.Push(SELF.Consumes, artifactType)
        RETURN SELF
    END FUNCTION

    FUNCTION Produce(artifactType)
        IF !Fission_ListContains(SELF.Produces, artifactType) THEN ignored = Array.Push(SELF.Produces, artifactType)
        RETURN SELF
    END FUNCTION

    FUNCTION Capability(name)
        ignored = SELF.Capabilities.Append(name)
        RETURN SELF
    END FUNCTION

    FUNCTION Require(name)
        ignored = SELF.Requirements.Append(name)
        RETURN SELF
    END FUNCTION

    FUNCTION CompatibleWith(name)
        IF !Fission_ListContains(SELF.Compatibility, name) THEN ignored = Array.Push(SELF.Compatibility, name)
        RETURN SELF
    END FUNCTION

    FUNCTION Configure(key, value)
        SELF.Configuration = Object.Set(SELF.Configuration, key, value)
        RETURN SELF
    END FUNCTION

    FUNCTION TransformWith(callback)
        SELF.TransformHandler = callback
        RETURN SELF
    END FUNCTION

    FUNCTION CanConsume(artifactType)
        RETURN Fission_ListContains(SELF.Consumes, artifactType)
    END FUNCTION

    FUNCTION CanProduce(artifactType)
        RETURN Fission_ListContains(SELF.Produces, artifactType)
    END FUNCTION

    FUNCTION Summary()
        RETURN SELF.Name + " [" + SELF.ComponentClass + "] " + Array.Join(SELF.Consumes, ",") + " -> " + Array.Join(SELF.Produces, ",")
    END FUNCTION

    FUNCTION TransformArtifact(artifact, context, outputType)
        IF SELF.TransformHandler == NULL THEN
            moduleOutput = Fission_ModuleTransformArtifact(SELF, artifact, context, outputType)
            IF moduleOutput != NULL THEN RETURN moduleOutput
            output = FissionArtifact(outputType, artifact.Name, artifact.Value)
            ignored = output.WithMetadata("PreviousType", artifact.Type)
            ignored = output.WithMetadata("ProducedBy", SELF.Name)
            RETURN output
        END IF
        handler = SELF.TransformHandler
        RETURN handler(artifact, context)
    END FUNCTION
END CLASS
