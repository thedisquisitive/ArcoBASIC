' Builds every fission/tests/native_programs/*.abas fixture as a real,
' standalone Linux x86-64 executable with NO embedded bytecode VM at all --
' compiled entirely by the Fission Compiler Substrate's own native codegen
' (fission/amir/lower_x86_64.abas), not legacy ArcoFission. See that file's
' own header comment for the current (deliberately small, disclosed)
' supported construct subset, and fission/tests/native_programs/ itself for
' why these fixtures are kept separate from fission/tests/substrate_programs/
' (whose bytecode-VM-embedded path supports a much larger subset already).
#IMPORT "fission/build/rivet_native_runtime.abas"

FUNCTION Fission_RivetBuildNativeDriver(compilerTarget)
    target = BUILD.ArcoCapsule("fission-compile-to-x86-64")
    target.Entry = "fission/cli/compile_to_x86_64.abas"
    target.OutputDirectory = ".rivet/fission-native"
    ignored = target.UseCompilerTarget(compilerTarget)
    ignored = target.Build()
    RETURN target
END FUNCTION

FUNCTION Fission_RivetNativeProgramBaseName(entryPath)
    segments = String.Split(entryPath, "/")
    last = segments[LEN(segments) - 1]
    RETURN String.Slice(last, 0, String.Length(last) - String.Length(".abas"))
END FUNCTION

FUNCTION Fission_RivetNativeProgramEntries()
    entries = []
    FOR entry IN DIRECTORY("fission/tests/native_programs", FALSE)
        IF entry.Extension == ".abas" THEN ignored = Array.Push(entries, entry.Path)
    NEXT
    RETURN entries
END FUNCTION

' `hostBridgeResult` (Fission_RivetBuildHostBridge's own {OutputPath,
' FinalActionId}) is a real build-graph DEPENDENCY of every native
' capsule, not just something that happens to exist on disk by the time
' this RUNS -- without this, a cold/parallel build could run this
' capsule's own Compile action (which RUNS the driver, and the driver
' checks for host_bridge.o's own real existence at that exact moment)
' before the host bridge's own Compile action has actually produced it,
' silently compiling a capsule with no host-function support at all
' instead of a real "wait for it" dependency edge.
FUNCTION Fission_RivetBuildNativeCapsule(entryPath, driverTarget, hostBridgeResult)
    target = BUILD.FissionNativeCapsule(Fission_RivetNativeProgramBaseName(entryPath))
    target.Entry = entryPath
    target.OutputDirectory = "build/fission-native-programs"
    ignored = target.UseDriverTarget(driverTarget)
    ignored = target.AddDependency({FinalActionId: hostBridgeResult.FinalActionId})
    ignored = target.Build()
    RETURN target
END FUNCTION

FUNCTION Fission_RivetBuildAllNativeCapsules(compilerTarget)
    driverTarget = Fission_RivetBuildNativeDriver(compilerTarget)
    hostBridgeResult = Fission_RivetBuildHostBridge()
    targets = []
    FOR entryPath IN Fission_RivetNativeProgramEntries()
        ignored = Array.Push(targets, Fission_RivetBuildNativeCapsule(entryPath, driverTarget, hostBridgeResult))
    NEXT
    RETURN targets
END FUNCTION

' The Arcology Fusion Linker's own standalone CLI (fission/cli/fusion.abas)
' -- a genuinely separate, directly invocable program, not just an
' in-process function fission/cli/compile_to_x86_64.abas happens to call
' (see that CLI's own header comment). An ordinary ArcoCapsule, the same
' shape every other first-party Fission CLI tool in this build already
' uses -- Fusion needs no bytecode-VM-embedding or native-codegen
' machinery of its OWN to build itself, it's a plain ArcoBASIC program
' compiled the normal way, same as ArcoFission/rivet/fissure already are.
FUNCTION Fission_RivetBuildFusionCli(compilerTarget)
    target = BUILD.ArcoCapsule("fusion")
    target.Entry = "fission/cli/fusion.abas"
    target.OutputDirectory = "build"
    ignored = target.UseCompilerTarget(compilerTarget)
    ignored = target.Build()
    RETURN target
END FUNCTION
