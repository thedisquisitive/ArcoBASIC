#IMPORT "fission/core/module.abas"
#IMPORT "fission/modules/arcobasic_frontend/module.abas"


FUNCTION Fission_RivetBuildModule(module, compilerTarget)
    target = BUILD.ArcoCapsule(module.OutputName)
    target.Entry = module.Entry
    target.OutputDirectory = module.OutputDirectory
    ignored = target.UseCompilerTarget(compilerTarget)
    ignored = target.Build()
    RETURN target
END FUNCTION

FUNCTION Fission_RivetBuildDefaultModules(compilerTarget)
    targets = []
    ignored = Array.Push(targets, Fission_RivetBuildModule(Fission_ArcoBasicFrontendModule(), compilerTarget))
    RETURN targets
END FUNCTION
