' Project-local Fissure config for the new Fission Compiler Substrate.
' The implementation under this directory is ArcoBASIC; this probe uses the legacy
' C++ ArcoFission binary only as the G0 bootstrap runner.

ignored = RegisterCommandProbe(
    "fission.substrate-core",
    "ROOT=\"$(pwd)/..\" && cd \"$ROOT\" && tests/integration/fission_substrate_core_smoke.sh \"${ARCOFISSION_PATH:-$ROOT/build-rivet/ArcoFission}\" \"$ROOT\"",
    ["fission", "substrate", "core", "wp-001"],
    ["core/", "build/", "modules/", "language/", "sir/", "tests/core_smoke.abas", "tests/language_authoring_kit_smoke.abas", "tests/module_smoke.abas", "tests/arcobasic_language_smoke.abas", "tests/arcobasic_access_interface_smoke.abas", "tests/arcobasic_call_statement_smoke.abas", "tests/arcobasic_callable_comprehension_smoke.abas", "tests/arcobasic_class_smoke.abas", "tests/arcobasic_control_smoke.abas", "tests/arcobasic_decimal_smoke.abas", "tests/arcobasic_diagnostics_smoke.abas", "tests/arcobasic_directive_decl_smoke.abas", "tests/arcobasic_do_bitwise_smoke.abas", "tests/arcobasic_expression_smoke.abas", "tests/arcobasic_fission_self_parse_smoke.abas", "tests/arcobasic_fission_self_semantic_smoke.abas", "tests/arcobasic_function_smoke.abas", "tests/arcobasic_include_metadata_smoke.abas", "tests/arcobasic_legacy_operator_smoke.abas", "tests/arcobasic_let_smoke.abas", "tests/arcobasic_lexer_smoke.abas", "tests/arcobasic_literal_smoke.abas", "tests/arcobasic_logic_smoke.abas", "tests/arcobasic_loop_semantic_smoke.abas", "tests/arcobasic_named_defaults_smoke.abas", "tests/arcobasic_os_stdlib_parse_smoke.abas", "tests/arcobasic_parser_smoke.abas", "tests/arcobasic_postfix_smoke.abas", "tests/arcobasic_preprocess_smoke.abas", "tests/arcobasic_preprocess_compile_smoke.abas", "tests/arcobasic_preprocess_error_smoke.abas", "tests/arcobasic_real_project_parse_smoke.abas", "tests/arcobasic_real_timer_parse_smoke.abas", "tests/arcobasic_reveal_smoke.abas", "tests/arcobasic_self_semantic_smoke.abas", "tests/arcobasic_semantic_smoke.abas", "tests/arcobasic_semantic_diagnostics_smoke.abas", "tests/arcobasic_semantic_reference_smoke.abas", "tests/arcobasic_shared_smoke.abas", "tests/arcobasic_single_line_if_smoke.abas", "tests/arcobasic_strict_semantic_smoke.abas", "tests/arcobasic_string_smoke.abas", "tests/arcobasic_type_compound_smoke.abas", "tests/sir_builder_smoke.abas"]
