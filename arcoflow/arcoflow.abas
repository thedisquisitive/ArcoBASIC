#DESCRIPTION "ArcoFlow IDE prototype -- edit, save, run, see output"

' First working prototype of the ArcoFlow IDE discussed in project planning: edit an ArcoBASIC
' file, save it, run it via ArcoFission, see the output. Pure text editing only -- no Intent/graph
' view yet, deliberately. This never touches reveal AST/PRETTY, only File.ReadText/WriteText on
' whatever file is open and Process.Run to shell out to ArcoFission, which is what actually
' resolves #IMPORT for multi-file projects; this editor only ever shows/saves one file's own raw
' text, never a preprocessed/#IMPORT-flattened merge, so it can't confuse a multi-file project by
' writing another module's content back into the file being edited.

#IMPORT "gui"

IF GUI.Available() == FALSE THEN
    PRINT "ArcoFlow needs a Wayland or X11 desktop session."
    ExitTheProgram(0)
END IF

' The ArcoFlow project format (canonized this pass): a ".arcoproj" file is a single ArcoBASIC
' object-literal expression (Project.Load in runtime.cpp evaluates it through the language's own
' parser, not a bespoke format), living as "project.arcoproj" at a project's root. It's entirely
' optional -- opening a bare .abas file with no project around it still works exactly as before.
' Recognized fields, all optional: Name, Entry, Files (paths relative to the project file --
' drives the project explorer sidebar below), Window: {Width, Height}, ArcoFissionPath.
projectName = ""
projectPath = ""
projectRoot = ""
projectFiles = []
projectWindowWidth = 1000
projectWindowHeight = 700
projectArcoFissionPath = ""

opened_path = ""
IF LEN(Args) > 0 THEN opened_path = Args[0]

IF opened_path <> "" ANDALSO Path.Extension(opened_path) == ".arcoproj" THEN
    ' Opened directly as `arcoflow some.arcoproj`: that file IS the project, and its Entry field
    ' (if any) says which file to actually edit.
    projectPath = opened_path
ELSE
    candidate = Path.Join(Path.DirName(opened_path), "project.arcoproj")
    IF File.Exists(candidate) THEN projectPath = candidate
END IF

IF projectPath <> "" THEN
    TRY
        ' Object.Get with a default rather than direct dot-access: every field (including the
        ' whole Window sub-object) is optional, and dotting into a key that's simply absent from
        ' the project file throws ("undefined property"), not returns something falsy.
        project = Project.Load(projectPath)
        projectName = Object.Get(project, "Name", "")
        projectEntry = Object.Get(project, "Entry", "")
        projectRoot = Path.DirName(projectPath)
        projectFiles = Object.Get(project, "Files", [])
        windowConfig = Object.Get(project, "Window", {})
        projectWindowWidth = Object.Get(windowConfig, "Width", projectWindowWidth)
        projectWindowHeight = Object.Get(windowConfig, "Height", projectWindowHeight)
        projectArcoFissionPath = Object.Get(project, "ArcoFissionPath", "")
        IF opened_path == projectPath ANDALSO projectEntry <> "" THEN
            opened_path = Path.Join(projectRoot, projectEntry)
        END IF
    CATCH err
        PRINT "ArcoFlow could not load " + projectPath + ": " + err.Message
    END TRY
END IF

initial_path = "untitled.abas"
has_path = FALSE
IF opened_path <> "" ANDALSO Path.Extension(opened_path) <> ".arcoproj" THEN
    initial_path = opened_path
    has_path = TRUE
END IF
initial_content = ""
IF File.Exists(initial_path) THEN initial_content = File.ReadText(initial_path)

arcofission_path = projectArcoFissionPath
IF arcofission_path == "" THEN arcofission_path = Process.Env("ARCOFISSION_PATH")
IF arcofission_path == "" THEN arcofission_path = "ArcoFission"

window_title = "ArcoFlow"
IF projectName <> "" THEN window_title = "ArcoFlow - " + projectName + " - " + Path.BaseName(initial_path)
IF projectName == "" THEN window_title = "ArcoFlow - " + Path.BaseName(initial_path)

TRY
    GUI.Application("arcoflow", "ArcoFlow")
    window = GUI.Window(window_title, projectWindowWidth, projectWindowHeight)
CATCH err
    PRINT "ArcoFlow window could not be opened: " + err.Message
    ExitTheProgram(0)
END TRY

app = {"Path": initial_path, "HasPath": has_path, "Dirty": FALSE, "Running": TRUE, "Status": "Ready", "Output": "", "ToolbarHover": "", "ProjectName": projectName, "CollapsedFolders": []}

editor = TextArea(initial_content)
runButton = Button("Run (F5)")
saveButton = Button("Save")
openButton = Button("Open")
newButton = Button("New")

' Sort key that puts folders before files within each directory level while still keeping every
' folder immediately before its own descendants (ComputeVisibleRows below relies on a folder's
' subtree being contiguous). Trick: mark every path segment with "0:" except a *file* row's own
' final segment, which gets "1:" -- ancestor segments are always folders so they're always "0:",
' and a plain lexicographic sort then does the right thing for free: "0:src" sorts before both
' "0:src/..." (a shorter string that's a prefix of a longer one sorts first, i.e. a folder sorts
' before its own children) and "1:main.abas" (folders before files), while "0:src/0:utils" sorts
' before "0:src/1:app.abas" (folders before files *within* src specifically).
FUNCTION RowSortKey(row)
    RETURN row.SortKey
END FUNCTION

' Project.Files entries may contain "/" to place a file under one or more folders (e.g.
' "src/utils/helper.abas"); BuildExplorerRows flattens that into one row per path segment seen
' (folders get one row the first time they're seen, files always get their own row), each
' carrying its nesting Depth so the drawing loop can indent it and ComputeVisibleRows can tell
' whether it's inside a currently-collapsed folder.
FUNCTION BuildExplorerRows(files)
    rows = []
    knownFolders = []
    FOR i = 0 TO LEN(files) - 1
        parts = String.Split(files[i], "/")
        prefix = ""
        keyPrefix = ""
        FOR d = 0 TO LEN(parts) - 2
            IF prefix == "" THEN prefix = parts[d] ELSE prefix = prefix + "/" + parts[d]
            IF keyPrefix == "" THEN keyPrefix = "0:" + parts[d] ELSE keyPrefix = keyPrefix + "/0:" + parts[d]
            IF Array.Contains(knownFolders, prefix) == FALSE THEN
                ignored = Array.Add(knownFolders, prefix)
                ignored2 = Array.Add(rows, {Kind: "folder", Label: parts[d], Path: prefix, Depth: d, SortKey: keyPrefix})
            END IF
        NEXT d
        fileName = parts[LEN(parts) - 1]
        fileKey = "1:" + fileName
        IF keyPrefix <> "" THEN fileKey = keyPrefix + "/" + fileKey
        ignored3 = Array.Add(rows, {Kind: "file", Label: fileName, Path: files[i], Depth: LEN(parts) - 1, SortKey: fileKey})
    NEXT i
    RETURN Array.SortBy(rows, ADDRESSOF RowSortKey)
END FUNCTION

' Indexes into `rows` that should currently be drawn, given which folder Paths are collapsed --
' skips every row nested under a collapsed folder (deeper Depth, contiguous following it) without
' needing the rows themselves to carry parent pointers.
FUNCTION ComputeVisibleRows(rows, collapsed)
    visible = []
    skipDepth = -1
    FOR i = 0 TO LEN(rows) - 1
        row = rows[i]
        IF skipDepth >= 0 ANDALSO row.Depth > skipDepth THEN
            ' inside a collapsed folder's subtree -- stays hidden
        ELSE
            skipDepth = -1
            ignored = Array.Add(visible, i)
            IF row.Kind == "folder" ANDALSO Array.Contains(collapsed, row.Path) THEN skipDepth = row.Depth
        END IF
    NEXT i
    RETURN visible
END FUNCTION

FUNCTION ToggleFolder(path)
    at = Array.Find(app.CollapsedFolders, path)
    IF at >= 0 THEN
        ignored = Array.RemoveAt(app.CollapsedFolders, at)
    ELSE
        ignored = Array.Add(app.CollapsedFolders, path)
    END IF
END FUNCTION

' One Button per explorer row (folders and files alike -- a folder row's "click" toggles it
' instead of opening a file), built once up front like the toolbar buttons above. Which of these
' are actually drawn/hit-tested varies frame to frame with collapse state; see ComputeVisibleRows.
' The row is drawn by hand below (see DrawExplorerRow) rather than Button.Draw -- Button's label
' is centered, which reads fine for a 4-word toolbar button but not for a left-aligned, indented,
' icon-prefixed tree row -- so these exist purely for SetBounds/ContainsPoint/Hovered/HandleEvent.
explorerRows = BuildExplorerRows(projectFiles)
rowButtons = []
FOR i = 0 TO LEN(explorerRows) - 1
    ignored = Array.Add(rowButtons, Button(""))
NEXT i
sidebarWidth = 0
IF LEN(projectFiles) > 0 THEN sidebarWidth = 200

FUNCTION RefreshTitle()
    suffix = ""
    IF app.Dirty THEN suffix = " *"
    title = "ArcoFlow - " + Path.BaseName(app.Path) + suffix
    IF app.ProjectName <> "" THEN title = "ArcoFlow - " + app.ProjectName + " - " + Path.BaseName(app.Path) + suffix
    GUI.SetTitle(window, title)
END FUNCTION

FUNCTION MarkDirty()
    app.Dirty = TRUE
    RefreshTitle()
END FUNCTION

FUNCTION SaveDocument()
    IF app.HasPath == FALSE THEN
        selected_path = GUI.SaveFileDialog(window, "Save ArcoBASIC File", app.Path)
        IF selected_path == "" THEN RETURN FALSE
        app.Path = selected_path
        app.HasPath = TRUE
    END IF
    File.WriteText(app.Path, editor.Text)
    app.Dirty = FALSE
    app.Status = "Saved " + app.Path
    RefreshTitle()
    RETURN TRUE
END FUNCTION

FUNCTION OpenPath(selected_path)
    IF app.Dirty THEN
        IF GUI.Confirm(window, "Unsaved changes", "Discard the current file and open another?") == FALSE THEN RETURN FALSE
    END IF
    IF selected_path == "" THEN RETURN FALSE
    IF File.Exists(selected_path) == FALSE THEN
        app.Status = "File does not exist: " + selected_path
        RETURN FALSE
    END IF
    app.Path = selected_path
    app.HasPath = TRUE
    editor.SetText(File.ReadText(selected_path))
    app.Dirty = FALSE
    app.Status = "Opened " + app.Path
    RefreshTitle()
    RETURN TRUE
END FUNCTION

FUNCTION OpenDocument()
    selected_path = GUI.OpenFileDialog(window, "Open ArcoBASIC File", app.Path)
    RETURN OpenPath(selected_path)
END FUNCTION

FUNCTION NewDocument()
    IF app.Dirty THEN
        IF GUI.Confirm(window, "Unsaved changes", "Discard the current file and start a new one?") == FALSE THEN RETURN FALSE
    END IF
    editor.SetText("")
    app.Path = "untitled.abas"
    app.HasPath = FALSE
    app.Dirty = TRUE
    app.Status = "New file"
    RefreshTitle()
    RETURN TRUE
END FUNCTION

FUNCTION RunProgram()
    IF SaveDocument() == FALSE THEN
        app.Status = "Run cancelled (file not saved)"
        RETURN FALSE
    END IF
    app.Status = "Running..."
    command = "\"" + arcofission_path + "\" compile-run \"" + app.Path + "\""
    result = Process.Run(command)
    app.Output = result.Output
    IF result.ExitCode == 0 THEN
        app.Status = "Finished (exit 0)"
    ELSE
        app.Status = "Failed (exit " + STRING(result.ExitCode) + ")"
    END IF
    RETURN TRUE
END FUNCTION

FUNCTION RequestClose()
    IF app.Dirty THEN
        IF GUI.Confirm(window, "Unsaved changes", "Close ArcoFlow without saving your changes?") == FALSE THEN
            GUI.SetShouldClose(window, FALSE)
            RETURN FALSE
        END IF
    END IF
    app.Running = FALSE
    RETURN TRUE
END FUNCTION

RefreshTitle()

WHILE app.Running
    size = GUI.Size(window)
    GUI.Clear(window, 0.055, 0.062, 0.082)

    ' Project explorer sidebar -- only takes up space at all when a project with Files was
    ' loaded, so a bare .abas file with no project keeps today's full-width layout untouched.
    ' Computed once per frame and reused below for event handling too, so a click is tested
    ' against exactly the rows that were actually drawn (and positioned) this same frame.
    visibleRows = ComputeVisibleRows(explorerRows, app.CollapsedFolders)
    IF sidebarWidth > 0 THEN
        GUI.Rectangle(window, 0, 0, sidebarWidth, size.Height, 0.045, 0.05, 0.068)
        GUI.Text(window, projectName, 14, 14, 12, 0.5, 0.58, 0.72, 1.0)
        row_heights = []
        FOR i = 0 TO LEN(visibleRows) - 1
            ignored = Array.Add(row_heights, 26)
        NEXT i
        row_offsets = VStack(40, row_heights, 4)
        FOR i = 0 TO LEN(visibleRows) - 1
            ' `rowButtons[rowIndex].SetBounds(...)` doesn't parse -- indexing then dotting into
            ' the result is a real, pre-existing lexer gap (`.` only tokenizes as part of a
            ' compound dotted identifier scanned in one go, not as its own token, so it has
            ' nowhere to go right after a `]`). Same workaround as Func(...).Field elsewhere: go
            ' through plain variables first, themselves references to the same instances.
            rowIndex = visibleRows[i]
            row = explorerRows[rowIndex]
            rowButton = rowButtons[rowIndex]
            indent = row.Depth * 14
            rowX = 8 + indent
            rowY = row_offsets[i]
            rowW = sidebarWidth - 16 - indent
            rowH = 26
            rowButton.SetBounds(rowX, rowY, rowW, rowH)
            isActiveFile = row.Kind == "file" ANDALSO Path.BaseName(app.Path) == Path.BaseName(row.Path)
            isFolder = row.Kind == "folder"

            ' Background: folders get a distinct base tint from files (visible even before
            ' reading any text), the active file overrides everything, hover lightens whichever
            ' applies. Isn't a real % blend, just three hand-picked, visually-checked shades.
            bgR = 0.08
            bgG = 0.09
            bgB = 0.12
            IF isFolder THEN
                bgR = 0.065
                bgG = 0.075
                bgB = 0.1
            END IF
            IF rowButton.Hovered THEN
                bgR = bgR + 0.04
                bgG = bgG + 0.045
                bgB = bgB + 0.05
            END IF
            IF isActiveFile THEN
                bgR = 0.16
                bgG = 0.24
                bgB = 0.36
            END IF
            GUI.RoundedRectangle(window, rowX, rowY, rowW, rowH, 4, bgR, bgG, bgB, 1.0)

            ' Left-aligned icon + label rather than Button.Draw's centered text -- reads as an
            ' actual tree instead of a column of pill buttons, and lets folders/files diverge in
            ' color: folders amber (matches a closed/open folder's usual warm tone regardless of
            ' the actual icon glyph used), files a cool white, dimmed further for anything that
            ' isn't a .abas source file so the project's own code stands out from the rest.
            icon = "  "
            textR = 0.82
            textG = 0.87
            textB = 0.95
            IF isFolder THEN
                textR = 0.86
                textG = 0.7
                textB = 0.42
                icon = "> "
                IF Array.Contains(app.CollapsedFolders, row.Path) == FALSE THEN icon = "v "
            ELSE
                IF Path.Extension(row.Path) <> ".abas" THEN
                    textR = 0.5
                    textG = 0.53
                    textB = 0.6
                END IF
            END IF
            IF isActiveFile THEN
                textR = 0.95
                textG = 0.97
                textB = 1.0
            END IF

            label = icon + row.Label
            measured = GUI.MeasureText(window, label, 13)
            GUI.Text(window, label, rowX + 6, rowY + (rowH - measured.Height) / 2, 13, textR, textG, textB, 1.0)
        NEXT i
    END IF

    toolbar_height = 46
    GUI.Rectangle(window, sidebarWidth, 0, size.Width - sidebarWidth, toolbar_height, 0.075, 0.086, 0.115)
    button_widths = [70, 90, 70, 70]
    button_offsets = HStack(sidebarWidth + 12, button_widths, 8)
    newButton.SetBounds(button_offsets[0], 8, button_widths[0], 30)
    openButton.SetBounds(button_offsets[1], 8, button_widths[1], 30)
    saveButton.SetBounds(button_offsets[2], 8, button_widths[2], 30)
    runButton.SetBounds(button_offsets[3], 8, button_widths[3], 30)
    newButton.Draw(window)
    openButton.Draw(window)
    saveButton.Draw(window)
    runButton.Draw(window)

    editor_y = toolbar_height + 8
    output_height = 160
    editor_height = size.Height - editor_y - output_height - 40
    editor.SetBounds(sidebarWidth + 12, editor_y, size.Width - sidebarWidth - 24, editor_height)
    editor.Draw(window)

    output_y = editor_y + editor_height + 8
    GUI.RoundedRectangle(window, sidebarWidth + 12, output_y, size.Width - sidebarWidth - 24, output_height, 6, 0.07, 0.08, 0.1, 1.0)
    GUI.Text(window, "OUTPUT", sidebarWidth + 22, output_y + 8, 12, 0.5, 0.58, 0.7, 1.0)
    GUI.SetClip(window, sidebarWidth + 12, output_y, size.Width - sidebarWidth - 24, output_height)
    GUI.TextMono(window, app.Output, sidebarWidth + 22, output_y + 26, 13, 0.82, 0.88, 0.94, 1.0)
    GUI.ResetClip(window)

    status_y = size.Height - 26
    GUI.Text(window, app.Status, sidebarWidth + 12, status_y, 13, 0.55, 0.62, 0.72, 1.0)
    GUI.Text(window, "F5 run   Ctrl+S save   Ctrl+O open   Ctrl+N new", size.Width - 340, status_y, 13, 0.45, 0.52, 0.62, 1.0)

    GUI.Present(window)

    event = GUI.WaitEvent(0.04)

    IF event.Type == "close" THEN ignored = RequestClose()

    IF newButton.HandleEvent(window, event) THEN ignored = NewDocument()
    IF openButton.HandleEvent(window, event) THEN ignored = OpenDocument()
    IF saveButton.HandleEvent(window, event) THEN ignored = SaveDocument()
    IF runButton.HandleEvent(window, event) THEN ignored = RunProgram()

    FOR i = 0 TO LEN(visibleRows) - 1
        rowIndex = visibleRows[i]
        row = explorerRows[rowIndex]
        rowButton = rowButtons[rowIndex]
        IF rowButton.HandleEvent(window, event) THEN
            IF row.Kind == "folder" THEN
                ignored = ToggleFolder(row.Path)
            ELSE
                ignored = OpenPath(Path.Join(projectRoot, row.Path))
            END IF
        END IF
    NEXT i

    before_text = editor.Text
    changed = editor.HandleEvent(window, event)
    IF changed ORELSE editor.Text <> before_text THEN MarkDirty()

    IF event.Type == "key" ANDALSO (event.Action == "press" ORELSE event.Action == "repeat") THEN
        IF event.Key == "f5" THEN ignored = RunProgram()
        IF event.Ctrl THEN
            IF event.Key == "s" THEN ignored = SaveDocument()
            IF event.Key == "o" THEN ignored = OpenDocument()
            IF event.Key == "n" THEN ignored = NewDocument()
        END IF
    END IF
WEND

GUI.Close(window)
IF app.Dirty THEN PRINT "ArcoFlow closed with unsaved changes in " + app.Path
