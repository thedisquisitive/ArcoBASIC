' RFC-0048 Milestone N0 Phase 1: real NIC identification probe. A standalone fixture (matching
' this project's own established pattern for a driver's first real proof -- ps2-keyboard-driver.
' abas, usb-hid-keyboard-driver.abas, gpu-discovery-probe.abas) that runs the real PCI scan and
' reports every real network-class device found over serial: vendor ID, device ID,
' class/subclass/prog-if, and all 6 real BARs.
'
' Real, honest scope of this specific proof: this only proves the scan mechanism itself works
' generically (finds a real PCI class-0x02 device, reports its real vendor/device/class/BARs
' correctly, correctly identifies known vendor IDs including VirtIO's own 0x1AF4). It does not yet
' touch the device's own MMIO/BAR registers -- MMIO mapping and virtqueue setup are Milestone N0
' Phase 2's own scope.
'
' Inlined verbatim from stdlib/network_discovery_policy.abas -- this backend has no #INCLUDE
' mechanism, matching every other real driver fixture in this project.

#PROFILE UEFI
#TARGET X86_64
#RUNTIME NONE

FUNCTION NetDiscoveryPciConfigAddressPort() AS IOPORT
    RETURN PORT.Address(3320)   ' 0xCF8
END FUNCTION

FUNCTION NetDiscoveryPciConfigDataPort() AS IOPORT
    RETURN PORT.Address(3324)   ' 0xCFC
END FUNCTION

FUNCTION NetDiscoveryPciConfigReadU32(bus AS U32, device AS U32, func AS U32, offset AS U32) AS U32
    LET address AS U32 = 2147483648
    address = address OR (bus SHL 16)
    address = address OR (device SHL 11)
    address = address OR (func SHL 8)
    address = address OR (offset AND 252)
    LET addrPort AS IOPORT = NetDiscoveryPciConfigAddressPort()
    LET dataPort AS IOPORT = NetDiscoveryPciConfigDataPort()
    PORT.WriteDWord(addrPort, address)
    LET value AS U32 = PORT.ReadDWord(dataPort)
    RETURN value
END FUNCTION

FUNCTION NetDiscoveryStateAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(61865984))   ' 0x3B00000, clear of every other fixed scratch region this project uses
END FUNCTION
FUNCTION NetDiscoveryCountAddress() AS MMIOPTR
    RETURN NetDiscoveryStateAddress()
END FUNCTION
FUNCTION NetDiscoveryMaxDevices() AS U32
    RETURN 4
END FUNCTION
FUNCTION NetDiscoveryEntryStride() AS U32
    RETURN 64
END FUNCTION
FUNCTION NetDiscoveryEntryAddress(index AS U32) AS MMIOPTR
    RETURN ADDRESS.Offset(NetDiscoveryStateAddress(), 8 + (index * NetDiscoveryEntryStride()))
END FUNCTION

FUNCTION NetDiscoveryWriteEntry(index AS U32, bus AS U32, device AS U32, func AS U32, vendorId AS U32, deviceId AS U32, baseClass AS U32, subclass AS U32, progIf AS U32) AS U64
    LET addr AS MMIOPTR = NetDiscoveryEntryAddress(index)
    MEMORY.Write32(addr, bus)
    MEMORY.Write32(ADDRESS.Offset(addr, 4), device)
    MEMORY.Write32(ADDRESS.Offset(addr, 8), func)
    MEMORY.Write32(ADDRESS.Offset(addr, 12), vendorId)
    MEMORY.Write32(ADDRESS.Offset(addr, 16), deviceId)
    MEMORY.Write32(ADDRESS.Offset(addr, 20), baseClass)
    MEMORY.Write32(ADDRESS.Offset(addr, 24), subclass)
    MEMORY.Write32(ADDRESS.Offset(addr, 28), progIf)
    LET barIndex AS U32 = 0
    WHILE barIndex < 6
        LET barValue AS U32 = NetDiscoveryPciConfigReadU32(bus, device, func, 16 + (barIndex * 4))
        MEMORY.Write32(ADDRESS.Offset(addr, 32 + (barIndex * 4)), barValue)
        barIndex = barIndex + 1
    WEND
    RETURN 0
END FUNCTION

FUNCTION NetDiscovery.Discover(systemTable AS UEFI.SystemTable) AS U32
    MEMORY.Write32(NetDiscoveryCountAddress(), 0)
    LET count AS U32 = 0
    LET bus AS U32 = 0
    WHILE bus < 256
        LET device AS U32 = 0
        WHILE device < 32
            LET func AS U32 = 0
            WHILE func < 8
                LET vendorDevice AS U32 = NetDiscoveryPciConfigReadU32(bus, device, func, 0)
                LET vendorId AS U32 = vendorDevice AND 65535
                IF vendorId <> 65535 THEN
                    LET classReg AS U32 = NetDiscoveryPciConfigReadU32(bus, device, func, 8)
                    LET baseClass AS U32 = (classReg SHR 24) AND 255
                    IF baseClass = 2 THEN
                        IF count < NetDiscoveryMaxDevices() THEN
                            LET deviceId AS U32 = (vendorDevice SHR 16) AND 65535
                            LET subclass AS U32 = (classReg SHR 16) AND 255
                            LET progIf AS U32 = (classReg SHR 8) AND 255
                            NetDiscoveryWriteEntry(count, bus, device, func, vendorId, deviceId, baseClass, subclass, progIf)
                            count = count + 1
                            MEMORY.Write32(NetDiscoveryCountAddress(), count)
                        END IF
                    END IF
                END IF
                func = func + 1
            WEND
            device = device + 1
        WEND
        bus = bus + 1
    WEND
    RETURN count
END FUNCTION

FUNCTION NetDiscoveryVendorCode(vendorId AS U32) AS U32
    IF vendorId = 6900 THEN
        RETURN 1
    END IF
    IF vendorId = 32902 THEN
        RETURN 2
    END IF
    IF vendorId = 5348 THEN
        RETURN 3
    END IF
    RETURN 0
END FUNCTION

FUNCTION SerialByte(value AS U8) AS U64
    LET port AS IOPORT = PORT.Address(1016)
    PORT.WriteByte(port, value)
    RETURN 0
END FUNCTION

FUNCTION SerialDecimalScratchAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(61870080))   ' 0x3B01000, clear of NetDiscoveryStateAddress's own region
END FUNCTION

FUNCTION SerialWriteDecimal(value AS U64) AS U64
    IF value = 0 THEN
        SerialByte(48)
        RETURN 0
    END IF
    LET dest AS MMIOPTR = SerialDecimalScratchAddress()
    LET v AS U64 = value
    LET count AS U64 = 0
    WHILE v > 0
        LET digit AS U64 = v MOD 10
        LET digitByte AS U8 = digit + 48
        MEMORY.Write8(ADDRESS.Offset(dest, count), digitByte)
        v = v \ 10
        count = count + 1
    WEND
    LET lo AS U64 = 0
    LET hi AS U64 = count - 1
    WHILE lo < hi
        LET a AS U8 = MEMORY.Read8(ADDRESS.Offset(dest, lo))
        LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(dest, hi))
        MEMORY.Write8(ADDRESS.Offset(dest, lo), b)
        MEMORY.Write8(ADDRESS.Offset(dest, hi), a)
        lo = lo + 1
        hi = hi - 1
    WEND
    LET i AS U64 = 0
    WHILE i < count
        SerialByte(MEMORY.Read8(ADDRESS.Offset(dest, i)))
        i = i + 1
    WEND
    RETURN 0
END FUNCTION

FUNCTION SerialWriteVendorLabel(code AS U32) AS U64
    IF code = 1 THEN
        SerialByte(86)
        SerialByte(73)
        SerialByte(82)
        SerialByte(84)
        SerialByte(73)
        SerialByte(79)
        RETURN 0
    END IF
    IF code = 2 THEN
        SerialByte(73)
        SerialByte(78)
        SerialByte(84)
        SerialByte(69)
        SerialByte(76)
        RETURN 0
    END IF
    IF code = 3 THEN
        SerialByte(82)
        SerialByte(84)
        SerialByte(76)
        RETURN 0
    END IF
    SerialByte(85)
    SerialByte(78)
    SerialByte(75)
    SerialByte(78)
    SerialByte(79)
    SerialByte(87)
    SerialByte(78)
    RETURN 0
END FUNCTION

FUNCTION ReportEntry(index AS U32) AS U64
    LET addr AS MMIOPTR = NetDiscoveryEntryAddress(index)
    LET bus AS U32 = MEMORY.Read32(addr)
    LET device AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 4))
    LET func AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 8))
    LET vendorId AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 12))
    LET deviceId AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 16))
    LET baseClass AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 20))
    LET subclass AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 24))
    LET progIf AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 28))

    SerialByte(78)
    SerialByte(69)
    SerialByte(84)
    SerialByte(32)
    SerialWriteDecimal(index)
    SerialByte(58)
    SerialByte(32)

    SerialByte(66)
    SerialByte(85)
    SerialByte(83)
    SerialByte(61)
    SerialWriteDecimal(bus)
    SerialByte(32)
    SerialByte(68)
    SerialByte(69)
    SerialByte(86)
    SerialByte(61)
    SerialWriteDecimal(device)
    SerialByte(32)
    SerialByte(70)
    SerialByte(78)
    SerialByte(61)
    SerialWriteDecimal(func)
    SerialByte(32)

    SerialByte(86)
    SerialByte(73)
    SerialByte(68)
    SerialByte(61)
    SerialWriteDecimal(vendorId)
    SerialByte(32)
    SerialByte(68)
    SerialByte(73)
    SerialByte(68)
    SerialByte(61)
    SerialWriteDecimal(deviceId)
    SerialByte(32)

    SerialByte(67)
    SerialByte(76)
    SerialByte(83)
    SerialByte(61)
    SerialWriteDecimal(baseClass)
    SerialByte(47)
    SerialWriteDecimal(subclass)
    SerialByte(47)
    SerialWriteDecimal(progIf)
    SerialByte(32)

    SerialByte(86)
    SerialByte(69)
    SerialByte(78)
    SerialByte(68)
    SerialByte(79)
    SerialByte(82)
    SerialByte(61)
    LET vendorCode AS U32 = NetDiscoveryVendorCode(vendorId)
    SerialWriteVendorLabel(vendorCode)
    SerialByte(13)
    SerialByte(10)

    LET barIndex AS U32 = 0
    WHILE barIndex < 6
        SerialByte(32)
        SerialByte(32)
        SerialByte(66)
        SerialByte(65)
        SerialByte(82)
        SerialWriteDecimal(barIndex)
        SerialByte(61)
        LET barValue AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 32 + (barIndex * 4)))
        SerialWriteDecimal(barValue)
        SerialByte(13)
        SerialByte(10)
        barIndex = barIndex + 1
    WEND
    RETURN 0
END FUNCTION

FUNCTION Main(imageHandle AS UEFI.Handle, systemTable AS UEFI.SystemTable) AS U64
    systemTable.BootServices.SetWatchdogTimer(0, 0, 0, 0)
    SerialByte(80)
    SerialByte(82)
    SerialByte(69)
    SerialByte(13)
    SerialByte(10)

    LET count AS U32 = NetDiscovery.Discover(systemTable)

    SerialByte(67)
    SerialByte(79)
    SerialByte(85)
    SerialByte(78)
    SerialByte(84)
    SerialByte(61)
    SerialWriteDecimal(count)
    SerialByte(13)
    SerialByte(10)

    LET i AS U32 = 0
    WHILE i < count
        ReportEntry(i)
        i = i + 1
    WEND

    SerialByte(68)
    SerialByte(79)
    SerialByte(78)
    SerialByte(69)
    SerialByte(13)
    SerialByte(10)

    CPU.HaltForever
    RETURN 0
END FUNCTION
