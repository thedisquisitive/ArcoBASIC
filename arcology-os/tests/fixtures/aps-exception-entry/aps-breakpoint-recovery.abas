#PROFILE UEFI
#TARGET X86_64
#RUNTIME NONE
#CALLCONV UEFI

' APS breakpoint-recovery proof. Builds the same CR3-cutover identity-mapped hierarchy as
' tests/fixtures/aps-cr3-cutover/aps-cr3-cutover.abas, then -- under the APS-owned address space,
' post-ExitBootServices -- installs an IDT whose gates address the compiler-synthesized
' exception-entry table (.agents/reports/aps-exception-entry-stub.md), executes a deliberate
' CPU.Breakpoint, and proves the CPU actually resumes past it rather than hanging or resetting.
' Success is observable only through the serial markers below: nothing after "APS BP TEST START"
' prints unless the exception-entry stub's vector-3 (#BP) recovery path is genuinely correct end
' to end on a real CPU, not just in the encoder-level and reveal-level tests that exercise the
' generated bytes without ever executing them.
'
' Deliberately does not replace the firmware GDT or load a TSS: an IDT gate with IST=0 (used here)
' never consults the TSS at all, and building a *replacement* GDT safely still needs a CS reload
' this backend cannot do yet (aps-owned-gdt.md's "Segment-selector reload" gate). The gates below
' instead reference CPU.ReadCS() -- the code selector the firmware already loaded, and which stays
' valid and unchanged for the lifetime of this proof.

FUNCTION SerialByte(value AS U8) AS U64
    LET port AS IOPORT = PORT.Address(1016)
    LET statusPort AS IOPORT = PORT.Offset(port, 5)
    LET attempts AS U32 = 0
    WHILE (PORT.ReadByte(statusPort) AND 32) = 0
        CPU.Pause
        attempts = attempts + 1
        IF attempts >= 10000 THEN
            RETURN 1
        END IF
    WEND
    PORT.WriteByte(port, value)
    RETURN 0
END FUNCTION

FUNCTION SerialInit() AS U64
    LET base AS IOPORT = PORT.Address(1016)
    PORT.WriteByte(PORT.Offset(base, 1), 0)
    PORT.WriteByte(PORT.Offset(base, 3), 128)
    PORT.WriteByte(base, 1)
    PORT.WriteByte(PORT.Offset(base, 1), 0)
    PORT.WriteByte(PORT.Offset(base, 3), 3)
    PORT.WriteByte(PORT.Offset(base, 2), 199)
    PORT.WriteByte(PORT.Offset(base, 4), 11)
    RETURN 0
END FUNCTION

' "APS BP TEST START\r\n" -- printed once, immediately before the IDT is built. If nothing after
' this line ever appears, the run hung or reset before (or during) descriptor-table setup.
FUNCTION SerialMarkerStart() AS U64
    SerialByte(65)
    SerialByte(80)
    SerialByte(83)
    SerialByte(32)
    SerialByte(66)
    SerialByte(80)
    SerialByte(32)
    SerialByte(84)
    SerialByte(69)
    SerialByte(83)
    SerialByte(84)
    SerialByte(32)
    SerialByte(83)
    SerialByte(84)
    SerialByte(65)
    SerialByte(82)
    SerialByte(84)
    SerialByte(13)
    SerialByte(10)
    RETURN 0
END FUNCTION

' "APS IDT LOADED\r\n" -- printed after LIDT executes successfully.
FUNCTION SerialMarkerIDT() AS U64
    SerialByte(65)
    SerialByte(80)
    SerialByte(83)
    SerialByte(32)
    SerialByte(73)
    SerialByte(68)
    SerialByte(84)
    SerialByte(32)
    SerialByte(76)
    SerialByte(79)
    SerialByte(65)
    SerialByte(68)
    SerialByte(69)
    SerialByte(68)
    SerialByte(13)
    SerialByte(10)
    RETURN 0
END FUNCTION

' "APS BP RECOVERED\r\n" -- the actual proof. Only reachable if CPU.Breakpoint's INT3 vectored
' through this table's vector-3 stub, the shared handler recognized it, and IRETQ genuinely
' resumed execution at the instruction right after CPU.Breakpoint -- including the CALL into this
' very function, which a resume off by even one byte would corrupt (see aps-exception-entry-stub.md's
' fix note on this table's IRETQ resume address).
FUNCTION SerialMarkerRecovered() AS U64
    SerialByte(65)
    SerialByte(80)
    SerialByte(83)
    SerialByte(32)
    SerialByte(66)
    SerialByte(80)
    SerialByte(32)
    SerialByte(82)
    SerialByte(69)
    SerialByte(67)
    SerialByte(79)
    SerialByte(86)
    SerialByte(69)
    SerialByte(82)
    SerialByte(69)
    SerialByte(68)
    SerialByte(13)
    SerialByte(10)
    RETURN 0
END FUNCTION

' Mirrors stdlib/descriptor_table_policy.abas's IDTWriteInterruptGate/BuildMinimalIDT (inlined --
' this build takes a single source file). See that file's comments for why codeSelector is
' caller-supplied rather than a hardcoded constant.
FUNCTION IDTWriteInterruptGate(table AS MMIOPTR, index AS U32, handler AS U64, codeSelector AS U16, ist AS U8) AS BOOL
    LET gate AS MMIOPTR = ADDRESS.Offset(table, index * 16)
    MEMORY.Write16(gate, handler AND 65535)
    MEMORY.Write16(ADDRESS.Offset(gate, 2), codeSelector)
    MEMORY.Write8(ADDRESS.Offset(gate, 4), ist AND 7)
    MEMORY.Write8(ADDRESS.Offset(gate, 5), 142)
    MEMORY.Write16(ADDRESS.Offset(gate, 6), (handler SHR 16) AND 65535)
    MEMORY.Write32(ADDRESS.Offset(gate, 8), (handler SHR 32) AND 4294967295)
    MEMORY.Write32(ADDRESS.Offset(gate, 12), 0)
    RETURN 1
END FUNCTION

FUNCTION BuildMinimalIDT(table AS MMIOPTR, pseudoDescriptor AS MMIOPTR, codeSelector AS U16) AS BOOL
    LET index AS U32 = 0
    WHILE index < 256
        LET gate AS MMIOPTR = ADDRESS.Offset(table, index * 16)
        MEMORY.Write64(gate, 0)
        MEMORY.Write64(ADDRESS.Offset(gate, 8), 0)
        index = index + 1
    WEND
    LET entry AS U64 = CPU.ExceptionVectorTableBase()
    LET vector AS U32 = 0
    WHILE vector < 32
        LET ist AS U8 = 0
        IF vector = 8 THEN ist = 1
        IDTWriteInterruptGate(table, vector, entry, codeSelector, ist)
        entry = entry + 16
        vector = vector + 1
    WEND
    MEMORY.Write16(ADDRESS.Offset(pseudoDescriptor, 0), 4095)
    MEMORY.Write64(ADDRESS.Offset(pseudoDescriptor, 2), ADDRESS.Value(table))
    RETURN 1
END FUNCTION

FUNCTION AcquireMapAndExit(imageHandle AS UEFI.Handle, systemTable AS UEFI.SystemTable) AS U64
    LET mapSize AS U64 = 0
    LET mapSizeAddress AS PTR = ADDRESS.Local(mapSize)
    LET probe AS U64 = systemTable.BootServices.GetMemoryMap(mapSizeAddress, 0, 0, 0, 0)
    IF mapSize = 0 THEN
        RETURN 1
    END IF
    LET allocationSize AS U64 = mapSize + 65536
    LET buffer AS U64 = 0
    LET bufferAddress AS PTR = ADDRESS.Local(buffer)
    LET allocate AS U64 = systemTable.BootServices.AllocatePool(2, allocationSize, bufferAddress)
    IF allocate <> 0 THEN
        RETURN 1
    END IF
    ' GetMemoryMap's MemoryMapSize is IN/OUT: the caller must set it to the size of the buffer
    ' actually being passed before this second call, not leave it at the smaller size the first
    ' (buffer-less) probe call reported. Leaving it at the old probed value under-reports the real
    ' buffer size and can spuriously fail with EFI_BUFFER_TOO_SMALL if the live map has grown at
    ' all since the probe -- which it routinely has, including from the AllocatePool call just
    ' above.
    mapSize = allocationSize
    LET mapKey AS U64 = 0
    LET mapKeyAddress AS PTR = ADDRESS.Local(mapKey)
    LET descriptorSize AS U64 = 0
    LET descriptorSizeAddress AS PTR = ADDRESS.Local(descriptorSize)
    LET descriptorVersion AS U32 = 0
    LET descriptorVersionAddress AS PTR = ADDRESS.Local(descriptorVersion)
    LET status AS U64 = systemTable.BootServices.GetMemoryMap(mapSizeAddress, buffer, mapKeyAddress, descriptorSizeAddress, descriptorVersionAddress)
    IF status <> 0 THEN
        systemTable.BootServices.FreePool(buffer)
        RETURN 1
    END IF
    IF descriptorSize < 48 THEN
        systemTable.BootServices.FreePool(buffer)
        RETURN 1
    END IF
    RETURN systemTable.BootServices.ExitBootServices(imageHandle, mapKey)
END FUNCTION

FUNCTION Main(imageHandle AS UEFI.Handle, systemTable AS UEFI.SystemTable) AS U64
    systemTable.BootServices.SetWatchdogTimer(0, 0, 0, 0)
    systemTable.ConsoleOut.Write("APS PRE")

    ' Allocate physically contiguous, page-aligned table storage through the firmware handoff ABI:
    ' 3 pages for the identity-map root/PDPT/page-directory, 2 pages for the IDT (exactly 4096
    ' bytes for 256 16-byte gates) plus its 16-byte LIDT pseudo-descriptor.
    LET root AS U64 = 0
    LET rootAddress AS PTR = ADDRESS.Local(root)
    LET pageStatus AS U64 = systemTable.BootServices.AllocatePages(0, 2, 3, rootAddress)
    IF pageStatus <> 0 THEN
        systemTable.ConsoleOut.Write("APS ALLOC FAIL")
        CPU.HaltForever
    END IF
    LET idtRoot AS U64 = 0
    LET idtRootAddress AS PTR = ADDRESS.Local(idtRoot)
    LET idtPageStatus AS U64 = systemTable.BootServices.AllocatePages(0, 2, 2, idtRootAddress)
    IF idtPageStatus <> 0 THEN
        systemTable.ConsoleOut.Write("APS IDT ALLOC FAIL")
        CPU.HaltForever
    END IF
    systemTable.ConsoleOut.Write("APS PAGE")
    LET pdpt AS U64 = root + 4096
    LET pageDirectory AS U64 = root + 8192

    ' Clear the root and PDPT through the explicit physical bootstrap access mechanism.
    LET clearIndex AS U64 = 0
    WHILE clearIndex < 1536
        MEMORY.PhysicalWrite64(ADDRESS.Physical(root + (clearIndex * 8)), 0)
        clearIndex = clearIndex + 1
    WEND
    MEMORY.PhysicalWrite64(ADDRESS.Physical(root), pdpt OR 3)
    MEMORY.PhysicalWrite64(ADDRESS.Physical(pdpt), pageDirectory OR 3)
    ' Conservative 2 MiB identity leaves cover the first 1 GiB, including this image, its stack,
    ' and the IDT/pseudo-descriptor pages just reserved.
    LET directoryIndex AS U64 = 0
    WHILE directoryIndex < 512
        MEMORY.PhysicalWrite64(ADDRESS.Physical(pageDirectory + (directoryIndex * 8)), (directoryIndex * 2097152) OR 131)
        directoryIndex = directoryIndex + 1
    WEND
    LET rootCheck AS U64 = MEMORY.Read64(ADDRESS.Virtual(root))
    LET pdptCheck AS U64 = MEMORY.Read64(ADDRESS.Virtual(pdpt))
    IF rootCheck <> (pdpt OR 3) THEN
        systemTable.ConsoleOut.Write("APS ROOT BAD")
        CPU.HaltForever
    END IF
    IF pdptCheck <> (pageDirectory OR 3) THEN
        systemTable.ConsoleOut.Write("APS PDPT BAD")
        CPU.HaltForever
    END IF
    systemTable.ConsoleOut.Write("APS TABLE OK")

    ' Mask firmware timer interrupts before the ownership boundary; the IDT built below replaces
    ' them entirely once loaded.
    CPU.DisableInterrupts
    LET exitStatus AS U64 = AcquireMapAndExit(imageHandle, systemTable)
    IF exitStatus <> 0 THEN
        CPU.HaltForever
    END IF

    ' The next instruction executes under the APS-created identity hierarchy.
    CPU.DisableInterrupts
    CPU.WriteCR3(root)
    LET activeRoot AS U64 = CPU.ReadCR3()
    IF activeRoot <> root THEN
        CPU.HaltForever
    END IF
    ' Translation sanity check: this ordinary RAM write must succeed under the APS root.
    MEMORY.Write32(ADDRESS.Virtual(1048576), 2779096485)

    SerialInit()
    SerialMarkerStart()

    LET codeSelector AS U16 = CPU.ReadCS()
    LET idtTable AS MMIOPTR = ADDRESS.MMIO(ADDRESS.Virtual(idtRoot))
    LET idtPseudo AS MMIOPTR = ADDRESS.MMIO(ADDRESS.Virtual(idtRoot + 4096))
    BuildMinimalIDT(idtTable, idtPseudo, codeSelector)
    CPU.LoadIDT(ADDRESS.Value(idtPseudo))
    SerialMarkerIDT()

    ' The proof: a deliberate breakpoint. Everything from here on -- including the CALL into
    ' SerialMarkerRecovered itself -- only runs if the exception-entry stub's #BP recovery path
    ' genuinely resumed execution at the correct address.
    CPU.Breakpoint

    SerialMarkerRecovered()
    CPU.HaltForever
END FUNCTION
