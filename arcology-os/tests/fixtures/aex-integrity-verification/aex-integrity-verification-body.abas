' RFC-0046 AEX Phase 11 test body. This validates INTEGRITY chunks and proves a protected CODE
' chunk fails closed when its bytes or integrity metadata are mutated.

FUNCTION SerialByte(value AS U8) AS U64
    PORT.Write8(PORT.Address(1016), value)
    RETURN 0
END FUNCTION

FUNCTION SerialText(a AS U32, b AS U32, c AS U32, d AS U32, e AS U32) AS U64
    LET aByte AS U8 = a
    LET bByte AS U8 = b
    LET cByte AS U8 = c
    LET dByte AS U8 = d
    LET eByte AS U8 = e
    SerialByte(aByte)
    SerialByte(bByte)
    SerialByte(cByte)
    SerialByte(dByte)
    SerialByte(eByte)
    RETURN 0
END FUNCTION

FUNCTION AexPhase11SourceAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(62521344))   ' 0x3BA0000
END FUNCTION

FUNCTION AexPhase11FileLength() AS U64
    RETURN 752
END FUNCTION

FUNCTION AexPhase11Clear(base AS MMIOPTR, count AS U64) AS U64
    LET i AS U64 = 0
    WHILE i < count
        MEMORY.Write8(ADDRESS.Offset(base, i), 0)
        i = i + 1
    WEND
    RETURN 0
END FUNCTION

FUNCTION AexPhase11WriteMagic(base AS MMIOPTR) AS U64
    MEMORY.Write8(ADDRESS.Offset(base, 0), 65)
    MEMORY.Write8(ADDRESS.Offset(base, 1), 82)
    MEMORY.Write8(ADDRESS.Offset(base, 2), 67)
    MEMORY.Write8(ADDRESS.Offset(base, 3), 79)
    MEMORY.Write8(ADDRESS.Offset(base, 4), 65)
    MEMORY.Write8(ADDRESS.Offset(base, 5), 69)
    MEMORY.Write8(ADDRESS.Offset(base, 6), 88)
    MEMORY.Write8(ADDRESS.Offset(base, 7), 0)
    RETURN 0
END FUNCTION

FUNCTION AexPhase11WriteEntry(index AS U32, chunkID AS U32, typeHigh AS U64, typeLow AS U64, offset AS U64, length AS U64) AS U64
    LET index64 AS U64 = index
    LET entry AS MMIOPTR = ADDRESS.Offset(AexPhase11SourceAddress(), 64 + (index64 * 96))
    MEMORY.Write32(ADDRESS.Offset(entry, 0), chunkID)
    MEMORY.Write64(ADDRESS.Offset(entry, 4), typeHigh)
    MEMORY.Write64(ADDRESS.Offset(entry, 12), typeLow)
    MEMORY.Write32(ADDRESS.Offset(entry, 20), 1)
    MEMORY.Write64(ADDRESS.Offset(entry, 24), offset)
    MEMORY.Write64(ADDRESS.Offset(entry, 32), length)
    MEMORY.Write64(ADDRESS.Offset(entry, 40), length)
    MEMORY.Write32(ADDRESS.Offset(entry, 48), 8)
    MEMORY.Write32(ADDRESS.Offset(entry, 52), 0)
    RETURN 0
END FUNCTION

FUNCTION AexPhase11WriteHeaderAndDirectory() AS U64
    LET base AS MMIOPTR = AexPhase11SourceAddress()
    AexPhase11Clear(base, 1024)

    AexPhase11WriteMagic(base)
    MEMORY.Write32(ADDRESS.Offset(base, 8), 65536)
    MEMORY.Write32(ADDRESS.Offset(base, 12), 64)
    MEMORY.Write64(ADDRESS.Offset(base, 16), 1229782938247303441)
    MEMORY.Write64(ADDRESS.Offset(base, 24), 2459565876494606882)
    MEMORY.Write64(ADDRESS.Offset(base, 32), 64)
    MEMORY.Write32(ADDRESS.Offset(base, 40), 5)
    MEMORY.Write32(ADDRESS.Offset(base, 44), 1)
    MEMORY.Write32(ADDRESS.Offset(base, 48), 0)

    AexPhase11WriteEntry(0, 1, AexTypeManifestHigh(), AexTypeManifestLow(), 544, 80)
    AexPhase11WriteEntry(1, 2, AexTypeComponentHigh(), AexTypeComponentLow(), 624, 48)
    AexPhase11WriteEntry(2, 10, AexTypeImplementationHigh(), AexTypeImplementationLow(), 672, 40)
    AexPhase11WriteEntry(3, 20, AexTypeCodeHigh(), AexTypeCodeLow(), 712, 8)
    AexPhase11WriteEntry(4, 90, AexTypeIntegrityHigh(), AexTypeIntegrityLow(), 720, 32)
    RETURN 0
END FUNCTION

FUNCTION AexPhase11WriteIntegrity(offset AS U64, integrityID AS U32, coveredID AS U32, expected AS U32, coveredLength AS U64) AS U64
    LET data AS MMIOPTR = ADDRESS.Offset(AexPhase11SourceAddress(), offset)
    MEMORY.Write32(ADDRESS.Offset(data, 0), integrityID)
    MEMORY.Write32(ADDRESS.Offset(data, 4), AexIntegrityAlgorithmChecksum32())
    MEMORY.Write32(ADDRESS.Offset(data, 8), coveredID)
    MEMORY.Write32(ADDRESS.Offset(data, 12), expected)
    MEMORY.Write64(ADDRESS.Offset(data, 16), coveredLength)
    MEMORY.Write32(ADDRESS.Offset(data, 24), 0)
    MEMORY.Write32(ADDRESS.Offset(data, 28), 0)
    RETURN 0
END FUNCTION

FUNCTION AexPhase11WriteFixture() AS U64
    AexPhase11WriteHeaderAndDirectory()
    LET base AS MMIOPTR = AexPhase11SourceAddress()

    LET manifest AS MMIOPTR = ADDRESS.Offset(base, 544)
    MEMORY.Write64(ADDRESS.Offset(manifest, 0), 1229782938247303441)
    MEMORY.Write64(ADDRESS.Offset(manifest, 8), 2459565876494606882)
    MEMORY.Write32(ADDRESS.Offset(manifest, 16), 1)
    MEMORY.Write32(ADDRESS.Offset(manifest, 20), 0)
    MEMORY.Write32(ADDRESS.Offset(manifest, 24), 0)
    MEMORY.Write64(ADDRESS.Offset(manifest, 28), 3689348814741910323)
    MEMORY.Write64(ADDRESS.Offset(manifest, 36), 4919131752989213764)
    MEMORY.Write32(ADDRESS.Offset(manifest, 44), 1)
    MEMORY.Write32(ADDRESS.Offset(manifest, 48), 0)
    MEMORY.Write32(ADDRESS.Offset(manifest, 52), 1)
    MEMORY.Write32(ADDRESS.Offset(manifest, 56), 0)
    MEMORY.Write32(ADDRESS.Offset(manifest, 60), 2)
    MEMORY.Write32(ADDRESS.Offset(manifest, 64), 1)
    MEMORY.Write32(ADDRESS.Offset(manifest, 68), 0)
    MEMORY.Write32(ADDRESS.Offset(manifest, 72), 0)
    MEMORY.Write32(ADDRESS.Offset(manifest, 76), 2)

    LET component AS MMIOPTR = ADDRESS.Offset(base, 624)
    MEMORY.Write32(ADDRESS.Offset(component, 0), 2)
    MEMORY.Write64(ADDRESS.Offset(component, 4), 1229782938247303441)
    MEMORY.Write64(ADDRESS.Offset(component, 12), 2459565876494606882)
    MEMORY.Write32(ADDRESS.Offset(component, 20), 1)
    MEMORY.Write32(ADDRESS.Offset(component, 24), 0)
    MEMORY.Write32(ADDRESS.Offset(component, 28), 1)
    MEMORY.Write32(ADDRESS.Offset(component, 32), 0)
    MEMORY.Write32(ADDRESS.Offset(component, 36), 0)
    MEMORY.Write32(ADDRESS.Offset(component, 40), 0)
    MEMORY.Write32(ADDRESS.Offset(component, 44), 10)

    LET impl AS MMIOPTR = ADDRESS.Offset(base, 672)
    MEMORY.Write32(ADDRESS.Offset(impl, 0), 2)
    MEMORY.Write32(ADDRESS.Offset(impl, 4), AexImplTypeNative())
    MEMORY.Write32(ADDRESS.Offset(impl, 8), AexArchX86_64())
    MEMORY.Write32(ADDRESS.Offset(impl, 12), AexAbiNativeMajorCurrent())
    MEMORY.Write32(ADDRESS.Offset(impl, 16), AexAbiNativeMinorCurrent())
    MEMORY.Write64(ADDRESS.Offset(impl, 20), 0)
    MEMORY.Write32(ADDRESS.Offset(impl, 28), 7)
    MEMORY.Write32(ADDRESS.Offset(impl, 32), 20)
    MEMORY.Write32(ADDRESS.Offset(impl, 36), 0)

    MEMORY.Write8(ADDRESS.Offset(base, 712), 1)
    MEMORY.Write8(ADDRESS.Offset(base, 713), 2)
    MEMORY.Write8(ADDRESS.Offset(base, 714), 3)
    MEMORY.Write8(ADDRESS.Offset(base, 715), 4)
    MEMORY.Write8(ADDRESS.Offset(base, 716), 5)
    MEMORY.Write8(ADDRESS.Offset(base, 717), 6)
    MEMORY.Write8(ADDRESS.Offset(base, 718), 7)
    MEMORY.Write8(ADDRESS.Offset(base, 719), 8)

    AexPhase11WriteIntegrity(720, 90, 20, 36, 8)
    RETURN 0
END FUNCTION

FUNCTION RunValidIntegrity() AS BOOL
    AexPhase11WriteFixture()
    IF AEX.ValidateHeader(AexPhase11SourceAddress(), AexPhase11FileLength()) <> 0 THEN
        RETURN 0
    END IF
    IF AEX.ValidateDirectory(AexPhase11SourceAddress(), AexPhase11FileLength()) <> 0 THEN
        RETURN 0
    END IF
    IF AEX.ValidateManifest(AexPhase11SourceAddress(), AexPhase11FileLength()) <> 0 THEN
        RETURN 0
    END IF
    IF AEX.VerifyIntegrity(AexPhase11SourceAddress(), AexPhase11FileLength()) <> 0 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunCodeTamper() AS BOOL
    AexPhase11WriteFixture()
    MEMORY.Write8(ADDRESS.Offset(AexPhase11SourceAddress(), 719), 9)
    IF AEX.VerifyIntegrity(AexPhase11SourceAddress(), AexPhase11FileLength()) <> AexErrorIntegrityMismatch() THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunIntegrityMissing() AS BOOL
    AexPhase11WriteFixture()
    AexPhase11WriteEntry(4, 90, AexTypeDataHigh(), AexTypeDataLow(), 720, 32)
    IF AEX.VerifyIntegrity(AexPhase11SourceAddress(), AexPhase11FileLength()) <> AexErrorIntegrityMissing() THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunIntegrityTooShort() AS BOOL
    AexPhase11WriteFixture()
    AexPhase11WriteEntry(4, 90, AexTypeIntegrityHigh(), AexTypeIntegrityLow(), 720, 28)
    IF AEX.VerifyIntegrity(AexPhase11SourceAddress(), AexPhase11FileLength()) <> AexErrorIntegrityOutOfBounds() THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunIntegrityBadAlgorithm() AS BOOL
    AexPhase11WriteFixture()
    MEMORY.Write32(ADDRESS.Offset(AexPhase11SourceAddress(), 724), 99)
    IF AEX.VerifyIntegrity(AexPhase11SourceAddress(), AexPhase11FileLength()) <> AexErrorIntegrityInvalid() THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunIntegrityCoveredMissing() AS BOOL
    AexPhase11WriteFixture()
    MEMORY.Write32(ADDRESS.Offset(AexPhase11SourceAddress(), 728), 99)
    IF AEX.VerifyIntegrity(AexPhase11SourceAddress(), AexPhase11FileLength()) <> AexErrorIntegrityInvalid() THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunIntegrityLengthMismatch() AS BOOL
    AexPhase11WriteFixture()
    MEMORY.Write64(ADDRESS.Offset(AexPhase11SourceAddress(), 736), 7)
    IF AEX.VerifyIntegrity(AexPhase11SourceAddress(), AexPhase11FileLength()) <> AexErrorIntegrityInvalid() THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION ReportCase(label0 AS U32, label1 AS U32, label2 AS U32, label3 AS U32, label4 AS U32, ok AS BOOL) AS U64
    SerialText(label0, label1, label2, label3, label4)
    IF ok = 1 THEN
        SerialByte(58)
        SerialByte(32)
        SerialByte(80)
        SerialByte(65)
        SerialByte(83)
        SerialByte(83)
    ELSE
        SerialByte(58)
        SerialByte(32)
        SerialByte(70)
        SerialByte(65)
        SerialByte(73)
        SerialByte(76)
    END IF
    SerialByte(13)
    SerialByte(10)
    RETURN 0
END FUNCTION

FUNCTION Main(imageHandle AS UEFI.Handle, systemTable AS UEFI.SystemTable) AS U64
    systemTable.BootServices.SetWatchdogTimer(0, 0, 0, 0)
    SerialByte(80)
    SerialByte(82)
    SerialByte(69)
    SerialByte(13)
    SerialByte(10)

    LET testsPassed AS U32 = 0
    LET testsFailed AS U32 = 0

    LET ValidOk AS BOOL = RunValidIntegrity()
    ReportCase(73, 78, 84, 71, 32, ValidOk)
    IF ValidOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET TamperOk AS BOOL = RunCodeTamper()
    ReportCase(84, 65, 77, 80, 32, TamperOk)
    IF TamperOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET MissingOk AS BOOL = RunIntegrityMissing()
    ReportCase(77, 73, 83, 83, 32, MissingOk)
    IF MissingOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET BoundsOk AS BOOL = RunIntegrityTooShort()
    ReportCase(66, 78, 68, 83, 32, BoundsOk)
    IF BoundsOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET AlgorithmOk AS BOOL = RunIntegrityBadAlgorithm()
    ReportCase(65, 76, 71, 79, 32, AlgorithmOk)
    IF AlgorithmOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET CoveredOk AS BOOL = RunIntegrityCoveredMissing()
    ReportCase(67, 79, 86, 82, 32, CoveredOk)
    IF CoveredOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET LengthOk AS BOOL = RunIntegrityLengthMismatch()
    ReportCase(76, 69, 78, 71, 32, LengthOk)
    IF LengthOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    SerialByte(68)
    SerialByte(79)
    SerialByte(78)
    SerialByte(69)
    SerialByte(32)
    IF testsFailed = 0 THEN
        SerialByte(65)
        SerialByte(76)
        SerialByte(76)
        SerialByte(80)
        SerialByte(65)
        SerialByte(83)
        SerialByte(83)
    ELSE
        SerialByte(83)
        SerialByte(79)
        SerialByte(77)
        SerialByte(69)
        SerialByte(70)
        SerialByte(65)
        SerialByte(73)
        SerialByte(76)
    END IF
    SerialByte(13)
    SerialByte(10)
    RETURN testsFailed
END FUNCTION
