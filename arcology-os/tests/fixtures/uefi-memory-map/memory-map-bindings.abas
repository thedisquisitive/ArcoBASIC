#PROFILE UEFI
#TARGET X86_64
#RUNTIME NONE
#CALLCONV UEFI

' Raw ABI binding proof. A typed bootstrap wrapper will replace the placeholder output pointers.
FUNCTION Main(systemTable AS UEFI.SystemTable) AS U64
    LET status AS U64 = systemTable.BootServices.GetMemoryMap(0, 0, 0, 0, 0)
    RETURN status
END FUNCTION
