' RFC-0046 AEX Phase 4 real test fixture -- loads real, byte-exact .aex test files (a
' MANIFEST chunk plus one COMPONENT chunk each) directly into scratch memory and runs
' AEX.ValidateHeader -> AEX.ValidateDirectory -> AEX.ValidateManifest against each,
' comparing the real returned manifest-validation error code to what each fixture is
' deliberately malformed (or not) to produce. In-memory only for Phase 4's own real
' scope -- ArcFS-backed loading is Phase 6, a real, separate, later increment.

#PROFILE UEFI
#TARGET X86_64
#RUNTIME NONE

FUNCTION AexHeaderSize() AS U32
    RETURN 64
END FUNCTION
FUNCTION AexDirectoryEntryStride() AS U32
    RETURN 96
END FUNCTION
FUNCTION AexFormatMajorCurrent() AS U32
    RETURN 1
END FUNCTION
FUNCTION AexFormatMinorCurrent() AS U32
    RETURN 0
END FUNCTION
FUNCTION AexU64Max() AS U64
    RETURN 18446744073709551615
END FUNCTION

' ==========================================================================================
' Bootstrap header: magic check and field readers
' ==========================================================================================

FUNCTION AexCheckMagic(buffer AS MMIOPTR) AS BOOL
    ' "ARCOAEX\0"
    IF MEMORY.Read8(buffer) <> 65 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 1)) <> 82 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 2)) <> 67 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 3)) <> 79 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 4)) <> 65 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 5)) <> 69 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 6)) <> 88 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 7)) <> 0 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION AexReadFormatVersion(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 8))
END FUNCTION
FUNCTION AexFormatMajorOf(version AS U32) AS U32
    RETURN version SHR 16
END FUNCTION
FUNCTION AexFormatMinorOf(version AS U32) AS U32
    RETURN version AND 65535
END FUNCTION
FUNCTION AexReadHeaderSize(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 12))
END FUNCTION
FUNCTION AexReadAssemblyIDHigh(buffer AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(buffer, 16))
END FUNCTION
FUNCTION AexReadAssemblyIDLow(buffer AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(buffer, 24))
END FUNCTION
FUNCTION AexReadDirectoryOffset(buffer AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(buffer, 32))
END FUNCTION
FUNCTION AexReadDirectoryCount(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 40))
END FUNCTION
FUNCTION AexReadRootManifestID(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 44))
END FUNCTION
FUNCTION AexReadHeaderFlags(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 48))
END FUNCTION

' ==========================================================================================
' Real loader error classes (Section 38's own spirit: deterministic, specific, not a bare
' boolean). 0 always means success.
' ==========================================================================================

FUNCTION AexErrorOk() AS U32
    RETURN 0
END FUNCTION
FUNCTION AexErrorBadMagic() AS U32
    RETURN 1
END FUNCTION
FUNCTION AexErrorUnsupportedFormatVersion() AS U32
    RETURN 2
END FUNCTION
FUNCTION AexErrorBadHeaderSize() AS U32
    RETURN 3
END FUNCTION
FUNCTION AexErrorDirectoryOutOfBounds() AS U32
    RETURN 4
END FUNCTION
FUNCTION AexErrorChunkOutOfBounds() AS U32
    RETURN 5
END FUNCTION
FUNCTION AexErrorUnknownRequiredChunkType() AS U32
    RETURN 6
END FUNCTION
FUNCTION AexErrorBadAlignment() AS U32
    RETURN 7
END FUNCTION

' Phase 2: Bootstrap header validation. Checks magic, format compatibility, declared header
' size, and that the chunk directory itself (offset + count*stride) fits within the real file
' length -- all before a single byte of the directory or any chunk is trusted. fileLength is the
' real, independently-known size of the loaded buffer (never taken from inside the file itself).
FUNCTION AEX.ValidateHeader(buffer AS MMIOPTR, fileLength AS U64) AS U32
    IF AexCheckMagic(buffer) = 0 THEN
        RETURN AexErrorBadMagic()
    END IF

    LET version AS U32 = AexReadFormatVersion(buffer)
    IF AexFormatMajorOf(version) <> AexFormatMajorCurrent() THEN
        RETURN AexErrorUnsupportedFormatVersion()
    END IF

    LET headerSize AS U32 = AexReadHeaderSize(buffer)
    IF headerSize <> AexHeaderSize() THEN
        RETURN AexErrorBadHeaderSize()
    END IF
    LET headerSizeAsU64 AS U64 = headerSize
    IF fileLength < headerSizeAsU64 THEN
        RETURN AexErrorBadHeaderSize()
    END IF

    LET dirOffset AS U64 = AexReadDirectoryOffset(buffer)
    LET dirCount AS U32 = AexReadDirectoryCount(buffer)
    LET dirCountAsU64 AS U64 = dirCount
    LET strideAsU64 AS U64 = AexDirectoryEntryStride()

    ' Real overflow-safe bounds check: dirOffset + dirCount*stride must not wrap, and must fit
    ' within fileLength -- the same "check before adding" discipline this project's own Physical
    ' Region Database allocator already established (RegionEnd's own overflow guard).
    IF dirCountAsU64 > 0 THEN
        IF strideAsU64 > (AexU64Max() \ dirCountAsU64) THEN
            RETURN AexErrorDirectoryOutOfBounds()
        END IF
    END IF
    LET dirByteLength AS U64 = dirCountAsU64 * strideAsU64
    IF dirOffset > AexU64Max() - dirByteLength THEN
        RETURN AexErrorDirectoryOutOfBounds()
    END IF
    LET dirEnd AS U64 = dirOffset + dirByteLength
    IF dirEnd > fileLength THEN
        RETURN AexErrorDirectoryOutOfBounds()
    END IF
    IF dirOffset < headerSizeAsU64 THEN
        RETURN AexErrorDirectoryOutOfBounds()
    END IF

    RETURN AexErrorOk()
END FUNCTION

' ==========================================================================================
' Chunk directory entries
' ==========================================================================================

FUNCTION AexDirectoryEntryAddress(buffer AS MMIOPTR, dirOffset AS U64, index AS U32) AS MMIOPTR
    LET indexAsU64 AS U64 = index
    LET strideAsU64 AS U64 = AexDirectoryEntryStride()
    RETURN ADDRESS.Offset(buffer, dirOffset + (indexAsU64 * strideAsU64))
END FUNCTION

FUNCTION AexReadEntryChunkID(entry AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(entry)
END FUNCTION
FUNCTION AexReadEntryTypeHigh(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 4))
END FUNCTION
FUNCTION AexReadEntryTypeLow(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 12))
END FUNCTION
FUNCTION AexReadEntryFlags(entry AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(entry, 20))
END FUNCTION
FUNCTION AexReadEntryOffset(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 24))
END FUNCTION
FUNCTION AexReadEntryStoredLength(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 32))
END FUNCTION
FUNCTION AexReadEntryLogicalLength(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 40))
END FUNCTION
FUNCTION AexReadEntryAlignment(entry AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(entry, 48))
END FUNCTION
FUNCTION AexReadEntryEncoding(entry AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(entry, 52))
END FUNCTION
FUNCTION AexEntryIsRequired(entry AS MMIOPTR) AS BOOL
    LET entryFlags AS U32 = AexReadEntryFlags(entry)
    IF (entryFlags AND 1) <> 0 THEN
        RETURN 1
    END IF
    RETURN 0
END FUNCTION

' ==========================================================================================
' Standard AEX v1 chunk type identifiers (Section 11), real name-based UUIDv5 values --
' reproducible, not arbitrary: uuid.uuid5(NAMESPACE, "<TYPE NAME>") against a fixed, documented
' namespace UUID (6f5a2b3c-6e91-4f7a-9b3d-1a2c4e5f6081), computed once offline. Section 10.1
' explicitly requires a "large, collision-resistant namespace" and rules out a small enum as the
' sole mechanism -- this is that namespace, not a placeholder.
' ==========================================================================================

FUNCTION AexTypeManifestHigh() AS U64
    RETURN 14719843082355629295
END FUNCTION
FUNCTION AexTypeManifestLow() AS U64
    RETURN 9271930309043522079
END FUNCTION
FUNCTION AexTypeComponentHigh() AS U64
    RETURN 17360645306394565346
END FUNCTION
FUNCTION AexTypeComponentLow() AS U64
    RETURN 10985166509681775976
END FUNCTION
FUNCTION AexTypeImplementationHigh() AS U64
    RETURN 7866732109378180226
END FUNCTION
FUNCTION AexTypeImplementationLow() AS U64
    RETURN 11707123199072077656
END FUNCTION
FUNCTION AexTypeCodeHigh() AS U64
    RETURN 859404424522585693
END FUNCTION
FUNCTION AexTypeCodeLow() AS U64
    RETURN 12635621945936320080
END FUNCTION
FUNCTION AexTypeDataHigh() AS U64
    RETURN 3615471906802654651
END FUNCTION
FUNCTION AexTypeDataLow() AS U64
    RETURN 10345390336377140389
END FUNCTION
FUNCTION AexTypeResourceHigh() AS U64
    RETURN 5222799288954347266
END FUNCTION
FUNCTION AexTypeResourceLow() AS U64
    RETURN 13099566529540005749
END FUNCTION
FUNCTION AexTypeInterfaceHigh() AS U64
    RETURN 5188981897502022009
END FUNCTION
FUNCTION AexTypeInterfaceLow() AS U64
    RETURN 9356764828807109312
END FUNCTION
FUNCTION AexTypeRequirementHigh() AS U64
    RETURN 16336843977330678789
END FUNCTION
FUNCTION AexTypeRequirementLow() AS U64
    RETURN 12837214165910454027
END FUNCTION
FUNCTION AexTypeCapabilityRequestHigh() AS U64
    RETURN 12856951402654093542
END FUNCTION
FUNCTION AexTypeCapabilityRequestLow() AS U64
    RETURN 9717357363546278734
END FUNCTION
FUNCTION AexTypeArcoBindingHigh() AS U64
    RETURN 3383338636804706761
END FUNCTION
FUNCTION AexTypeArcoBindingLow() AS U64
    RETURN 10373826175911607214
END FUNCTION
FUNCTION AexTypeLifecycleHigh() AS U64
    RETURN 11836149854792734762
END FUNCTION
FUNCTION AexTypeLifecycleLow() AS U64
    RETURN 12071940426696027757
END FUNCTION
FUNCTION AexTypeMemoryPolicyHigh() AS U64
    RETURN 8487650950097361309
END FUNCTION
FUNCTION AexTypeMemoryPolicyLow() AS U64
    RETURN 10360956938434793214
END FUNCTION
FUNCTION AexTypeDiagnosticHigh() AS U64
    RETURN 17590739986515580581
END FUNCTION
FUNCTION AexTypeDiagnosticLow() AS U64
    RETURN 13035724507959637328
END FUNCTION
FUNCTION AexTypeSymbolHigh() AS U64
    RETURN 7765587605643352733
END FUNCTION
FUNCTION AexTypeSymbolLow() AS U64
    RETURN 12686448849480363835
END FUNCTION
FUNCTION AexTypeRecoveryHigh() AS U64
    RETURN 7906943963867533620
END FUNCTION
FUNCTION AexTypeRecoveryLow() AS U64
    RETURN 12296157333266628153
END FUNCTION
FUNCTION AexTypeIntegrityHigh() AS U64
    RETURN 5265016724168201421
END FUNCTION
FUNCTION AexTypeIntegrityLow() AS U64
    RETURN 11438856236987991108
END FUNCTION
FUNCTION AexTypeSignatureHigh() AS U64
    RETURN 2858157070238898764
END FUNCTION
FUNCTION AexTypeSignatureLow() AS U64
    RETURN 11055745981261010592
END FUNCTION

' Real membership test against every standard v1 chunk type. Deliberately a flat, repetitive
' chain of comparisons rather than a lookup table -- there is no array-of-records primitive on
' this backend cheap enough to justify one for a fixed 17-entry constant set, and a flat chain
' is trivially auditable against Section 11's own list, one line per type.
FUNCTION AexIsKnownChunkType(typeHigh AS U64, typeLow AS U64) AS BOOL
    IF typeHigh = AexTypeManifestHigh() THEN
        IF typeLow = AexTypeManifestLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeComponentHigh() THEN
        IF typeLow = AexTypeComponentLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeImplementationHigh() THEN
        IF typeLow = AexTypeImplementationLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeCodeHigh() THEN
        IF typeLow = AexTypeCodeLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeDataHigh() THEN
        IF typeLow = AexTypeDataLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeResourceHigh() THEN
        IF typeLow = AexTypeResourceLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeInterfaceHigh() THEN
        IF typeLow = AexTypeInterfaceLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeRequirementHigh() THEN
        IF typeLow = AexTypeRequirementLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeCapabilityRequestHigh() THEN
        IF typeLow = AexTypeCapabilityRequestLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeArcoBindingHigh() THEN
        IF typeLow = AexTypeArcoBindingLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeLifecycleHigh() THEN
        IF typeLow = AexTypeLifecycleLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeMemoryPolicyHigh() THEN
        IF typeLow = AexTypeMemoryPolicyLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeDiagnosticHigh() THEN
        IF typeLow = AexTypeDiagnosticLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeSymbolHigh() THEN
        IF typeLow = AexTypeSymbolLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeRecoveryHigh() THEN
        IF typeLow = AexTypeRecoveryLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeIntegrityHigh() THEN
        IF typeLow = AexTypeIntegrityLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeSignatureHigh() THEN
        IF typeLow = AexTypeSignatureLow() THEN
            RETURN 1
        END IF
    END IF
    RETURN 0
END FUNCTION

' Phase 3: Chunk directory validation (Section 10.3). For every entry: offset/storedLength must
' not overflow, offset+storedLength must fit within the file, alignment must be a real power of
' two the offset actually satisfies, and an unknown REQUIRED chunk type fails closed while an
' unknown OPTIONAL one is a real, deliberate no-op (Section 10.2). Assumes AEX.ValidateHeader
' already passed -- this function trusts dirOffset/dirCount only because that already happened.
FUNCTION AEX.ValidateDirectory(buffer AS MMIOPTR, fileLength AS U64) AS U32
    LET dirOffset AS U64 = AexReadDirectoryOffset(buffer)
    LET dirCount AS U32 = AexReadDirectoryCount(buffer)
    LET index AS U32 = 0

    WHILE index < dirCount
        LET entry AS MMIOPTR = AexDirectoryEntryAddress(buffer, dirOffset, index)
        LET chunkOffset AS U64 = AexReadEntryOffset(entry)
        LET storedLength AS U64 = AexReadEntryStoredLength(entry)
        LET alignment AS U32 = AexReadEntryAlignment(entry)

        IF chunkOffset > AexU64Max() - storedLength THEN
            RETURN AexErrorChunkOutOfBounds()
        END IF
        LET chunkEnd AS U64 = chunkOffset + storedLength
        IF chunkEnd > fileLength THEN
            RETURN AexErrorChunkOutOfBounds()
        END IF

        ' Alignment must be a real power of two (0 is treated as "no requirement", matching
        ' bytewise-anything storage) and the chunk's own offset must actually satisfy it.
        IF alignment > 1 THEN
            IF (alignment AND (alignment - 1)) <> 0 THEN
                RETURN AexErrorBadAlignment()
            END IF
            LET alignmentAsU64 AS U64 = alignment
            IF (chunkOffset MOD alignmentAsU64) <> 0 THEN
                RETURN AexErrorBadAlignment()
            END IF
        END IF

        LET required AS BOOL = AexEntryIsRequired(entry)
        IF required = 1 THEN
            LET typeHigh AS U64 = AexReadEntryTypeHigh(entry)
            LET typeLow AS U64 = AexReadEntryTypeLow(entry)
            IF AexIsKnownChunkType(typeHigh, typeLow) = 0 THEN
                RETURN AexErrorUnknownRequiredChunkType()
            END IF
        END IF

        index = index + 1
    WEND

    RETURN AexErrorOk()
END FUNCTION

' Real chunk lookup by ChunkID (used to resolve RootManifestID from the header into an actual
' directory entry). Returns AexDirectoryEntryStride()-sentinel... no -- returns the real found
' entry address, or the buffer's own base address is never a valid "not found" sentinel, so a
' separate BOOL out-of-band signal is needed. Matches this project's own established "staged
' result, caller checks a companion flag" idiom (RFC-0007's own RPM staging pattern) rather than
' inventing a fragile sentinel address.
FUNCTION AexFindChunkFoundAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(60817408))   ' 0x3A00000, a tiny 4-byte scratch flag
END FUNCTION

FUNCTION AexFindChunkByID(buffer AS MMIOPTR, wantChunkID AS U32) AS MMIOPTR
    LET dirOffset AS U64 = AexReadDirectoryOffset(buffer)
    LET dirCount AS U32 = AexReadDirectoryCount(buffer)
    LET index AS U32 = 0
    MEMORY.Write32(AexFindChunkFoundAddress(), 0)

    WHILE index < dirCount
        LET entry AS MMIOPTR = AexDirectoryEntryAddress(buffer, dirOffset, index)
        IF AexReadEntryChunkID(entry) = wantChunkID THEN
            MEMORY.Write32(AexFindChunkFoundAddress(), 1)
            RETURN entry
        END IF
        index = index + 1
    WEND

    RETURN buffer
END FUNCTION

' ==========================================================================================
' Phase 4: Manifest and component graph (Section 61). Real content layout for the two chunk
' types Phase 4 actually interprets -- MANIFEST (Section 12/13) and COMPONENT (Section 14) --
' scoped to assembly-level identity and topology plus per-component identity/role/lifecycle and
' its own real graph edges (which chunk IDs it names as implementations/interfaces). What those
' referenced IMPLEMENTATION/INTERFACE/CAPABILITY_REQUEST chunks actually CONTAIN is real,
' separate work for Phases 5/8/9 -- Phase 4 only confirms the graph itself is well-formed.
'
' MANIFEST chunk content (76-byte fixed portion, then three variable regions in this order):
'   +0  AssemblyIDHigh          U64
'   +8  AssemblyIDLow           U64
'   +16 VersionMajor            U32
'   +20 VersionMinor            U32
'   +24 VersionPatch            U32
'   +28 BuildIDHigh             U64
'   +36 BuildIDLow              U64
'   +44 RequiredFormatMajor     U32
'   +48 RequiredFormatMinor     U32
'   +52 RequiredAbiMajor        U32
'   +56 RequiredAbiMinor        U32
'   +60 RootComponentID         U32
'   +64 DeclaredComponentCount  U32
'   +68 DisplayNameLength       U32
'   +72 CanonicalNameLength     U32
'   +76 DeclaredComponentIDs    DeclaredComponentCount x U32
'   ..  DisplayName             DisplayNameLength bytes
'   ..  CanonicalName           CanonicalNameLength bytes
'
' COMPONENT chunk content (44-byte fixed portion, then three variable ID lists then a name):
'   +0  ComponentID              U32
'   +4  OwningAssemblyIDHigh     U64
'   +12 OwningAssemblyIDLow      U64
'   +20 ComponentRole            U32
'   +24 LifecyclePolicy          U32  (0=EAGER 1=LAZY 2=ON_DEMAND 3=SERVICE_BOUND 4=OPTIONAL)
'   +28 ImplementationCount      U32
'   +32 ProvidedInterfaceCount   U32
'   +36 RequiredInterfaceCount   U32
'   +40 NameLength               U32
'   +44 ImplementationIDs        ImplementationCount x U32
'   ..  ProvidedInterfaceIDs     ProvidedInterfaceCount x U32
'   ..  RequiredInterfaceIDs     RequiredInterfaceCount x U32
'   ..  Name                     NameLength bytes
' ==========================================================================================

FUNCTION AexErrorMissingManifest() AS U32
    RETURN 8
END FUNCTION
FUNCTION AexErrorManifestOutOfBounds() AS U32
    RETURN 9
END FUNCTION
FUNCTION AexErrorRootComponentNotDeclared() AS U32
    RETURN 10
END FUNCTION
FUNCTION AexErrorMissingRequiredComponent() AS U32
    RETURN 11
END FUNCTION
FUNCTION AexErrorComponentAssemblyMismatch() AS U32
    RETURN 12
END FUNCTION
FUNCTION AexErrorComponentOutOfBounds() AS U32
    RETURN 13
END FUNCTION

FUNCTION AexManifestFixedSize() AS U32
    RETURN 76
END FUNCTION
FUNCTION AexReadManifestAssemblyIDHigh(data AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(data)
END FUNCTION
FUNCTION AexReadManifestAssemblyIDLow(data AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(data, 8))
END FUNCTION
FUNCTION AexReadManifestVersionMajor(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 16))
END FUNCTION
FUNCTION AexReadManifestVersionMinor(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 20))
END FUNCTION
FUNCTION AexReadManifestVersionPatch(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 24))
END FUNCTION
FUNCTION AexReadManifestBuildIDHigh(data AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(data, 28))
END FUNCTION
FUNCTION AexReadManifestBuildIDLow(data AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(data, 36))
END FUNCTION
FUNCTION AexReadManifestRequiredFormatMajor(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 44))
END FUNCTION
FUNCTION AexReadManifestRequiredFormatMinor(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 48))
END FUNCTION
FUNCTION AexReadManifestRequiredAbiMajor(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 52))
END FUNCTION
FUNCTION AexReadManifestRequiredAbiMinor(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 56))
END FUNCTION
FUNCTION AexReadManifestRootComponentID(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 60))
END FUNCTION
FUNCTION AexReadManifestDeclaredComponentCount(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 64))
END FUNCTION
FUNCTION AexReadManifestDisplayNameLength(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 68))
END FUNCTION
FUNCTION AexReadManifestCanonicalNameLength(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 72))
END FUNCTION
FUNCTION AexManifestDeclaredComponentIDAt(data AS MMIOPTR, index AS U32) AS U32
    LET indexAsU64 AS U64 = index
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 76 + (indexAsU64 * 4)))
END FUNCTION

FUNCTION AexComponentFixedSize() AS U32
    RETURN 44
END FUNCTION
FUNCTION AexReadComponentID(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(data)
END FUNCTION
FUNCTION AexReadComponentAssemblyIDHigh(data AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(data, 4))
END FUNCTION
FUNCTION AexReadComponentAssemblyIDLow(data AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(data, 12))
END FUNCTION
FUNCTION AexReadComponentRole(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 20))
END FUNCTION
FUNCTION AexReadComponentLifecycle(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 24))
END FUNCTION
FUNCTION AexReadComponentImplementationCount(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 28))
END FUNCTION
FUNCTION AexReadComponentProvidedInterfaceCount(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 32))
END FUNCTION
FUNCTION AexReadComponentRequiredInterfaceCount(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 36))
END FUNCTION
FUNCTION AexReadComponentNameLength(data AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(data, 40))
END FUNCTION

' Real, per-component validation: resolves componentID through the SAME chunk directory (a
' component is just another chunk), confirms its real type, bounds-checks its own three variable
' ID lists plus name against its own real LogicalLength (identical overflow-safe discipline to
' AEX.ValidateDirectory), and confirms the component's own recorded owning assembly actually
' matches the manifest that declared it -- Section 14.2's "canonical identity SHALL combine
' assembly identity and component identity" made a real, checked invariant instead of a
' documentation-only promise.
FUNCTION AexValidateOneComponent(buffer AS MMIOPTR, componentID AS U32, expectAssemblyHigh AS U64, expectAssemblyLow AS U64, fileLength AS U64) AS U32
    LET componentEntry AS MMIOPTR = AexFindChunkByID(buffer, componentID)
    IF MEMORY.Read32(AexFindChunkFoundAddress()) = 0 THEN
        RETURN AexErrorMissingRequiredComponent()
    END IF
    LET typeHigh AS U64 = AexReadEntryTypeHigh(componentEntry)
    LET typeLow AS U64 = AexReadEntryTypeLow(componentEntry)
    IF typeHigh <> AexTypeComponentHigh() THEN
        RETURN AexErrorMissingRequiredComponent()
    END IF
    IF typeLow <> AexTypeComponentLow() THEN
        RETURN AexErrorMissingRequiredComponent()
    END IF

    LET componentOffset AS U64 = AexReadEntryOffset(componentEntry)
    LET componentLogicalLength AS U64 = AexReadEntryLogicalLength(componentEntry)
    LET componentData AS MMIOPTR = ADDRESS.Offset(buffer, componentOffset)

    LET fixedSize AS U64 = AexComponentFixedSize()
    IF componentLogicalLength < fixedSize THEN
        RETURN AexErrorComponentOutOfBounds()
    END IF

    LET implCount AS U32 = AexReadComponentImplementationCount(componentData)
    LET providedCount AS U32 = AexReadComponentProvidedInterfaceCount(componentData)
    LET requiredCount AS U32 = AexReadComponentRequiredInterfaceCount(componentData)
    LET nameLen AS U32 = AexReadComponentNameLength(componentData)

    LET implCountAsU64 AS U64 = implCount
    LET providedCountAsU64 AS U64 = providedCount
    LET requiredCountAsU64 AS U64 = requiredCount
    LET nameLenAsU64 AS U64 = nameLen

    LET totalNeeded AS U64 = fixedSize

    IF implCountAsU64 > (AexU64Max() \ 4) THEN
        RETURN AexErrorComponentOutOfBounds()
    END IF
    LET implBytes AS U64 = implCountAsU64 * 4
    IF totalNeeded > AexU64Max() - implBytes THEN
        RETURN AexErrorComponentOutOfBounds()
    END IF
    totalNeeded = totalNeeded + implBytes

    IF providedCountAsU64 > (AexU64Max() \ 4) THEN
        RETURN AexErrorComponentOutOfBounds()
    END IF
    LET providedBytes AS U64 = providedCountAsU64 * 4
    IF totalNeeded > AexU64Max() - providedBytes THEN
        RETURN AexErrorComponentOutOfBounds()
    END IF
    totalNeeded = totalNeeded + providedBytes

    IF requiredCountAsU64 > (AexU64Max() \ 4) THEN
        RETURN AexErrorComponentOutOfBounds()
    END IF
    LET requiredBytes AS U64 = requiredCountAsU64 * 4
    IF totalNeeded > AexU64Max() - requiredBytes THEN
        RETURN AexErrorComponentOutOfBounds()
    END IF
    totalNeeded = totalNeeded + requiredBytes

    IF totalNeeded > AexU64Max() - nameLenAsU64 THEN
        RETURN AexErrorComponentOutOfBounds()
    END IF
    totalNeeded = totalNeeded + nameLenAsU64

    IF totalNeeded > componentLogicalLength THEN
        RETURN AexErrorComponentOutOfBounds()
    END IF

    LET ownAssemblyHigh AS U64 = AexReadComponentAssemblyIDHigh(componentData)
    LET ownAssemblyLow AS U64 = AexReadComponentAssemblyIDLow(componentData)
    IF ownAssemblyHigh <> expectAssemblyHigh THEN
        RETURN AexErrorComponentAssemblyMismatch()
    END IF
    IF ownAssemblyLow <> expectAssemblyLow THEN
        RETURN AexErrorComponentAssemblyMismatch()
    END IF

    RETURN AexErrorOk()
END FUNCTION

' Phase 4's own real entry point: resolves the header's RootManifestID through the chunk
' directory, confirms it is genuinely a MANIFEST chunk, bounds-checks the manifest's own three
' variable regions against its real LogicalLength, confirms the declared root component is
' actually among the declared components (a real graph-consistency check, not assumed), then
' validates every declared component in turn. Assumes AEX.ValidateHeader and
' AEX.ValidateDirectory already passed -- this function trusts the directory only because that
' already happened.
FUNCTION AEX.ValidateManifest(buffer AS MMIOPTR, fileLength AS U64) AS U32
    LET rootManifestID AS U32 = AexReadRootManifestID(buffer)
    LET manifestEntry AS MMIOPTR = AexFindChunkByID(buffer, rootManifestID)
    IF MEMORY.Read32(AexFindChunkFoundAddress()) = 0 THEN
        RETURN AexErrorMissingManifest()
    END IF
    LET manifestTypeHigh AS U64 = AexReadEntryTypeHigh(manifestEntry)
    LET manifestTypeLow AS U64 = AexReadEntryTypeLow(manifestEntry)
    IF manifestTypeHigh <> AexTypeManifestHigh() THEN
        RETURN AexErrorMissingManifest()
    END IF
    IF manifestTypeLow <> AexTypeManifestLow() THEN
        RETURN AexErrorMissingManifest()
    END IF

    LET manifestOffset AS U64 = AexReadEntryOffset(manifestEntry)
    LET manifestLogicalLength AS U64 = AexReadEntryLogicalLength(manifestEntry)
    LET manifestData AS MMIOPTR = ADDRESS.Offset(buffer, manifestOffset)

    LET fixedSize AS U64 = AexManifestFixedSize()
    IF manifestLogicalLength < fixedSize THEN
        RETURN AexErrorManifestOutOfBounds()
    END IF

    LET declaredCount AS U32 = AexReadManifestDeclaredComponentCount(manifestData)
    LET displayLen AS U32 = AexReadManifestDisplayNameLength(manifestData)
    LET canonicalLen AS U32 = AexReadManifestCanonicalNameLength(manifestData)

    LET declaredCountAsU64 AS U64 = declaredCount
    LET displayLenAsU64 AS U64 = displayLen
    LET canonicalLenAsU64 AS U64 = canonicalLen

    IF declaredCountAsU64 > (AexU64Max() \ 4) THEN
        RETURN AexErrorManifestOutOfBounds()
    END IF
    LET declaredBytes AS U64 = declaredCountAsU64 * 4
    LET totalNeeded AS U64 = fixedSize
    IF totalNeeded > AexU64Max() - declaredBytes THEN
        RETURN AexErrorManifestOutOfBounds()
    END IF
    totalNeeded = totalNeeded + declaredBytes

    IF totalNeeded > AexU64Max() - displayLenAsU64 THEN
        RETURN AexErrorManifestOutOfBounds()
    END IF
    totalNeeded = totalNeeded + displayLenAsU64

    IF totalNeeded > AexU64Max() - canonicalLenAsU64 THEN
        RETURN AexErrorManifestOutOfBounds()
    END IF
    totalNeeded = totalNeeded + canonicalLenAsU64

    IF totalNeeded > manifestLogicalLength THEN
        RETURN AexErrorManifestOutOfBounds()
    END IF

    LET rootComponentID AS U32 = AexReadManifestRootComponentID(manifestData)
    LET foundRoot AS BOOL = 0
    LET i AS U32 = 0
    WHILE i < declaredCount
        LET candidateID AS U32 = AexManifestDeclaredComponentIDAt(manifestData, i)
        IF candidateID = rootComponentID THEN
            foundRoot = 1
        END IF
        i = i + 1
    WEND
    IF foundRoot = 0 THEN
        RETURN AexErrorRootComponentNotDeclared()
    END IF

    LET assemblyHigh AS U64 = AexReadManifestAssemblyIDHigh(manifestData)
    LET assemblyLow AS U64 = AexReadManifestAssemblyIDLow(manifestData)

    LET j AS U32 = 0
    WHILE j < declaredCount
        LET componentID AS U32 = AexManifestDeclaredComponentIDAt(manifestData, j)
        LET componentResult AS U32 = AexValidateOneComponent(buffer, componentID, assemblyHigh, assemblyLow, fileLength)
        IF componentResult <> AexErrorOk() THEN
            RETURN componentResult
        END IF
        j = j + 1
    WEND

    RETURN AexErrorOk()
END FUNCTION

FUNCTION SerialByte(value AS U8) AS U64
    LET port AS IOPORT = PORT.Address(1016)
    PORT.WriteByte(port, value)
    RETURN 0
END FUNCTION

FUNCTION SerialText(a AS U32, b AS U32, c AS U32, d AS U32, e AS U32) AS U64
    LET aByte AS U8 = a
    LET bByte AS U8 = b
    LET cByte AS U8 = c
    LET dByte AS U8 = d
    LET eByte AS U8 = e
    SerialByte(aByte)
    SerialByte(bByte)
    SerialByte(cByte)
    SerialByte(dByte)
    SerialByte(eByte)
    RETURN 0
END FUNCTION

FUNCTION ValidManifestBufferAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(62914560))
END FUNCTION
FUNCTION ValidManifestFileLength() AS U64
    RETURN 408
