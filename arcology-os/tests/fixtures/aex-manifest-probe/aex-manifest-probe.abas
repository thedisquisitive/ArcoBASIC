FUNCTION ReportCase(label0 AS U32, label1 AS U32, label2 AS U32, label3 AS U32, label4 AS U32, ok AS BOOL) AS U64
    SerialText(label0, label1, label2, label3, label4)
    IF ok = 1 THEN
        SerialByte(58)
        SerialByte(32)
        SerialByte(80)
        SerialByte(65)
        SerialByte(83)
        SerialByte(83)
    ELSE
        SerialByte(58)
        SerialByte(32)
        SerialByte(70)
        SerialByte(65)
        SerialByte(73)
        SerialByte(76)
    END IF
    SerialByte(13)
    SerialByte(10)
    RETURN 0
END FUNCTION

FUNCTION Main(imageHandle AS UEFI.Handle, systemTable AS UEFI.SystemTable) AS U64
    systemTable.BootServices.SetWatchdogTimer(0, 0, 0, 0)
    SerialByte(80)
    SerialByte(82)
    SerialByte(69)
    SerialByte(13)
    SerialByte(10)

    LET testsPassed AS U32 = 0
    LET testsFailed AS U32 = 0

    LET ValidManifestOk AS BOOL = RunValidManifest()
    ReportCase(86, 65, 76, 73, 68, ValidManifestOk)
    IF ValidManifestOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET MissingManifestOk AS BOOL = RunMissingManifest()
    ReportCase(77, 73, 83, 77, 70, MissingManifestOk)
    IF MissingManifestOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET ManifestWrongTypeOk AS BOOL = RunManifestWrongType()
    ReportCase(87, 82, 84, 89, 80, ManifestWrongTypeOk)
    IF ManifestWrongTypeOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET ManifestOutOfBoundsOk AS BOOL = RunManifestOutOfBounds()
    ReportCase(77, 70, 79, 79, 66, ManifestOutOfBoundsOk)
    IF ManifestOutOfBoundsOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET RootComponentNotDeclaredOk AS BOOL = RunRootComponentNotDeclared()
    ReportCase(82, 84, 78, 68, 67, RootComponentNotDeclaredOk)
    IF RootComponentNotDeclaredOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET MissingRequiredComponentOk AS BOOL = RunMissingRequiredComponent()
    ReportCase(77, 73, 83, 67, 80, MissingRequiredComponentOk)
    IF MissingRequiredComponentOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET ComponentAssemblyMismatchOk AS BOOL = RunComponentAssemblyMismatch()
    ReportCase(67, 80, 65, 83, 77, ComponentAssemblyMismatchOk)
    IF ComponentAssemblyMismatchOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET ComponentOutOfBoundsOk AS BOOL = RunComponentOutOfBounds()
    ReportCase(67, 80, 79, 79, 66, ComponentOutOfBoundsOk)
    IF ComponentOutOfBoundsOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    SerialByte(68)
    SerialByte(79)
    SerialByte(78)
    SerialByte(69)
    SerialByte(32)
    IF testsFailed = 0 THEN
        SerialByte(65)
        SerialByte(76)
        SerialByte(76)
        SerialByte(80)
        SerialByte(65)
        SerialByte(83)
        SerialByte(83)
    ELSE
        SerialByte(83)
        SerialByte(79)
        SerialByte(77)
        SerialByte(69)
        SerialByte(70)
        SerialByte(65)
        SerialByte(73)
        SerialByte(76)
    END IF
    SerialByte(13)
    SerialByte(10)

    CPU.HaltForever
    RETURN 0
END FUNCTION
