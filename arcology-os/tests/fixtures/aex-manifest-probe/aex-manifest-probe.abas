FUNCTION RunValidManifest() AS BOOL
    WriteValidManifest()
    LET hdrResult AS U32 = AEX.ValidateHeader(ValidManifestBufferAddress(), ValidManifestFileLength())
    IF hdrResult <> 0 THEN
        RETURN 0
    END IF
    LET dirResult AS U32 = AEX.ValidateDirectory(ValidManifestBufferAddress(), ValidManifestFileLength())
    IF dirResult <> 0 THEN
        RETURN 0
    END IF
    LET manifestResult AS U32 = AEX.ValidateManifest(ValidManifestBufferAddress(), ValidManifestFileLength())
    IF manifestResult <> 0 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunMissingManifest() AS BOOL
    WriteMissingManifest()
    LET hdrResult AS U32 = AEX.ValidateHeader(MissingManifestBufferAddress(), MissingManifestFileLength())
    IF hdrResult <> 0 THEN
        RETURN 0
    END IF
    LET dirResult AS U32 = AEX.ValidateDirectory(MissingManifestBufferAddress(), MissingManifestFileLength())
    IF dirResult <> 0 THEN
        RETURN 0
    END IF
    LET manifestResult AS U32 = AEX.ValidateManifest(MissingManifestBufferAddress(), MissingManifestFileLength())
    IF manifestResult <> 8 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

