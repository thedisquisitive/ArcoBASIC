FUNCTION ReportCase(label0 AS U32, label1 AS U32, label2 AS U32, label3 AS U32, label4 AS U32, ok AS BOOL) AS U64
    SerialText(label0, label1, label2, label3, label4)
    IF ok = 1 THEN
        SerialByte(58)
        SerialByte(32)
        SerialByte(80)
        SerialByte(65)
        SerialByte(83)
        SerialByte(83)
    ELSE
        SerialByte(58)
        SerialByte(32)
        SerialByte(70)
        SerialByte(65)
        SerialByte(73)
        SerialByte(76)
    END IF
    SerialByte(13)
    SerialByte(10)
    RETURN 0
END FUNCTION

FUNCTION Main(imageHandle AS UEFI.Handle, systemTable AS UEFI.SystemTable) AS U64
    systemTable.BootServices.SetWatchdogTimer(0, 0, 0, 0)
    SerialByte(80)
    SerialByte(82)
    SerialByte(69)
    SerialByte(13)
    SerialByte(10)

    LET testsPassed AS U32 = 0
    LET testsFailed AS U32 = 0

    LET ValidSelectOk AS BOOL = RunValidSelect()
    ReportCase(86, 83, 69, 76, 32, ValidSelectOk)
    IF ValidSelectOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET PrioritySelectionOk AS BOOL = RunPrioritySelection()
    ReportCase(80, 82, 73, 79, 32, PrioritySelectionOk)
    IF PrioritySelectionOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET NoCompatibleArchitectureOk AS BOOL = RunNoCompatibleArchitecture()
    ReportCase(65, 82, 67, 72, 32, NoCompatibleArchitectureOk)
    IF NoCompatibleArchitectureOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET NoCompatibleAbiMinorOk AS BOOL = RunNoCompatibleAbiMinor()
    ReportCase(65, 66, 73, 86, 32, NoCompatibleAbiMinorOk)
    IF NoCompatibleAbiMinorOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET ImplementationInvalidMissingOk AS BOOL = RunImplementationInvalidMissing()
    ReportCase(73, 77, 73, 83, 32, ImplementationInvalidMissingOk)
    IF ImplementationInvalidMissingOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET ImplementationWrongTypeOk AS BOOL = RunImplementationWrongType()
    ReportCase(73, 84, 89, 80, 32, ImplementationWrongTypeOk)
    IF ImplementationWrongTypeOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET ImplementationOutOfBoundsOk AS BOOL = RunImplementationOutOfBounds()
    ReportCase(73, 79, 79, 66, 32, ImplementationOutOfBoundsOk)
    IF ImplementationOutOfBoundsOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET ImplementationOwnerMismatchOk AS BOOL = RunImplementationOwnerMismatch()
    ReportCase(73, 79, 87, 78, 32, ImplementationOwnerMismatchOk)
    IF ImplementationOwnerMismatchOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    SerialByte(68)
    SerialByte(79)
    SerialByte(78)
    SerialByte(69)
    SerialByte(32)
    IF testsFailed = 0 THEN
        SerialByte(65)
        SerialByte(76)
        SerialByte(76)
        SerialByte(80)
        SerialByte(65)
        SerialByte(83)
        SerialByte(83)
    ELSE
        SerialByte(83)
        SerialByte(79)
        SerialByte(77)
        SerialByte(69)
        SerialByte(70)
        SerialByte(65)
        SerialByte(73)
        SerialByte(76)
    END IF
    SerialByte(13)
    SerialByte(10)

    CPU.HaltForever
    RETURN 0
END FUNCTION
