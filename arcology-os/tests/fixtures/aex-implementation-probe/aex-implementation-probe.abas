FUNCTION RunValidSelect() AS BOOL
    WriteValidSelect()
    LET hdrResult AS U32 = AEX.ValidateHeader(ValidSelectBufferAddress(), ValidSelectFileLength())
    IF hdrResult <> 0 THEN
        RETURN 0
    END IF
    LET dirResult AS U32 = AEX.ValidateDirectory(ValidSelectBufferAddress(), ValidSelectFileLength())
    IF dirResult <> 0 THEN
        RETURN 0
    END IF
    LET manifestResult AS U32 = AEX.ValidateManifest(ValidSelectBufferAddress(), ValidSelectFileLength())
    IF manifestResult <> 0 THEN
        RETURN 0
    END IF
    LET selectResult AS U32 = AEX.SelectImplementation(ValidSelectBufferAddress(), 2, ValidSelectFileLength())
    IF selectResult <> 0 THEN
        RETURN 0
    END IF
    LET selectedImplID AS U32 = MEMORY.Read32(AexSelectedImplementationIDAddress())
    IF selectedImplID <> 10 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunPrioritySelection() AS BOOL
    WritePrioritySelection()
    LET hdrResult AS U32 = AEX.ValidateHeader(PrioritySelectionBufferAddress(), PrioritySelectionFileLength())
    IF hdrResult <> 0 THEN
        RETURN 0
