    LET selectResult AS U32 = AEX.SelectImplementation(PrioritySelectionBufferAddress(), 2, PrioritySelectionFileLength())
    IF selectResult <> 0 THEN
        RETURN 0
    END IF
    LET selectedImplID AS U32 = MEMORY.Read32(AexSelectedImplementationIDAddress())
    IF selectedImplID <> 11 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

