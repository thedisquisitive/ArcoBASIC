FUNCTION FontGlyphRowByte(code AS U32, row AS U32) AS U32
    IF code < 32 THEN
        RETURN 0
    END IF
    IF code > 126 THEN
        RETURN 0
    END IF
    LET glyphIndex AS U32 = code - 32
    LET glyphOffset AS U32 = glyphIndex * 8
    LET rowByte AS U32 = MEMORY.Read8(ADDRESS.Offset(FontTableAddress(), glyphOffset + row))
    RETURN rowByte
END FUNCTION

FUNCTION TermStateAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(51380224))   ' 0x3100000
END FUNCTION
FUNCTION TermFramebufferPhysAddress() AS MMIOPTR
    RETURN TermStateAddress()
END FUNCTION
FUNCTION TermStrideAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(TermStateAddress(), 8)
END FUNCTION
FUNCTION TermWidthPxAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(TermStateAddress(), 12)
END FUNCTION
FUNCTION TermHeightPxAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(TermStateAddress(), 16)
END FUNCTION
FUNCTION TermColsAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(TermStateAddress(), 20)
END FUNCTION
FUNCTION TermRowsAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(TermStateAddress(), 24)
END FUNCTION
FUNCTION TermCursorColAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(TermStateAddress(), 28)
END FUNCTION
FUNCTION TermCursorRowAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(TermStateAddress(), 32)
END FUNCTION
FUNCTION TermReadyAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(TermStateAddress(), 36)
END FUNCTION
FUNCTION TermScaleAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(TermStateAddress(), 40)
END FUNCTION

' A REAL finding from this fixture's own first physical hardware run: a fixed 8x8-at-2x (16px)
' glyph cell, legible on QEMU's own 1280x800 virtual display, was "nearly impossible to read" on
' the user's real laptop panel -- a fixed pixel size doesn't track a real panel's own actual
' resolution/density the way a virtual display's did. TermGlyphScale now reads a real value
' computed once in SetupGopDashboard from the real detected GOP width (never hardcoded), targeting
' roughly the same ~80-column line width regardless of the real panel's own resolution, clamped to
' [2,6] so this never regresses below the original known-legible size nor grows absurd on a very
' high-resolution panel. TermCellPx derives from it, not the other way around.
FUNCTION TermCellPx() AS U32
    RETURN 8 * TermGlyphScale()
END FUNCTION
FUNCTION TermGlyphScale() AS U32
    RETURN MEMORY.Read32(TermScaleAddress())
END FUNCTION

' Explicit breakpoints rather than a divide-and-floor formula -- an earlier version of this fixture
' derived scale from a target column count via integer division, and at a real common laptop width
' (1920) it silently floored right back down to the same "illegible" scale=2 it was meant to fix
' (1920 \ 90 \ 8 = 2, the exact same result as 1280 \ 90 \ 8). Explicit thresholds are easy to reason
' about and verify against real GOP widths directly, with no rounding surprises. 1280 (QEMU's own
' `-vga std` default) deliberately stays at the original known-legible scale=2, so the existing
' pixel-region smoke test's own expectations don't shift; 1920 (this project's own real hardware,
' and the single most common real laptop panel width) steps up to scale=3.
FUNCTION ComputeTermScale(widthPx AS U32) AS U32
    LET scale AS U32 = 2
    IF widthPx >= 1600 THEN
        scale = 3
    END IF
    IF widthPx >= 2200 THEN
        scale = 4
    END IF
    IF widthPx >= 3000 THEN
        scale = 5
    END IF
    IF widthPx >= 3800 THEN
        scale = 6
    END IF
    RETURN scale
END FUNCTION
FUNCTION TermFgColor() AS U32
    RETURN 16777215   ' white on every real 32bpp GOP pixel format this project has ever seen (equal
                       ' RGB components render the same regardless of channel order)
END FUNCTION
FUNCTION TermBgColor() AS U32
    RETURN 0           ' black
END FUNCTION

' Draws one real glyph, scaled, at a given PIXEL (not cell) origin -- always draws the full cell
' background too (not just the "on" pixels), so this doubles as this terminal's own real per-cell
' erase primitive (used directly by TermPutChar's own backspace handling).
' Real, generic pixel-block primitives -- the boot dashboard's own real drawing vocabulary, matching
' docs/arcology-boot-screen-concept.md's own explicit "safe early features" list (solid fills,
' rectangles, borders, lines, bitmap text; no gradients/alpha/animation).
FUNCTION FillRect(framebuffer AS MMIOPTR, stride AS U32, x AS U32, y AS U32, w AS U32, h AS U32, color AS U32) AS U64
    LET dy AS U32 = 0
    WHILE dy < h
        LET dx AS U32 = 0
        WHILE dx < w
            LET pixelOffset AS U32 = ((y + dy) * stride + (x + dx)) * 4
            LET pixel AS MMIOPTR = ADDRESS.Offset(framebuffer, pixelOffset)
            MEMORY.Write32(pixel, color)
            dx = dx + 1
        WEND
        dy = dy + 1
    WEND
    RETURN 0
END FUNCTION

FUNCTION DrawHLine(framebuffer AS MMIOPTR, stride AS U32, x AS U32, y AS U32, w AS U32, color AS U32) AS U64
    FillRect(framebuffer, stride, x, y, w, 1, color)
    RETURN 0
END FUNCTION

FUNCTION DrawVLine(framebuffer AS MMIOPTR, stride AS U32, x AS U32, y AS U32, h AS U32, color AS U32) AS U64
    FillRect(framebuffer, stride, x, y, 1, h, color)
    RETURN 0
END FUNCTION

FUNCTION DrawRectBorder(framebuffer AS MMIOPTR, stride AS U32, x AS U32, y AS U32, w AS U32, h AS U32, color AS U32) AS U64
    DrawHLine(framebuffer, stride, x, y, w, color)
    LET yBottom AS U32 = y + h - 1
    DrawHLine(framebuffer, stride, x, yBottom, w, color)
    DrawVLine(framebuffer, stride, x, y, h, color)
    LET xRight AS U32 = x + w - 1
    DrawVLine(framebuffer, stride, xRight, y, h, color)
    RETURN 0
END FUNCTION

' The dashboard's own real, position-independent glyph draw -- unlike DrawChar below (which always
' reads its scale/colors from the scrolling terminal's own fixed globals), this takes them
' explicitly, since dashboard text needs multiple real sizes (a large title, small panel labels)
' and real state-driven colors (not always the terminal's own fixed white-on-black).
FUNCTION DrawGlyphAt(framebuffer AS MMIOPTR, stride AS U32, pxX AS U32, pxY AS U32, code AS U32, scale AS U32, fg AS U32, bg AS U32) AS U64
    LET row AS U32 = 0
    WHILE row < 8
        LET rowByte AS U32 = FontGlyphRowByte(code, row)
        LET col AS U32 = 0
        WHILE col < 8
            LET bitIndex AS U32 = 7 - col
            LET mask AS U32 = 1 SHL bitIndex
            LET on AS U32 = rowByte AND mask
            LET color AS U32 = bg
            IF on <> 0 THEN
                color = fg
            END IF
            LET dy AS U32 = 0
            WHILE dy < scale
                LET dx AS U32 = 0
                WHILE dx < scale
                    LET px AS U32 = pxX + (col * scale) + dx
                    LET py AS U32 = pxY + (row * scale) + dy
                    LET pixelOffset AS U32 = (py * stride + px) * 4
                    LET pixel AS MMIOPTR = ADDRESS.Offset(framebuffer, pixelOffset)
                    MEMORY.Write32(pixel, color)
                    dx = dx + 1
                WEND
                dy = dy + 1
            WEND
            col = col + 1
        WEND
        row = row + 1
    WEND
    RETURN 0
END FUNCTION

FUNCTION DrawChar(framebuffer AS MMIOPTR, stride AS U32, pxX AS U32, pxY AS U32, code AS U32) AS U64
    LET scale AS U32 = TermGlyphScale()
    LET fg AS U32 = TermFgColor()
    LET bg AS U32 = TermBgColor()
    LET row AS U32 = 0
    WHILE row < 8
        LET rowByte AS U32 = FontGlyphRowByte(code, row)
        LET col AS U32 = 0
        WHILE col < 8
            LET bitIndex AS U32 = 7 - col
            LET mask AS U32 = 1 SHL bitIndex
            LET on AS U32 = rowByte AND mask
            LET color AS U32 = bg
            IF on <> 0 THEN
                color = fg
            END IF
            LET dy AS U32 = 0
            WHILE dy < scale
                LET dx AS U32 = 0
                WHILE dx < scale
                    LET px AS U32 = pxX + (col * scale) + dx
                    LET py AS U32 = pxY + (row * scale) + dy
                    LET pixelOffset AS U32 = (py * stride + px) * 4
                    LET pixel AS MMIOPTR = ADDRESS.Offset(framebuffer, pixelOffset)
                    MEMORY.Write32(pixel, color)
                    dx = dx + 1
                WEND
                dy = dy + 1
            WEND
            col = col + 1
        WEND
        row = row + 1
    WEND
    RETURN 0
END FUNCTION

FUNCTION TermFramebufferMmio() AS MMIOPTR
    LET phys AS U64 = MEMORY.Read64(TermFramebufferPhysAddress())
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(phys))
END FUNCTION

FUNCTION TermClear() AS U64
    LET ready AS U32 = MEMORY.Read32(TermReadyAddress())
    IF ready = 0 THEN
        RETURN 0
    END IF
    LET framebuffer AS MMIOPTR = TermFramebufferMmio()
    LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
    LET widthPx AS U32 = MEMORY.Read32(TermWidthPxAddress())
    LET heightPx AS U32 = MEMORY.Read32(TermHeightPxAddress())
    LET bg AS U32 = TermBgColor()
    LET y AS U32 = 0
    WHILE y < heightPx
        LET x AS U32 = 0
        WHILE x < widthPx
            LET pixelOffset AS U32 = (y * stride + x) * 4
            LET pixel AS MMIOPTR = ADDRESS.Offset(framebuffer, pixelOffset)
            MEMORY.Write32(pixel, bg)
            x = x + 1
        WEND
        y = y + 1
    WEND
    MEMORY.Write32(TermCursorColAddress(), 0)
    MEMORY.Write32(TermCursorRowAddress(), 0)
    RETURN 0
END FUNCTION

' The real on-screen terminal's own character sink -- called for EVERY byte this fixture ever
' echoes to serial, so the real interactive session is genuinely visible on a real laptop screen,
' not just over a wire nothing in this project can currently read back from real hardware. A
' real, deliberately simple terminal: newline advances a row and wraps to the top (clearing) once
' past the bottom; backspace moves back one cell and redraws it as blank; anything else outside
' the real embedded font's own 32-126 range is silently dropped (fail-closed, matching this
' project's own established discipline for undefined input).
FUNCTION TermPutChar(code AS U32) AS U64
    LET ready AS U32 = MEMORY.Read32(TermReadyAddress())
    IF ready = 0 THEN
        RETURN 0
    END IF
    IF code = 13 THEN
        RETURN 0
    END IF
    LET cellPx AS U32 = TermCellPx()
    LET cols AS U32 = MEMORY.Read32(TermColsAddress())
    LET rows AS U32 = MEMORY.Read32(TermRowsAddress())
    LET col AS U32 = MEMORY.Read32(TermCursorColAddress())
    LET row AS U32 = MEMORY.Read32(TermCursorRowAddress())

    IF code = 10 THEN
        col = 0
        row = row + 1
    ELSE
        IF code = 8 THEN
            IF col > 0 THEN
                col = col - 1
            END IF
            LET framebuffer AS MMIOPTR = TermFramebufferMmio()
            LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
            DrawChar(framebuffer, stride, col * cellPx, row * cellPx, 32)
        ELSE
            IF code >= 32 THEN
                IF code <= 126 THEN
                    LET framebuffer AS MMIOPTR = TermFramebufferMmio()
                    LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
                    DrawChar(framebuffer, stride, col * cellPx, row * cellPx, code)
                    col = col + 1
                    IF col >= cols THEN
                        col = 0
                        row = row + 1
                    END IF
                END IF
            END IF
        END IF
    END IF

    IF row >= rows THEN
        TermClear()
        RETURN 0
    END IF

    MEMORY.Write32(TermCursorColAddress(), col)
    MEMORY.Write32(TermCursorRowAddress(), row)
    RETURN 0
END FUNCTION

' The real combined sink this fixture uses everywhere it used to call SerialByte directly --
' writes to BOTH the real serial port (this project's own established, QEMU-testable output
' channel) and the real on-screen terminal above, so the exact same interactive session is
' observable both ways, from the same call sites, with no special-casing at each site.
FUNCTION EchoChar(code AS U8) AS U64
    SerialByte(code)
    TermPutChar(code)
    RETURN 0
END FUNCTION

