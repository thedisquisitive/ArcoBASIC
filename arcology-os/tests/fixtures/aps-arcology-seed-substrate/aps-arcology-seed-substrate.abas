' Draws one real label (by its own fixed table offset) left-to-right at (x,y), returning the total
' pixel width drawn -- lets callers right-align or center text using a real measured width instead
' of a guessed one.
FUNCTION DrawLabel(framebuffer AS MMIOPTR, stride AS U32, x AS U32, y AS U32, labelOffset AS U32, scale AS U32, fg AS U32, bg AS U32) AS U32
    LET cellW AS U32 = 8 * scale
    LET i AS U32 = 0
    LET done AS BOOL = 0
    WHILE done = 0
        IF i >= 64 THEN
            done = 1
        ELSE
            LET code AS U32 = MEMORY.Read8(ADDRESS.Offset(DashboardLabelTableAddress(), labelOffset + i))
            IF code = 0 THEN
                done = 1
            ELSE
                DrawGlyphAt(framebuffer, stride, x + (i * cellW), y, code, scale, fg, bg)
                i = i + 1
            END IF
        END IF
    WEND
    RETURN i * cellW
END FUNCTION

' ==========================================================================================
' Arcology Boot Screen -- real System Assembly View (docs/arcology-boot-screen-concept.md).
' Real subsystem states, driven by this fixture's own real boot milestones -- no simulated or
' fake progress. Palette matches the concept doc's own specified colors exactly.
' ==========================================================================================

FUNCTION DashBg() AS U32
    RETURN 2068
END FUNCTION
FUNCTION DashPrimary() AS U32
    RETURN 6742271
END FUNCTION
FUNCTION DashDim() AS U32
    RETURN 3359834
END FUNCTION
FUNCTION DashMagenta() AS U32
    RETURN 16723614
END FUNCTION
FUNCTION DashAmber() AS U32
    RETURN 16755234
END FUNCTION
FUNCTION DashRed() AS U32
    RETURN 16726843
END FUNCTION
FUNCTION DashActive() AS U32
    RETURN 15269887
END FUNCTION

' Real state codes: 0=PENDING (not yet evaluated), 1=INITIALIZING, 2=READY, 3=ACTIVE, 4=FAILED --
' matches the concept doc's own State Language section exactly.
FUNCTION DashStateColor(state AS U32) AS U32
    IF state = 1 THEN
        RETURN DashPrimary()
    END IF
    IF state = 2 THEN
        RETURN DashPrimary()
    END IF
    IF state = 3 THEN
        RETURN DashActive()
    END IF
    IF state = 4 THEN
        RETURN DashRed()
    END IF
    RETURN DashDim()
END FUNCTION

FUNCTION DashStateLabel(state AS U32) AS U32
    IF state = 1 THEN
        RETURN LABEL_ST_INIT()
    END IF
    IF state = 2 THEN
        RETURN LABEL_ST_READY()
    END IF
    IF state = 3 THEN
        RETURN LABEL_ST_ACTIVE()
    END IF
    IF state = 4 THEN
        RETURN LABEL_ST_FAILED()
    END IF
    RETURN LABEL_ST_PENDING()
END FUNCTION

' Real dashboard layout state: 6 subsystem panel slots, an event-feed write cursor (5 fixed
' lines, filled top-to-bottom -- no scrolling, matching the concept doc's own "avoid scrolling
' regions with heavy redraw logic" guidance), and the real milestone counter behind "ASSEMBLY
' N/10".
FUNCTION DashStateAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(55574528))   ' 0x3500000
END FUNCTION
FUNCTION DashEventCursorAddress() AS MMIOPTR
    RETURN DashStateAddress()
END FUNCTION
FUNCTION DashAssemblyCountAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(DashStateAddress(), 4)
END FUNCTION

FUNCTION DashPanelX(index AS U32) AS U32
    RETURN 20 + (index * 162)
END FUNCTION
FUNCTION DashPanelY() AS U32
    RETURN 210
END FUNCTION
FUNCTION DashPanelW() AS U32
    RETURN 150
END FUNCTION
FUNCTION DashPanelH() AS U32
    RETURN 96
END FUNCTION

FUNCTION DashSubsystemLabel(index AS U32) AS U32
    IF index = 0 THEN
        RETURN LABEL_LBL_MEMORY()
    END IF
    IF index = 1 THEN
        RETURN LABEL_LBL_ADDRESS_SPACE()
    END IF
    IF index = 2 THEN
        RETURN LABEL_LBL_IO()
    END IF
    IF index = 3 THEN
        RETURN LABEL_LBL_INPUT()
    END IF
    IF index = 4 THEN
        RETURN LABEL_LBL_DISPLAY()
    END IF
    RETURN LABEL_LBL_CONSOLE()
END FUNCTION

' Redraws ONE subsystem panel's own border + name + state text -- called every time a real
' milestone changes that subsystem's own real state, not on a timer or animation loop.
FUNCTION DashSetSubsystem(index AS U32, state AS U32) AS U64
    LET ready AS U32 = MEMORY.Read32(TermReadyAddress())
    IF ready = 0 THEN
        RETURN 0
    END IF
    LET framebuffer AS MMIOPTR = TermFramebufferMmio()
    LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
    LET x AS U32 = DashPanelX(index)
    LET y AS U32 = DashPanelY()
    LET w AS U32 = DashPanelW()
    LET h AS U32 = DashPanelH()
    LET color AS U32 = DashStateColor(state)
    FillRect(framebuffer, stride, x, y, w, h, DashBg())
    DrawRectBorder(framebuffer, stride, x, y, w, h, color)
    DrawLabel(framebuffer, stride, x + 10, y + 14, DashSubsystemLabel(index), 1, DashPrimary(), DashBg())
    DrawHLine(framebuffer, stride, x + 10, y + 30, w - 20, DashDim())
    DrawLabel(framebuffer, stride, x + 10, y + 42, DashStateLabel(state), 1, color, DashBg())
    RETURN 0
END FUNCTION

' Appends one real event line to the next open feed slot (5 total, top-to-bottom).
FUNCTION DashAddEvent(labelOffset AS U32) AS U64
    LET ready AS U32 = MEMORY.Read32(TermReadyAddress())
    IF ready = 0 THEN
        RETURN 0
    END IF
    LET cursor AS U32 = MEMORY.Read32(DashEventCursorAddress())
    IF cursor >= 8 THEN
        RETURN 0
    END IF
    LET framebuffer AS MMIOPTR = TermFramebufferMmio()
    LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
    LET x AS U32 = 40
    LET y AS U32 = 400 + (cursor * 20)
    DrawLabel(framebuffer, stride, x, y, labelOffset, 1, DashPrimary(), DashBg())
    MEMORY.Write32(DashEventCursorAddress(), cursor + 1)
    RETURN 0
END FUNCTION

' Redraws the segmented "ASSEMBLY N/10" bar -- a real milestone counter, not a simulated timer.
FUNCTION DashUpdateAssembly(current AS U32, total AS U32) AS U64
    LET ready AS U32 = MEMORY.Read32(TermReadyAddress())
    IF ready = 0 THEN
        RETURN 0
    END IF
    MEMORY.Write32(DashAssemblyCountAddress(), current)
    LET framebuffer AS MMIOPTR = TermFramebufferMmio()
    LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
    LET barY AS U32 = 330
    FillRect(framebuffer, stride, 20, barY, 700, 24, DashBg())
    DrawLabel(framebuffer, stride, 20, barY + 4, LABEL_ASSEMBLY(), 1, DashPrimary(), DashBg())
    LET segX AS U32 = 140
    LET seg AS U32 = 0
    WHILE seg < total
        LET segColor AS U32 = DashDim()
        IF seg < current THEN
            segColor = DashActive()
        END IF
        FillRect(framebuffer, stride, segX + (seg * 24), barY, 18, 16, segColor)
        seg = seg + 1
    WEND
    RETURN 0
END FUNCTION

' Redraws the status panel's own single title line -- the concept doc's own full AUTHORITY/
' CONTRACT/SCOPE/POLICY field breakdown is real future work, out of this first increment's own
' scope; one real, current, milestone-driven headline is what this increment actually delivers.
FUNCTION DashSetStatus(labelOffset AS U32, color AS U32) AS U64
    LET ready AS U32 = MEMORY.Read32(TermReadyAddress())
    IF ready = 0 THEN
        RETURN 0
    END IF
    LET framebuffer AS MMIOPTR = TermFramebufferMmio()
    LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
    FillRect(framebuffer, stride, 540, 400, 460, 24, DashBg())
    DrawLabel(framebuffer, stride, 540, 400, labelOffset, 1, color, DashBg())
    RETURN 0
END FUNCTION

' Marks the UEFI-to-APS authority handoff -- the concept doc's own most important symbolic
' moment. Recolors the APS box to SOVEREIGN/magenta and draws a severed (crossed) link where the
' UEFI-APS connector used to read as live, matching the doc's own "severed or crossed link ...
' indicates control has passed" direction.
FUNCTION DashShowSovereign() AS U64
    LET ready AS U32 = MEMORY.Read32(TermReadyAddress())
    IF ready = 0 THEN
        RETURN 0
    END IF
    LET framebuffer AS MMIOPTR = TermFramebufferMmio()
    LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
    LET apsX AS U32 = 280
    LET apsY AS U32 = 80
    LET apsW AS U32 = 180
    LET apsH AS U32 = 90
    DrawRectBorder(framebuffer, stride, apsX, apsY, apsW, apsH, DashMagenta())
    LET boxLabelY AS U32 = apsY + 58
    FillRect(framebuffer, stride, apsX + 10, boxLabelY, apsW - 20, 16, DashBg())
    DrawLabel(framebuffer, stride, apsX + 10, boxLabelY, LABEL_SOVEREIGN(), 1, DashMagenta(), DashBg())
    LET midY AS U32 = apsY + (apsH \ 2)
    DrawHLine(framebuffer, stride, 200, midY, 80, DashMagenta())
    RETURN 0
END FUNCTION

' Draws every static piece of the dashboard exactly once: background, header, the UEFI/APS
' transition boxes (UEFI side only -- DashShowSovereign draws the APS side once real sovereignty
' is established), all 6 subsystem panels at their real starting PENDING state, the empty
' assembly bar frame, the event feed panel frame, the status panel frame, and the footer.
FUNCTION DashDrawStatic() AS U64
    LET ready AS U32 = MEMORY.Read32(TermReadyAddress())
    IF ready = 0 THEN
        RETURN 0
    END IF
    LET framebuffer AS MMIOPTR = TermFramebufferMmio()
    LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
    LET widthPx AS U32 = MEMORY.Read32(TermWidthPxAddress())
    LET heightPx AS U32 = MEMORY.Read32(TermHeightPxAddress())

    FillRect(framebuffer, stride, 0, 0, widthPx, heightPx, DashBg())

    DrawLabel(framebuffer, stride, 20, 10, LABEL_ARCOLOGY(), 3, DashActive(), DashBg())
    DrawLabel(framebuffer, stride, 20, 46, LABEL_SYSTEM_ASSEMBLY(), 1, DashPrimary(), DashBg())
    LET platformW AS U32 = 8 * 1 * 11
    DrawLabel(framebuffer, stride, widthPx - platformW - 20, 16, LABEL_PLATFORM(), 1, DashDim(), DashBg())
    DrawHLine(framebuffer, stride, 10, 64, widthPx - 20, DashDim())

    LET uefiX AS U32 = 60
    LET uefiY AS U32 = 92
    DrawRectBorder(framebuffer, stride, uefiX, uefiY, 140, 70, DashDim())
    DrawLabel(framebuffer, stride, uefiX + 10, uefiY + 12, LABEL_UEFI(), 1, DashDim(), DashBg())
    DrawLabel(framebuffer, stride, uefiX + 10, uefiY + 28, LABEL_FIRMWARE(), 1, DashDim(), DashBg())
    DrawHLine(framebuffer, stride, uefiX + 10, uefiY + 44, 120, DashDim())
    DrawLabel(framebuffer, stride, uefiX + 10, uefiY + 50, LABEL_HANDOFF_COMPLETE(), 1, DashDim(), DashBg())

    LET apsX AS U32 = 280
    LET apsY AS U32 = 80
    DrawRectBorder(framebuffer, stride, apsX, apsY, 180, 90, DashDim())
    DrawLabel(framebuffer, stride, apsX + 10, apsY + 12, LABEL_APS(), 2, DashDim(), DashBg())
    DrawLabel(framebuffer, stride, apsX + 10, apsY + 40, LABEL_SUBSTRATE(), 1, DashDim(), DashBg())

    LET panelIdx AS U32 = 0
    WHILE panelIdx < 6
        DashSetSubsystem(panelIdx, 0)
        panelIdx = panelIdx + 1
    WEND

    DashUpdateAssembly(0, 10)

    LET feedX AS U32 = 20
    LET feedY AS U32 = 370
    DrawRectBorder(framebuffer, stride, feedX, feedY, 480, 190, DashDim())
    DrawLabel(framebuffer, stride, feedX + 10, feedY + 10, LABEL_EVENT_FEED(), 1, DashPrimary(), DashBg())
    DrawHLine(framebuffer, stride, feedX + 10, feedY + 26, 460, DashDim())

    LET statusX AS U32 = 520
    LET statusY AS U32 = 370
    DrawRectBorder(framebuffer, stride, statusX, statusY, 480, 190, DashDim())
    DrawLabel(framebuffer, stride, statusX + 10, statusY + 10, LABEL_STATUS_HDR(), 1, DashPrimary(), DashBg())
    DrawHLine(framebuffer, stride, statusX + 10, statusY + 26, 460, DashDim())

    LET footerY AS U32 = heightPx - 26
    DrawHLine(framebuffer, stride, 10, footerY, widthPx - 20, DashDim())
    DrawLabel(framebuffer, stride, 20, footerY + 8, LABEL_FOOTER_VER(), 1, DashDim(), DashBg())
    DrawLabel(framebuffer, stride, 400, footerY + 8, LABEL_FOOTER_MOTTO(), 1, DashDim(), DashBg())

    MEMORY.Write32(DashEventCursorAddress(), 0)
    RETURN 0
END FUNCTION
