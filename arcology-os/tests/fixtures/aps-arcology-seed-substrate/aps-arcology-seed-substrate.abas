FUNCTION SubstrateScratchAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(46137344))   ' 0x2C00000, clear of the xHCI driver's own 0x2800000 page
END FUNCTION

FUNCTION LineBufferAddress() AS MMIOPTR
    RETURN SubstrateScratchAddress()
END FUNCTION

FUNCTION LineBufferMaxChars() AS U32
    RETURN 120
END FUNCTION

FUNCTION LineIsHelp(lineBuf AS MMIOPTR, lineLen AS U32) AS BOOL
    IF lineLen <> 4 THEN
        RETURN 0
    END IF
    LET c0 AS U8 = MEMORY.Read8(lineBuf)
    LET c1 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 1))
    LET c2 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 2))
    LET c3 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 3))
    IF c0 = 72 OR c0 = 104 THEN
        IF c1 = 69 OR c1 = 101 THEN
            IF c2 = 76 OR c2 = 108 THEN
                IF c3 = 80 OR c3 = 112 THEN
                    RETURN 1
                END IF
            END IF
        END IF
    END IF
    RETURN 0
END FUNCTION

FUNCTION LineIsOt(lineBuf AS MMIOPTR, lineLen AS U32) AS BOOL
    IF lineLen <> 2 THEN
        RETURN 0
    END IF
    LET c0 AS U8 = MEMORY.Read8(lineBuf)
    LET c1 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 1))
    IF c0 = 79 OR c0 = 111 THEN
        IF c1 = 84 OR c1 = 116 THEN
            RETURN 1
        END IF
    END IF
    RETURN 0
END FUNCTION

' TEST-ONLY -- not part of RFC-0007's own real command set (matches arcology-seed-ready.abas's own
' precedent: a real Arcology Seed keeps running forever, EXIT exists purely for automated QEMU
' testing to terminate deterministically instead of running to a fixed timeout every time).
FUNCTION LineIsExit(lineBuf AS MMIOPTR, lineLen AS U32) AS BOOL
    IF lineLen <> 4 THEN
        RETURN 0
    END IF
    LET c0 AS U8 = MEMORY.Read8(lineBuf)
    LET c1 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 1))
    LET c2 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 2))
    LET c3 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 3))
    IF c0 = 69 OR c0 = 101 THEN
        IF c1 = 88 OR c1 = 120 THEN
            IF c2 = 73 OR c2 = 105 THEN
                IF c3 = 84 OR c3 = 116 THEN
                    RETURN 1
                END IF
            END IF
        END IF
    END IF
    RETURN 0
END FUNCTION

' Real, minimal Shift tracking -- RFC-0045's own PS/2 and USB HID drivers are both explicitly
' "unshifted only" (a named Non-Goal; full modifier tracking is real future work). Real Program
' Mode PRINT statements need a typable string delimiter, and on a real US QWERTY layout the double
' quote is Shift+apostrophe -- with no shift support at all, `"` could never actually be typed on
' real hardware, which would make this whole feature real but unusable. Rather than pick a
' different (less conventional) delimiter to dodge the gap, this closes it directly but narrowly:
' only enough Shift state to disambiguate the apostrophe key, not a general modifier system.
FUNCTION KeyModifierStateAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(57737216))   ' 0x3710000, clear of RpmStateAddress's own 0x3700000 region
END FUNCTION
FUNCTION ShiftHeld() AS U32
    RETURN MEMORY.Read32(KeyModifierStateAddress())
END FUNCTION
FUNCTION SetShiftHeld(value AS U32) AS U64
    MEMORY.Write32(KeyModifierStateAddress(), value)
    RETURN 0
END FUNCTION

' The real combined-input poll: checks the Phase 1 PS/2 path first, then the Phase 3 USB HID path
' (only if a real USB keyboard was actually enumerated -- usbSlotId <> 0), returning the first real
' translated character either produces, or 0 if neither has one ready. Non-blocking, matching both
' underlying drivers' own PollScancode/PollReport contracts -- callers poll this in their own loop.
FUNCTION PollAnyKey(usbSlotId AS U32) AS U16
    LET scancode AS U32 = PS2Keyboard.PollScancode()
    IF scancode <> 0 THEN
        IF scancode = 42 THEN
            SetShiftHeld(1)
        ELSE
            IF scancode = 54 THEN
                SetShiftHeld(1)
            ELSE
                IF scancode = 170 THEN
                    SetShiftHeld(0)
                ELSE
                    IF scancode = 182 THEN
                        SetShiftHeld(0)
                    ELSE
                        LET translated AS U16 = PS2Keyboard.ScancodeToChar(scancode)
                        IF translated = 39 THEN
                            IF ShiftHeld() = 1 THEN
                                translated = 34
                            END IF
                        END IF
                        IF translated <> 0 THEN
                            RETURN translated
                        END IF
                    END IF
                END IF
            END IF
        END IF
    END IF

    IF usbSlotId <> 0 THEN
        LET reportBuffer AS MMIOPTR = XhciScratchDmaMmio()
        LET gotReport AS BOOL = UsbHidKeyboard.PollReport(usbSlotId, reportBuffer)
        IF gotReport = 1 THEN
            LET modifierByte AS U32 = MmioReadField32(reportBuffer, 0, 0, 8)
            IF (modifierByte AND 34) <> 0 THEN
                SetShiftHeld(1)
            ELSE
                SetShiftHeld(0)
            END IF
            LET keycode AS U32 = MmioReadField32(reportBuffer, 2, 0, 8)
            LET charCode AS U32 = UsbHidKeyboard.KeycodeToChar(keycode)
            IF charCode = 39 THEN
                IF ShiftHeld() = 1 THEN
                    charCode = 34
                END IF
            END IF
            IF charCode <> 0 THEN
                LET charAsU16 AS U16 = charCode
                RETURN charAsU16
            END IF
        END IF
    END IF

    RETURN 0
END FUNCTION

' ==========================================================================================
' RFC-0007 Program Mode -- Resident Program Memory (RPM), first real increment: PRINT and GOTO
' only (a deliberate, named scope reduction; LET/variables, IF, and FOR/NEXT are real, separate
' follow-on increments). No dynamic allocator exists on this backend, so RPM is a fixed-size
' sorted array in a dedicated scratch region -- the same "fixed scratch buffer, not a heap" idiom
' this fixture already uses for its line buffer, font table, and dashboard label table.
'
' Record layout (80 bytes/entry, RpmMaxLines() entries, always kept sorted+compacted so entries
' [0, count) are the whole live program with no gaps -- insert/delete do a real in-place shift
' rather than tombstoning, keeping RUN/LIST simple straight-line scans):
'   +0  lineNumber (U32)
'   +4  stmtType   (U32): 1 = PRINT, 2 = GOTO
'   +8  auxU32     (U32): GOTO's own target line number; unused (left 0) for PRINT
'   +12 text       (68 bytes, ASCII, null-terminated): PRINT's own literal payload; unused for GOTO
' ==========================================================================================

FUNCTION RpmStateAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(57671680))   ' 0x3700000, clear of DashStateAddress's own 0x3500000 region
END FUNCTION
FUNCTION RpmCountAddress() AS MMIOPTR
    RETURN RpmStateAddress()
END FUNCTION
FUNCTION RpmMaxLines() AS U32
    RETURN 64
END FUNCTION
FUNCTION RpmEntryStride() AS U32
    RETURN 80
END FUNCTION
FUNCTION RpmMaxTextChars() AS U32
    RETURN 67
END FUNCTION
FUNCTION RpmEntriesBase() AS MMIOPTR
    RETURN ADDRESS.Offset(RpmStateAddress(), 8)
END FUNCTION
FUNCTION RpmEntryAddress(index AS U32) AS MMIOPTR
    RETURN ADDRESS.Offset(RpmEntriesBase(), index * RpmEntryStride())
END FUNCTION
' One staged PRINT payload (parsed but not yet committed to a sorted slot) plus its own real
' length, since this dialect has no multi-value return -- the same "stage into fixed memory, read
' it back" idiom MID's own shared scratch buffer already established.
FUNCTION RpmStagingTextAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(RpmStateAddress(), 5128)   ' 8 + 64*80
END FUNCTION
FUNCTION RpmStagedTextLenAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(RpmStateAddress(), 5196)
END FUNCTION
FUNCTION RpmDecimalScratchAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(RpmStateAddress(), 5204)
END FUNCTION

FUNCTION IsDigit(ch AS U8) AS BOOL
    IF ch >= 48 THEN
        IF ch <= 57 THEN
            RETURN 1
        END IF
    END IF
    RETURN 0
END FUNCTION

FUNCTION CountLeadingDigits(lineBuf AS MMIOPTR, lineLen AS U32, startIdx AS U32) AS U32
    LET i AS U32 = startIdx
    LET done AS BOOL = 0
    WHILE done = 0
        IF i >= lineLen THEN
            done = 1
        ELSE
            LET ch AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, i))
            IF IsDigit(ch) = 1 THEN
                i = i + 1
            ELSE
                done = 1
            END IF
        END IF
    WEND
    RETURN i - startIdx
END FUNCTION

' No overflow protection -- callers are required to bound digitCount (<= 5) themselves first, the
' same discipline RpmHandleNumberedLine and its GOTO-target parsing both follow, since a U32 line
' number/target has no business exceeding RFC-0007 Section 6's own 65535 ceiling anyway.
FUNCTION ParseDecimalRange(lineBuf AS MMIOPTR, startIdx AS U32, digitCount AS U32) AS U32
    LET value AS U32 = 0
    LET i AS U32 = 0
    WHILE i < digitCount
        LET ch AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, startIdx + i))
        LET chVal AS U32 = ch
        value = (value * 10) + (chVal - 48)
        i = i + 1
    WEND
    RETURN value
END FUNCTION

FUNCTION SkipSpaces(lineBuf AS MMIOPTR, lineLen AS U32, startIdx AS U32) AS U32
    LET i AS U32 = startIdx
    LET done AS BOOL = 0
    WHILE done = 0
        IF i >= lineLen THEN
            done = 1
        ELSE
            LET ch AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, i))
            IF ch = 32 THEN
                i = i + 1
            ELSE
                done = 1
            END IF
        END IF
    WEND
    RETURN i
END FUNCTION

' Returns lineLen itself (never a real index) as the "no closing quote found" sentinel -- safe and
' unambiguous since every real index is strictly less than lineLen.
FUNCTION FindClosingQuote(lineBuf AS MMIOPTR, lineLen AS U32, startIdx AS U32) AS U32
    LET i AS U32 = startIdx
    LET done AS BOOL = 0
    WHILE done = 0
        IF i >= lineLen THEN
            done = 1
        ELSE
            LET ch AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, i))
            IF ch = 34 THEN
                done = 1
            ELSE
                i = i + 1
            END IF
        END IF
    WEND
    RETURN i
END FUNCTION

FUNCTION MatchPrintKeyword(lineBuf AS MMIOPTR, lineLen AS U32, idx AS U32) AS BOOL
    IF idx + 5 > lineLen THEN
        RETURN 0
    END IF
    LET c0 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, idx))
    LET c1 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, idx + 1))
    LET c2 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, idx + 2))
    LET c3 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, idx + 3))
    LET c4 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, idx + 4))
    IF c0 = 80 OR c0 = 112 THEN
        IF c1 = 82 OR c1 = 114 THEN
            IF c2 = 73 OR c2 = 105 THEN
                IF c3 = 78 OR c3 = 110 THEN
                    IF c4 = 84 OR c4 = 116 THEN
                        RETURN 1
                    END IF
                END IF
            END IF
        END IF
    END IF
    RETURN 0
END FUNCTION

FUNCTION MatchGotoKeyword(lineBuf AS MMIOPTR, lineLen AS U32, idx AS U32) AS BOOL
    IF idx + 4 > lineLen THEN
        RETURN 0
    END IF
    LET c0 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, idx))
    LET c1 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, idx + 1))
    LET c2 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, idx + 2))
    LET c3 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, idx + 3))
    IF c0 = 71 OR c0 = 103 THEN
        IF c1 = 79 OR c1 = 111 THEN
            IF c2 = 84 OR c2 = 116 THEN
                IF c3 = 79 OR c3 = 111 THEN
                    RETURN 1
                END IF
            END IF
        END IF
    END IF
    RETURN 0
END FUNCTION

FUNCTION LineIsRun(lineBuf AS MMIOPTR, lineLen AS U32) AS BOOL
    IF lineLen <> 3 THEN
        RETURN 0
    END IF
    LET c0 AS U8 = MEMORY.Read8(lineBuf)
    LET c1 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 1))
    LET c2 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 2))
    IF c0 = 82 OR c0 = 114 THEN
        IF c1 = 85 OR c1 = 117 THEN
            IF c2 = 78 OR c2 = 110 THEN
                RETURN 1
            END IF
        END IF
    END IF
    RETURN 0
END FUNCTION

FUNCTION LineIsList(lineBuf AS MMIOPTR, lineLen AS U32) AS BOOL
    IF lineLen <> 4 THEN
        RETURN 0
    END IF
    LET c0 AS U8 = MEMORY.Read8(lineBuf)
    LET c1 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 1))
    LET c2 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 2))
    LET c3 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 3))
    IF c0 = 76 OR c0 = 108 THEN
        IF c1 = 73 OR c1 = 105 THEN
            IF c2 = 83 OR c2 = 115 THEN
                IF c3 = 84 OR c3 = 116 THEN
                    RETURN 1
                END IF
            END IF
        END IF
    END IF
    RETURN 0
END FUNCTION

FUNCTION LineIsNew(lineBuf AS MMIOPTR, lineLen AS U32) AS BOOL
    IF lineLen <> 3 THEN
        RETURN 0
    END IF
    LET c0 AS U8 = MEMORY.Read8(lineBuf)
    LET c1 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 1))
    LET c2 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 2))
    IF c0 = 78 OR c0 = 110 THEN
        IF c1 = 69 OR c1 = 101 THEN
            IF c2 = 87 OR c2 = 119 THEN
                RETURN 1
            END IF
        END IF
    END IF
    RETURN 0
END FUNCTION

' Section 8 lists CLEAR alongside NEW as a real, required command, but with no variables yet (a
' real, separate future increment) CLEAR has nothing distinct from NEW to actually do -- rather
' than leave it unrecognized (a real RFC compliance gap) or silently wrong, it aliases NEW verbatim
' until real variable storage exists to give it its own honest behavior.
FUNCTION LineIsClear(lineBuf AS MMIOPTR, lineLen AS U32) AS BOOL
    IF lineLen <> 5 THEN
        RETURN 0
    END IF
    LET c0 AS U8 = MEMORY.Read8(lineBuf)
    LET c1 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 1))
    LET c2 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 2))
    LET c3 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 3))
    LET c4 AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, 4))
    IF c0 = 67 OR c0 = 99 THEN
        IF c1 = 76 OR c1 = 108 THEN
            IF c2 = 69 OR c2 = 101 THEN
                IF c3 = 65 OR c3 = 97 THEN
                    IF c4 = 82 OR c4 = 114 THEN
                        RETURN 1
                    END IF
                END IF
            END IF
        END IF
    END IF
    RETURN 0
END FUNCTION

' Real PRINT-statement parser shared by BOTH Immediate Mode (`PRINT "HI"`, RFC-0007 Section 4's own
' example, executed right away and never stored) and Program Mode (`10 PRINT "HI"`, staged then
' committed into RPM by the caller). Stages the extracted literal text into RpmStagingTextAddress
' and its real length into RpmStagedTextLenAddress on success; leaves both untouched on failure.
FUNCTION TryParsePrintStatement(lineBuf AS MMIOPTR, lineLen AS U32, startIdx AS U32) AS BOOL
    LET matched AS BOOL = MatchPrintKeyword(lineBuf, lineLen, startIdx)
    IF matched = 0 THEN
        RETURN 0
    END IF
    LET afterKw AS U32 = startIdx + 5
    LET afterSpace AS U32 = SkipSpaces(lineBuf, lineLen, afterKw)
    IF afterSpace >= lineLen THEN
        RETURN 0
    END IF
    LET quoteCh AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, afterSpace))
    IF quoteCh <> 34 THEN
        RETURN 0
    END IF
    LET textStart AS U32 = afterSpace + 1
    LET closeIdx AS U32 = FindClosingQuote(lineBuf, lineLen, textStart)
    IF closeIdx >= lineLen THEN
        RETURN 0
    END IF
    LET textLen AS U32 = closeIdx - textStart
    IF textLen > RpmMaxTextChars() THEN
        RETURN 0
    END IF
    LET i AS U32 = 0
    WHILE i < textLen
        LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(lineBuf, textStart + i))
        MEMORY.Write8(ADDRESS.Offset(RpmStagingTextAddress(), i), b)
        i = i + 1
    WEND
    MEMORY.Write32(RpmStagedTextLenAddress(), textLen)
    RETURN 1
END FUNCTION

FUNCTION RpmCopyEntry(srcIdx AS U32, dstIdx AS U32) AS U64
    LET srcAddr AS MMIOPTR = RpmEntryAddress(srcIdx)
    LET dstAddr AS MMIOPTR = RpmEntryAddress(dstIdx)
    MEMORY.Write32(dstAddr, MEMORY.Read32(srcAddr))
    MEMORY.Write32(ADDRESS.Offset(dstAddr, 4), MEMORY.Read32(ADDRESS.Offset(srcAddr, 4)))
    MEMORY.Write32(ADDRESS.Offset(dstAddr, 8), MEMORY.Read32(ADDRESS.Offset(srcAddr, 8)))
    LET i AS U32 = 0
    WHILE i < 68
        LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(srcAddr, 12 + i))
        MEMORY.Write8(ADDRESS.Offset(dstAddr, 12 + i), b)
        i = i + 1
    WEND
    RETURN 0
END FUNCTION

FUNCTION RpmWriteEntry(idx AS U32, lineNumber AS U32, stmtType AS U32, auxU32 AS U32, textLen AS U32) AS U64
    LET addr AS MMIOPTR = RpmEntryAddress(idx)
    MEMORY.Write32(addr, lineNumber)
    MEMORY.Write32(ADDRESS.Offset(addr, 4), stmtType)
    MEMORY.Write32(ADDRESS.Offset(addr, 8), auxU32)
    LET i AS U32 = 0
    WHILE i < textLen
        LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(RpmStagingTextAddress(), i))
        MEMORY.Write8(ADDRESS.Offset(addr, 12 + i), b)
        i = i + 1
    WEND
    MEMORY.Write8(ADDRESS.Offset(addr, 12 + textLen), 0)
    RETURN 0
END FUNCTION

' RpmMaxLines() itself doubles as the "not found" sentinel for both of the next two functions --
' unambiguous, since a real index is always strictly less than RpmMaxLines().
FUNCTION RpmFindIndex(lineNumber AS U32) AS U32
    LET count AS U32 = MEMORY.Read32(RpmCountAddress())
    LET i AS U32 = 0
    LET found AS U32 = RpmMaxLines()
    LET done AS BOOL = 0
    WHILE done = 0
        IF i >= count THEN
            done = 1
        ELSE
            LET entryLineNumber AS U32 = MEMORY.Read32(RpmEntryAddress(i))
            IF entryLineNumber = lineNumber THEN
                found = i
                done = 1
            ELSE
                i = i + 1
            END IF
        END IF
    WEND
    RETURN found
END FUNCTION

FUNCTION RpmFindInsertPosition(lineNumber AS U32, count AS U32) AS U32
    LET i AS U32 = 0
    LET done AS BOOL = 0
    WHILE done = 0
        IF i >= count THEN
            done = 1
        ELSE
            LET entryLineNumber AS U32 = MEMORY.Read32(RpmEntryAddress(i))
            IF entryLineNumber > lineNumber THEN
                done = 1
            ELSE
                i = i + 1
            END IF
        END IF
    WEND
    RETURN i
END FUNCTION

' RFC-0007 Section 5's own edit rules (new line number -> insert, existing -> replace) plus
' Section 6's own "no partial modification" requirement on a full table -- capacity is checked
' BEFORE any shifting begins, so a failed insert never corrupts the existing sorted program.
FUNCTION RpmCommit(lineNumber AS U32, stmtType AS U32, auxU32 AS U32, textLen AS U32) AS BOOL
    LET count AS U32 = MEMORY.Read32(RpmCountAddress())
    LET foundIdx AS U32 = RpmFindIndex(lineNumber)

    IF foundIdx <> RpmMaxLines() THEN
        RpmWriteEntry(foundIdx, lineNumber, stmtType, auxU32, textLen)
        RETURN 1
    END IF

    IF count >= RpmMaxLines() THEN
        RETURN 0
    END IF

    LET insertAt AS U32 = RpmFindInsertPosition(lineNumber, count)
    LET i AS U32 = count
    WHILE i > insertAt
        RpmCopyEntry(i - 1, i)
        i = i - 1
    WEND

    RpmWriteEntry(insertAt, lineNumber, stmtType, auxU32, textLen)
    MEMORY.Write32(RpmCountAddress(), count + 1)
    RETURN 1
END FUNCTION

FUNCTION RpmDelete(lineNumber AS U32) AS U64
    LET count AS U32 = MEMORY.Read32(RpmCountAddress())
    LET foundIdx AS U32 = RpmFindIndex(lineNumber)
    IF foundIdx = RpmMaxLines() THEN
        RETURN 0
    END IF
    LET i AS U32 = foundIdx
    WHILE i < count - 1
        RpmCopyEntry(i + 1, i)
        i = i + 1
    WEND
    MEMORY.Write32(RpmCountAddress(), count - 1)
    RETURN 0
END FUNCTION

FUNCTION RpmNew() AS U64
    MEMORY.Write32(RpmCountAddress(), 0)
    RETURN 0
END FUNCTION

' Same digit-string-reversal pattern this project already established (ArcFSWriteDecimal), scoped
' to U32 since RFC-0007 line numbers top out at 65535.
FUNCTION RpmWriteDecimal(dest AS MMIOPTR, value AS U32) AS U32
    IF value = 0 THEN
        MEMORY.Write8(dest, 48)
        RETURN 1
    END IF
    LET v AS U32 = value
    LET count AS U32 = 0
    WHILE v > 0
        LET digit AS U32 = v MOD 10
        LET digitByte AS U8 = digit + 48
        MEMORY.Write8(ADDRESS.Offset(dest, count), digitByte)
        v = v \ 10
        count = count + 1
    WEND
    LET lo AS U32 = 0
    LET hi AS U32 = count - 1
    WHILE lo < hi
        LET a AS U8 = MEMORY.Read8(ADDRESS.Offset(dest, lo))
        LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(dest, hi))
        MEMORY.Write8(ADDRESS.Offset(dest, lo), b)
        MEMORY.Write8(ADDRESS.Offset(dest, hi), a)
        lo = lo + 1
        hi = hi - 1
    WEND
    RETURN count
END FUNCTION

FUNCTION EchoDecimal(value AS U32) AS U64
    LET buf AS MMIOPTR = RpmDecimalScratchAddress()
    LET count AS U32 = RpmWriteDecimal(buf, value)
    LET i AS U32 = 0
    WHILE i < count
        LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(buf, i))
        EchoChar(b)
        i = i + 1
    WEND
    RETURN 0
END FUNCTION

FUNCTION RpmEchoEntryText(addr AS MMIOPTR) AS U64
    LET textAddr AS MMIOPTR = ADDRESS.Offset(addr, 12)
    LET j AS U32 = 0
    LET done AS BOOL = 0
    WHILE done = 0
        LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(textAddr, j))
        IF b = 0 THEN
            done = 1
        ELSE
            EchoChar(b)
            j = j + 1
        END IF
    WEND
    PrintCRLF()
    RETURN 0
END FUNCTION

FUNCTION PrintOutOfMemoryError() AS U64
    EchoChar(63)
    EchoChar(79)
    EchoChar(85)
    EchoChar(84)
    EchoChar(32)
    EchoChar(79)
    EchoChar(70)
    EchoChar(32)
    EchoChar(80)
    EchoChar(82)
    EchoChar(79)
    EchoChar(71)
    EchoChar(82)
    EchoChar(65)
    EchoChar(77)
    EchoChar(32)
    EchoChar(77)
    EchoChar(69)
    EchoChar(77)
    EchoChar(79)
    EchoChar(82)
    EchoChar(89)
    PrintCRLF()
    RETURN 0
END FUNCTION

FUNCTION PrintBreakMessage(lineNumber AS U32) AS U64
    EchoChar(66)
    EchoChar(82)
    EchoChar(69)
    EchoChar(65)
    EchoChar(75)
    EchoChar(32)
    EchoChar(73)
    EchoChar(78)
    EchoChar(32)
    EchoDecimal(lineNumber)
    PrintCRLF()
    RETURN 0
END FUNCTION

FUNCTION PrintUndefinedStatementError(lineNumber AS U32) AS U64
    EchoChar(63)
    EchoChar(85)
    EchoChar(78)
    EchoChar(68)
    EchoChar(69)
    EchoChar(70)
    EchoChar(73)
    EchoChar(78)
    EchoChar(69)
    EchoChar(68)
    EchoChar(32)
    EchoChar(83)
    EchoChar(84)
    EchoChar(65)
    EchoChar(84)
    EchoChar(69)
    EchoChar(77)
    EchoChar(69)
    EchoChar(78)
    EchoChar(84)
    EchoChar(32)
    EchoChar(73)
    EchoChar(78)
    EchoChar(32)
    EchoDecimal(lineNumber)
    PrintCRLF()
    RETURN 0
END FUNCTION

' RFC-0007 Section 5's edit rules: a bare line number deletes; `<N> PRINT "..."` or `<N> GOTO <M>`
' insert-or-replace via RpmCommit. digitCount is the caller's own already-bounded (<= 5) leading
' digit count, avoiding a second, unbounded scan here.
FUNCTION RpmHandleNumberedLine(lineBuf AS MMIOPTR, lineLen AS U32, digitCount AS U32) AS U64
    LET lineNumber AS U32 = ParseDecimalRange(lineBuf, 0, digitCount)
    IF lineNumber = 0 THEN
        PrintSyntaxError()
        RETURN 0
    END IF
    IF lineNumber > 65535 THEN
        PrintSyntaxError()
        RETURN 0
    END IF

    LET idx AS U32 = SkipSpaces(lineBuf, lineLen, digitCount)
    IF idx >= lineLen THEN
        RpmDelete(lineNumber)
        RETURN 0
    END IF

    LET okPrint AS BOOL = TryParsePrintStatement(lineBuf, lineLen, idx)
    IF okPrint = 1 THEN
        LET textLen AS U32 = MEMORY.Read32(RpmStagedTextLenAddress())
        LET stored AS BOOL = RpmCommit(lineNumber, 1, 0, textLen)
        IF stored = 0 THEN
            PrintOutOfMemoryError()
        END IF
        RETURN 0
    END IF

    LET okGoto AS BOOL = MatchGotoKeyword(lineBuf, lineLen, idx)
    IF okGoto = 1 THEN
        LET afterKw AS U32 = idx + 4
        LET afterSpace AS U32 = SkipSpaces(lineBuf, lineLen, afterKw)
        LET targetDigits AS U32 = CountLeadingDigits(lineBuf, lineLen, afterSpace)
        IF targetDigits = 0 THEN
            PrintSyntaxError()
            RETURN 0
        END IF
        IF targetDigits > 5 THEN
            PrintSyntaxError()
            RETURN 0
        END IF
        LET target AS U32 = ParseDecimalRange(lineBuf, afterSpace, targetDigits)
        LET stored AS BOOL = RpmCommit(lineNumber, 2, target, 0)
        IF stored = 0 THEN
            PrintOutOfMemoryError()
        END IF
        RETURN 0
    END IF

    PrintSyntaxError()
    RETURN 0
END FUNCTION

FUNCTION RpmList() AS U64
    LET count AS U32 = MEMORY.Read32(RpmCountAddress())
    LET i AS U32 = 0
    WHILE i < count
        LET addr AS MMIOPTR = RpmEntryAddress(i)
        LET lineNumber AS U32 = MEMORY.Read32(addr)
        LET stmtType AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 4))
        EchoDecimal(lineNumber)
        EchoChar(32)
        IF stmtType = 1 THEN
            EchoChar(80)
            EchoChar(82)
            EchoChar(73)
            EchoChar(78)
            EchoChar(84)
            EchoChar(32)
            EchoChar(34)
            LET textAddr AS MMIOPTR = ADDRESS.Offset(addr, 12)
            LET j AS U32 = 0
            LET done AS BOOL = 0
            WHILE done = 0
                LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(textAddr, j))
                IF b = 0 THEN
                    done = 1
                ELSE
                    EchoChar(b)
                    j = j + 1
                END IF
            WEND
            EchoChar(34)
        ELSE
            IF stmtType = 2 THEN
                EchoChar(71)
                EchoChar(79)
                EchoChar(84)
                EchoChar(79)
                EchoChar(32)
                LET target AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 8))
                EchoDecimal(target)
            END IF
        END IF
        PrintCRLF()
        i = i + 1
    WEND
    RETURN 0
END FUNCTION

' The real interpreter: walks RPM in sorted order, GOTO re-seeks by real line number (not array
' index -- the table is sparse), PRINT echoes its own staged literal. A cooperative ESC check runs
' once per statement (this backend has no keyboard IRQ yet, only polling) so a genuine `10 PRINT
' "HI" / 20 GOTO 10` infinite loop can still be broken out of -- the real, necessary answer to
' "how do you stop a running program" that choosing to support GOTO at all requires.
FUNCTION RpmRun(usbSlotId AS U32) AS U64
    LET count AS U32 = MEMORY.Read32(RpmCountAddress())
    LET idx AS U32 = 0
    LET exitReason AS U32 = 0
    LET stopLineNumber AS U32 = 0
    LET looping AS BOOL = 1

    WHILE looping = 1
        IF idx >= count THEN
            looping = 0
        ELSE
            LET addr AS MMIOPTR = RpmEntryAddress(idx)
            LET curLineNumber AS U32 = MEMORY.Read32(addr)
            LET key AS U16 = PollAnyKey(usbSlotId)
            IF key = 27 THEN
                exitReason = 1
                stopLineNumber = curLineNumber
                looping = 0
            ELSE
                LET stmtType AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 4))
                IF stmtType = 1 THEN
                    RpmEchoEntryText(addr)
                    idx = idx + 1
                ELSE
                    IF stmtType = 2 THEN
                        LET target AS U32 = MEMORY.Read32(ADDRESS.Offset(addr, 8))
                        LET targetIdx AS U32 = RpmFindIndex(target)
                        IF targetIdx = RpmMaxLines() THEN
                            exitReason = 2
                            stopLineNumber = curLineNumber
                            looping = 0
                        ELSE
                            idx = targetIdx
                        END IF
                    ELSE
                        idx = idx + 1
                    END IF
                END IF
            END IF
        END IF
    WEND

    IF exitReason = 1 THEN
        PrintBreakMessage(stopLineNumber)
    END IF
    IF exitReason = 2 THEN
        PrintUndefinedStatementError(stopLineNumber)
    END IF
    RETURN 0
END FUNCTION

' The real Enter-key dispatcher, factored out of Main() entirely -- Main() has already needed two
' other extractions this project (SetupUsbKeyboard, SetupGopDashboard) purely to stay under this
' backend's own real stack-frame budget, and this dispatch alone needed several new locals across
' 8 real command branches. Returns 0 to stop the whole READY. loop (the TEST-ONLY EXIT command),
' 1 otherwise.
FUNCTION HandleEnteredLine(lineBuf AS MMIOPTR, lineLen AS U32, usbSlotId AS U32) AS BOOL
    LET dispatched AS BOOL = 0
    LET running AS BOOL = 1

    IF dispatched = 0 THEN
        IF LineIsHelp(lineBuf, lineLen) = 1 THEN
            PrintHelpText()
            dispatched = 1
        END IF
    END IF
    IF dispatched = 0 THEN
        IF LineIsOt(lineBuf, lineLen) = 1 THEN
            PrintOtText()
            dispatched = 1
        END IF
    END IF
    IF dispatched = 0 THEN
        IF LineIsExit(lineBuf, lineLen) = 1 THEN
            PrintHaltText()
            running = 0
            dispatched = 1
        END IF
    END IF
    IF dispatched = 0 THEN
        IF LineIsRun(lineBuf, lineLen) = 1 THEN
            RpmRun(usbSlotId)
            dispatched = 1
        END IF
    END IF
    IF dispatched = 0 THEN
        IF LineIsList(lineBuf, lineLen) = 1 THEN
            RpmList()
            dispatched = 1
        END IF
    END IF
    IF dispatched = 0 THEN
        IF LineIsNew(lineBuf, lineLen) = 1 THEN
            RpmNew()
            dispatched = 1
        END IF
    END IF
    IF dispatched = 0 THEN
        IF LineIsClear(lineBuf, lineLen) = 1 THEN
            RpmNew()
            dispatched = 1
        END IF
    END IF
    IF dispatched = 0 THEN
        LET firstCh AS U8 = MEMORY.Read8(lineBuf)
        IF IsDigit(firstCh) = 1 THEN
            LET leadDigits AS U32 = CountLeadingDigits(lineBuf, lineLen, 0)
            IF leadDigits > 5 THEN
                PrintSyntaxError()
            ELSE
                RpmHandleNumberedLine(lineBuf, lineLen, leadDigits)
            END IF
            dispatched = 1
        END IF
    END IF
    IF dispatched = 0 THEN
        LET immediateOk AS BOOL = TryParsePrintStatement(lineBuf, lineLen, 0)
        IF immediateOk = 1 THEN
            LET textLen AS U32 = MEMORY.Read32(RpmStagedTextLenAddress())
            LET k AS U32 = 0
            WHILE k < textLen
                LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(RpmStagingTextAddress(), k))
                EchoChar(b)
                k = k + 1
            WEND
            PrintCRLF()
            dispatched = 1
        END IF
    END IF
    IF dispatched = 0 THEN
        PrintSyntaxError()
    END IF

    RETURN running
END FUNCTION

' Real, dynamically-computed 1GB identity-map extension -- reusable for ANY real physical MMIO/
' framebuffer region this fixture needs to keep reading/writing after its own CR3 switch, given
' just that region's own real base address (never hardcoded, always read back from whichever real
' driver/protocol discovered it) and one spare, already-allocated page to use as a second PDPT if a
' genuinely new PML4 slot is needed. See this fixture's own header comment (added when the xHCI
' MMIO BAR was the first real region found needing this) for the full finding.
'
' Real, honest fail-open: if physAddr is 0 (the region was never actually discovered/mapped, e.g.
' no xHCI controller present at all), this is a deliberate no-op -- an earlier version of this
' logic, before this guard existed, silently corrupted the existing low-1GB mapping in exactly
' that case, caught immediately by a real PS/2-only negative-control run (SUBSTRATE PDPT BAD).
FUNCTION MapExtra1GbRegion(root AS U64, lowPdpt AS U64, sparePdptPage AS U64, physAddr AS U64) AS U64
    IF physAddr = 0 THEN
        RETURN 0
    END IF
    LET oneGb AS U64 = 1073741824
    LET entriesPerPml4Slot AS U64 = 512
    LET gbIndexOverall AS U64 = physAddr \ oneGb
    LET pml4Index AS U64 = gbIndexOverall \ entriesPerPml4Slot
    LET pdptEntryIndex AS U64 = gbIndexOverall - (pml4Index * entriesPerPml4Slot)
    LET gbAlignedBase AS U64 = gbIndexOverall * oneGb
    LET pdptEntryOffset AS U64 = pdptEntryIndex * 8

    IF pml4Index = 0 THEN
        ' Same 512GB window the low-1GB map's own PDPT already covers -- reuse it directly rather
        ' than also wiring a spare PDPT into root[0], which would silently replace (not add to)
        ' the existing low-1GB mapping.
        MEMORY.PhysicalWrite64(ADDRESS.Physical(lowPdpt + pdptEntryOffset), gbAlignedBase OR 131)
        RETURN 0
    END IF

    LET pml4SlotOffset AS U64 = pml4Index * 8
    LET existingEntry AS U64 = MEMORY.Read64(ADDRESS.Virtual(root + pml4SlotOffset))
    IF existingEntry <> 0 THEN
        ' This PML4 slot was already wired up by an earlier real region (e.g. both the xHCI BAR
        ' and the GOP framebuffer happening to share the same 512GB window) -- reuse that SAME
        ' already-mapped PDPT instead of the caller's own spare page, so the earlier region's own
        ' mapping isn't orphaned.
        LET existingPdpt AS U64 = (existingEntry \ 4096) * 4096
        MEMORY.PhysicalWrite64(ADDRESS.Physical(existingPdpt + pdptEntryOffset), gbAlignedBase OR 131)
        RETURN 0
    END IF

    MEMORY.PhysicalWrite64(ADDRESS.Physical(root + pml4SlotOffset), sparePdptPage OR 3)
    MEMORY.PhysicalWrite64(ADDRESS.Physical(sparePdptPage + pdptEntryOffset), gbAlignedBase OR 131)
    RETURN sparePdptPage
END FUNCTION

' TEMPORARY real-hardware diagnostic (RFC-0045 Phase 5): a real physical run froze visibly at
' "SUBSTRATE TABLE OK", the last ConsoleOut marker before ExitBootServices -- everything after that
' point (ExitBootServices itself, the CR3 switch, GDT/IDT/CS reload, the new framebuffer identity
' mapping) is genuinely untested on real silicon, since aps-gdt-reload.abas's own proof of this
' exact sequence was QEMU-only. With no real serial capture available on this hardware, the ONLY
' observable channel left is the screen itself -- this draws one small, distinctly-colored raw
' pixel block per real risk point, each in its own fixed screen position, so whichever block is
' the LAST one drawn before a real freeze tells us exactly how far execution actually got. Bypasses
' the font/terminal system entirely (direct MEMORY.Write32 only) so it can't itself be broken by
' whatever this is diagnosing.
FUNCTION DrawDiagBlock(index AS U32, color AS U32) AS U64
    LET phys AS U64 = MEMORY.Read64(TermFramebufferPhysAddress())
    LET stride AS U32 = MEMORY.Read32(TermStrideAddress())
    LET mmio AS MMIOPTR = ADDRESS.MMIO(ADDRESS.Virtual(phys))
    LET blockX AS U32 = index * 60
    LET blockY AS U32 = 300   ' well below where the terminal's own text ever reaches, so PrintBanner/TermClear never overwrite these
    LET dy AS U32 = 0
    WHILE dy < 50
        LET dx AS U32 = 0
        WHILE dx < 50
            LET px AS U32 = blockX + dx
            LET py AS U32 = blockY + dy
            LET pixelOffset AS U32 = (py * stride + px) * 4
            LET pixel AS MMIOPTR = ADDRESS.Offset(mmio, pixelOffset)
            MEMORY.Write32(pixel, color)
            dx = dx + 1
        WEND
        dy = dy + 1
    WEND
    RETURN 0
END FUNCTION

' Extracted out of Main (its own function, its own stack frame) purely to keep Main itself under
' this backend's own real per-function stack-frame budget -- Main was already close to that limit
' before this real-hardware diagnostic session even started; this real USB enumeration block alone
' accounted for ~9 of Main's own locals.
FUNCTION SetupUsbKeyboard(systemTable AS UEFI.SystemTable) AS U32
    LET usbSlotId AS U32 = 0
    LET pciFound AS BOOL = UsbXhci.DiscoverPci(systemTable)
    IF pciFound = 1 THEN
        UsbXhci.MapMmio(systemTable)
        LET maxPorts AS U32 = UsbXhci.MaxPorts()
        LET resetOk AS BOOL = UsbXhci.Reset(systemTable)
        IF resetOk = 1 THEN
            LET ringsOk AS BOOL = UsbXhci.SetupRings(systemTable)
            IF ringsOk = 1 THEN
                LET startOk AS BOOL = UsbXhci.Start()
                IF startOk = 1 THEN
                    LET connectedPort AS U32 = 0
                    LET portIndex AS U32 = 1
                    WHILE portIndex <= maxPorts
                        LET raw AS U32 = UsbXhci.PortRaw(portIndex)
                        IF (raw AND 1) <> 0 THEN
                            IF connectedPort = 0 THEN
                                connectedPort = portIndex
                            END IF
                        END IF
                        portIndex = portIndex + 1
                    WEND
                    IF connectedPort <> 0 THEN
                        LET portResetOk AS BOOL = UsbXhci.ResetPort(connectedPort)
                        IF portResetOk = 1 THEN
                            usbSlotId = UsbHidKeyboard.Init(systemTable, connectedPort)
                        END IF
                    END IF
                END IF
            END IF
        END IF
    END IF
    RETURN usbSlotId
END FUNCTION

' Extracted out of Main for the same real reason SetupUsbKeyboard was: Main's own per-function
' stack-frame budget. Real GOP discovery, terminal state setup, and the dashboard's own first
' real paint -- moved to the very start of Main's own execution (ahead of PS/2 + USB HID setup)
' so the real System Assembly dashboard (docs/arcology-boot-screen-concept.md) can be brought up
' as early as possible and show every REAL subsequent milestone live, not replayed after the
' fact. Pre-exit, needs BootServices. Allowed to fail closed (returns 0): a real on-screen
' dashboard is this fixture's own real goal, but a serial-only session (this project's own prior,
' already-proven fallback) remains genuinely correct if no GOP device is ever found.
FUNCTION SetupGopDashboard(systemTable AS UEFI.SystemTable) AS BOOL
    LET gop AS UEFI.GraphicsOutputProtocol = UEFI.GOP.Discover(systemTable)
    IF gop = 0 THEN
        systemTable.ConsoleOut.Write("SUBSTRATE GOP NONE\r\n")
        RETURN 0
    END IF
    LET framebuffer AS PHYSICALPTR = UEFI.GOP.FrameBufferBase(gop)
    LET widthPx AS U32 = UEFI.GOP.Width(gop)
    LET heightPx AS U32 = UEFI.GOP.Height(gop)
    LET stride AS U32 = UEFI.GOP.PixelsPerScanLine(gop)
    LET fbBaseAsU64 AS U64 = ADDRESS.Value(framebuffer)
    MEMORY.Write64(TermFramebufferPhysAddress(), fbBaseAsU64)
    MEMORY.Write32(TermStrideAddress(), stride)
    MEMORY.Write32(TermWidthPxAddress(), widthPx)
    MEMORY.Write32(TermHeightPxAddress(), heightPx)

    MEMORY.Write32(TermScaleAddress(), ComputeTermScale(widthPx))

    LET cellPx AS U32 = TermCellPx()
    LET termCols AS U32 = widthPx \ cellPx
    LET termRows AS U32 = heightPx \ cellPx
    MEMORY.Write32(TermColsAddress(), termCols)
    MEMORY.Write32(TermRowsAddress(), termRows)
    WriteFontData()
    WriteDashboardLabels()
    MEMORY.Write32(TermReadyAddress(), 1)
    systemTable.ConsoleOut.Write("SUBSTRATE GOP READY\r\n")
    DashDrawStatic()
    DashSetSubsystem(4, 1)
    DashAddEvent(LABEL_EV_GOP_OK())
    DashUpdateAssembly(1, 10)
    RETURN 1
END FUNCTION

FUNCTION Main(imageHandle AS UEFI.Handle, systemTable AS UEFI.SystemTable) AS U64
    systemTable.BootServices.SetWatchdogTimer(0, 0, 0, 0)
    systemTable.ConsoleOut.Write("SUBSTRATE PRE\r\n")
    MEMORY.Write32(TermReadyAddress(), 0)

    ' A REAL bug found on real hardware, never reproduced under QEMU (the exact same class of gap
    ' as the earlier CR3/identity-map finding): QEMU's own VM RAM starts fully zeroed on every boot,
    ' a well-known QEMU behavior this fixture was silently relying on for RpmCountAddress and
    ' KeyModifierStateAddress -- neither was ever explicitly zeroed before first use, only assumed
    ' zero. Real physical RAM makes no such guarantee at all; on the user's own laptop,
    ' RpmCountAddress read back as real leftover garbage, so RUN walked a garbage-length "program"
    ' of uninitialized entries (almost none of which coincidentally matched stmtType 1 or 2, so
    ' nothing ever printed) until a real injected ESC caught it mid-scan and reported whatever
    ' garbage happened to be sitting in that entry's own lineNumber field as the break line. Fixed
    ' by explicitly zeroing both here, matching TermReadyAddress's own existing precedent just above
    ' -- every piece of this fixture's own persistent state that gets READ before any code path is
    ' guaranteed to have WRITTEN it first needs the same treatment, not just this one.
    MEMORY.Write32(RpmCountAddress(), 0)
    MEMORY.Write32(KeyModifierStateAddress(), 0)

    LET gopOk AS BOOL = SetupGopDashboard(systemTable)

    PS2Keyboard.Init()
    IF gopOk = 1 THEN
        DashSetSubsystem(2, 1)
        DashAddEvent(LABEL_EV_PS2())
        DashUpdateAssembly(2, 10)
    END IF

    ' Real USB HID keyboard enumeration -- allowed to fail closed (usbSlotId stays 0) if no USB
    ' keyboard is attached; PS/2 alone is a real, correct configuration (RFC-0045's own explicit
    ' "EITHER input path" requirement), not a fixture failure. All of this needs BootServices.
    ' AllocatePages and must happen before ExitBootServices.
    LET usbSlotId AS U32 = SetupUsbKeyboard(systemTable)
    IF usbSlotId <> 0 THEN
        ' Once the dashboard is live, its own event feed already carries this milestone (labeled,
        ' not just logged) -- firmware's own ConsoleOut text cursor keeps advancing independently of
        ' our drawing, and a later write here would land its glyphs directly on top of already-
        ' painted dashboard pixels (confirmed via a real QEMU screendump: "TABLE OK" bled straight
        ' across the I/O panel). Gated to serial-only fallback for the no-GOP case.
        IF gopOk = 0 THEN
            systemTable.ConsoleOut.Write("SUBSTRATE USB READY\r\n")
        ELSE
            DashAddEvent(LABEL_EV_HID_OK())
        END IF
    ELSE
        IF gopOk = 0 THEN
            systemTable.ConsoleOut.Write("SUBSTRATE USB NONE\r\n")
        ELSE
            DashAddEvent(LABEL_EV_HID_NONE())
        END IF
    END IF
    IF gopOk = 1 THEN
        DashSetSubsystem(2, 3)
        DashSetSubsystem(3, 3)
        DashUpdateAssembly(3, 10)
    END IF

    ' 5 pages: root/PDPT0/PD0 (the same low-1GB identity map aps-gdt-reload.abas established) plus
    ' two spare PDPT pages for MapExtra1GbRegion -- one for the xHCI controller's own real MMIO
    ' BAR, one for the GOP framebuffer's own real base, whichever real PML4 slots they each land
    ' in (see MapExtra1GbRegion's own header comment for the full finding this closes).
    LET root AS U64 = 0
    LET rootAddress AS PTR = ADDRESS.Local(root)
    LET pageStatus AS U64 = systemTable.BootServices.AllocatePages(0, 2, 5, rootAddress)
    IF pageStatus <> 0 THEN
        systemTable.ConsoleOut.Write("SUBSTRATE ALLOC FAIL\r\n")
        CPU.HaltForever
    END IF
    LET idtRoot AS U64 = 0
    LET idtRootAddress AS PTR = ADDRESS.Local(idtRoot)
    LET idtPageStatus AS U64 = systemTable.BootServices.AllocatePages(0, 2, 2, idtRootAddress)
    IF idtPageStatus <> 0 THEN
        systemTable.ConsoleOut.Write("SUBSTRATE IDT ALLOC FAIL\r\n")
        CPU.HaltForever
    END IF
    LET gdtRoot AS U64 = 0
    LET gdtRootAddress AS PTR = ADDRESS.Local(gdtRoot)
    LET gdtPageStatus AS U64 = systemTable.BootServices.AllocatePages(0, 2, 1, gdtRootAddress)
    IF gdtPageStatus <> 0 THEN
        systemTable.ConsoleOut.Write("SUBSTRATE GDT ALLOC FAIL\r\n")
        CPU.HaltForever
    END IF

    LET pdpt AS U64 = root + 4096
    LET pageDirectory AS U64 = root + 8192
    LET pdptExtraA AS U64 = root + 12288
    LET pdptExtraB AS U64 = root + 16384
    LET clearIndex AS U64 = 0
    WHILE clearIndex < 2560
        MEMORY.PhysicalWrite64(ADDRESS.Physical(root + (clearIndex * 8)), 0)
        clearIndex = clearIndex + 1
    WEND
    MEMORY.PhysicalWrite64(ADDRESS.Physical(root), pdpt OR 3)
    MEMORY.PhysicalWrite64(ADDRESS.Physical(pdpt), pageDirectory OR 3)
    LET directoryIndex AS U64 = 0
    WHILE directoryIndex < 512
        MEMORY.PhysicalWrite64(ADDRESS.Physical(pageDirectory + (directoryIndex * 8)), (directoryIndex * 2097152) OR 131)
        directoryIndex = directoryIndex + 1
    WEND

    ' A REAL bug found on real hardware, never reproduced under QEMU: aps-gdt-reload.abas's own
    ' minimal identity map (just the low 1GB above) is only enough if the CPU can keep fetching
    ' its OWN currently-executing code the instant CR3 changes -- which depends on where firmware
    ' actually loaded this image and its stack. QEMU/OVMF happens to place both within the first
    ' 1GB, so this was never visible there; nothing guarantees that on real hardware, and a real
    ' physical run froze at exactly this point (confirmed via a real checkpoint-color diagnostic:
    ' visible through "ExitBootServices succeeded", never reaching "CR3 switch succeeded"). Rather
    ' than trying to discover the image's own exact base/stack (LoadedImageProtocol, RSP, etc.) and
    ' map just that, this identity-maps the WHOLE 512GB range PML4 slot 0 can address, using the
    ' SAME already-allocated pdpt page: entry 0 keeps the existing 2MB-granularity low-1GB mapping
    ' above, entries 1-511 become direct 1GB pages covering 1GB-512GB. Free (no extra allocation),
    ' and makes "is the currently-running code/stack identity-mapped" no longer a real question for
    ' any real machine's own firmware-chosen load address under 512GB -- every real system this
    ' project targets.
    LET extraPdptIndex AS U64 = 1
    WHILE extraPdptIndex < 512
        LET gbBase AS U64 = extraPdptIndex * 1073741824
        MEMORY.PhysicalWrite64(ADDRESS.Physical(pdpt + (extraPdptIndex * 8)), gbBase OR 131)
        extraPdptIndex = extraPdptIndex + 1
    WEND

    LET mmioBasePhys AS U64 = MEMORY.Read64(XhciMmioBasePhysAddress())
    MapExtra1GbRegion(root, pdpt, pdptExtraA, mmioBasePhys)

    LET fbBasePhysForMap AS U64 = 0
    IF gopOk = 1 THEN
        fbBasePhysForMap = MEMORY.Read64(TermFramebufferPhysAddress())
    END IF
    MapExtra1GbRegion(root, pdpt, pdptExtraB, fbBasePhysForMap)

    LET rootCheck AS U64 = MEMORY.Read64(ADDRESS.Virtual(root))
    LET pdptCheck AS U64 = MEMORY.Read64(ADDRESS.Virtual(pdpt))
    IF rootCheck <> (pdpt OR 3) THEN
        systemTable.ConsoleOut.Write("SUBSTRATE ROOT BAD\r\n")
        CPU.HaltForever
    END IF
    IF pdptCheck <> (pageDirectory OR 3) THEN
        systemTable.ConsoleOut.Write("SUBSTRATE PDPT BAD\r\n")
        CPU.HaltForever
    END IF
    IF gopOk = 0 THEN
        systemTable.ConsoleOut.Write("SUBSTRATE TABLE OK\r\n")
    END IF
    IF gopOk = 1 THEN
        ' Real checkpoint (was a raw diagnostic color block during this fixture's own real-
        ' hardware bring-up; the dashboard's own MEMORY panel now carries the same signal, labeled
        ' instead of just colored): the real page-table build above (including MapExtra1GbRegion
        ' for both the xHCI BAR and the framebuffer, and the full 512GB PML4-slot-0 identity map
        ' this fixture's own real hardware freeze required) completed successfully.
        DashSetSubsystem(0, 3)
        DashAddEvent(LABEL_EV_MEM())
        DashUpdateAssembly(4, 10)
    END IF

    CPU.DisableInterrupts
    LET exitStatus AS U64 = AcquireMapAndExit(imageHandle, systemTable)
    IF exitStatus <> 0 THEN
        CPU.HaltForever
    END IF
    IF gopOk = 1 THEN
        ' A real ExitBootServices call succeeded and the dashboard (raw framebuffer writes only,
        ' no ConsoleOut) still works -- confirms ExitBootServices itself isn't the freeze, and
        ' (since CR3 hasn't been touched yet) that firmware's own page tables are still intact.
        DashSetSubsystem(1, 1)
        DashAddEvent(LABEL_EV_BS())
        DashUpdateAssembly(5, 10)
    END IF

    ' Past this point, ConsoleOut is never touched again -- it hangs post-ExitBootServices (RFC-
    ' 0045 Section 4's own real finding). All further output goes through EchoChar (real serial +
    ' the dashboard/on-screen terminal below).
    CPU.DisableInterrupts
    CPU.WriteCR3(root)
    LET activeRoot AS U64 = CPU.ReadCR3()
    IF activeRoot <> root THEN
        CPU.HaltForever
    END IF
    IF gopOk = 1 THEN
        ' CR3 now points at THIS fixture's own page tables, and a real dashboard redraw to the
        ' SAME framebuffer address still works -- confirms MapExtra1GbRegion's own real 1GB
        ' mapping for the framebuffer, AND the full 512GB low-slot identity map, are both actually
        ' correct on this real hardware, not just under QEMU. The concept doc's own most important
        ' symbolic moment: the real UEFI-to-APS authority handoff.
        DashSetSubsystem(1, 3)
        DashAddEvent(LABEL_EV_CR3())
        DashUpdateAssembly(6, 10)
        DashShowSovereign()
        DashSetStatus(LABEL_STATUS_TITLE(), DashMagenta())
    END IF

    SerialInit()

    LET gdtTable AS MMIOPTR = ADDRESS.MMIO(ADDRESS.Virtual(gdtRoot))
    LET tssTable AS MMIOPTR = ADDRESS.MMIO(ADDRESS.Virtual(gdtRoot + 256))
    LET gdtPseudo AS MMIOPTR = ADDRESS.MMIO(ADDRESS.Virtual(gdtRoot + 512))
    LET tssBase AS U64 = ADDRESS.Value(tssTable)
    BuildTSS(tssTable, 0, 0)
    BuildMinimalGDT(gdtTable, gdtPseudo, tssBase)

    LET idtTable AS MMIOPTR = ADDRESS.MMIO(ADDRESS.Virtual(idtRoot))
    LET idtPseudo AS MMIOPTR = ADDRESS.MMIO(ADDRESS.Virtual(idtRoot + 4096))
    BuildMinimalIDT(idtTable, idtPseudo, 8)

    ActivateDescriptorTables(ADDRESS.Value(gdtPseudo), ADDRESS.Value(idtPseudo), 24, 8)
    CPU.ReloadStackSegment(16)

    LET liveCS AS U64 = CPU.ReadCS()
    IF liveCS <> 8 THEN
        CPU.HaltForever
    END IF
    IF gopOk = 1 THEN
        ' The new GDT/IDT are loaded, CS/SS are reloaded against them, and CPU.ReadCS() confirms
        ' it live -- a real dashboard redraw still works. Everything real risk in this fixture's
        ' own post-exit sequence is now confirmed working.
        DashAddEvent(LABEL_EV_GDT())
        DashUpdateAssembly(7, 10)
    END IF

    IF gopOk = 1 THEN
        DashSetSubsystem(4, 3)
        DashAddEvent(LABEL_EV_TERM())
        DashUpdateAssembly(8, 10)
        DashSetSubsystem(5, 3)
        DashUpdateAssembly(10, 10)
    END IF

    ' Handoff to the "higher system UI" (docs/arcology-boot-screen-concept.md's own last real
    ' boot-sequence step): the dashboard has done its real job -- clear it and drop into the
    ' genuine interactive READY. session below.
    IF gopOk = 1 THEN
        TermClear()
    END IF

    SerialByte(83)
    SerialByte(85)
    SerialByte(66)
    SerialByte(83)
    SerialByte(84)
    SerialByte(82)
    SerialByte(65)
    SerialByte(84)
    SerialByte(69)
    SerialByte(32)
    SerialByte(76)
    SerialByte(73)
    SerialByte(86)
    SerialByte(69)
    SerialByte(13)
    SerialByte(10)

    ' The genuine RFC-0007 interactive loop: HELP / OT / ?SYNTAX ERROR / backspace, running under
    ' APS's own CR3/GDT/IDT, fed by BOTH real input paths via PollAnyKey, and now genuinely
    ' visible on a real screen (not just over a wire) -- this is the real proof RFC-0045 Phase 4
    ' AND Phase 5 both exist for. Never CPU.HaltForever's on its own; only the TEST-ONLY EXIT
    ' command (see LineIsExit's own header comment) ends it, for automated QEMU testing.
    PrintBanner()

    LET lineBuf AS MMIOPTR = LineBufferAddress()
    LET lineLen AS U32 = 0
    LET maxChars AS U32 = LineBufferMaxChars()
    LET running AS BOOL = 1

    WHILE running = 1
        LET ch AS U16 = PollAnyKey(usbSlotId)
        IF ch <> 0 THEN
            IF ch = 13 THEN
                PrintCRLF()
                IF lineLen = 0 THEN
                    PrintReady()
                ELSE
                    running = HandleEnteredLine(lineBuf, lineLen, usbSlotId)
                    IF running = 1 THEN
                        PrintReady()
                    END IF
                END IF
                lineLen = 0
            ELSE
                IF ch = 8 THEN
                    IF lineLen > 0 THEN
                        lineLen = lineLen - 1
                        EchoChar(8)
                        EchoChar(32)
                        EchoChar(8)
                    END IF
                ELSE
                    IF ch >= 32 THEN
                        IF ch < 127 THEN
                            IF lineLen < maxChars THEN
                                LET chByte AS U8 = ch
                                MEMORY.Write8(ADDRESS.Offset(lineBuf, lineLen), chByte)
                                lineLen = lineLen + 1
                                EchoChar(chByte)
                            END IF
                        END IF
                    END IF
                END IF
            END IF
        ELSE
            CPU.Pause
        END IF
    WEND

    CPU.HaltForever
    RETURN 0
END FUNCTION
' Real dashboard text labels -- ASCII bytes for every fixed label the boot dashboard draws,
' written once into a real scratch buffer (each label at its own fixed offset, null-
' terminated) and drawn via DrawLabel below. Generated from a fixed table, not hand-typed,
' to keep byte values honest.
' Real dashboard text labels -- ASCII bytes for every fixed label the boot dashboard draws,
' written once into a real scratch buffer (each label at its own fixed offset, null-
' terminated) and drawn via DrawLabel below. Generated from a fixed table, not hand-typed,
' to keep byte values honest.
' Real dashboard text labels -- ASCII bytes for every fixed label the boot dashboard draws,
' written once into a real scratch buffer (each label at its own fixed offset, null-
' terminated) and drawn via DrawLabel below. Generated from a fixed table, not hand-typed,
' to keep byte values honest.
FUNCTION DashboardLabelTableAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(54525952))   ' 0x3400000, clear of every other fixed scratch region this fixture uses
END FUNCTION

FUNCTION WriteDashboardLabelsPart0() AS U64
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 0), 65)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 1), 82)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 2), 67)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 3), 79)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 4), 76)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 5), 79)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 6), 71)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 7), 89)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 8), 0)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 16), 83)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 17), 89)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 18), 83)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 19), 84)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 20), 69)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 21), 77)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 22), 32)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 23), 65)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 24), 83)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 25), 83)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 26), 69)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 27), 77)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 28), 66)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 29), 76)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 30), 89)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 31), 0)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 40), 85)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 41), 69)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 42), 70)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 43), 73)
