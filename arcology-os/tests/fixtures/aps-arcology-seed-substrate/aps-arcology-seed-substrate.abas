    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 48), 95)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 49), 54)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 50), 52)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 51), 0)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 56), 85)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 57), 69)
    MEMORY.Write8(ADDRESS.Offset(DashboardLabelTableAddress(), 58), 70)
    RETURN 0
END FUNCTION

