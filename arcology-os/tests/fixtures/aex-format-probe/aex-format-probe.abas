FUNCTION RunValidMinimal() AS BOOL
    WriteValidMinimal()
    LET hdrResult AS U32 = AEX.ValidateHeader(ValidMinimalBufferAddress(), ValidMinimalFileLength())
    IF hdrResult <> 0 THEN
        RETURN 0
    END IF
    LET dirResult AS U32 = AEX.ValidateDirectory(ValidMinimalBufferAddress(), ValidMinimalFileLength())
    IF dirResult <> 0 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunInvalidMagic() AS BOOL
    WriteInvalidMagic()
    LET hdrResult AS U32 = AEX.ValidateHeader(InvalidMagicBufferAddress(), InvalidMagicFileLength())
    IF hdrResult <> 1 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunInvalidHeaderSize() AS BOOL
    WriteInvalidHeaderSize()
    LET hdrResult AS U32 = AEX.ValidateHeader(InvalidHeaderSizeBufferAddress(), InvalidHeaderSizeFileLength())
    IF hdrResult <> 3 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunDirectoryOutOfBounds() AS BOOL
    WriteDirectoryOutOfBounds()
    LET hdrResult AS U32 = AEX.ValidateHeader(DirectoryOutOfBoundsBufferAddress(), DirectoryOutOfBoundsFileLength())
    IF hdrResult <> 4 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunChunkOutOfBounds() AS BOOL
    WriteChunkOutOfBounds()
    LET hdrResult AS U32 = AEX.ValidateHeader(ChunkOutOfBoundsBufferAddress(), ChunkOutOfBoundsFileLength())
    IF hdrResult <> 0 THEN
        RETURN 0
    END IF
    LET dirResult AS U32 = AEX.ValidateDirectory(ChunkOutOfBoundsBufferAddress(), ChunkOutOfBoundsFileLength())
    IF dirResult <> 5 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunUnknownOptionalChunk() AS BOOL
    WriteUnknownOptionalChunk()
    LET hdrResult AS U32 = AEX.ValidateHeader(UnknownOptionalChunkBufferAddress(), UnknownOptionalChunkFileLength())
    IF hdrResult <> 0 THEN
        RETURN 0
    END IF
    LET dirResult AS U32 = AEX.ValidateDirectory(UnknownOptionalChunkBufferAddress(), UnknownOptionalChunkFileLength())
    IF dirResult <> 0 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunUnknownRequiredChunk() AS BOOL
    WriteUnknownRequiredChunk()
    LET hdrResult AS U32 = AEX.ValidateHeader(UnknownRequiredChunkBufferAddress(), UnknownRequiredChunkFileLength())
    IF hdrResult <> 0 THEN
        RETURN 0
    END IF
    LET dirResult AS U32 = AEX.ValidateDirectory(UnknownRequiredChunkBufferAddress(), UnknownRequiredChunkFileLength())
    IF dirResult <> 6 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RunBadAlignment() AS BOOL
    WriteBadAlignment()
    LET hdrResult AS U32 = AEX.ValidateHeader(BadAlignmentBufferAddress(), BadAlignmentFileLength())
    IF hdrResult <> 0 THEN
        RETURN 0
    END IF
    LET dirResult AS U32 = AEX.ValidateDirectory(BadAlignmentBufferAddress(), BadAlignmentFileLength())
    IF dirResult <> 7 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION ReportCase(label0 AS U32, label1 AS U32, label2 AS U32, label3 AS U32, label4 AS U32, ok AS BOOL) AS U64
    SerialText(label0, label1, label2, label3, label4)
    IF ok = 1 THEN
        SerialByte(58)
        SerialByte(32)
        SerialByte(80)
        SerialByte(65)
        SerialByte(83)
        SerialByte(83)
    ELSE
        SerialByte(58)
        SerialByte(32)
        SerialByte(70)
        SerialByte(65)
        SerialByte(73)
        SerialByte(76)
    END IF
    SerialByte(13)
    SerialByte(10)
    RETURN 0
END FUNCTION

FUNCTION Main(imageHandle AS UEFI.Handle, systemTable AS UEFI.SystemTable) AS U64
    systemTable.BootServices.SetWatchdogTimer(0, 0, 0, 0)
    SerialByte(80)
    SerialByte(82)
    SerialByte(69)
    SerialByte(13)
    SerialByte(10)

    LET testsPassed AS U32 = 0
    LET testsFailed AS U32 = 0

    LET ValidMinimalOk AS BOOL = RunValidMinimal()
    ReportCase(86, 65, 76, 73, 68, ValidMinimalOk)
    IF ValidMinimalOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET InvalidMagicOk AS BOOL = RunInvalidMagic()
    ReportCase(77, 65, 71, 73, 67, InvalidMagicOk)
    IF InvalidMagicOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET InvalidHeaderSizeOk AS BOOL = RunInvalidHeaderSize()
    ReportCase(72, 83, 73, 90, 69, InvalidHeaderSizeOk)
    IF InvalidHeaderSizeOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET DirectoryOutOfBoundsOk AS BOOL = RunDirectoryOutOfBounds()
    ReportCase(68, 73, 82, 79, 66, DirectoryOutOfBoundsOk)
    IF DirectoryOutOfBoundsOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET ChunkOutOfBoundsOk AS BOOL = RunChunkOutOfBounds()
    ReportCase(67, 72, 75, 79, 66, ChunkOutOfBoundsOk)
    IF ChunkOutOfBoundsOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET UnknownOptionalChunkOk AS BOOL = RunUnknownOptionalChunk()
    ReportCase(85, 78, 75, 79, 80, UnknownOptionalChunkOk)
    IF UnknownOptionalChunkOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET UnknownRequiredChunkOk AS BOOL = RunUnknownRequiredChunk()
    ReportCase(85, 78, 75, 82, 81, UnknownRequiredChunkOk)
    IF UnknownRequiredChunkOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    LET BadAlignmentOk AS BOOL = RunBadAlignment()
    ReportCase(65, 76, 73, 71, 78, BadAlignmentOk)
    IF BadAlignmentOk = 1 THEN
        testsPassed = testsPassed + 1
    ELSE
        testsFailed = testsFailed + 1
    END IF

    SerialByte(68)
    SerialByte(79)
    SerialByte(78)
    SerialByte(69)
    SerialByte(32)
    IF testsFailed = 0 THEN
        SerialByte(65)
        SerialByte(76)
        SerialByte(76)
        SerialByte(80)
        SerialByte(65)
        SerialByte(83)
        SerialByte(83)
    ELSE
        SerialByte(83)
        SerialByte(79)
        SerialByte(77)
        SerialByte(69)
        SerialByte(70)
        SerialByte(65)
        SerialByte(73)
        SerialByte(76)
    END IF
    SerialByte(13)
    SerialByte(10)

    CPU.HaltForever
    RETURN 0
END FUNCTION
