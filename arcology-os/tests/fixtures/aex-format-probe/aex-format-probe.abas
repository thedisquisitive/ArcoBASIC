    RETURN 11707123199072077656
END FUNCTION
FUNCTION AexTypeCodeHigh() AS U64
    RETURN 859404424522585693
END FUNCTION
FUNCTION AexTypeCodeLow() AS U64
    RETURN 12635621945936320080
END FUNCTION
FUNCTION AexTypeDataHigh() AS U64
    RETURN 3615471906802654651
END FUNCTION
FUNCTION AexTypeDataLow() AS U64
    RETURN 10345390336377140389
END FUNCTION
FUNCTION AexTypeResourceHigh() AS U64
    RETURN 5222799288954347266
END FUNCTION
FUNCTION AexTypeResourceLow() AS U64
    RETURN 13099566529540005749
END FUNCTION
FUNCTION AexTypeInterfaceHigh() AS U64
    RETURN 5188981897502022009
END FUNCTION
FUNCTION AexTypeInterfaceLow() AS U64
    RETURN 9356764828807109312
END FUNCTION
