#PROFILE UEFI
#TARGET X86_64
#RUNTIME NONE
#CALLCONV UEFI

' Real hardware end-to-end proof that UefiBlockDevice.* (real discovered EFI_BLOCK_IO_PROTOCOL
' hardware) works as an ALTERNATIVE BlockDevice provider for the read-only FAT32 Filesystem
' Provider (RFC-0038 Requirements 6.3/6.4), selected via FAT32.SelectBlockDevice -- not the
' RAM-preload trick the original aps-block-storage.abas proof used. Frozen copies of
' block_device_policy.abas, uefi_block_device_policy.abas, and fat32_policy.abas are inlined
' below, matching this project's own established fixture convention (this compiler's freestanding
' target takes one source file, no module/include system).
'
' The disk attached under test (run-uefi-hello-with-blockio-disk.sh) is a REAL FAT32 filesystem
' image built by build-fat32-test-image.py -- the SAME generator, SAME known file
' (README.TXT, 3333 bytes, byte-sum 211490), and SAME checksum this project's original
' RAMDisk-backed FAT32 proof (aps-block-storage.abas) already established as correct -- proving
' the read path is unchanged, only the block device underneath it is real hardware instead of a
' RAM-preloaded region.

' APS RAM Disk Block Device Provider (RFC-0038: APS Block Storage and Filesystem Provider
' Substrate, Requirements 6.1/6.2). Backs the Filesystem Provider layer (fat32_policy.abas) with
' no real storage hardware driver needed -- the RAM disk itself is just a byte range in memory.


' --- A documented deviation, stated up front, in the same spirit as loop_policy.abas's own
' header note. ---
'
' RFC-0038 Section 6.1 specifies `RAMDisk.Create(sizeBytes AS U64) AS BlockDevice` -- a value of
' an abstract `BlockDevice` interface type, so calling code can hold a RAM disk, a future AHCI
' device, etc. behind one shape. This implementation exposes `RAMDisk.*` as concrete, directly-
' named functions instead (`RAMDisk.SectorSize()`, `RAMDisk.ReadSectors(...)`, ...), and
' `RAMDisk.Create` returns `BOOL`, not a `BlockDevice` value. Reason: this compiler's freestanding
' x86-64 backend has no runtime-polymorphic dispatch mechanism at all -- confirmed the same way
' RFC-0037's `Loop.RegisterHook` deviation was confirmed (AmirInstruction::Kind::AddressOf is
' unhandled by generate_x86_64_function; CallValue can only call a compile-time-known function
' name). There is only one RAM disk in this milestone -- the same "one instance, fixed scratch
' state" pattern every prior RFC in this chain has used (one timer, one loop, one exception
' table) -- so the concrete-function shape loses nothing real yet; it becomes a genuine gap only
' once a second, different BlockDevice implementation (a real AHCI/NVMe/virtio-blk driver, all
' explicitly Non-Goals/Future Extensions of this RFC) needs to be swapped in behind the same
' calling code, at which point this needs the same treatment RFC-0027's freestanding callables
' would need for Loop.RegisterHook.
'
' A second deviation, specific to RAMDisk.Create: RFC-0038's own text says the backing memory
' should be "AllocatePages-sourced." This implementation's RAMDisk.Create does not allocate
' memory at all -- it records the size of a *fixed, pre-populated* memory region (see
' RAMDiskBaseAddress below) whose bytes are already correct by the time this program starts,
' because the QEMU/OVMF test harness places them there before boot (scripts/run/
' run-uefi-hello-with-preload.sh, a `-device loader,file=...,addr=...` preload -- see that
' script's own header comment and .agents/reports/aps-block-storage.md for why). This sidesteps
' RFC-0038 Stop Condition #17.5's anticipated UEFI-Block-IO-binding gap entirely rather than
' hitting it: no UEFI protocol call populates this RAM disk in this implementation, at any point.
' A future increment that actually copies bytes from a live UEFI Block IO device into freshly
' AllocatePages'd memory would change this function's *body*, not its contract --
' RAMDisk.SectorSize/SectorCount/ReadSectors/WriteSectors/IsWritable are unaffected either way.

FUNCTION RAMDiskBaseAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(67108864))   ' 0x4000000, 64 MiB -- see header note
END FUNCTION

FUNCTION RAMDiskStateAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(33751040))   ' 0x2030000
END FUNCTION

FUNCTION RAMDisk.Create(sizeBytes AS U64) AS BOOL
    MEMORY.Write64(RAMDiskStateAddress(), sizeBytes \ 512)
    RETURN 1
END FUNCTION

FUNCTION RAMDisk.SectorSize() AS U32
    RETURN 512
END FUNCTION

FUNCTION RAMDisk.SectorCount() AS U64
    RETURN MEMORY.Read64(RAMDiskStateAddress())
END FUNCTION

FUNCTION RAMDisk.IsWritable() AS BOOL
    RETURN 1
END FUNCTION

' Requirement 6.1: MUST reject (return FALSE, MUST NOT partially transfer) a request whose
' startSector + count exceeds SectorCount().
FUNCTION RAMDisk.ReadSectors(startSector AS U64, count AS U32, destination AS MMIOPTR) AS BOOL
    LET total AS U64 = RAMDisk.SectorCount()
    LET countAsU64 AS U64 = count
    IF startSector + countAsU64 > total THEN
        RETURN 0
    END IF
    LET byteOffset AS U64 = startSector * 512
    LET byteCount AS U64 = count * 512
    LET i AS U64 = 0
    WHILE i < byteCount
        LET value AS U8 = MEMORY.Read8(ADDRESS.Offset(RAMDiskBaseAddress(), byteOffset + i))
        MEMORY.Write8(ADDRESS.Offset(destination, i), value)
        i = i + 1
    WEND
    RETURN 1
END FUNCTION

' Requirement 6.1: WriteSectors on a device where IsWritable() is FALSE MUST return FALSE without
' touching the medium -- not reachable for the RAM disk itself (always writable), but implemented
' symmetrically with ReadSectors for contract completeness; unexercised by this RFC's own QEMU
' proof, which only reads a pre-populated, read-only-in-spirit test image.
FUNCTION RAMDisk.WriteSectors(startSector AS U64, count AS U32, source AS MMIOPTR) AS BOOL
    LET total AS U64 = RAMDisk.SectorCount()
    LET countAsU64 AS U64 = count
    IF startSector + countAsU64 > total THEN
        RETURN 0
    END IF
    LET byteOffset AS U64 = startSector * 512
    LET byteCount AS U64 = count * 512
    LET i AS U64 = 0
    WHILE i < byteCount
        LET value AS U8 = MEMORY.Read8(ADDRESS.Offset(source, i))
        MEMORY.Write8(ADDRESS.Offset(RAMDiskBaseAddress(), byteOffset + i), value)
        i = i + 1
    WEND
    RETURN 1
END FUNCTION

' UEFI-backed BlockDevice Provider (RFC-0038 Section 6.1/6.2), backed by a REAL discovered
' EFI_BLOCK_IO_PROTOCOL device -- the hardware-side follow-on to RFC-0038 Section 17.5's stop
' condition, closed at the compiler-binding level in
' .agents/reports/aps-blockio-discovery-binding.md, and proven against a real attached QEMU disk
' in .agents/reports/aps-blockio-disk-provider.md.


' --- Documented deviations, stated up front, same spirit as block_device_policy.abas's own
' header note. ---
'
' 1. Same "concrete functions instead of an abstract BlockDevice interface value" deviation
'    RAMDisk.* already documents -- this backend has no runtime-polymorphic dispatch at all.
'
' 2. A SECOND, NEW deviation this provider needed that RAMDisk.* did not: the discovered
'    UEFI.BlockIoProtocol value itself cannot be persisted across calls as a still-typed value the
'    way mediaId/blockSize/sectorCount can. What CAN be persisted -- and what genuinely works,
'    confirmed directly against real generated x86-64 before relying on it -- is the raw protocol
'    pointer as a plain U64, RELOADED and RE-DECLARED with an explicit `AS UEFI.BlockIoProtocol`
'    type annotation in each function that needs to call a real protocol method. This works
'    because this compiler's field-chain resolution (src/compiler/fission.cpp) keys off a
'    variable's DECLARED type (tracked per-function in a name->type map populated by every typed
'    LET, not only function parameters), not off whether the variable literally is a parameter --
'    an is_method call on ANY local variable carrying an explicit UEFI.* type annotation resolves
'    through the same generic CallExternal path a genuine parameter would. Confirmed in generated
'    x86-64: `call [r11+0x18]`, ReadBlocks's own registered offset, appears identically whether
'    blockIo arrives as a parameter or is reloaded from memory and re-annotated. (An earlier,
'    narrower reading of this constraint -- assuming only literal parameters work -- is corrected
'    here; not a defect in the earlier binding work, just an incomplete first read of the
'    resolution code before this provider needed the fuller picture.)
'
' 3. `UefiBlockDevice.Discover` requires the discovered media's own BlockSize to be exactly 512.
'    UEFI.BLOCKIO.MediaFlags only exposes the packed RemovableMedia/MediaPresent/LogicalPartition/
'    ReadOnly word (uefi-bindings.md's own documented scope reduction: no single-byte
'    displacement-addressed encoder primitive exists, so a whole packed word is read instead of
'    one bit) -- this provider extracts the bits it needs from that word via ordinary SHR/AND.
'
' 4. UEFI.BLOCKIO.DISCOVER is a single LocateProtocol call (matching UEFI.GOP.DISCOVER's own
'    documented single-handle scope): it returns whichever EFI_BLOCK_IO_PROTOCOL handle firmware
'    hands back first, not necessarily any particular disk a caller has in mind. This provider
'    does not attempt multi-handle enumeration/selection -- callers that need a SPECIFIC device
'    among several need a future, separate enumeration binding, out of scope here.

FUNCTION UefiBlockDeviceStateAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(37748736))   ' 0x2400000, this provider's own scratch state
END FUNCTION

' State layout, all within one page: blockIo pointer (U64, +0), mediaId (U32, +8), sectorCount
' (U64, +16), writable flag (U32, +24), discovered flag (U32, +28).
FUNCTION UefiBlockDeviceStatePointerAddress() AS MMIOPTR
    RETURN UefiBlockDeviceStateAddress()
END FUNCTION

FUNCTION UefiBlockDeviceStateMediaIdAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(UefiBlockDeviceStateAddress(), 8)
END FUNCTION

FUNCTION UefiBlockDeviceStateSectorCountAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(UefiBlockDeviceStateAddress(), 16)
END FUNCTION

FUNCTION UefiBlockDeviceStateWritableAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(UefiBlockDeviceStateAddress(), 24)
END FUNCTION

FUNCTION UefiBlockDeviceStateDiscoveredAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(UefiBlockDeviceStateAddress(), 28)
END FUNCTION

' Discovers a real EFI_BLOCK_IO_PROTOCOL device and records its identity/geometry into fixed
' scratch state for every later UefiBlockDevice.* call to use. Requires the discovered media to be
' present and to use exactly 512-byte sectors (scope reduction #3 above) -- returns FALSE rather
' than a partially-usable provider otherwise, matching RFC-0038 Requirement 6.1's own fail-closed
' spirit for RAMDisk.
FUNCTION UefiBlockDevice.Discover(systemTable AS UEFI.SystemTable) AS BOOL
    LET blockIo AS UEFI.BlockIoProtocol = UEFI.BLOCKIO.Discover(systemTable)
    IF blockIo = 0 THEN
        RETURN 0
    END IF

    LET mediaFlags AS U32 = UEFI.BLOCKIO.MediaFlags(blockIo)
    LET mediaPresent AS U32 = (mediaFlags \ 256) AND 255
    LET readOnly AS U32 = (mediaFlags \ 16777216) AND 255
    IF mediaPresent = 0 THEN
        RETURN 0
    END IF

    LET blockSize AS U32 = UEFI.BLOCKIO.BlockSize(blockIo)
    IF blockSize <> 512 THEN
        RETURN 0
    END IF

    LET lastBlock AS U64 = UEFI.BLOCKIO.LastBlock(blockIo)
    LET mediaId AS U32 = UEFI.BLOCKIO.MediaId(blockIo)

    MEMORY.Write64(UefiBlockDeviceStatePointerAddress(), blockIo)
    MEMORY.Write32(UefiBlockDeviceStateMediaIdAddress(), mediaId)
    MEMORY.Write64(UefiBlockDeviceStateSectorCountAddress(), lastBlock + 1)
    IF readOnly = 0 THEN
        MEMORY.Write32(UefiBlockDeviceStateWritableAddress(), 1)
    ELSE
        MEMORY.Write32(UefiBlockDeviceStateWritableAddress(), 0)
    END IF
    MEMORY.Write32(UefiBlockDeviceStateDiscoveredAddress(), 1)
    RETURN 1
END FUNCTION

FUNCTION UefiBlockDevice.IsDiscovered() AS BOOL
    RETURN MEMORY.Read32(UefiBlockDeviceStateDiscoveredAddress())
END FUNCTION

FUNCTION UefiBlockDevice.SectorSize() AS U32
    RETURN 512
END FUNCTION

FUNCTION UefiBlockDevice.SectorCount() AS U64
    RETURN MEMORY.Read64(UefiBlockDeviceStateSectorCountAddress())
END FUNCTION

FUNCTION UefiBlockDevice.IsWritable() AS BOOL
    RETURN MEMORY.Read32(UefiBlockDeviceStateWritableAddress())
END FUNCTION

' Requirement 6.1: MUST reject (return FALSE, MUST NOT partially transfer) a request whose
' startSector + count exceeds SectorCount() -- checked BEFORE the real ReadBlocks call, matching
' RAMDisk.ReadSectors's own bounds-check-first shape.
FUNCTION UefiBlockDevice.ReadSectors(startSector AS U64, count AS U32, destination AS MMIOPTR) AS BOOL
    LET total AS U64 = UefiBlockDevice.SectorCount()
    LET countAsU64 AS U64 = count
    IF startSector + countAsU64 > total THEN
        RETURN 0
    END IF
    LET blockIo AS UEFI.BlockIoProtocol = MEMORY.Read64(UefiBlockDeviceStatePointerAddress())
    LET mediaId AS U32 = MEMORY.Read32(UefiBlockDeviceStateMediaIdAddress())
    LET bufferSize AS U64 = countAsU64 * 512
    LET status AS U64 = blockIo.ReadBlocks(mediaId, startSector, bufferSize, destination)
    RETURN status = 0
END FUNCTION

' Requirement 6.1: WriteSectors on a device where IsWritable() is FALSE MUST return FALSE without
' touching the medium -- checked before ever calling the real WriteBlocks method, matching
' RAMDisk.WriteSectors's own contract, now genuinely reachable (a real EFI_BLOCK_IO_MEDIA can
' legitimately be read-only, unlike RAMDisk's always-writable fixed region).
FUNCTION UefiBlockDevice.WriteSectors(startSector AS U64, count AS U32, source AS MMIOPTR) AS BOOL
    IF UefiBlockDevice.IsWritable() = 0 THEN
        RETURN 0
    END IF
    LET total AS U64 = UefiBlockDevice.SectorCount()
    LET countAsU64 AS U64 = count
    IF startSector + countAsU64 > total THEN
        RETURN 0
    END IF
    LET blockIo AS UEFI.BlockIoProtocol = MEMORY.Read64(UefiBlockDeviceStatePointerAddress())
    LET mediaId AS U32 = MEMORY.Read32(UefiBlockDeviceStateMediaIdAddress())
    LET bufferSize AS U64 = countAsU64 * 512
    LET status AS U64 = blockIo.WriteBlocks(mediaId, startSector, bufferSize, source)
    RETURN status = 0
END FUNCTION

' APS read-only FAT32 Filesystem Provider (RFC-0038 Requirements 6.3/6.4). Reads against a
' SELECTED BlockDevice provider -- RAMDisk.* (block_device_policy.abas, the default) or
' UefiBlockDevice.* (uefi_block_device_policy.abas, real discovered hardware) -- chosen via
' FAT32.SelectBlockDevice, dispatched through a fixed IF-chain rather than a true interface value.
' Not runtime-polymorphic dispatch (this backend has none -- the same reason block_device_policy's
' own header comment gives for RAMDisk.Create): the SAME "fixed-slot IF-chain instead of a real
' interface" idiom `loop_policy.abas`'s `LoopInvokeSlot` and `volumes_policy.abas`'s own
' provider-tag dispatch already established for this exact problem elsewhere in this project --
' applied here, not reinvented. See FAT32BlockReadSectors/FAT32BlockSectorCount below.


' --- Two more documented deviations, on top of block_device_policy.abas's. ---
'
' 1. Paths are NOT STRING. RFC-0038 Section 6.3 specifies `Open(path AS STRING, ...)`. This
'    implementation takes an 11-byte raw 8.3 short-name buffer (MMIOPTR) instead --
'    FAT32.Open(nameBuffer AS MMIOPTR) AS BOOL -- matching the on-disk directory-entry name field
'    exactly. This is not a style preference: STRING equality comparison was tested directly on
'    this freestanding backend and found to silently return the WRONG answer at runtime (compiles
'    clean, "SOURCE ACCEPTED", generates code, but `path = "HELLO"` evaluated false for an exact
'    match under QEMU). That is a correctness bug in the compiler's freestanding STRING support,
'    not a missing feature reported as missing -- exactly the kind of "looks correct, isn't
'    correct" trap this project's own testing discipline exists to catch (see
'    project_arcology_os_exception_entry.md's QEMU-boot-noise lesson, and RFC-0037's own
'    Timer.Ticks()-vs-pending-table design note, for two earlier examples of the same principle).
'    It was not chased down and fixed here -- real, separate compiler work, out of this RFC's
'    scope -- only worked around, the same judgment RFC-0037 made about the BOOL-IF-condition and
'    TRUE-literal gaps it found. See .agents/reports/aps-block-storage.md for the minimal repro.
' 2. Root-directory-only: FAT32.Open does not walk subdirectories. RFC-0038 Section 19 already
'    explicitly leaves long-filename (VFAT) support to implementation judgment as "an acceptable
'    first cut"; this implementation extends that same judgment to subdirectory traversal for the
'    same reason (real parsing complexity, not required to prove the read path -- byte-for-byte
'    correct multi-cluster file reads via genuine FAT chain-walking -- actually works).
' 3. Enumerate/Stat do not return `DirectoryEntry[]` (RFC-0038 Section 6.3's array-typed return).
'    Arrays are, like STRING, untested territory on this backend, and this RFC's real
'    deliverable -- the read path -- does not need them. FAT32.CountEntries()/FAT32.StatSize()
'    below are minimal, array-free stand-ins that exercise the same directory-scan machinery
'    Open() uses, without committing to an unverified return-type shape.
'
' Only one file may be open at a time in this implementation (the same "one instance" pattern
' block_device_policy.abas's header comment names) -- FileHandle is therefore not a distinct
' value at all; Read/Close operate on the single open-file state this file owns.

FUNCTION FAT32StateAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(33755136))   ' 0x2031000
END FUNCTION

FUNCTION FAT32ScratchSectorA() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(33759232))   ' 0x2032000 -- boot sector / directory scan
END FUNCTION

FUNCTION FAT32ScratchSectorB() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(33763328))   ' 0x2033000 -- FAT entry reads
END FUNCTION

FUNCTION FAT32OpenFileState() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(33771520))   ' 0x2035000
END FUNCTION

' Geometry cache layout (FAT32StateAddress, all U64 for uniform MEMORY.Read64/Write64 access even
' where the on-disk field is narrower):
'   +0  bytesPerSector        +8  sectorsPerCluster     +16 reservedSectorCount
'   +24 numFATs                +32 fatSize32             +40 rootCluster
'   +48 firstDataSector (derived: reservedSectorCount + numFATs*fatSize32)
'   +56 mounted (0/1)
'   +64 blockDeviceProvider (U32; 0=RAMDisk, 1=UefiBlockDevice -- see FAT32.SelectBlockDevice)

' RFC-0038 Section 6.1's own BlockDevice contract: RAMDisk.* and UefiBlockDevice.* both implement
' the identical ReadSectors(startSector AS U64, count AS U32, destination AS MMIOPTR) AS BOOL /
' SectorCount() AS U64 shape -- confirmed identical, not assumed, by construction (both files were
' written to the same contract). FAT32BlockReadSectors/FAT32BlockSectorCount are this file's own
' fixed-slot dispatch, exactly the shape volumes_policy.abas's own header comment already
' describes for provider-tag dispatch, applied to the ReadSectors/SectorCount half of that same
' contract instead of the Mount/Open half.
FUNCTION FAT32BlockDeviceSelectorAddress() AS MMIOPTR
    RETURN ADDRESS.Offset(FAT32StateAddress(), 64)
END FUNCTION

FUNCTION FAT32.BlockDeviceProviderRAMDisk() AS U32
    RETURN 0
END FUNCTION

FUNCTION FAT32.BlockDeviceProviderUefi() AS U32
    RETURN 1
END FUNCTION

' Selects which real BlockDevice provider FAT32.Mount and every subsequent read go through. MUST
' be called before FAT32.Mount if UefiBlockDevice is wanted -- Mount's own boot-sector read is
' itself provider-dependent, and this file has no way to reorder that for a caller. Rejects any
' value other than the two named providers (fail-closed, matching Requirement 6.1's own
' bounds-checking spirit rather than silently accepting an unknown selector).
'
' Defaults to RAMDisk (0) if never called at all: fresh scratch memory reads as zero at boot in
' this project's own established QEMU/OVMF environment (every prior "mounted"/state flag in this
' file already relies on the identical fact), so every EXISTING caller that never calls this
' function keeps its exact prior behavior unchanged -- this is a deliberately additive,
' non-breaking change, not a silent behavior shift for callers that predate UefiBlockDevice.
FUNCTION FAT32.SelectBlockDevice(provider AS U32) AS BOOL
    IF provider <> 0 THEN
        IF provider <> 1 THEN
            RETURN 0
        END IF
    END IF
    MEMORY.Write32(FAT32BlockDeviceSelectorAddress(), provider)
    RETURN 1
END FUNCTION

FUNCTION FAT32.ActiveBlockDevice() AS U32
    RETURN MEMORY.Read32(FAT32BlockDeviceSelectorAddress())
END FUNCTION

FUNCTION FAT32BlockReadSectors(startSector AS U64, count AS U32, destination AS MMIOPTR) AS BOOL
    IF FAT32.ActiveBlockDevice() = 1 THEN
        RETURN UefiBlockDevice.ReadSectors(startSector, count, destination)
    END IF
    RETURN RAMDisk.ReadSectors(startSector, count, destination)
END FUNCTION

' UefiBlockDevice.ReadSectors/SectorCount fail closed by construction even if a caller selects
' provider 1 without ever calling UefiBlockDevice.Discover first: SectorCount() reads as 0 from
' never-touched scratch state, so ReadSectors's own Requirement 6.1 bounds check
' (startSector + count > SectorCount()) rejects every non-empty request rather than reading
' undiscovered/undefined memory. Confirmed directly in .agents/reports/aps-blockio-fat32-uefi.md
' rather than assumed -- selecting UefiBlockDevice before discovery makes FAT32.Mount fail closed
' (returns FALSE), the same as pointing FAT32 at a genuinely absent device.
FUNCTION FAT32BlockSectorCount() AS U64
    IF FAT32.ActiveBlockDevice() = 1 THEN
        RETURN UefiBlockDevice.SectorCount()
    END IF
    RETURN RAMDisk.SectorCount()
END FUNCTION

FUNCTION FAT32CheckLabel() AS BOOL
    LET base AS MMIOPTR = FAT32ScratchSectorA()
    IF MEMORY.Read8(ADDRESS.Offset(base, 82)) <> 70 THEN RETURN 0    ' 'F'
    IF MEMORY.Read8(ADDRESS.Offset(base, 83)) <> 65 THEN RETURN 0    ' 'A'
    IF MEMORY.Read8(ADDRESS.Offset(base, 84)) <> 84 THEN RETURN 0    ' 'T'
    IF MEMORY.Read8(ADDRESS.Offset(base, 85)) <> 51 THEN RETURN 0    ' '3'
    IF MEMORY.Read8(ADDRESS.Offset(base, 86)) <> 50 THEN RETURN 0    ' '2'
    IF MEMORY.Read8(ADDRESS.Offset(base, 87)) <> 32 THEN RETURN 0    ' ' '
    IF MEMORY.Read8(ADDRESS.Offset(base, 88)) <> 32 THEN RETURN 0
    IF MEMORY.Read8(ADDRESS.Offset(base, 89)) <> 32 THEN RETURN 0
    RETURN 1
END FUNCTION

' Requirement 6.3: Mount MUST validate the device's structure enough to reject a device that does
' not contain this provider's format, and MUST return FALSE rather than mounting unconditionally
' (Section 10's fail-closed requirement). Validates the boot signature (0x55AA), the "FAT32   "
' filesystem-type label, and every geometry field it reads for an impossible zero value before
' trusting it, per Section 10's bounds-checking requirement.
FUNCTION FAT32.Mount() AS BOOL
    IF FAT32BlockReadSectors(0, 1, FAT32ScratchSectorA()) = 0 THEN
        RETURN 0
    END IF
    LET signature AS U16 = MEMORY.Read16(ADDRESS.Offset(FAT32ScratchSectorA(), 510))
    IF signature <> 43605 THEN   ' 0xAA55, little-endian read
        RETURN 0
    END IF
    IF FAT32CheckLabel() = 0 THEN
        RETURN 0
    END IF

    LET bytesPerSector AS U64 = MEMORY.Read16(ADDRESS.Offset(FAT32ScratchSectorA(), 11))
    LET sectorsPerCluster AS U64 = MEMORY.Read8(ADDRESS.Offset(FAT32ScratchSectorA(), 13))
    LET reservedSectorCount AS U64 = MEMORY.Read16(ADDRESS.Offset(FAT32ScratchSectorA(), 14))
    LET numFATs AS U64 = MEMORY.Read8(ADDRESS.Offset(FAT32ScratchSectorA(), 16))
    LET fatSize32 AS U64 = MEMORY.Read32(ADDRESS.Offset(FAT32ScratchSectorA(), 36))
    LET rootCluster AS U64 = MEMORY.Read32(ADDRESS.Offset(FAT32ScratchSectorA(), 44))

    IF bytesPerSector = 0 THEN RETURN 0
    IF sectorsPerCluster = 0 THEN RETURN 0
    IF reservedSectorCount = 0 THEN RETURN 0
    IF numFATs = 0 THEN RETURN 0
    IF fatSize32 = 0 THEN RETURN 0
    IF rootCluster < 2 THEN RETURN 0

    LET firstDataSector AS U64 = reservedSectorCount + (numFATs * fatSize32)
    IF firstDataSector >= FAT32BlockSectorCount() THEN RETURN 0

    LET state AS MMIOPTR = FAT32StateAddress()
    MEMORY.Write64(state, bytesPerSector)
    MEMORY.Write64(ADDRESS.Offset(state, 8), sectorsPerCluster)
    MEMORY.Write64(ADDRESS.Offset(state, 16), reservedSectorCount)
    MEMORY.Write64(ADDRESS.Offset(state, 24), numFATs)
    MEMORY.Write64(ADDRESS.Offset(state, 32), fatSize32)
    MEMORY.Write64(ADDRESS.Offset(state, 40), rootCluster)
    MEMORY.Write64(ADDRESS.Offset(state, 48), firstDataSector)
    MEMORY.Write64(ADDRESS.Offset(state, 56), 1)
    RETURN 1
END FUNCTION

FUNCTION FAT32.IsWritable() AS BOOL
    RETURN 0
END FUNCTION

FUNCTION FAT32ClusterToSector(cluster AS U64) AS U64
    LET state AS MMIOPTR = FAT32StateAddress()
    LET firstDataSector AS U64 = MEMORY.Read64(ADDRESS.Offset(state, 48))
    LET sectorsPerCluster AS U64 = MEMORY.Read64(ADDRESS.Offset(state, 8))
    RETURN firstDataSector + ((cluster - 2) * sectorsPerCluster)
END FUNCTION

' Follows the chain: reads the 4-byte FAT32 entry for `cluster` and returns it masked to 28 bits
' (the low 4 bits of the top byte are reserved). >= 0x0FFFFFF8 signals end-of-chain.
FUNCTION FAT32ReadFatEntry(cluster AS U64) AS U64
    LET state AS MMIOPTR = FAT32StateAddress()
    LET bytesPerSector AS U64 = MEMORY.Read64(state)
    LET reservedSectorCount AS U64 = MEMORY.Read64(ADDRESS.Offset(state, 16))
    LET fatByteOffset AS U64 = (reservedSectorCount * bytesPerSector) + (cluster * 4)
    LET sector AS U64 = fatByteOffset \ bytesPerSector
    LET offsetInSector AS U64 = fatByteOffset - (sector * bytesPerSector)
    FAT32BlockReadSectors(sector, 1, FAT32ScratchSectorB())
    LET raw AS U32 = MEMORY.Read32(ADDRESS.Offset(FAT32ScratchSectorB(), offsetInSector))
    RETURN raw AND 268435455   ' 0x0FFFFFFF
END FUNCTION

FUNCTION FAT32NameMatches(entryPtr AS MMIOPTR, nameBuffer AS MMIOPTR) AS BOOL
    LET i AS U64 = 0
    WHILE i < 11
        LET a AS U8 = MEMORY.Read8(ADDRESS.Offset(entryPtr, i))
        LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(nameBuffer, i))
        IF a <> b THEN
            RETURN 0
        END IF
        i = i + 1
    WEND
    RETURN 1
END FUNCTION

' Requirement 6.3: Open. Scans the root directory's cluster chain for an 8.3-name match (skipping
' deleted entries, 0xE5, and VFAT long-name entries, attribute 0x0F) -- root-directory-only, per
' this file's header note. On a match, records first cluster / size / position=0 / open=1 as the
' single open-file state and returns TRUE; returns FALSE (leaving no state open) if not found or
' the directory ends (a zero first byte) without a match.
FUNCTION FAT32.Open(nameBuffer AS MMIOPTR) AS BOOL
    LET state AS MMIOPTR = FAT32StateAddress()
    LET rootCluster AS U64 = MEMORY.Read64(ADDRESS.Offset(state, 40))
    LET sectorsPerCluster AS U64 = MEMORY.Read64(ADDRESS.Offset(state, 8))
    LET bytesPerSector AS U64 = MEMORY.Read64(state)

    LET cluster AS U64 = rootCluster
    LET searching AS U64 = 1
    WHILE searching = 1
        LET baseSector AS U64 = FAT32ClusterToSector(cluster)
        LET sectorIndex AS U64 = 0
        WHILE sectorIndex < sectorsPerCluster
            FAT32BlockReadSectors(baseSector + sectorIndex, 1, FAT32ScratchSectorA())
            LET entryOffset AS U64 = 0
            WHILE entryOffset < bytesPerSector
                LET firstByte AS U8 = MEMORY.Read8(ADDRESS.Offset(FAT32ScratchSectorA(), entryOffset))
                IF firstByte = 0 THEN
                    RETURN 0
                END IF
                IF firstByte <> 229 THEN
                    LET attr AS U8 = MEMORY.Read8(ADDRESS.Offset(FAT32ScratchSectorA(), entryOffset + 11))
                    LET lfnBits AS U8 = attr AND 15
                    IF lfnBits <> 15 THEN
                        LET matchPtr AS MMIOPTR = ADDRESS.Offset(FAT32ScratchSectorA(), entryOffset)
                        IF FAT32NameMatches(matchPtr, nameBuffer) = 1 THEN
                            LET hi AS U64 = MEMORY.Read16(ADDRESS.Offset(FAT32ScratchSectorA(), entryOffset + 20))
                            LET lo AS U64 = MEMORY.Read16(ADDRESS.Offset(FAT32ScratchSectorA(), entryOffset + 26))
                            LET size AS U64 = MEMORY.Read32(ADDRESS.Offset(FAT32ScratchSectorA(), entryOffset + 28))
                            LET firstCluster AS U64 = (hi SHL 16) OR lo
                            LET fileState AS MMIOPTR = FAT32OpenFileState()
                            MEMORY.Write64(fileState, firstCluster)
                            MEMORY.Write64(ADDRESS.Offset(fileState, 8), size)
                            MEMORY.Write64(ADDRESS.Offset(fileState, 16), 0)
                            MEMORY.Write64(ADDRESS.Offset(fileState, 24), 1)
                            RETURN 1
                        END IF
                    END IF
                END IF
                entryOffset = entryOffset + 32
            WEND
            sectorIndex = sectorIndex + 1
        WEND
        LET nextCluster AS U64 = FAT32ReadFatEntry(cluster)
        IF nextCluster >= 268435448 THEN   ' 0x0FFFFFF8, end of chain
            searching = 0
        ELSE
            cluster = nextCluster
        END IF
    WEND
    RETURN 0
END FUNCTION

' Requirement 6.3: Read. Walks the open file's cluster chain from its current position, copying
' up to maxBytes into `buffer`, and returns the number of bytes actually transferred (0 at
' end-of-file). This is the real proof surface: correct behavior here requires the FAT
' chain-walking above to be genuinely correct across a multi-cluster file, not just a
' single-cluster toy case.
FUNCTION FAT32.Read(buffer AS MMIOPTR, maxBytes AS U64) AS U64
    LET fileState AS MMIOPTR = FAT32OpenFileState()
    LET isOpen AS U64 = MEMORY.Read64(ADDRESS.Offset(fileState, 24))
    IF isOpen = 0 THEN
        RETURN 0
    END IF
    LET firstCluster AS U64 = MEMORY.Read64(fileState)
    LET fileSize AS U64 = MEMORY.Read64(ADDRESS.Offset(fileState, 8))
    LET position AS U64 = MEMORY.Read64(ADDRESS.Offset(fileState, 16))

    LET remaining AS U64 = fileSize - position
    LET toRead AS U64 = maxBytes
    IF remaining < toRead THEN toRead = remaining
    IF toRead = 0 THEN
        RETURN 0
    END IF

    LET state AS MMIOPTR = FAT32StateAddress()
    LET bytesPerSector AS U64 = MEMORY.Read64(state)
    LET sectorsPerCluster AS U64 = MEMORY.Read64(ADDRESS.Offset(state, 8))
    LET clusterSizeBytes AS U64 = bytesPerSector * sectorsPerCluster

    LET clusterIndex AS U64 = position \ clusterSizeBytes
    LET offsetInCluster AS U64 = position - (clusterIndex * clusterSizeBytes)

    LET cluster AS U64 = firstCluster
    LET walked AS U64 = 0
    WHILE walked < clusterIndex
        cluster = FAT32ReadFatEntry(cluster)
        walked = walked + 1
    WEND

    LET written AS U64 = 0
    WHILE written < toRead
        LET baseSector AS U64 = FAT32ClusterToSector(cluster)
        LET sectorInCluster AS U64 = offsetInCluster \ bytesPerSector
        LET offsetInSector AS U64 = offsetInCluster - (sectorInCluster * bytesPerSector)

        FAT32BlockReadSectors(baseSector + sectorInCluster, 1, FAT32ScratchSectorA())

        LET availableInSector AS U64 = bytesPerSector - offsetInSector
        LET remainingInCluster AS U64 = clusterSizeBytes - offsetInCluster
        LET chunk AS U64 = toRead - written
        IF availableInSector < chunk THEN chunk = availableInSector
        IF remainingInCluster < chunk THEN chunk = remainingInCluster

        LET copyIndex AS U64 = 0
        WHILE copyIndex < chunk
            LET value AS U8 = MEMORY.Read8(ADDRESS.Offset(FAT32ScratchSectorA(), offsetInSector + copyIndex))
            MEMORY.Write8(ADDRESS.Offset(buffer, written + copyIndex), value)
            copyIndex = copyIndex + 1
        WEND

        written = written + chunk
        offsetInCluster = offsetInCluster + chunk
        position = position + chunk

        IF offsetInCluster >= clusterSizeBytes THEN
            IF written < toRead THEN
                cluster = FAT32ReadFatEntry(cluster)
            END IF
            offsetInCluster = 0
        END IF
    WEND

    MEMORY.Write64(ADDRESS.Offset(fileState, 16), position)
    RETURN written
END FUNCTION

FUNCTION FAT32.Seek(offset AS U64) AS BOOL
    LET fileState AS MMIOPTR = FAT32OpenFileState()
    LET isOpen AS U64 = MEMORY.Read64(ADDRESS.Offset(fileState, 24))
    IF isOpen = 0 THEN
        RETURN 0
    END IF
    LET fileSize AS U64 = MEMORY.Read64(ADDRESS.Offset(fileState, 8))
    IF offset > fileSize THEN
        RETURN 0
    END IF
    MEMORY.Write64(ADDRESS.Offset(fileState, 16), offset)
    RETURN 1
END FUNCTION

FUNCTION FAT32.Close() AS BOOL
    MEMORY.Write64(ADDRESS.Offset(FAT32OpenFileState(), 24), 0)
    RETURN 1
END FUNCTION

' Minimal, array-free stand-ins for Requirement 6.3's Enumerate/Stat (see this file's header note
' #3). Exercises the same root-directory-scan machinery FAT32.Open uses.
FUNCTION FAT32.CountEntries() AS U64
    LET state AS MMIOPTR = FAT32StateAddress()
    LET rootCluster AS U64 = MEMORY.Read64(ADDRESS.Offset(state, 40))
    LET sectorsPerCluster AS U64 = MEMORY.Read64(ADDRESS.Offset(state, 8))
    LET bytesPerSector AS U64 = MEMORY.Read64(state)

    LET count AS U64 = 0
    LET cluster AS U64 = rootCluster
    LET scanning AS U64 = 1
    WHILE scanning = 1
        LET baseSector AS U64 = FAT32ClusterToSector(cluster)
        LET sectorIndex AS U64 = 0
        WHILE sectorIndex < sectorsPerCluster
            FAT32BlockReadSectors(baseSector + sectorIndex, 1, FAT32ScratchSectorA())
            LET entryOffset AS U64 = 0
            WHILE entryOffset < bytesPerSector
                LET firstByte AS U8 = MEMORY.Read8(ADDRESS.Offset(FAT32ScratchSectorA(), entryOffset))
                IF firstByte = 0 THEN
                    RETURN count
                END IF
                IF firstByte <> 229 THEN
                    LET attr AS U8 = MEMORY.Read8(ADDRESS.Offset(FAT32ScratchSectorA(), entryOffset + 11))
                    LET lfnBits AS U8 = attr AND 15
                    IF lfnBits <> 15 THEN
                        count = count + 1
                    END IF
                END IF
                entryOffset = entryOffset + 32
            WEND
            sectorIndex = sectorIndex + 1
        WEND
        LET nextCluster AS U64 = FAT32ReadFatEntry(cluster)
        IF nextCluster >= 268435448 THEN
            scanning = 0
        ELSE
            cluster = nextCluster
        END IF
    WEND
    RETURN count
END FUNCTION

FUNCTION Main(imageHandle AS UEFI.Handle, systemTable AS UEFI.SystemTable) AS U64
    systemTable.BootServices.SetWatchdogTimer(0, 0, 0, 0)
    systemTable.ConsoleOut.Write("BLOCKIO FAT32 START")

    ' Negative control: the default provider (RAMDisk, never Created in this fixture) has zero
    ' sector count, so Mount must fail closed BEFORE UefiBlockDevice is ever selected -- proving
    ' the selector genuinely gates which device FAT32 reads, not a decorative no-op.
    IF FAT32.Mount() <> 0 THEN
        systemTable.ConsoleOut.Write("BLOCKIO FAT32 DEFAULT MOUNT WRONGLY SUCCEEDED")
        CPU.HaltForever
    END IF
    systemTable.ConsoleOut.Write("BLOCKIO FAT32 DEFAULT MOUNT CORRECTLY REJECTED")

    LET discovered AS BOOL = UefiBlockDevice.Discover(systemTable)
    IF discovered = 0 THEN
        systemTable.ConsoleOut.Write("BLOCKIO FAT32 DISCOVER FAILED")
        CPU.HaltForever
    END IF

    IF FAT32.SelectBlockDevice(FAT32.BlockDeviceProviderUefi()) = 0 THEN
        systemTable.ConsoleOut.Write("BLOCKIO FAT32 SELECT FAILED")
        CPU.HaltForever
    END IF

    IF FAT32.Mount() = 0 THEN
        systemTable.ConsoleOut.Write("BLOCKIO FAT32 MOUNT FAILED")
        CPU.HaltForever
    END IF
    systemTable.ConsoleOut.Write("BLOCKIO FAT32 MOUNTED")

    LET scratch AS MMIOPTR = ADDRESS.MMIO(ADDRESS.Virtual(39321600))   ' 0x2580000
    LET nameBuffer AS MMIOPTR = ADDRESS.Offset(scratch, 0)
    LET readBufferAddress AS MMIOPTR = ADDRESS.Offset(scratch, 64)

    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 0), 82)     ' 'R'
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 1), 69)     ' 'E'
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 2), 65)     ' 'A'
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 3), 68)     ' 'D'
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 4), 77)     ' 'M'
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 5), 69)     ' 'E'
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 6), 32)     ' ' '
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 7), 32)     ' ' '
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 8), 84)     ' 'T'
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 9), 88)     ' 'X'
    MEMORY.Write8(ADDRESS.Offset(nameBuffer, 10), 84)    ' 'T'

    IF FAT32.Open(nameBuffer) = 0 THEN
        systemTable.ConsoleOut.Write("BLOCKIO FAT32 OPEN FAILED")
        CPU.HaltForever
    END IF

    LET totalBytes AS U64 = 0
    LET byteSum AS U64 = 0
    LET readLoopGuard AS U64 = 0
    LET reading AS U64 = 1
    WHILE reading = 1
        LET got AS U64 = FAT32.Read(readBufferAddress, 64)
        IF got = 0 THEN
            reading = 0
        ELSE
            LET k AS U64 = 0
            WHILE k < got
                LET b AS U8 = MEMORY.Read8(ADDRESS.Offset(readBufferAddress, k))
                LET bAsU64 AS U64 = b
                byteSum = byteSum + bAsU64
                k = k + 1
            WEND
            totalBytes = totalBytes + got
        END IF
        readLoopGuard = readLoopGuard + 1
        IF readLoopGuard > 200 THEN
            systemTable.ConsoleOut.Write("BLOCKIO FAT32 READ LOOP GUARD")
            CPU.HaltForever
        END IF
    WEND

    FAT32.Close()

    IF totalBytes <> 3333 THEN
        systemTable.ConsoleOut.Write("BLOCKIO FAT32 SIZE BAD")
        CPU.HaltForever
    END IF
    IF byteSum <> 211490 THEN
        systemTable.ConsoleOut.Write("BLOCKIO FAT32 CHECKSUM BAD")
        CPU.HaltForever
    END IF

    CPU.MemoryBarrier
    systemTable.ConsoleOut.Write("BLOCKIO FAT32 DONE")
    CPU.HaltForever
END FUNCTION
