' RFC-0048 Section 8.1 / Steering Addendum Section 2.1: the driver-side Network Interface Contract.
' Higher layers (the Networking Fabric, and eventually Ethernet/ARP/IPv4) MUST consume NIC
' capability through this generic boundary, never by depending on a specific backend's own
' function names or state layout. This is a real, minimal instance of that boundary -- an
' explicit IF-chain dispatch on a backend tag, matching this project's own established idiom for
' "more than one provider behind one call surface" (loop_policy.abas's LoopInvokeSlot,
' volumes_policy.abas's provider-tag dispatch, fat32_policy.abas's block-device selection). This
' backend has no interface/polymorphism mechanism, so an explicit tag dispatch IS the generic
' boundary on this backend, not a placeholder for one.
'
' Exactly one backend is registered today (VirtIO-net, tag NET_BACKEND_VIRTIO). The dispatch shape
' is structurally ready for a second backend to attach beside it without any change to whatever
' calls through this contract -- the addendum's own explicit acceptance requirement for "remaining
' N0 work" (Section 11).
'
' Transmit/receive are now real too (RFC-0048 Section 6.1's own explicit ownership requirement is
' implemented in the backend -- see virtio_net_policy.abas's own header comment -- and exposed
' here behind the same generic boundary as everything else). A caller never touches a virtqueue,
' descriptor, or the backend's own state layout directly: SetupReceive/SetupTransmit bring the two
' queues up, Transmit publishes a frame, PollReceive/PollTransmitComplete check for a completion
' (non-blocking -- the caller owns its own bounded retry loop, matching this project's established
' busy-wait idiom), and ReceiveBufferAddress/ReceiveHeaderSize let a caller read a received frame
' without needing to know the backend's own wire-format header size (virtio-net's real 10-byte
' virtio_net_hdr) is even virtio-specific -- a future second backend reports its own real value.

#PROFILE UEFI
#TARGET X86_64
#RUNTIME NONE

FUNCTION NetBackendVirtio() AS U32
    RETURN 1
END FUNCTION

' Real backend bring-up: discover the device on the PCI bus, map its I/O transport, reset it, and
' negotiate the feature subset this project's driver actually understands. Returns FALSE, honestly,
' at whichever real stage first fails -- no partial success is reported as success.
FUNCTION NetworkInterface.Start(backendTag AS U32, systemTable AS UEFI.SystemTable) AS BOOL
    IF backendTag = NetBackendVirtio() THEN
        LET found AS BOOL = VirtioNet.DiscoverPci(systemTable)
        IF found = 0 THEN
            RETURN 0
        END IF
        LET mapped AS BOOL = VirtioNet.MapIo(systemTable)
        IF mapped = 0 THEN
            RETURN 0
        END IF
        VirtioNet.Reset()
        LET negotiated AS BOOL = VirtioNet.Negotiate()
        RETURN negotiated
    END IF
    RETURN 0
END FUNCTION

' Real legacy VirtIO teardown: writing 0 to DeviceStatus is the spec-defined reset/release step.
FUNCTION NetworkInterface.Stop(backendTag AS U32) AS BOOL
    IF backendTag = NetBackendVirtio() THEN
        RETURN VirtioNet.Reset()
    END IF
    RETURN 0
END FUNCTION

' Real negotiated-feature bitmask, not a synthesized capability list -- honest about exactly what
' this driver actually accepted from the device.
FUNCTION NetworkInterface.GetCapabilities(backendTag AS U32) AS U32
    IF backendTag = NetBackendVirtio() THEN
        RETURN VirtioNet.GetCapabilities()
    END IF
    RETURN 0
END FUNCTION

' Writes the real 6-byte MAC address to outAddr. Returns FALSE without writing anything if the
' backend cannot honestly report one (e.g. VIRTIO_NET_F_MAC was not negotiated).
FUNCTION NetworkInterface.GetMAC(backendTag AS U32, outAddr AS MMIOPTR) AS BOOL
    IF backendTag = NetBackendVirtio() THEN
        RETURN VirtioNet.ReadMac(outAddr)
    END IF
    RETURN 0
END FUNCTION

' 0=DOWN, 1=UP, 2=UNKNOWN (backend cannot honestly report link state right now).
FUNCTION NetworkInterface.GetLinkState(backendTag AS U32) AS U32
    IF backendTag = NetBackendVirtio() THEN
        RETURN VirtioNet.LinkState()
    END IF
    RETURN 2
END FUNCTION

' Brings the receive queue up and posts its one real buffer. Ownership of that buffer transfers to
' the device as part of this call -- see virtio_net_policy.abas's own ownership discussion.
FUNCTION NetworkInterface.SetupReceive(backendTag AS U32, systemTable AS UEFI.SystemTable) AS BOOL
    IF backendTag = NetBackendVirtio() THEN
        LET rxState AS MMIOPTR = VirtioNetRxQueueStateAddress()
        LET setup AS BOOL = VirtioNet.SetupQueue(systemTable, 0, rxState)
        IF setup = 0 THEN
            RETURN 0
        END IF
        RETURN VirtioNet.PostRxBuffer(rxState)
    END IF
    RETURN 0
END FUNCTION

' Brings the transmit queue up. No buffer is published until NetworkInterface.Transmit is called.
FUNCTION NetworkInterface.SetupTransmit(backendTag AS U32, systemTable AS UEFI.SystemTable) AS BOOL
    IF backendTag = NetBackendVirtio() THEN
        LET txState AS MMIOPTR = VirtioNetTxQueueStateAddress()
        RETURN VirtioNet.SetupQueue(systemTable, 1, txState)
    END IF
    RETURN 0
END FUNCTION

' Publishes frameAddr/frameLen for transmission. Ownership of that memory transfers to the device
' at this call -- the caller MUST NOT touch it again until NetworkInterface.PollTransmitComplete
' reports it back.
FUNCTION NetworkInterface.Transmit(backendTag AS U32, frameAddr AS MMIOPTR, frameLen AS U32) AS BOOL
    IF backendTag = NetBackendVirtio() THEN
        LET txState AS MMIOPTR = VirtioNetTxQueueStateAddress()
        RETURN VirtioNet.TransmitFrame(txState, frameAddr, frameLen)
    END IF
    RETURN 0
END FUNCTION

' Non-blocking check: TRUE and outLen written if the device has returned the transmitted buffer.
' Callers own their own bounded polling loop, never blocking indefinitely inside this function.
FUNCTION NetworkInterface.PollTransmitComplete(backendTag AS U32, outLen AS PTR) AS BOOL
    IF backendTag = NetBackendVirtio() THEN
        LET txState AS MMIOPTR = VirtioNetTxQueueStateAddress()
        RETURN VirtioNet.TryConsumeUsed(txState, outLen)
    END IF
    RETURN 0
END FUNCTION

' Non-blocking check: TRUE and outLen written if a frame has arrived. Ownership of the receive
' buffer returns to the caller at this point -- see NetworkInterface.ReceiveBufferAddress to read
' it, and NetworkInterface.SetupReceive again to re-post it for a future receive.
FUNCTION NetworkInterface.PollReceive(backendTag AS U32, outLen AS PTR) AS BOOL
    IF backendTag = NetBackendVirtio() THEN
        LET rxState AS MMIOPTR = VirtioNetRxQueueStateAddress()
        RETURN VirtioNet.TryConsumeUsed(rxState, outLen)
    END IF
    RETURN 0
END FUNCTION

' The real address of the receive queue's one buffer -- valid to read only after
' NetworkInterface.PollReceive has reported a completion. Includes the backend's own real wire-
' format header (see NetworkInterface.ReceiveHeaderSize); the actual frame begins after that many
' bytes.
FUNCTION NetworkInterface.ReceiveBufferAddress(backendTag AS U32) AS MMIOPTR
    IF backendTag = NetBackendVirtio() THEN
        LET rxState AS MMIOPTR = VirtioNetRxQueueStateAddress()
        LET bufPhys AS U64 = MEMORY.Read64(VirtioNetQueueBufPhysAddrField(rxState))
        RETURN ADDRESS.MMIO(ADDRESS.Virtual(bufPhys))
    END IF
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(0))
END FUNCTION

' Real, backend-reported byte count a caller must skip at the start of a received buffer before
' the actual Ethernet frame begins -- VirtIO-net's own real 10-byte virtio_net_hdr today. A future
' second backend reports its own real value here; callers never hardcode this.
FUNCTION NetworkInterface.ReceiveHeaderSize(backendTag AS U32) AS U32
    IF backendTag = NetBackendVirtio() THEN
        RETURN 10
    END IF
    RETURN 0
END FUNCTION
