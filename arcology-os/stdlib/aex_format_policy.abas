' RFC-0046 AEX Phase 1-3: real binary constants, bootstrap header validation, and chunk
' directory validation for the Arcology Executable Assembly format. Scoped exactly to Section
' 61's own Phases 1-3 ("AEX binary constants and parser structures" / "Bootstrap header
' validation" / "Chunk directory validation") -- manifest/component/capability interpretation
' (Phase 4+) and ArcFS-backed loading (Phase 6) are real, separate, later increments, not
' attempted here.
'
' Byte layout (both widths fixed here, per Section 9/10's own explicit invitation: "The final
' binary field widths SHALL be fixed by implementation").
'
' Bootstrap Header (64 bytes):
'   +0  Magic            8 bytes, "ARCOAEX\0"
'   +8  FormatVersion    U32, high 16 bits = major, low 16 bits = minor -- packed into one U32
'                         deliberately, to avoid ever calling MEMORY.Read16 (a real, documented
'                         compiler bug returns 0 for a 16-bit read at a high MMIO address; every
'                         other real driver in this project reads sub-32-bit fields via a
'                         32-bit-aligned Read32 + SHR/AND instead, and AEX follows the same
'                         established discipline from the start rather than rediscovering it)
'   +12 HeaderSize       U32, must equal AexHeaderSize() for v1
'   +16 AssemblyIDHigh   U64  (AssemblyID is a real 128-bit value, held as two U64 halves --
'   +24 AssemblyIDLow    U64   this backend has no native 128-bit type, the same convention
'                               ArcFS's own 128-bit OIDs already established)
'   +32 DirectoryOffset  U64
'   +40 DirectoryCount   U32
'   +44 RootManifestID   U32, the ChunkID of the directory entry holding the root MANIFEST
'   +48 Flags            U32
'   +52 Reserved         12 bytes, zeroed, real expansion room per Section 9.1
'
' Chunk Directory Entry (96 bytes each):
'   +0  ChunkID              U32, unique within this file
'   +4  ChunkTypeIDHigh      U64  (ChunkTypeID is also a real 128-bit value -- Section 10.1's
'   +12 ChunkTypeIDLow       U64   own "large, collision-resistant namespace" requirement met
'                                   with real UUIDv5 values generated offline, not an arbitrary
'                                   small enum Section 10.1 explicitly rules out)
'   +20 Flags                U32, bit0 = REQUIRED(1) / OPTIONAL(0)
'   +24 Offset               U64, absolute byte offset from file start
'   +32 StoredLength         U64
'   +40 LogicalLength        U64
'   +48 Alignment            U32
'   +52 EncodingOrCompress   U32, 0 = raw/uncompressed for Phase 1-3
'   +56 Hash                 32 bytes, reserved -- unused/unchecked until Phase 11 (integrity)
'   +88 Reserved             8 bytes

#PROFILE UEFI
#TARGET X86_64
#RUNTIME NONE

FUNCTION AexHeaderSize() AS U32
    RETURN 64
END FUNCTION
FUNCTION AexDirectoryEntryStride() AS U32
    RETURN 96
END FUNCTION
FUNCTION AexFormatMajorCurrent() AS U32
    RETURN 1
END FUNCTION
FUNCTION AexFormatMinorCurrent() AS U32
    RETURN 0
END FUNCTION
FUNCTION AexU64Max() AS U64
    RETURN 18446744073709551615
END FUNCTION

' ==========================================================================================
' Bootstrap header: magic check and field readers
' ==========================================================================================

FUNCTION AexCheckMagic(buffer AS MMIOPTR) AS BOOL
    ' "ARCOAEX\0"
    IF MEMORY.Read8(buffer) <> 65 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 1)) <> 82 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 2)) <> 67 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 3)) <> 79 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 4)) <> 65 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 5)) <> 69 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 6)) <> 88 THEN
        RETURN 0
    END IF
    IF MEMORY.Read8(ADDRESS.Offset(buffer, 7)) <> 0 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION AexReadFormatVersion(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 8))
END FUNCTION
FUNCTION AexFormatMajorOf(version AS U32) AS U32
    RETURN version SHR 16
END FUNCTION
FUNCTION AexFormatMinorOf(version AS U32) AS U32
    RETURN version AND 65535
END FUNCTION
FUNCTION AexReadHeaderSize(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 12))
END FUNCTION
FUNCTION AexReadAssemblyIDHigh(buffer AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(buffer, 16))
END FUNCTION
FUNCTION AexReadAssemblyIDLow(buffer AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(buffer, 24))
END FUNCTION
FUNCTION AexReadDirectoryOffset(buffer AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(buffer, 32))
END FUNCTION
FUNCTION AexReadDirectoryCount(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 40))
END FUNCTION
FUNCTION AexReadRootManifestID(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 44))
END FUNCTION
FUNCTION AexReadHeaderFlags(buffer AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(buffer, 48))
END FUNCTION

' ==========================================================================================
' Real loader error classes (Section 38's own spirit: deterministic, specific, not a bare
' boolean). 0 always means success.
' ==========================================================================================

FUNCTION AexErrorOk() AS U32
    RETURN 0
END FUNCTION
FUNCTION AexErrorBadMagic() AS U32
    RETURN 1
END FUNCTION
FUNCTION AexErrorUnsupportedFormatVersion() AS U32
    RETURN 2
END FUNCTION
FUNCTION AexErrorBadHeaderSize() AS U32
    RETURN 3
END FUNCTION
FUNCTION AexErrorDirectoryOutOfBounds() AS U32
    RETURN 4
END FUNCTION
FUNCTION AexErrorChunkOutOfBounds() AS U32
    RETURN 5
END FUNCTION
FUNCTION AexErrorUnknownRequiredChunkType() AS U32
    RETURN 6
END FUNCTION
FUNCTION AexErrorBadAlignment() AS U32
    RETURN 7
END FUNCTION

' Phase 2: Bootstrap header validation. Checks magic, format compatibility, declared header
' size, and that the chunk directory itself (offset + count*stride) fits within the real file
' length -- all before a single byte of the directory or any chunk is trusted. fileLength is the
' real, independently-known size of the loaded buffer (never taken from inside the file itself).
FUNCTION AEX.ValidateHeader(buffer AS MMIOPTR, fileLength AS U64) AS U32
    IF AexCheckMagic(buffer) = 0 THEN
        RETURN AexErrorBadMagic()
    END IF

    LET version AS U32 = AexReadFormatVersion(buffer)
    IF AexFormatMajorOf(version) <> AexFormatMajorCurrent() THEN
        RETURN AexErrorUnsupportedFormatVersion()
    END IF

    LET headerSize AS U32 = AexReadHeaderSize(buffer)
    IF headerSize <> AexHeaderSize() THEN
        RETURN AexErrorBadHeaderSize()
    END IF
    LET headerSizeAsU64 AS U64 = headerSize
    IF fileLength < headerSizeAsU64 THEN
        RETURN AexErrorBadHeaderSize()
    END IF

    LET dirOffset AS U64 = AexReadDirectoryOffset(buffer)
    LET dirCount AS U32 = AexReadDirectoryCount(buffer)
    LET dirCountAsU64 AS U64 = dirCount
    LET strideAsU64 AS U64 = AexDirectoryEntryStride()

    ' Real overflow-safe bounds check: dirOffset + dirCount*stride must not wrap, and must fit
    ' within fileLength -- the same "check before adding" discipline this project's own Physical
    ' Region Database allocator already established (RegionEnd's own overflow guard).
    IF dirCountAsU64 > 0 THEN
        IF strideAsU64 > (AexU64Max() \ dirCountAsU64) THEN
            RETURN AexErrorDirectoryOutOfBounds()
        END IF
    END IF
    LET dirByteLength AS U64 = dirCountAsU64 * strideAsU64
    IF dirOffset > AexU64Max() - dirByteLength THEN
        RETURN AexErrorDirectoryOutOfBounds()
    END IF
    LET dirEnd AS U64 = dirOffset + dirByteLength
    IF dirEnd > fileLength THEN
        RETURN AexErrorDirectoryOutOfBounds()
    END IF
    IF dirOffset < headerSizeAsU64 THEN
        RETURN AexErrorDirectoryOutOfBounds()
    END IF

    RETURN AexErrorOk()
END FUNCTION

' ==========================================================================================
' Chunk directory entries
' ==========================================================================================

FUNCTION AexDirectoryEntryAddress(buffer AS MMIOPTR, dirOffset AS U64, index AS U32) AS MMIOPTR
    LET indexAsU64 AS U64 = index
    LET strideAsU64 AS U64 = AexDirectoryEntryStride()
    RETURN ADDRESS.Offset(buffer, dirOffset + (indexAsU64 * strideAsU64))
END FUNCTION

FUNCTION AexReadEntryChunkID(entry AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(entry)
END FUNCTION
FUNCTION AexReadEntryTypeHigh(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 4))
END FUNCTION
FUNCTION AexReadEntryTypeLow(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 12))
END FUNCTION
FUNCTION AexReadEntryFlags(entry AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(entry, 20))
END FUNCTION
FUNCTION AexReadEntryOffset(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 24))
END FUNCTION
FUNCTION AexReadEntryStoredLength(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 32))
END FUNCTION
FUNCTION AexReadEntryLogicalLength(entry AS MMIOPTR) AS U64
    RETURN MEMORY.Read64(ADDRESS.Offset(entry, 40))
END FUNCTION
FUNCTION AexReadEntryAlignment(entry AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(entry, 48))
END FUNCTION
FUNCTION AexReadEntryEncoding(entry AS MMIOPTR) AS U32
    RETURN MEMORY.Read32(ADDRESS.Offset(entry, 52))
END FUNCTION
FUNCTION AexEntryIsRequired(entry AS MMIOPTR) AS BOOL
    LET entryFlags AS U32 = AexReadEntryFlags(entry)
    IF (entryFlags AND 1) <> 0 THEN
        RETURN 1
    END IF
    RETURN 0
END FUNCTION

' ==========================================================================================
' Standard AEX v1 chunk type identifiers (Section 11), real name-based UUIDv5 values --
' reproducible, not arbitrary: uuid.uuid5(NAMESPACE, "<TYPE NAME>") against a fixed, documented
' namespace UUID (6f5a2b3c-6e91-4f7a-9b3d-1a2c4e5f6081), computed once offline. Section 10.1
' explicitly requires a "large, collision-resistant namespace" and rules out a small enum as the
' sole mechanism -- this is that namespace, not a placeholder.
' ==========================================================================================

FUNCTION AexTypeManifestHigh() AS U64
    RETURN 14719843082355629295
END FUNCTION
FUNCTION AexTypeManifestLow() AS U64
    RETURN 9271930309043522079
END FUNCTION
FUNCTION AexTypeComponentHigh() AS U64
    RETURN 17360645306394565346
END FUNCTION
FUNCTION AexTypeComponentLow() AS U64
    RETURN 10985166509681775976
END FUNCTION
FUNCTION AexTypeImplementationHigh() AS U64
    RETURN 7866732109378180226
END FUNCTION
FUNCTION AexTypeImplementationLow() AS U64
    RETURN 11707123199072077656
END FUNCTION
FUNCTION AexTypeCodeHigh() AS U64
    RETURN 859404424522585693
END FUNCTION
FUNCTION AexTypeCodeLow() AS U64
    RETURN 12635621945936320080
END FUNCTION
FUNCTION AexTypeDataHigh() AS U64
    RETURN 3615471906802654651
END FUNCTION
FUNCTION AexTypeDataLow() AS U64
    RETURN 10345390336377140389
END FUNCTION
FUNCTION AexTypeResourceHigh() AS U64
    RETURN 5222799288954347266
END FUNCTION
FUNCTION AexTypeResourceLow() AS U64
    RETURN 13099566529540005749
END FUNCTION
FUNCTION AexTypeInterfaceHigh() AS U64
    RETURN 5188981897502022009
END FUNCTION
FUNCTION AexTypeInterfaceLow() AS U64
    RETURN 9356764828807109312
END FUNCTION
FUNCTION AexTypeRequirementHigh() AS U64
    RETURN 16336843977330678789
END FUNCTION
FUNCTION AexTypeRequirementLow() AS U64
    RETURN 12837214165910454027
END FUNCTION
FUNCTION AexTypeCapabilityRequestHigh() AS U64
    RETURN 12856951402654093542
END FUNCTION
FUNCTION AexTypeCapabilityRequestLow() AS U64
    RETURN 9717357363546278734
END FUNCTION
FUNCTION AexTypeArcoBindingHigh() AS U64
    RETURN 3383338636804706761
END FUNCTION
FUNCTION AexTypeArcoBindingLow() AS U64
    RETURN 10373826175911607214
END FUNCTION
FUNCTION AexTypeLifecycleHigh() AS U64
    RETURN 11836149854792734762
END FUNCTION
FUNCTION AexTypeLifecycleLow() AS U64
    RETURN 12071940426696027757
END FUNCTION
FUNCTION AexTypeMemoryPolicyHigh() AS U64
    RETURN 8487650950097361309
END FUNCTION
FUNCTION AexTypeMemoryPolicyLow() AS U64
    RETURN 10360956938434793214
END FUNCTION
FUNCTION AexTypeDiagnosticHigh() AS U64
    RETURN 17590739986515580581
END FUNCTION
FUNCTION AexTypeDiagnosticLow() AS U64
    RETURN 13035724507959637328
END FUNCTION
FUNCTION AexTypeSymbolHigh() AS U64
    RETURN 7765587605643352733
END FUNCTION
FUNCTION AexTypeSymbolLow() AS U64
    RETURN 12686448849480363835
END FUNCTION
FUNCTION AexTypeRecoveryHigh() AS U64
    RETURN 7906943963867533620
END FUNCTION
FUNCTION AexTypeRecoveryLow() AS U64
    RETURN 12296157333266628153
END FUNCTION
FUNCTION AexTypeIntegrityHigh() AS U64
    RETURN 5265016724168201421
END FUNCTION
FUNCTION AexTypeIntegrityLow() AS U64
    RETURN 11438856236987991108
END FUNCTION
FUNCTION AexTypeSignatureHigh() AS U64
    RETURN 2858157070238898764
END FUNCTION
FUNCTION AexTypeSignatureLow() AS U64
    RETURN 11055745981261010592
END FUNCTION

' Real membership test against every standard v1 chunk type. Deliberately a flat, repetitive
' chain of comparisons rather than a lookup table -- there is no array-of-records primitive on
' this backend cheap enough to justify one for a fixed 17-entry constant set, and a flat chain
' is trivially auditable against Section 11's own list, one line per type.
FUNCTION AexIsKnownChunkType(typeHigh AS U64, typeLow AS U64) AS BOOL
    IF typeHigh = AexTypeManifestHigh() THEN
        IF typeLow = AexTypeManifestLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeComponentHigh() THEN
        IF typeLow = AexTypeComponentLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeImplementationHigh() THEN
        IF typeLow = AexTypeImplementationLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeCodeHigh() THEN
        IF typeLow = AexTypeCodeLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeDataHigh() THEN
        IF typeLow = AexTypeDataLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeResourceHigh() THEN
        IF typeLow = AexTypeResourceLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeInterfaceHigh() THEN
        IF typeLow = AexTypeInterfaceLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeRequirementHigh() THEN
        IF typeLow = AexTypeRequirementLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeCapabilityRequestHigh() THEN
        IF typeLow = AexTypeCapabilityRequestLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeArcoBindingHigh() THEN
        IF typeLow = AexTypeArcoBindingLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeLifecycleHigh() THEN
        IF typeLow = AexTypeLifecycleLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeMemoryPolicyHigh() THEN
        IF typeLow = AexTypeMemoryPolicyLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeDiagnosticHigh() THEN
        IF typeLow = AexTypeDiagnosticLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeSymbolHigh() THEN
        IF typeLow = AexTypeSymbolLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeRecoveryHigh() THEN
        IF typeLow = AexTypeRecoveryLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeIntegrityHigh() THEN
        IF typeLow = AexTypeIntegrityLow() THEN
            RETURN 1
        END IF
    END IF
    IF typeHigh = AexTypeSignatureHigh() THEN
        IF typeLow = AexTypeSignatureLow() THEN
            RETURN 1
        END IF
    END IF
    RETURN 0
END FUNCTION

' Phase 3: Chunk directory validation (Section 10.3). For every entry: offset/storedLength must
' not overflow, offset+storedLength must fit within the file, alignment must be a real power of
' two the offset actually satisfies, and an unknown REQUIRED chunk type fails closed while an
' unknown OPTIONAL one is a real, deliberate no-op (Section 10.2). Assumes AEX.ValidateHeader
' already passed -- this function trusts dirOffset/dirCount only because that already happened.
FUNCTION AEX.ValidateDirectory(buffer AS MMIOPTR, fileLength AS U64) AS U32
    LET dirOffset AS U64 = AexReadDirectoryOffset(buffer)
    LET dirCount AS U32 = AexReadDirectoryCount(buffer)
    LET index AS U32 = 0

    WHILE index < dirCount
        LET entry AS MMIOPTR = AexDirectoryEntryAddress(buffer, dirOffset, index)
        LET chunkOffset AS U64 = AexReadEntryOffset(entry)
        LET storedLength AS U64 = AexReadEntryStoredLength(entry)
        LET alignment AS U32 = AexReadEntryAlignment(entry)

        IF chunkOffset > AexU64Max() - storedLength THEN
            RETURN AexErrorChunkOutOfBounds()
        END IF
        LET chunkEnd AS U64 = chunkOffset + storedLength
        IF chunkEnd > fileLength THEN
            RETURN AexErrorChunkOutOfBounds()
        END IF

        ' Alignment must be a real power of two (0 is treated as "no requirement", matching
        ' bytewise-anything storage) and the chunk's own offset must actually satisfy it.
        IF alignment > 1 THEN
            IF (alignment AND (alignment - 1)) <> 0 THEN
                RETURN AexErrorBadAlignment()
            END IF
            LET alignmentAsU64 AS U64 = alignment
            IF (chunkOffset MOD alignmentAsU64) <> 0 THEN
                RETURN AexErrorBadAlignment()
            END IF
        END IF

        LET required AS BOOL = AexEntryIsRequired(entry)
        IF required = 1 THEN
            LET typeHigh AS U64 = AexReadEntryTypeHigh(entry)
            LET typeLow AS U64 = AexReadEntryTypeLow(entry)
            IF AexIsKnownChunkType(typeHigh, typeLow) = 0 THEN
                RETURN AexErrorUnknownRequiredChunkType()
            END IF
        END IF

        index = index + 1
    WEND

    RETURN AexErrorOk()
END FUNCTION

' Real chunk lookup by ChunkID (used to resolve RootManifestID from the header into an actual
' directory entry). Returns AexDirectoryEntryStride()-sentinel... no -- returns the real found
' entry address, or the buffer's own base address is never a valid "not found" sentinel, so a
' separate BOOL out-of-band signal is needed. Matches this project's own established "staged
' result, caller checks a companion flag" idiom (RFC-0007's own RPM staging pattern) rather than
' inventing a fragile sentinel address.
FUNCTION AexFindChunkFoundAddress() AS MMIOPTR
    RETURN ADDRESS.MMIO(ADDRESS.Virtual(60817408))   ' 0x3A00000, a tiny 4-byte scratch flag
END FUNCTION

FUNCTION AexFindChunkByID(buffer AS MMIOPTR, wantChunkID AS U32) AS MMIOPTR
    LET dirOffset AS U64 = AexReadDirectoryOffset(buffer)
    LET dirCount AS U32 = AexReadDirectoryCount(buffer)
    LET index AS U32 = 0
    MEMORY.Write32(AexFindChunkFoundAddress(), 0)

    WHILE index < dirCount
        LET entry AS MMIOPTR = AexDirectoryEntryAddress(buffer, dirOffset, index)
        IF AexReadEntryChunkID(entry) = wantChunkID THEN
            MEMORY.Write32(AexFindChunkFoundAddress(), 1)
            RETURN entry
        END IF
        index = index + 1
    WEND

    RETURN buffer
END FUNCTION
