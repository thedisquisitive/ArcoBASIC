' RFC-0018 descriptor validation and region policy. Firmware descriptors are read once and
' translated into substrate-owned base/page ranges; allocator code must consume those ranges.

#PROFILE UEFI
#TARGET X86_64
#RUNTIME NONE

FUNCTION RegionEnd(base AS U64, pages AS U64) AS U64
    IF pages = 0 THEN
        RETURN 0
    END IF
    IF pages > 4503599627370495 THEN
        RETURN 0
    END IF
    LET bytes AS U64 = pages * 4096
    IF base > 18446744073709551615 - bytes THEN
        RETURN 0
    END IF
    RETURN base + bytes
END FUNCTION

FUNCTION ValidateRegion(base AS U64, pages AS U64, descriptorSize AS U64) AS BOOL
    IF descriptorSize < 48 THEN
        RETURN 0
    END IF
    IF (base AND 4095) <> 0 THEN
        RETURN 0
    END IF
    IF RegionEnd(base, pages) = 0 THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

FUNCTION RegionsOverlap(firstBase AS U64, firstPages AS U64, secondBase AS U64, secondPages AS U64) AS BOOL
    LET firstEnd AS U64 = RegionEnd(firstBase, firstPages)
    LET secondEnd AS U64 = RegionEnd(secondBase, secondPages)
    IF firstEnd = 0 THEN
        RETURN 0
    END IF
    IF secondEnd = 0 THEN
        RETURN 0
    END IF
    IF firstBase >= secondEnd THEN
        RETURN 0
    END IF
    IF secondBase >= firstEnd THEN
        RETURN 0
    END IF
    RETURN 1
END FUNCTION

' UEFI descriptor kinds. These are translated here so the permanent PRD does
' not expose firmware's numeric vocabulary to allocator policy.
FUNCTION PRDStateForFirmwareType(firmwareType AS U32) AS U32
    ' FREE: conventional memory and persistent memory are allocatable.
    IF firmwareType = 7 OR firmwareType = 14 THEN RETURN 0
    ' RUNTIME: firmware runtime pages remain protected after ExitBootServices.
    IF firmwareType = 5 OR firmwareType = 6 THEN RETURN 3
    ' DEVICE: MMIO and MMIO port-space are never ordinary RAM.
    IF firmwareType = 11 OR firmwareType = 12 THEN RETURN 5
    ' Every other firmware class is reserved until an explicit Arcology policy
    ' elects to reclaim it.
    RETURN 1
END FUNCTION

FUNCTION PRDFlagsForFirmwareType(firmwareType AS U32) AS U32
    IF firmwareType = 11 OR firmwareType = 12 THEN RETURN 2
    IF firmwareType = 5 OR firmwareType = 6 THEN RETURN 4
    IF firmwareType = 9 OR firmwareType = 10 THEN RETURN 8
    RETURN 0
END FUNCTION
