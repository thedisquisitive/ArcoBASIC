#TARGET linux
#DESCRIPTION "ArcFS host support and media management utility"

FUNCTION Usage()
    PRINT "Usage:"
    PRINT "  arcfsctl status"
    PRINT "  arcfsctl install-support"
    PRINT "  arcfsctl devices"
    PRINT "  arcfsctl create-image PATH SIZE_BYTES [--format]"
    PRINT "  arcfsctl format TARGET --force [--size BYTES] [--volume-id HEX]"
    PRINT "  arcfsctl inspect SOURCE"
    PRINT "  arcfsctl ls SOURCE [PATH]"
    PRINT "  arcfsctl cat SOURCE PATH"
    PRINT "  arcfsctl mount SOURCE MOUNTPOINT"
    PRINT "  arcfsctl unmount TARGET"
    PRINT "  arcfsctl snapshot create SOURCE [--label TEXT]"
    PRINT "  arcfsctl snapshot list SOURCE"
    PRINT "  arcfsctl snapshot delete SOURCE ID"
    PRINT "  arcfsctl snapshot ls SOURCE ID [PATH]"
    PRINT "  arcfsctl snapshot cat SOURCE ID PATH"
    PRINT "  arcfsctl rollback SOURCE ID"
END FUNCTION

FUNCTION ShellQuote(value)
    text = STRING(value)
    quoted = "'"
    index = 0
    WHILE index < String.Length(text)
        ch = String.Slice(text, index, 1)
        IF ch == "'" THEN
            quoted = quoted + "'\''"
        ELSE
            quoted = quoted + ch
        END IF
        index = index + 1
    WEND
    RETURN quoted + "'"
END FUNCTION

FUNCTION JoinCommand(parts)
    command = ""
    index = 0
    WHILE index < LEN(parts)
        IF index > 0 THEN command = command + " "
        command = command + ShellQuote(parts[index])
        index = index + 1
    WEND
    RETURN command
END FUNCTION

FUNCTION RunParts(parts)
    result = Process.Run(JoinCommand(parts))
    IF Object.Has(result, "Output") THEN
        IF String.Length(result.Output) > 0 THEN PRINT result.Output
    END IF
    IF result.Ok THEN RETURN result.ExitCode
    IF Object.Has(result, "Error") THEN PRINT result.Error
    RETURN result.ExitCode
END FUNCTION

FUNCTION CommandExists(name)
    result = Process.Run("command -v " + ShellQuote(name) + " >/dev/null 2>&1")
    RETURN result.Ok
END FUNCTION

FUNCTION HelperExists(path)
    RETURN File.Exists(path)
END FUNCTION

FUNCTION Status()
    PRINT "platform: linux"
    IF CommandExists("arcfs-linux") THEN
        PRINT "arcfs-linux: installed"
    ELSE
        PRINT "arcfs-linux: missing"
    END IF
    IF CommandExists("mount.arcfs") OR HelperExists("/usr/sbin/mount.arcfs") THEN
        PRINT "mount.arcfs: installed"
    ELSE
        PRINT "mount.arcfs: missing"
    END IF
    IF CommandExists("mkfs.arcfs") OR HelperExists("/usr/sbin/mkfs.arcfs") THEN
        PRINT "mkfs.arcfs: installed"
    ELSE
        PRINT "mkfs.arcfs: missing"
    END IF
    IF CommandExists("fusermount3") THEN
        PRINT "fusermount3: installed"
    ELSE
        PRINT "fusermount3: missing"
    END IF
    IF CommandExists("udisksctl") THEN
        PRINT "udisksctl: installed"
    ELSE
        PRINT "udisksctl: missing"
    END IF
    IF File.Exists("/usr/lib/udev/rules.d/61-arcfs.rules") OR File.Exists("/etc/udev/rules.d/61-arcfs.rules") THEN
        PRINT "udev_arcfs_rule: installed"
    ELSE
        PRINT "udev_arcfs_rule: missing"
    END IF
    RETURN 0
END FUNCTION

FUNCTION InstallSupport()
    code = 0
    IF CommandExists("udevadm") THEN
        code = RunParts(["udevadm", "control", "--reload"])
        code = RunParts(["udevadm", "trigger", "--subsystem-match=block"])
    END IF
    IF CommandExists("systemctl") THEN
        code = RunParts(["systemctl", "try-reload-or-restart", "udisks2.service"])
    END IF
    ignored = Status()
    RETURN code
END FUNCTION

FUNCTION Devices()
    IF CommandExists("lsblk") THEN
        RETURN RunParts(["lsblk", "-o", "NAME,PATH,SIZE,TYPE,TRAN,RM,RO,FSTYPE,LABEL,UUID,MODEL,SERIAL,MOUNTPOINTS"])
    END IF
    RETURN RunParts(["udisksctl", "status"])
END FUNCTION

FUNCTION TailParts(program, start, appArgs)
    parts = [program]
    index = start
    WHILE index < LEN(appArgs)
        ignored = Array.Push(parts, appArgs[index])
        index = index + 1
    WEND
    RETURN parts
END FUNCTION

FUNCTION CreateImage(appArgs)
    IF LEN(appArgs) < 3 THEN
        Usage()
        RETURN 2
    END IF
    path = appArgs[1]
    size = appArgs[2]
    format = FALSE
    index = 3
    WHILE index < LEN(appArgs)
        IF appArgs[index] == "--format" THEN
            format = TRUE
        ELSE
            PRINT "arcfsctl: unknown create-image option: " + appArgs[index]
            RETURN 2
        END IF
        index = index + 1
    WEND
    code = RunParts(["truncate", "-s", size, path])
    IF code != 0 THEN RETURN code
    IF format THEN RETURN RunParts(["arcfs-linux", "mkfs", path, "--force"])
    PRINT path
    RETURN 0
END FUNCTION

FUNCTION MountVolume(appArgs)
    IF LEN(appArgs) < 3 THEN
        Usage()
        RETURN 2
    END IF
    parts = ["mount", "-t", "arcfs", appArgs[1], appArgs[2]]
    IF LEN(appArgs) > 3 THEN
        opts = ""
        index = 3
        WHILE index < LEN(appArgs)
            IF index > 3 THEN opts = opts + ","
            opts = opts + appArgs[index]
            index = index + 1
        WEND
        ignored = Array.Push(parts, "-o")
        ignored = Array.Push(parts, opts)
    END IF
    RETURN RunParts(parts)
END FUNCTION

FUNCTION UnmountVolume(appArgs)
    IF LEN(appArgs) != 2 THEN
        Usage()
        RETURN 2
    END IF
    RETURN RunParts(["udisksctl", "unmount", "-b", appArgs[1]])
END FUNCTION

appArgs = Runtime.Args()

IF LEN(appArgs) == 0 THEN
    Usage()
    ExitTheProgram(2)
END IF

command = Lower(appArgs[0])
exitCode = 0

IF command == "--help" OR command == "-h" THEN
    Usage()
ELSE
    IF command == "status" THEN
        exitCode = Status()
    ELSE
        IF command == "install-support" THEN
            exitCode = InstallSupport()
        ELSE
            IF command == "devices" THEN
                exitCode = Devices()
            ELSE
                IF command == "create-image" THEN
                    exitCode = CreateImage(appArgs)
                ELSE
                    IF command == "format" THEN
                        exitCode = RunParts(TailParts("mkfs.arcfs", 1, appArgs))
                    ELSE
                        IF command == "inspect" THEN
                            exitCode = RunParts(TailParts("arcfs-linux", 0, appArgs))
                        ELSE
                            IF command == "ls" THEN
                                exitCode = RunParts(TailParts("arcfs-linux", 0, appArgs))
                            ELSE
                                IF command == "cat" THEN
                                    exitCode = RunParts(TailParts("arcfs-linux", 0, appArgs))
                                ELSE
                                    IF command == "mount" THEN
                                        exitCode = MountVolume(appArgs)
                                    ELSE
                                        IF command == "unmount" THEN
                                            exitCode = UnmountVolume(appArgs)
                                        ELSE
                                            IF command == "snapshot" THEN
                                                exitCode = RunParts(TailParts("arcfs-linux", 0, appArgs))
                                            ELSE
                                                IF command == "rollback" THEN
                                                    exitCode = RunParts(TailParts("arcfs-linux", 0, appArgs))
                                                ELSE
                                                    Usage()
                                                    PRINT "arcfsctl: unknown command: " + appArgs[0]
                                                    exitCode = 2
                                                END IF
                                            END IF
                                        END IF
                                    END IF
                                END IF
                            END IF
                        END IF
                    END IF
                END IF
            END IF
        END IF
    END IF
END IF

ExitTheProgram(exitCode)
