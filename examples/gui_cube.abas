#DESCRIPTION "Rotating 3D cube GUI demo"

IF GUI.Available() == FALSE THEN
    PRINT "No Wayland or X11 GUI backend is available."
    ExitTheProgram(0)
END IF

TRY
    GUI.Application("arco-cube", "Arco Cube")
    window = GUI.Window("ArcoBASIC 3D Cube", 760, 560)
CATCH err
    PRINT "Cube demo window could not be opened: " + err.Message
    ExitTheProgram(0)
END TRY

vertices = [
    {"X": -1, "Y": -1, "Z": -1},
    {"X":  1, "Y": -1, "Z": -1},
    {"X":  1, "Y":  1, "Z": -1},
    {"X": -1, "Y":  1, "Z": -1},
    {"X": -1, "Y": -1, "Z":  1},
    {"X":  1, "Y": -1, "Z":  1},
    {"X":  1, "Y":  1, "Z":  1},
    {"X": -1, "Y":  1, "Z":  1},
]

edges = [
    [0, 1], [1, 2], [2, 3], [3, 0],
    [4, 5], [5, 6], [6, 7], [7, 4],
    [0, 4], [1, 5], [2, 6], [3, 7],
]

angle_x = 0
angle_y = 0
angle_z = 0
auto_spin = TRUE
running = TRUE

FUNCTION RotatePoint(point, ax, ay, az)
    x1 = point.X
    y1 = point.Y * COS(ax) - point.Z * SIN(ax)
    z1 = point.Y * SIN(ax) + point.Z * COS(ax)

    x2 = x1 * COS(ay) + z1 * SIN(ay)
    y2 = y1
    z2 = 0 - x1 * SIN(ay) + z1 * COS(ay)

    x3 = x2 * COS(az) - y2 * SIN(az)
    y3 = x2 * SIN(az) + y2 * COS(az)
    RETURN {"X": x3, "Y": y3, "Z": z2}
END FUNCTION

FUNCTION ProjectPoint(point, width, height)
    distance = 4.0
    scale = 165 / (point.Z + distance)
    RETURN {
        "X": width / 2 + point.X * scale,
        "Y": height / 2 + point.Y * scale,
        "Z": point.Z,
        "Scale": scale,
    }
END FUNCTION

FUNCTION DrawEdge(edge, projected)
    a = projected[edge[0]]
    b = projected[edge[1]]
    depth = (a.Z + b.Z) / 2
    shade = CLAMP((depth + 1.6) / 3.2, 0.0, 1.0)
    red = 0.25 + shade * 0.65
    green = 0.56 + shade * 0.36
    blue = 0.95
    thickness = 2.0 + shade * 2.5
    GUI.Line(window, a.X, a.Y, b.X, b.Y, thickness, red, green, blue)
END FUNCTION

FUNCTION DrawCube()
    size = GUI.Size(window)
    projected = []
    FOR vertex IN vertices
        rotated = RotatePoint(vertex, angle_x, angle_y, angle_z)
        ignored = Array.Add(projected, ProjectPoint(rotated, size.Width, size.Height))
    NEXT

    GUI.Clear(window, 0.035, 0.040, 0.055)
    GUI.Text(window, "ArcoBASIC rotating cube", 24, 22, 22, 0.85, 0.92, 1.0)
    GUI.Text(window, "Space toggles spin   Arrows rotate   Esc closes", 24, 52, 14, 0.48, 0.58, 0.72)

    FOR edge IN edges
        DrawEdge(edge, projected)
    NEXT

    FOR point IN projected
        radius = 3.0 + point.Scale / 42
        GUI.Circle(window, point.X, point.Y, radius, 1.0, 1.0, 1.0, 0.92)
    NEXT

    GUI.Present(window)
END FUNCTION

WHILE running
    IF auto_spin THEN
        angle_x = angle_x + 0.018
        angle_y = angle_y + 0.026
        angle_z = angle_z + 0.011
    END IF

    DrawCube()

    event = GUI.WaitEvent(0.016)
    IF event.Type == "close" THEN running = FALSE
    IF event.Type == "key" THEN
        IF event.Action == "press" OR event.Action == "repeat" THEN
            IF event.Key == "escape" THEN running = FALSE
            IF event.Key == "space" THEN auto_spin = NOT auto_spin
            IF event.Key == "left" THEN angle_y = angle_y - 0.12
            IF event.Key == "right" THEN angle_y = angle_y + 0.12
            IF event.Key == "up" THEN angle_x = angle_x - 0.12
            IF event.Key == "down" THEN angle_x = angle_x + 0.12
        END IF
    END IF
    IF GUI.ShouldClose(window) THEN running = FALSE
WEND

GUI.Close(window)
