rng = Random.Create(42, 54)
PRINT Random.Integer(0, 100, rng)
PRINT Random.Integer(0, 100, rng)
PRINT Random.Float(rng)
PRINT Random.Choice(["north", "south", "east", "west"], rng)
PRINT Random.Sample([1, 2, 3, 4, 5], 3, rng)
PRINT Random.Shuffle([1, 2, 3, 4, 5], rng)
Random.Reseed(rng, 42, 54)
PRINT Random.Integer(0, 100, rng)
Random.Destroy(rng)
