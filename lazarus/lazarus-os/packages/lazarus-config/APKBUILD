options="!check"

package() {
	install -Dm644 "$srcdir/bench.profile" "$pkgdir/etc/arcology-lazarus/bench.profile"
	install -Dm644 "$srcdir/90-arcology-lazarus.rules" "$pkgdir/etc/udev/rules.d/90-arcology-lazarus.rules"
}
