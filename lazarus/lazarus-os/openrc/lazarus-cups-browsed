#!/sbin/openrc-run

name="Arcology Lazarus printer discovery"
description="Discovers local driverless IPP printers and creates CUPS queues"
command="/usr/sbin/cups-browsed"
command_background="yes"
pidfile="/run/cups-browsed.pid"
output_log="/var/log/cups/cups-browsed.log"
error_log="/var/log/cups/cups-browsed.log"

depend() {
	need cupsd avahi-daemon dbus
	after lazarus-network
}

start_pre() {
	checkpath --directory --mode 0755 /var/cache/cups /var/log/cups
}

start_post() {
	# OpenRC status output follows the physical console. Emit one explicit
	# serial milestone so headless boot validation can still prove that printer
	# discovery started successfully.
	echo "lazarus-printers: driverless discovery ready" >/dev/ttyS0 2>/dev/null || true
}
