#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# This must precede every external command. If early userspace cannot even
# prepare BusyBox, the physical console still shows exactly where boot stopped.
echo "lazarus-live: Entered initramfs /init."

/usr/bin/busybox --install -s

message() {
	line="lazarus-live: $*"
	echo "$line"
	# tty0 is the primary console on physical machines. Keep a separate serial
	# copy for headless diagnostics and the QEMU smoke tests.
	serial_console=/dev/ttyS0
	if [ ! -w "$serial_console" ] && [ -w /sysroot/dev/ttyS0 ]; then
		serial_console=/sysroot/dev/ttyS0
	fi
	if [ -w "$serial_console" ]; then
		echo "$line" >"$serial_console" 2>/dev/null || true
	fi
}

rescue_shell() {
	message "$*"
	message "Dropping to recovery shell."
	exec /bin/sh
}

load_module() {
	module="$1"
	if [ -f "$module" ]; then
		insmod "$module" 2>/dev/null || true
		return 0
	fi
	if [ -f "$module.gz" ]; then
		tmp="/run/$(basename "$module").$$.ko"
		gzip -dc "$module.gz" > "$tmp" 2>/dev/null || return 0
		insmod "$tmp" 2>/dev/null || true
		rm -f "$tmp"
	fi
}

mount -t devtmpfs -o exec,nosuid,mode=0755,size=2M devtmpfs /dev 2>/dev/null || \
	mount -t tmpfs -o exec,nosuid,mode=0755,size=2M tmpfs /dev
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -c /dev/kmsg ] || mknod -m 660 /dev/kmsg c 1 11

mkdir -p /proc /sys /run /tmp /media/boot /media/root-ro /sysroot
mount -t proc -o noexec,nosuid,nodev proc /proc
mount -t sysfs -o noexec,nosuid,nodev sysfs /sys
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run

message "Early filesystems mounted."
message "Loading USB, storage, and filesystem drivers."
for module in \
	scsi_mod sd_mod \
	usbcore xhci_hcd xhci_pci ehci_hcd ehci_pci ohci_hcd ohci_pci uhci_hcd \
	usb_storage uas \
	vmd nvme_core nvme \
	ahci libahci libata ata_piix ata_generic \
	mmc_core mmc_block sdhci sdhci_pci \
	virtio_pci virtio_blk \
	isofs loop \
	ext4
do
	modprobe "$module" 2>/dev/null || true
done
kernel_release="$(uname -r)"
load_module "/usr/lib/modules/$kernel_release/kernel/fs/squashfs/squashfs.ko"
load_module "/usr/lib/modules/$kernel_release/kernel/fs/overlayfs/overlay.ko"

message "Waiting for boot media."
for attempt in $(seq 1 240); do
	mdev -s 2>/dev/null || true
	# USB and disk devices are checked before optical drives. Some systems
	# expose an empty sr0 even when firmware booted Lazarus from USB.
	for dev in /dev/sd? /dev/sd??* /dev/vd? /dev/vd??* /dev/nvme*n*; do
		[ -b "$dev" ] || continue
		mount -t iso9660 -o ro "$dev" /media/boot 2>/dev/null || continue
		if [ -f /media/boot/boot/arcology-lazarus-live.marker ] &&
		   [ -f /media/boot/boot/rootfs.squashfs ]; then
			bootdev="$dev"
			break 2
		fi
		umount /media/boot 2>/dev/null || true
	done
	# Retain optical boot support, but probe it less often to avoid repeatedly
	# asking the kernel to open an empty optical device.
	if [ $((attempt % 8)) -eq 0 ]; then
		for dev in /dev/sr*; do
			[ -b "$dev" ] || continue
			mount -t iso9660 -o ro "$dev" /media/boot 2>/dev/null || continue
			if [ -f /media/boot/boot/arcology-lazarus-live.marker ] &&
			   [ -f /media/boot/boot/rootfs.squashfs ]; then
				bootdev="$dev"
				break 2
			fi
			umount /media/boot 2>/dev/null || true
		done
	fi
	sleep 0.25
done

[ -n "${bootdev:-}" ] || rescue_shell "Could not find Arcology Lazarus boot media."
message "Boot media mounted from $bootdev."
installer_media=false
[ ! -f /media/boot/boot/lazarus-installer.flag ] || installer_media=true

mount -t squashfs -o ro,loop /media/boot/boot/rootfs.squashfs /media/root-ro || \
	rescue_shell "Could not mount /boot/rootfs.squashfs."

# The squashfs loop keeps its backing inode alive after ISO9660 is unmounted. Releasing the whole
# hybrid disk is necessary before Linux will allow its appended state partition to be mounted.
boot_media_released=false
if umount /media/boot 2>/dev/null; then
	boot_media_released=true
	message "Boot filesystem released after the live root was attached."
else
	message "Boot filesystem remains busy; using a bounded partition mapping for USB state."
fi

mount -t tmpfs -o mode=0755 tmpfs /sysroot || rescue_shell "Could not mount live tmpfs root."
mkdir -p /sysroot/.root-ro /sysroot/.root-rw /sysroot/.root-work
mount --move /media/root-ro /sysroot/.root-ro
mount -t overlay -o lowerdir=/sysroot/.root-ro,upperdir=/sysroot/.root-rw,workdir=/sysroot/.root-work overlay /sysroot || \
	rescue_shell "Could not create writable live overlay."

# Hybrid live USBs carry a small ext4 partition immediately after the boot payload. Only inspect
# partition 4 of the media that supplied this live root; never adopt a same-labeled state partition
# from a customer's disk or an installed Lazarus appliance.
case "$bootdev" in
	/dev/nvme*n*|/dev/mmcblk*|/dev/loop*|/dev/nbd*) state_device="${bootdev}p4" ;;
	/dev/sd*|/dev/vd*) state_device="${bootdev}4" ;;
	*) state_device="" ;;
esac
if [ -n "$state_device" ]; then
	for _ in $(seq 1 20); do
		mdev -s 2>/dev/null || true
		[ -b "$state_device" ] && break
		sleep 0.1
	done
fi
if [ -n "$state_device" ] && [ -b "$state_device" ] &&
   blkid "$state_device" 2>/dev/null | grep -q 'LABEL="LAZARUS_STATE"'; then
	mkdir -p /sysroot/var/lib/arcology-lazarus
	state_source="$state_device"
	state_mounted=false
	if [ "$boot_media_released" = true ] &&
	   mount -t ext4 -o rw,nosuid,nodev "$state_source" /sysroot/var/lib/arcology-lazarus; then
		state_mounted=true
	elif [ -r "/sys/class/block/${state_device##*/}/start" ]; then
		# ISO9660 can retain an exclusive claim on the hybrid whole-disk node while its
		# squashfs loop is active. Map only the trusted partition-4 byte range from that
		# same boot device so the non-overlapping ext4 state filesystem remains writable.
		state_offset_sectors="$(cat "/sys/class/block/${state_device##*/}/start")"
		state_loop="$(losetup -f 2>/dev/null || true)"
		if [ -n "$state_loop" ] &&
		   losetup -o "$((state_offset_sectors * 512))" "$state_loop" "$bootdev" 2>/dev/null &&
		   mount -t ext4 -o rw,nosuid,nodev "$state_loop" /sysroot/var/lib/arcology-lazarus; then
			state_source="$state_loop"
			state_mounted=true
		else
			[ -z "${state_loop:-}" ] || losetup -d "$state_loop" 2>/dev/null || true
		fi
	fi
	if [ "$state_mounted" = true ]; then
		state_probe=/sysroot/var/lib/arcology-lazarus/.lazarus-write-test
		if touch "$state_probe" 2>/dev/null; then
			rm -f "$state_probe"
		else
			umount /sysroot/var/lib/arcology-lazarus 2>/dev/null || true
			[ -z "${state_loop:-}" ] || losetup -d "$state_loop" 2>/dev/null || true
			state_mounted=false
		fi
	fi
	if [ "$state_mounted" = true ]; then
		state_root=/sysroot/var/lib/arcology-lazarus
		mkdir -p "$state_root/config" /sysroot/etc/arcology-lazarus
		for file in bench.profile network.conf; do
			persistent="$state_root/config/$file"
			active="/sysroot/etc/arcology-lazarus/$file"
			if [ ! -f "$persistent" ]; then
				cp "$active" "$persistent"
			fi
			mount --bind "$persistent" "$active"
		done
		chmod 0644 "$state_root/config/bench.profile" "$state_root/config/network.conf"
		message "Writable live appliance state mounted from $state_device via $state_source."
	else
		message "Live state partition $state_device could not be mounted; continuing with volatile state."
	fi
else
	message "No writable state partition was found on the boot media; continuing with volatile state."
fi

mkdir -p /sysroot/proc /sysroot/sys /sysroot/dev /sysroot/run /sysroot/media/boot
mount --move /proc /sysroot/proc
mount --move /sys /sysroot/sys
mount --move /dev /sysroot/dev
mount --move /run /sysroot/run
if [ "$boot_media_released" != true ]; then
	mount --move /media/boot /sysroot/media/boot
fi

message "Switching to Arcology Lazarus OS."
if [ "$installer_media" = true ]; then
	message "Installer media marker detected."
	chvt 1 2>/dev/null || true
	exec switch_root /sysroot /usr/local/sbin/lazarus-install-os
fi
exec switch_root /sysroot /sbin/init

rescue_shell "switch_root returned unexpectedly."
