#!/bin/sh
set -eu

log_input_devices() {
	if [ -r /proc/bus/input/devices ]; then
		printf 'lazarus-xinitrc: input devices snapshot\n' >>/dev/ttyS0 2>/dev/null || true
		sed 's/^/input: /' /proc/bus/input/devices >>/dev/ttyS0 2>/dev/null || true
	fi
}

if command -v modprobe >/dev/null 2>&1; then
	modprobe xhci_pci >/dev/null 2>&1 || true
	modprobe xhci_hcd >/dev/null 2>&1 || true
	modprobe virtio_input >/dev/null 2>&1 || true
	modprobe evdev >/dev/null 2>&1 || true
	modprobe hid_generic >/dev/null 2>&1 || true
	modprobe usbhid >/dev/null 2>&1 || true
fi

for _ in 1 2 3 4 5; do
	if grep -Eq 'Handlers=.*(mouse|event)' /proc/bus/input/devices 2>/dev/null; then
		break
	fi
	sleep 1
done

log_input_devices

# Kiosk presentation settings are deliberately omitted here. On the QEMU Xorg
# driver, even probing DPMS can stall before the client session starts.
printf 'lazarus-xinitrc: starting Lazarus client session\n' >>/dev/ttyS0 2>/dev/null || true
mkdir -p /run/arcology-lazarus
touch /run/arcology-lazarus/x-client-started

# Xorg must start with the service's privileges so it can claim the VT. The
# application and its session bus remain unprivileged.
display="${DISPLAY:-:0}"
xauthority="${XAUTHORITY:-}"
bench_profile="${LAZARUS_BENCH_PROFILE:-/etc/arcology-lazarus/bench.profile}"
service_socket="${LAZARUS_SERVICE_SOCKET:-/run/arcology-lazarus/service.sock}"
cursor_theme="${XCURSOR_THEME:-Adwaita}"
cursor_size="${XCURSOR_SIZE:-32}"
cursor_path="${XCURSOR_PATH:-/usr/share/icons}"
scale_environment="GDK_SCALE=1 GDK_DPI_SCALE=1"
if command -v xrandr >/dev/null 2>&1 && DISPLAY="$display" xrandr --query >/tmp/lazarus-xrandr.txt 2>/dev/null; then
	physical_output="$(awk '$2 == "connected" && $1 != "Virtual-1" { print $1; exit }' /tmp/lazarus-xrandr.txt)"
	if grep -q '^Virtual-1 connected' /tmp/lazarus-xrandr.txt; then
	# Set the X framebuffer and output mode together. Changing only the output
	# mode leaves QEMU's backing surface at its old dimensions when zoom-to-fit
	# is active, which confines the kiosk to one corner of the display.
		DISPLAY="$display" xrandr --fb 1920x1080 --output Virtual-1 --mode 1920x1080 >/dev/null 2>&1 || true
		printf 'lazarus-xinitrc: QEMU framebuffer and output set to 1920x1080 at GTK scale 1\n' >>/dev/ttyS0 2>/dev/null || true
	elif [ -n "$physical_output" ] &&
	     sed -n "/^$physical_output connected/,/^[^[:space:]]/p" /tmp/lazarus-xrandr.txt |
	         grep -q '^[[:space:]]*1920x1080[[:space:]]'; then
		# Use a predictable 1080p kiosk canvas on physical displays that advertise it. Lower-resolution
		# panels retain their native mode; the GTK shell remains scroll-safe down to 1024x768.
		DISPLAY="$display" xrandr --output "$physical_output" --mode 1920x1080 >/dev/null 2>&1 || true
		printf 'lazarus-xinitrc: physical output %s requested at 1920x1080 and GTK scale 1\n' \
			"$physical_output" >>/dev/ttyS0 2>/dev/null || true
	fi
	current_modes="$(DISPLAY="$display" xrandr --current 2>/dev/null | awk '
		$2 == "connected" { output=$1 }
		/^[[:space:]]+[0-9]+x[0-9]+.*\*/ { print output "=" $1 }
	')"
	printf 'lazarus-xinitrc: active display modes: %s\n' "${current_modes:-unknown}" >>/dev/ttyS0 2>/dev/null || true
fi
printf 'lazarus-xinitrc: exec Lazarus client\n' >>/dev/ttyS0 2>/dev/null || true
exec su -s /bin/sh lazarus -c "exec dbus-run-session -- env \
  DISPLAY='$display' \
  XAUTHORITY='$xauthority' \
  GDK_BACKEND=x11 \
  $scale_environment \
  HOME=/var/lib/arcology-lazarus \
  XCURSOR_THEME='$cursor_theme' \
  XCURSOR_SIZE='$cursor_size' \
  XCURSOR_PATH='$cursor_path' \
  LAZARUS_KIOSK_FULLSCREEN=1 \
  LAZARUS_BENCH_PROFILE='$bench_profile' \
  LAZARUS_SERVICE_SOCKET='$service_socket' \
  /usr/bin/lazarus-gui '$bench_profile'"
