; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are defined by the engine.

config_version=5

[application]

config/name="Arco3D (Godot Edition)"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[display]

; "Can we make the side panels pop out into independent windows?" -- the user's own explicit ask,
; then directly corrected once mid-build: "that's still contained within the single window, which
; doesn't fix the real estate problem." Confirmed directly (not assumed): Godot 4's own real,
; documented DEFAULT for this setting is true, meaning every `Window` node -- including the real
; ones this app's own floating-panel feature creates -- renders as an embedded rectangle INSIDE the
; single main OS window instead of a genuine separate top-level window a person can drag to another
; monitor. Explicit false here is the actual fix -- real multi-window/multi-monitor behavior needs
; this project setting, not just correct Window-node code.
window/subwindows/embed_subwindows=false

[rendering]

renderer/rendering_method="forward_plus"
